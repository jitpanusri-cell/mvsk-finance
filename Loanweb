  const perdiem = travel ? (+$('fDcPerdiem').value || 0) * (+$('fDcPerdiemDays').value || 0) * people : 0;
  const lodge = travel ? (+$('fDcLodge').value || 0) * (+$('fDcLodgeDays').value || 0) * people : 0;
  const routes = dcLines($('fDcTransportRoutes').value);
  if (routes.some(x => x.amt)) $('fDcTransport').value = routes.reduce((x, r) => x + r.amt, 0);
  const items = dcLines($('fDcItems').value).reduce((x, r) => x + r.amt, 0);
  const total = perdiem + lodge + (travel ? (+$('fDcTransport').value || 0) + (+$('fDcOtherAmt').value || 0) : 0) + items;
  $('fDcAmt').value = money(total);
  $('dcTotalPreview').textContent = money(total);
  if (DC.live) DC.live();
}
