  if (!r.loanDueDate) return { cls: 'due', txt: 'ค้างส่งคืน' };
  const d = Math.round((new Date(r.loanDueDate) - new Date(S.boot.today)) / 86400000);
  return d < 0 ? { cls: 'overdue', txt: 'เกินกำหนด ' + (-d) + ' วัน' } : { cls: 'due', txt: 'ค้างส่งคืน · ' + (d ? 'เหลือ ' + d + ' วัน' : 'ครบกำหนดวันนี้') };
}
