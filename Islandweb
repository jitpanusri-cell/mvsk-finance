<script>
  (function () {
    var h = document.getElementById('head'), n = document.getElementById('nav'), b = document.getElementById('burger'), s = document.getElementById('staffLink');
    b.addEventListener('click', function () { n.classList.toggle('show'); });
    window.addEventListener('scroll', function () { h.classList.toggle('scrolled', window.scrollY > 20); }, { passive: true });
    var dd = document.getElementById('grpDd'), db = document.getElementById('grpBtn');
    db.addEventListener('click', function (e) { e.stopPropagation(); var o = dd.classList.toggle('open'); db.setAttribute('aria-expanded', o); });
    document.addEventListener('click', function (e) { if (!dd.contains(e.target)) { dd.classList.remove('open'); db.setAttribute('aria-expanded', 'false'); } });
    s.addEventListener('click', function (e) { if (s.getAttribute('href') === '#') { e.preventDefault(); alert('ยังไม่ได้ผูกเว็บกับระบบการเงิน (ระบบการเงิน > เว็บไซต์ > ตั้งค่า)'); } });
  })();
</script>
