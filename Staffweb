  <!-- ยืนยัน -->
  <div class="modal" id="mConfirm" role="alertdialog" aria-modal="true" style="z-index:150">
    <div class="sheet sm" style="margin-top:12vh">
      <div class="sheet-b"><h3 id="cTitle" style="margin-bottom:8px"></h3><div id="cMsg" style="color:var(--muted)"></div></div>
      <div class="sheet-f"><button class="btn" data-close>ยกเลิก</button><button class="btn danger" id="cOk">ยืนยัน</button></div>
    </div>
  </div>

  <div id="toast" role="status"></div>

  <script>
    var TYPES = {
      'alert': { label: 'ด่วนที่สุด', icon: 'alert' },
      'finance-alert': { label: 'งานการเงิน', icon: 'coins' },
      'supplies-alert': { label: 'งานพัสดุ', icon: 'box' },
      'general': { label: 'ข่าวทั่วไป', icon: 'megaphone' },
      'document': { label: 'เอกสาร/ดาวน์โหลด', icon: 'file' }
    };
    var LINK_ICONS = ['wallet', 'box', 'chart', 'receipt', 'coins', 'file', 'folder', 'users', 'cap', 'card', 'sitemap', 'link'];
    var TH_MONTHS = ['มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน', 'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'];
    var S = { token: '', user: null, items: [], links: [], today: '', orderDirty: false, users: [], log: [] };

    function $(id) { return document.getElementById(id); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function icon(n, cls) { return '<svg class="ic ' + (cls || '') + '"><use href="#i-' + n + '"/></svg>'; }
    function store(k, v) { try { if (v === undefined) return sessionStorage.getItem(k); if (v === null) sessionStorage.removeItem(k); else sessionStorage.setItem(k, v); } catch (e) { return null; } }
    function storeL(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { return null; } }

    var busyN = 0;
    function busy(on) { busyN += on ? 1 : -1; $('busy').style.display = busyN > 0 ? 'block' : 'none'; }
    function toast(msg, err) { var t = $('toast'); t.className = err ? 'err' : ''; t.innerHTML = icon(err ? 'alert' : 'check') + esc(msg); t.style.display = 'flex'; clearTimeout(t._h); t._h = setTimeout(function () { t.style.display = 'none'; }, err ? 4500 : 2600); }

    /* เรียกฟังก์ชันฝั่งเซิร์ฟเวอร์ */
    function api(fn) {
      var args = Array.prototype.slice.call(arguments, 1);
      busy(true);
      return new Promise(function (res, rej) {
        google.script.run
          .withSuccessHandler(function (r) {
            busy(false);
            if (r && r.success === false) {
              if (/หมดเวลา/.test(r.message || '')) { showLogin(r.message); }
              rej(new Error(r.message || 'เกิดข้อผิดพลาด')); return;
            }
            res(r);
          })
          .withFailureHandler(function (e) { busy(false); rej(new Error((e && e.message) || 'เชื่อมต่อเซิร์ฟเวอร์ไม่สำเร็จ')); })[fn].apply(null, args);
      });
    }
    function fail(e) { toast(e.message || String(e), true); }

    function confirmBox(title, msg, okText) {
      return new Promise(function (res) {
        $('cTitle').textContent = title; $('cMsg').textContent = msg; $('cOk').textContent = okText || 'ยืนยัน';
        openM('mConfirm');
        $('cOk').onclick = function () { closeM('mConfirm'); res(true); };
        $('mConfirm').querySelectorAll('[data-close]').forEach(function (b) { b.onclick = function () { closeM('mConfirm'); res(false); }; });
      });
    }
    function openM(id) { $(id).classList.add('on'); document.body.style.overflow = 'hidden'; }
    function closeM(id) { $(id).classList.remove('on'); if (!document.querySelector('.modal.on')) document.body.style.overflow = ''; }

    function thaiDate(ymd) {
      if (!ymd) return '';
      var p = ymd.split('-');
      return 'วันที่ ' + Number(p[2]) + ' ' + TH_MONTHS[Number(p[1]) - 1] + ' พ.ศ. ' + (Number(p[0]) + 543);
    }
    function thaiToYmd(txt) {
      var m = String(txt || '').match(/(\d{1,2})\s+(\S+)\s+(?:พ\.ศ\.\s*)?(\d{4})/);
      if (!m) return '';
      var mi = TH_MONTHS.indexOf(m[2]); if (mi < 0) return '';
      var y = Number(m[3]) - 543;
      return y + '-' + ('0' + (mi + 1)).slice(-2) + '-' + ('0' + m[1]).slice(-2);
    }
    function plain(html) { var d = document.createElement('div'); d.innerHTML = String(html || '').replace(/<br\s*\/?>/gi, ' ').replace(/<\/(p|div|li)>/gi, ' '); d.querySelectorAll('script,style').forEach(function (x) { x.remove(); }); return (d.textContent || '').replace(/\s+/g, ' ').trim(); }
    function isExpired(a) { return a.expire && a.expire < S.today; }

    /* ---------- เข้าสู่ระบบ ---------- */
    function showLogin(msg) {
      store('stf_token', null); S.token = '';
      $('app').hidden = true; $('login').hidden = false;
      document.querySelectorAll('.modal.on').forEach(function (m) { m.classList.remove('on'); });
      $('loginErr').hidden = !msg; $('loginErr').textContent = msg || '';
      var u = storeL('stf_user'); if (u) { $('lUser').value = u; $('lRemember').checked = true; $('lPass').focus(); } else $('lUser').focus();
    }
    $('lShow').onclick = function () { var p = $('lPass'); var show = p.type === 'password'; p.type = show ? 'text' : 'password'; this.innerHTML = icon(show ? 'eye-off' : 'eye'); };
    $('loginForm').onsubmit = function (e) {
      e.preventDefault();
      var btn = $('lBtn'); btn.disabled = true; $('loginErr').hidden = true;
      api('verifyAdminLogin', $('lUser').value, $('lPass').value).then(function (r) {
        S.token = r.token; store('stf_token', r.token);
        storeL('stf_user', $('lRemember').checked ? $('lUser').value.trim() : null);
        $('lPass').value = '';
        $('weakPw').hidden = !r.weakPassword;
        return boot();
      }).catch(function (err) { $('loginErr').textContent = err.message; $('loginErr').hidden = false; })
        .then(function () { btn.disabled = false; });
    };
    $('btnLogout').onclick = function () { var t = S.token; api('logLogout', t).catch(function () { }); showLogin(''); toast('ออกจากระบบแล้ว'); };

    function boot() {
      return api('getStaffData', S.token).then(function (r) {
        S.user = r.user; S.items = r.items || []; S.links = r.links || []; S.today = r.today; S.orderDirty = false;
        $('login').hidden = true; $('app').hidden = false;
        $('uName').textContent = S.user.name; $('uAv').textContent = (S.user.name || '?').replace(/^(นาย|นางสาว|นาง|ว่าที่ร้อยตรี|ดร\.)\s*/, '').charAt(0);
        $('hello').textContent = 'สวัสดี ' + S.user.name;
        renderAll();
      });
    }

    /* ---------- แท็บ ---------- */
    function goTab(t) {
      document.querySelectorAll('.tab').forEach(function (b) { b.classList.toggle('on', b.dataset.tab === t); });
      document.querySelectorAll('[data-page]').forEach(function (s) { s.hidden = s.dataset.page !== t; });
      if (t === 'account') loadUsers();
      if (t === 'log') loadLog();
      window.scrollTo(0, 0);
    }
    $('tabs').onclick = function (e) { var b = e.target.closest('.tab'); if (b) goTab(b.dataset.tab); };

    function renderAll() { renderStats(); renderLinks(); renderRecent(); renderTable(); }

    function renderStats() {
      var I = S.items;
      var c = {
        all: I.length,
        on: I.filter(function (a) { return !a.isHidden && !isExpired(a); }).length,
        off: I.filter(function (a) { return a.isHidden; }).length,
        pin: I.filter(function (a) { return a.pinned; }).length,
        exp: I.filter(isExpired).length
      };
      var defs = [['', 'ประกาศทั้งหมด', 'megaphone', c.all], ['on', 'แสดงบนเว็บ', 'eye', c.on], ['off', 'ซ่อนอยู่', 'eye-off', c.off], ['pin', 'ปักหมุด', 'pin', c.pin], ['exp', 'หมดอายุแล้ว', 'clock', c.exp]];
      $('stats').innerHTML = defs.map(function (d) {
        return '<button class="card stat" data-stat="' + d[0] + '"><span class="k">' + icon(d[2], 'sm') + d[1] + '</span><span class="v">' + d[3] + '</span></button>';
      }).join('');
    }
    $('stats').onclick = function (e) { var b = e.target.closest('[data-stat]'); if (!b) return; $('nStatus').value = b.dataset.stat; $('nQ').value = ''; $('nType').value = ''; goTab('news'); renderTable(); };

    function linkHtml(l) {
      return '<a class="lk" href="' + esc(l.url) + '" target="_blank" rel="noopener"><span class="ico">' + icon(LINK_ICONS.indexOf(l.icon) >= 0 ? l.icon : 'link') + '</span>' +
        '<span class="grow"><b>' + esc(l.name) + '</b>' + (l.desc ? '<small>' + esc(l.desc) + '</small>' : '') + '</span>' + icon('external', 'sm') + '</a>';
    }
    function renderLinks() {
      var h = S.links.length ? S.links.map(linkHtml).join('') : '<div class="empty">ยังไม่มีลิงก์ระบบงาน</div>';
      $('homeLinks').innerHTML = h; $('sysLinks').innerHTML = h;
    }
    function renderRecent() {
      var list = S.items.slice().sort(function (a, b) { return (b.updatedAt ? toTs(b.updatedAt) : b.createdAt) - (a.updatedAt ? toTs(a.updatedAt) : a.createdAt); }).slice(0, 6);
      $('recent').innerHTML = list.length ? list.map(function (a) {
        return '<li><span class="tag t-' + esc(a.type) + '" style="flex:none">' + esc((TYPES[a.type] || TYPES.general).label) + '</span><span style="flex:1;min-width:0"><a href="#" data-edit="' + esc(a.id) + '" style="color:var(--navy);font-weight:600;text-decoration:none">' + esc(a.title) + '</a><br><span class="when">' + esc(a.updatedAt || '') + ' · ' + esc(a.adminName) + '</span></span></li>';
      }).join('') : '<li style="color:var(--muted)">ยังไม่มีประกาศ</li>';
    }
    function toTs(s) { var m = String(s).match(/(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2})/); return m ? new Date(m[3], m[2] - 1, m[1], m[4], m[5]).getTime() : 0; }

    /* ---------- ตารางประกาศ ---------- */
    (function () { $('nType').innerHTML += Object.keys(TYPES).map(function (k) { return '<option value="' + k + '">' + TYPES[k].label + '</option>'; }).join(''); $('eType').innerHTML = Object.keys(TYPES).map(function (k) { return '<option value="' + k + '">' + TYPES[k].label + '</option>'; }).join(''); })();

    function filteredItems() {
      var q = $('nQ').value.trim().toLowerCase(), st = $('nStatus').value, ty = $('nType').value;
      return S.items.filter(function (a) {
        if (ty && a.type !== ty) return false;
        if (st === 'on' && (a.isHidden || isExpired(a))) return false;
        if (st === 'off' && !a.isHidden) return false;
        if (st === 'pin' && !a.pinned) return false;
        if (st === 'exp' && !isExpired(a)) return false;
        if (q && (a.title + ' ' + plain(a.details) + ' ' + a.adminName + ' ' + a.date).toLowerCase().indexOf(q) < 0) return false;
        return true;
      });
    }
    function renderTable() {
      var list = filteredItems();
      var canOrder = list.length === S.items.length;
      $('nBody').innerHTML = list.length ? list.map(function (a, i) {
        var t = TYPES[a.type] || TYPES.general;
        var status = isExpired(a) ? '<span class="tag s-exp">หมดอายุ ' + esc(a.expire) + '</span>' : (a.isHidden ? '<span class="tag s-off">ซ่อน</span>' : '<span class="tag s-on">แสดง</span>');
        if (a.pinned) status += ' <span class="tag s-pin">ปักหมุด</span>';
        if (a.expire && !isExpired(a)) status += '<div class="hint">ถึง ' + esc(a.expire) + '</div>';
        return '<tr class="' + (a.isHidden || isExpired(a) ? 'is-hidden' : '') + '">' +
          '<td><div class="ord"><button class="ib" data-up="' + i + '" title="เลื่อนขึ้น"' + (!canOrder || i === 0 ? ' disabled' : '') + '>' + icon('up', 'sm') + '</button>' +
          '<button class="ib" data-down="' + i + '" title="เลื่อนลง"' + (!canOrder || i === list.length - 1 ? ' disabled' : '') + '>' + icon('down', 'sm') + '</button></div></td>' +
          '<td><div class="thumbs" style="' + (a.imageUrl ? 'background-image:url(\'' + esc(a.imageUrl).replace(/'/g, '%27') + '\')' : '') + '">' + (a.imageUrl ? '' : icon(t.icon)) + '</div></td>' +
          '<td><div class="ttl">' + esc(a.title) + '</div><div class="tagrow"><span class="tag t-' + esc(a.type) + '">' + esc(t.label) + '</span>' +
          (a.date ? '<span>' + esc(a.date) + '</span>' : '') + (a.links.length ? '<span>· แนบ ' + a.links.length + ' ไฟล์</span>' : '') + '</div></td>' +
          '<td class="hide-m">' + status + '</td>' +
          '<td class="hide-m" style="font-size:13.5px;color:var(--muted)">' + esc(a.adminName) + '<br>' + esc(a.updatedAt || '') + '</td>' +
          '<td><div class="acts">' +
          '<button class="ib' + (a.pinned ? ' on' : '') + '" data-pin="' + esc(a.id) + '" title="' + (a.pinned ? 'เลิกปักหมุด' : 'ปักหมุด') + '">' + icon('pin') + '</button>' +
          '<button class="ib" data-hide="' + esc(a.id) + '" title="' + (a.isHidden ? 'แสดงบนเว็บ' : 'ซ่อนจากเว็บ') + '">' + icon(a.isHidden ? 'eye-off' : 'eye') + '</button>' +
          '<button class="ib" data-edit="' + esc(a.id) + '" title="แก้ไข">' + icon('edit') + '</button>' +
          '<button class="ib" data-dup="' + esc(a.id) + '" title="คัดลอกเป็นประกาศใหม่">' + icon('copy') + '</button>' +
          '<button class="ib del" data-del="' + esc(a.id) + '" title="ลบ">' + icon('trash') + '</button>' +
          '</div></td></tr>';
      }).join('') : '<tr><td colspan="6"><div class="empty">' + (S.items.length ? 'ไม่พบประกาศตามเงื่อนไข' : 'ยังไม่มีประกาศ กด "สร้างประกาศ" เพื่อเริ่ม') + '</div></td></tr>';
      $('nHint').textContent = 'แสดง ' + list.length + ' จาก ' + S.items.length + ' รายการ' + (canOrder ? ' · ใช้ลูกศรเพื่อจัดลำดับการแสดงบนเว็บ แล้วกด "บันทึกลำดับ"' : ' · ล้างตัวกรองก่อนจึงจะจัดลำดับได้');
      $('btnSaveOrder').hidden = !S.orderDirty;
    }
    ['nQ', 'nStatus', 'nType'].forEach(function (id) { $(id).addEventListener('input', renderTable); });

    function byId(id) { return S.items.filter(function (a) { return a.id === id; })[0]; }
    function refresh() { return api('getStaffData', S.token).then(function (r) { S.items = r.items || []; S.today = r.today; S.orderDirty = false; renderAll(); }); }

    document.addEventListener('click', function (e) {
      var b;
      if ((b = e.target.closest('[data-goto]'))) { goTab(b.dataset.goto); return; }
      if ((b = e.target.closest('[data-new]'))) { openEditor(null); return; }
      if ((b = e.target.closest('[data-edit]'))) { e.preventDefault(); openEditor(byId(b.dataset.edit)); return; }
      if ((b = e.target.closest('[data-up]')) || (b = e.target.closest('[data-down]'))) {
        var i = Number(b.dataset.up != null ? b.dataset.up : b.dataset.down), j = b.dataset.up != null ? i - 1 : i + 1;
        var tmp = S.items[i]; S.items[i] = S.items[j]; S.items[j] = tmp; S.orderDirty = true; renderTable(); return;
      }
      if ((b = e.target.closest('[data-pin]'))) { var a = byId(b.dataset.pin); api('setAnnouncementFlag', S.token, a.id, 'pinned', !a.pinned).then(function (r) { toast(r.message); return refresh(); }).catch(fail); return; }
      if ((b = e.target.closest('[data-hide]'))) { var h = byId(b.dataset.hide); api('setAnnouncementFlag', S.token, h.id, 'hidden', !h.isHidden).then(function (r) { toast(r.message); return refresh(); }).catch(fail); return; }
      if ((b = e.target.closest('[data-dup]'))) { api('duplicateAnnouncement', S.token, b.dataset.dup).then(function (r) { toast(r.message); return refresh(); }).catch(fail); return; }
      if ((b = e.target.closest('[data-del]'))) {
        var d = byId(b.dataset.del);
        confirmBox('ลบประกาศนี้?', '"' + d.title + '" จะถูกลบออกจากระบบถาวร หากต้องการเก็บไว้ให้ใช้ปุ่มซ่อนแทน', 'ลบประกาศ').then(function (ok) {
          if (ok) api('deleteAnnouncement', S.token, d.id).then(function (r) { toast(r.message); return refresh(); }).catch(fail);
        });
        return;
      }
      if ((b = e.target.closest('.modal [data-close]')) && !b.closest('#mConfirm')) { closeM(b.closest('.modal').id); return; }
      if (e.target.classList.contains('modal') && e.target.id !== 'mConfirm' && e.target.id !== 'mEdit') closeM(e.target.id);
    });
    document.addEventListener('keydown', function (e) { if (e.key !== 'Escape') return; var m = document.querySelectorAll('.modal.on'); if (m.length) closeM(m[m.length - 1].id); });
    $('btnSaveOrder').onclick = function () {
      api('updateAnnouncementOrder', S.token, S.items.map(function (a) { return a.id; })).then(function (r) { toast(r.message); S.orderDirty = false; renderTable(); }).catch(fail);
    };

    /* ---------- ฟอร์มประกาศ ---------- */
    var editing = null;
    function openEditor(a) {
      editing = a;
      $('eTitleH').textContent = a ? 'แก้ไขประกาศ' : 'สร้างประกาศ';
      $('eId').value = a ? a.id : '';
      $('eTitle').value = a ? a.title : '';
      $('eType').value = a ? a.type : 'general';
      var ymd = a ? thaiToYmd(a.date) : S.today;
      $('eDatePick').value = ymd || '';
      $('eDateTxt').textContent = a && !ymd ? a.date : thaiDate(ymd);
      $('eDateTxt').dataset.raw = a && !ymd ? a.date : '';
      $('eExpire').value = a ? (a.expire || '') : '';
      $('eBody').innerHTML = a ? a.details : '';
      $('eImgUrl').value = a ? a.imageUrl : ''; $('eFile').value = ''; setImgPrev();
      $('eLinks').innerHTML = ''; (a ? a.links : []).forEach(function (l) { addLinkRow(l.name, l.url); });
      $('eVisible').checked = a ? !a.isHidden : true;
      $('ePinned').checked = a ? !!a.pinned : false;
      openM('mEdit'); setTimeout(function () { $('eTitle').focus(); }, 30);
    }
    $('eDatePick').onchange = function () { $('eDateTxt').textContent = thaiDate(this.value); $('eDateTxt').dataset.raw = ''; };
    function setImgPrev() { var u = $('eImgUrl').value.trim(); $('eImgPrev').style.backgroundImage = u ? 'url("' + u.replace(/"/g, '%22') + '")' : ''; $('eImgPrev').innerHTML = u ? '' : icon('image', 'lg'); }
    $('eImgUrl').oninput = setImgPrev;
    $('eImgClear').onclick = function () { $('eImgUrl').value = ''; $('eFile').value = ''; setImgPrev(); };
    $('eFile').onchange = function () {
      var f = this.files[0]; if (!f) return;
      if (String(f.type).indexOf('image') !== 0) { toast('เลือกได้เฉพาะไฟล์รูปภาพ', true); this.value = ''; return; }
      shrink(f, 1600, function (dataUrl) {
        $('eImgPrev').innerHTML = ''; $('eImgPrev').style.backgroundImage = 'url("' + dataUrl + '")';
        $('eSave').disabled = true;
        api('uploadImageToDrive', S.token, dataUrl, f.name).then(function (r) { $('eImgUrl').value = r.url; toast('อัปโหลดรูปแล้ว'); })
          .catch(function (e) { fail(e); setImgPrev(); }).then(function () { $('eSave').disabled = false; });
      });
    };
    /* ย่อรูปก่อนอัปโหลด ให้ไฟล์เล็กและส่งได้เร็ว */
    function shrink(file, max, cb) {
      var rd = new FileReader();
      rd.onload = function () {
        var img = new Image();
        img.onload = function () {
          var k = Math.min(1, max / Math.max(img.width, img.height));
          var c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
          var ctx = c.getContext('2d'); ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height); ctx.drawImage(img, 0, 0, c.width, c.height);
          cb(c.toDataURL('image/jpeg', .85));
        };
        img.onerror = function () { cb(rd.result); };
        img.src = rd.result;
      };
      rd.readAsDataURL(file);
    }

    function addLinkRow(name, url) {
      if ($('eLinks').children.length >= 6) { toast('แนบได้สูงสุด 6 รายการ', true); return; }
      var d = document.createElement('div'); d.className = 'link-row';
      d.innerHTML = '<input class="inp ln" placeholder="ชื่อปุ่ม เช่น ดาวน์โหลดแบบฟอร์ม" value="' + esc(name || '') + '">' +
        '<input class="inp lu" type="url" placeholder="ลิงก์ Google Drive หรือเว็บไซต์" value="' + esc(url || '') + '">' +
        '<div class="btns"><button type="button" class="ib" data-lu title="เลื่อนขึ้น">' + icon('up', 'sm') + '</button>' +
        '<button type="button" class="ib" data-ld title="เลื่อนลง">' + icon('down', 'sm') + '</button>' +
        '<button type="button" class="ib del" data-lx title="ลบ">' + icon('x', 'sm') + '</button></div>';
      $('eLinks').appendChild(d);
    }
    $('eAddLink').onclick = function () { addLinkRow(); var r = $('eLinks').lastElementChild; if (r) r.querySelector('.ln').focus(); };
    $('eLinks').onclick = function (e) {
      var r = e.target.closest('.link-row'); if (!r) return;
      if (e.target.closest('[data-lx]')) r.remove();
      else if (e.target.closest('[data-lu]') && r.previousElementSibling) r.parentNode.insertBefore(r, r.previousElementSibling);
      else if (e.target.closest('[data-ld]') && r.nextElementSibling) r.parentNode.insertBefore(r.nextElementSibling, r);
    };

    /* แถบเครื่องมือข้อความ */
    $('eTb').addEventListener('mousedown', function (e) { if (e.target.closest('.ib')) e.preventDefault(); });
    $('eTb').onclick = function (e) {
      var b = e.target.closest('[data-cmd]'); if (!b) return;
      var cmd = b.dataset.cmd, val = null;
      if (cmd === 'createLink') { val = prompt('วางลิงก์ (ขึ้นต้นด้วย https)'); if (!val) return; }
      document.execCommand(cmd, false, val); $('eBody').focus();
    };
    $('eSize').onchange = function () { if (this.value) { $('eBody').focus(); document.execCommand('fontSize', false, this.value); } this.value = ''; };
    $('eColor').onchange = function () { $('eBody').focus(); document.execCommand('foreColor', false, this.value); };
    $('eBody').addEventListener('paste', function (e) {
      var html = e.clipboardData && e.clipboardData.getData('text/html');
      if (!html) return;
      e.preventDefault();
      var d = document.createElement('div'); d.innerHTML = html;
      d.querySelectorAll('script,style,meta,link,img,iframe').forEach(function (x) { x.remove(); });
      d.querySelectorAll('*').forEach(function (x) { ['class', 'style', 'id'].forEach(function (k) { x.removeAttribute(k); }); });
      document.execCommand('insertHTML', false, d.innerHTML);
    });

    function formData() {
      var links = Array.prototype.map.call($('eLinks').children, function (r) { return { name: r.querySelector('.ln').value.trim(), url: r.querySelector('.lu').value.trim() }; })
        .filter(function (l) { return l.name || l.url; });
      var body = $('eBody').innerHTML.trim();
      if (!plain(body) && !/<img|<li/i.test(body)) body = '';
      return {
        id: $('eId').value, title: $('eTitle').value.trim(), type: $('eType').value,
        date: $('eDateTxt').dataset.raw || thaiDate($('eDatePick').value), expire: $('eExpire').value,
        details: body, imageUrl: $('eImgUrl').value.trim(), links: links,
        isHidden: !$('eVisible').checked, pinned: $('ePinned').checked
      };
    }
    $('eForm').onsubmit = function (e) {
      e.preventDefault();
      var o = formData();
      var bad = o.links.filter(function (l) { return !l.name || !/^https?:/i.test(l.url); });
      if (bad.length) { toast('เอกสารแนบต้องมีทั้งชื่อปุ่มและลิงก์ที่ขึ้นต้นด้วย https', true); return; }
      if (o.expire && o.expire < S.today && !o.isHidden) { toast('วันที่ "แสดงถึง" ผ่านไปแล้ว ประกาศจะไม่ขึ้นบนเว็บ', true); }
      $('eSave').disabled = true;
      api('saveAnnouncement', S.token, o).then(function (r) { toast(r.message); closeM('mEdit'); return refresh(); })
        .catch(fail).then(function () { $('eSave').disabled = false; });
    };
    $('ePreview').onclick = function () {
      var o = formData(), t = TYPES[o.type] || TYPES.general;
      $('prevBox').innerHTML = '<div class="tagrow" style="margin:0 0 6px"><span class="tag t-' + o.type + '">' + esc(t.label) + '</span>' + (o.date ? '<span>' + esc(o.date) + '</span>' : '') + '</div>' +
        '<h2 style="font-size:22px;margin-bottom:12px">' + esc(o.title || '(ยังไม่มีหัวข้อ)') + '</h2>' +
        (o.imageUrl ? '<img src="' + esc(o.imageUrl) + '" alt="">' : '') + '<div>' + o.details.replace(/<script[\s\S]*?<\/script>/gi, '') + '</div>' +
        (o.links.length ? '<div style="margin-top:14px;display:grid;gap:6px">' + o.links.map(function (l) { return '<span class="lk">' + icon('file') + '<span class="grow"><b>' + esc(l.name) + '</b></span></span>'; }).join('') + '</div>' : '');
      openM('mPrev');
    };

    /* ---------- ระบบงาน ---------- */
    $('btnEditLinks').onclick = function () { $('leRows').innerHTML = ''; S.links.forEach(addLe); if (!S.links.length) addLe({}); $('linkEditor').hidden = false; };
    function addLe(l) {
      var d = document.createElement('div'); d.className = 'row r3'; d.style.cssText = 'grid-template-columns:1fr 1.4fr 1.6fr 120px auto;align-items:center;margin-bottom:8px';
      d.innerHTML = '<input class="inp le-n" placeholder="ชื่อระบบ" value="' + esc(l.name || '') + '">' +
        '<input class="inp le-d" placeholder="คำอธิบายสั้น ๆ" value="' + esc(l.desc || '') + '">' +
        '<input class="inp le-u" type="url" placeholder="ลิงก์ https" value="' + esc(l.url || '') + '">' +
        '<select class="inp le-i">' + LINK_ICONS.map(function (k) { return '<option' + (k === (l.icon || 'link') ? ' selected' : '') + '>' + k + '</option>'; }).join('') + '</select>' +
        '<button type="button" class="ib del" title="ลบ">' + icon('x', 'sm') + '</button>';
      d.querySelector('.del').onclick = function () { d.remove(); };
      $('leRows').appendChild(d);
    }
    $('leAdd').onclick = function () { addLe({}); };
    $('leCancel').onclick = function () { $('linkEditor').hidden = true; };
    $('leSave').onclick = function () {
      var links = Array.prototype.map.call($('leRows').children, function (r) {
        return { name: r.querySelector('.le-n').value.trim(), desc: r.querySelector('.le-d').value.trim(), url: r.querySelector('.le-u').value.trim(), icon: r.querySelector('.le-i').value };
      }).filter(function (l) { return l.name || l.url; });
      if (links.some(function (l) { return !l.name || !/^https?:/i.test(l.url); })) { toast('ทุกแถวต้องมีชื่อระบบและลิงก์ที่ขึ้นต้นด้วย https', true); return; }
      api('saveStaffLinks', S.token, links).then(function (r) { S.links = r.links; renderLinks(); $('linkEditor').hidden = true; toast(r.message); }).catch(fail);
    };

    /* ---------- บัญชี ---------- */
    function loadUsers() {
      $('meUser').value = S.user.username; $('meName').value = S.user.name;
      api('listAdminUsers', S.token).then(function (r) {
        S.users = r.users;
        $('userList').innerHTML = r.users.map(function (u) {
          var me = u.username.toLowerCase() === S.user.username.toLowerCase();
          return '<tr><td><b>' + esc(u.name) + '</b>' + (me ? ' <span class="tag s-on">คุณ</span>' : '') + '<div class="hint" style="margin:0">' + esc(u.username) + '</div></td>' +
            '<td style="text-align:right">' + (me ? '' : '<button class="ib del" data-rmuser="' + esc(u.username) + '" title="ลบบัญชี">' + icon('trash') + '</button>') + '</td></tr>';
        }).join('');
      }).catch(fail);
    }
    $('userList').onclick = function (e) {
      var b = e.target.closest('[data-rmuser]'); if (!b) return;
      var un = b.dataset.rmuser;
      confirmBox('ลบบัญชีเจ้าหน้าที่?', 'บัญชี "' + un + '" จะเข้าสู่ระบบไม่ได้อีก', 'ลบบัญชี').then(function (ok) {
        if (ok) api('removeAdminUser', S.token, un).then(function (r) { toast(r.message); loadUsers(); }).catch(fail);
      });
    };
    $('meForm').onsubmit = function (e) {
      e.preventDefault();
      if ($('meNew').value !== $('meNew2').value) { toast('รหัสผ่านใหม่ทั้งสองช่องไม่ตรงกัน', true); return; }
      api('updateAdminPassword', S.token, $('meCur').value, $('meNew').value, $('meName').value).then(function (r) {
        toast(r.message); S.user.name = r.name; $('uName').textContent = r.name; $('hello').textContent = 'สวัสดี ' + r.name;
        if ($('meNew').value) $('weakPw').hidden = true;
        $('meCur').value = $('meNew').value = $('meNew2').value = ''; loadUsers();
      }).catch(fail);
    };
    $('btnAddUser').onclick = function () { $('uForm').reset(); openM('mUser'); $('uName2').focus(); };
    $('uForm').onsubmit = function (e) {
      e.preventDefault();
      api('addAdminUser', S.token, $('uUser').value, $('uPass').value, $('uName2').value).then(function (r) { toast(r.message); closeM('mUser'); loadUsers(); }).catch(fail);
    };

    /* ---------- ประวัติ ---------- */
    function loadLog() { api('getAdminLog', S.token, 100).then(function (r) { S.log = r.rows; renderLog(); }).catch(fail); }
    function renderLog() {
      var q = $('logQ').value.trim().toLowerCase();
      var rows = S.log.filter(function (r) { return !q || r.join(' ').toLowerCase().indexOf(q) >= 0; });
      $('logBody').innerHTML = rows.length ? rows.map(function (r) { return '<tr><td style="white-space:nowrap;color:var(--muted)">' + esc(r[0]) + '</td><td>' + esc(r[1]) + '</td><td><b>' + esc(r[2]) + '</b></td><td style="color:var(--muted)">' + esc(r[3]) + '</td></tr>'; }).join('')
        : '<tr><td colspan="4"><div class="empty">ไม่มีข้อมูล</div></td></tr>';
    }
    $('logQ').oninput = renderLog;
    $('btnLogReload').onclick = loadLog;

    /* ---------- เริ่มต้น ---------- */
    S.token = store('stf_token') || '';
    if (S.token) boot().catch(function () { showLogin(''); }); else showLogin('');
  </script>
</body>
</html>
