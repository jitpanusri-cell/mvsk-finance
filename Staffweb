<!DOCTYPE html>
<html lang="th">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เจ้าหน้าที่ - กลุ่มบริหารงานงบประมาณ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --navy: #13294b; --navy-2: #0c1d38; --navy-soft: #e8edf5; --gold: #c79a2e;
      --bg: #f3f5f8; --line: #dde3eb; --text: #1d2939; --muted: #5d6b7e;
      --red: #b42318; --red-soft: #fef3f2; --green: #067647; --green-soft: #ecfdf3; --amber: #93370d; --amber-soft: #fffaeb;
      --radius: 8px; --shadow: 0 1px 2px rgba(16, 24, 40, .06), 0 1px 3px rgba(16, 24, 40, .08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Sarabun', sans-serif; font-size: 15.5px; line-height: 1.55; color: var(--text); background: var(--bg); }
    h1, h2, h3, h4 { font-family: 'IBM Plex Sans Thai', 'Sarabun', sans-serif; line-height: 1.35; color: var(--navy); }
    button, input, select, textarea { font: inherit; color: inherit; }
    button { cursor: pointer; }
    .ic { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .ic.sm { width: 15px; height: 15px; } .ic.lg { width: 24px; height: 24px; }
    [hidden] { display: none !important; }

    /* ปุ่มและฟอร์ม */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; height: 38px; padding: 0 14px; border-radius: 6px; border: 1px solid var(--line); background: #fff; color: var(--navy); font-weight: 500; white-space: nowrap; text-decoration: none; }
    .btn:hover { border-color: var(--navy); }
    .btn.pri { background: var(--navy); border-color: var(--navy); color: #fff; }
    .btn.pri:hover { background: var(--navy-2); }
    .btn.gold { background: var(--gold); border-color: var(--gold); color: #fff; }
    .btn.danger { background: var(--red); border-color: var(--red); color: #fff; }
    .btn.ghost { border-color: transparent; background: transparent; }
    .btn.sm { height: 32px; padding: 0 10px; font-size: 14px; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    .ib { width: 32px; height: 32px; display: inline-grid; place-items: center; border: 1px solid var(--line); background: #fff; border-radius: 6px; color: var(--muted); }
    .ib:hover { color: var(--navy); border-color: var(--navy); }
    .ib.on { color: var(--gold); border-color: var(--gold); background: #fbf4e2; }
    .ib.del:hover { color: var(--red); border-color: var(--red); }
    .ib:disabled { opacity: .35; cursor: default; }
    label.f { display: block; font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 5px; }
    .inp { width: 100%; height: 40px; border: 1px solid var(--line); border-radius: 6px; padding: 0 12px; background: #fff; }
    textarea.inp { height: auto; padding: 10px 12px; }
    .inp:focus, .editor:focus { outline: 2px solid rgba(19, 41, 75, .18); border-color: var(--navy); }
    .hint { font-size: 13px; color: var(--muted); margin-top: 4px; }
    .row { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); }
    .row.r3 { grid-template-columns: repeat(3, 1fr); }
    .fg { margin-bottom: 14px; }
    .check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500; }
    .check input { width: 18px; height: 18px; accent-color: var(--navy); }

    /* หน้าเข้าสู่ระบบ */
    #login { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--navy-2); }
    .login-card { width: 100%; max-width: 400px; background: #fff; border-radius: 10px; padding: 32px 28px 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, .3); border-top: 4px solid var(--gold); }
    .login-card .logo { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 22px; }
    .login-card img { width: 72px; height: 72px; object-fit: contain; margin-bottom: 8px; }
    .login-card h1 { font-size: 21px; }
    .login-card p { color: var(--muted); font-size: 14px; }
    .pw { position: relative; }
    .pw .inp { padding-right: 44px; }
    .pw button { position: absolute; right: 4px; top: 4px; height: 32px; width: 36px; border: 0; background: none; color: var(--muted); display: grid; place-items: center; }
    .err { background: var(--red-soft); color: var(--red); border: 1px solid #fecdca; border-radius: 6px; padding: 8px 12px; font-size: 14px; margin-bottom: 12px; }
    .login-foot { margin-top: 18px; text-align: center; font-size: 14px; }
    .login-foot a { color: var(--navy); }

    /* โครงหน้าระบบ */
    .app-h { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 40; }
    .app-h::after { content: ''; display: block; height: 3px; background: var(--gold); }
    .app-h .in { max-width: 1240px; margin: 0 auto; padding: 0 20px; height: 62px; display: flex; align-items: center; gap: 12px; }
    .app-h img { width: 38px; height: 38px; object-fit: contain; }
    .app-h .t b { display: block; color: var(--navy); font-family: 'IBM Plex Sans Thai'; font-size: 16px; }
    .app-h .t small { color: var(--muted); font-size: 12.5px; }
    .app-h .who { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--navy-soft); color: var(--navy); display: grid; place-items: center; font-weight: 700; }
    .who .n { font-weight: 600; font-size: 14.5px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tabs { background: #fff; border-bottom: 1px solid var(--line); }
    .tabs .in { max-width: 1240px; margin: 0 auto; padding: 0 12px; display: flex; gap: 2px; overflow-x: auto; }
    .tab { border: 0; background: none; padding: 12px 14px; display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-weight: 500; border-bottom: 2px solid transparent; white-space: nowrap; }
    .tab:hover { color: var(--navy); }
    .tab.on { color: var(--navy); border-bottom-color: var(--navy); font-weight: 600; }
    .main { max-width: 1240px; margin: 0 auto; padding: 24px 20px 60px; }
    .page-h { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .page-h h2 { font-size: 22px; }
    .page-h .sub { color: var(--muted); font-size: 14.5px; }
    .card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
    .card-h { padding: 14px 18px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .card-h h3 { font-size: 16.5px; display: flex; align-items: center; gap: 8px; }
    .card-b { padding: 18px; }
    .banner { display: flex; gap: 10px; align-items: flex-start; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 14.5px; background: var(--amber-soft); border: 1px solid #fedf89; color: var(--amber); }

    /* ภาพรวม */
    .stats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 20px; }
    .stat { padding: 16px; display: flex; flex-direction: column; gap: 4px; cursor: pointer; text-align: left; }
    .stat:hover { border-color: var(--navy); }
    .stat .k { color: var(--muted); font-size: 14px; display: flex; align-items: center; gap: 6px; }
    .stat .v { font-family: 'IBM Plex Sans Thai'; font-size: 28px; font-weight: 700; color: var(--navy); }
    .two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; }
    .links { display: grid; gap: 10px; }
    .lk { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 6px; text-decoration: none; color: inherit; }
    .lk:hover { border-color: var(--navy); background: #fafbfc; }
    .lk .ico { width: 38px; height: 38px; border-radius: 6px; background: var(--navy-soft); color: var(--navy); display: grid; place-items: center; flex: none; }
    .lk b { display: block; font-weight: 600; }
    .lk small { color: var(--muted); font-size: 13px; display: block; }
    .lk .grow { flex: 1; min-width: 0; }
    .recent li { list-style: none; display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid #eef1f5; font-size: 14.5px; }
    .recent li:last-child { border: 0; }
    .recent .when { color: var(--muted); font-size: 13px; white-space: nowrap; }

    /* ตาราง */
    .tools { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--line); }
    .tools .search { position: relative; flex: 1; min-width: 220px; }
    .tools .search .ic { position: absolute; left: 10px; top: 11px; color: var(--muted); }
    .tools .search .inp { padding-left: 34px; }
    .tools select.inp { width: auto; min-width: 150px; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: 13.5px; color: var(--muted); font-weight: 600; padding: 10px 14px; background: #fafbfc; border-bottom: 1px solid var(--line); white-space: nowrap; }
    td { padding: 12px 14px; border-bottom: 1px solid #eef1f5; vertical-align: middle; }
    tr:last-child td { border-bottom: 0; }
    tr.is-hidden td { background: #fbfbfc; }
    tr.is-hidden .ttl { color: #8592a3; }
    .ttl { font-weight: 600; color: var(--navy); }
    .tagrow { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; align-items: center; font-size: 13px; color: var(--muted); }
    .tag { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 600; padding: 1px 8px; border-radius: 4px; border: 1px solid; }
    .t-alert { color: #b42318; background: #fef3f2; border-color: #fecdca; }
    .t-finance-alert { color: #93370d; background: #fffaeb; border-color: #fedf89; }
    .t-supplies-alert { color: #05603a; background: #ecfdf3; border-color: #abefc6; }
    .t-general { color: #1f3a68; background: #eef2f8; border-color: #c9d5e8; }
    .t-document { color: #3e4784; background: #f4f3ff; border-color: #d9d6fe; }
    .s-on { color: var(--green); background: var(--green-soft); border-color: #abefc6; }
    .s-off { color: #475467; background: #f2f4f7; border-color: #d0d5dd; }
    .s-exp { color: var(--red); background: var(--red-soft); border-color: #fecdca; }
    .s-pin { color: #fff; background: var(--gold); border-color: var(--gold); }
    .acts { display: flex; gap: 6px; justify-content: flex-end; }
    .ord { display: flex; flex-direction: column; gap: 2px; }
    .ord .ib { width: 26px; height: 22px; }
    .thumbs { width: 64px; height: 42px; border-radius: 4px; background: var(--navy-soft) center / cover; display: grid; place-items: center; color: #8a9ab0; border: 1px solid var(--line); }
    .empty { text-align: center; padding: 40px 16px; color: var(--muted); }
    .table-wrap { overflow-x: auto; }

    /* หน้าต่าง */
    .modal { position: fixed; inset: 0; z-index: 100; background: rgba(12, 22, 40, .55); display: none; justify-content: center; align-items: flex-start; padding: 32px 16px; overflow-y: auto; }
    .modal.on { display: flex; }
    .sheet { width: 100%; max-width: 860px; background: #fff; border-radius: 10px; box-shadow: 0 20px 50px rgba(0, 0, 0, .25); }
    .sheet.sm { max-width: 440px; }
    .sheet-h { padding: 16px 22px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
    .sheet-h h3 { font-size: 18px; }
    .sheet-b { padding: 20px 22px; }
    .sheet-f { padding: 14px 22px; border-top: 1px solid var(--line); background: #fafbfc; display: flex; gap: 8px; justify-content: flex-end; border-radius: 0 0 10px 10px; flex-wrap: wrap; }
    .sheet-f .left { margin-right: auto; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .tb { display: flex; gap: 4px; flex-wrap: wrap; padding: 6px; border: 1px solid var(--line); border-bottom: 0; border-radius: 6px 6px 0 0; background: #fafbfc; align-items: center; }
    .tb .ib { border-color: transparent; background: transparent; }
    .tb .ib:hover { background: #fff; border-color: var(--line); }
    .tb .sep { width: 1px; height: 22px; background: var(--line); margin: 0 4px; }
    .tb select { height: 32px; border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; background: #fff; font-size: 14px; }
    .tb input[type=color] { width: 32px; height: 30px; border: 1px solid var(--line); border-radius: 6px; padding: 2px; background: #fff; }
    .editor { min-height: 220px; max-height: 460px; overflow-y: auto; border: 1px solid var(--line); border-radius: 0 0 6px 6px; padding: 12px 14px; line-height: 1.7; }
    .editor ul, .editor ol { padding-left: 1.4em; }
    .editor:empty::before { content: attr(data-ph); color: #98a2b3; }
    .img-box { display: flex; gap: 14px; align-items: flex-start; }
    .img-prev { width: 160px; height: 100px; border: 1px dashed var(--line); border-radius: 6px; background: #fafbfc center / cover no-repeat; display: grid; place-items: center; color: #98a2b3; flex: none; }
    .link-row { display: grid; grid-template-columns: 1fr 1.6fr auto; gap: 8px; margin-bottom: 8px; align-items: center; }
    .link-row .btns { display: flex; gap: 4px; }
    .prev-box { border: 1px solid var(--line); border-radius: 6px; padding: 18px; line-height: 1.75; }
    .prev-box img { max-width: 100%; border-radius: 6px; margin-bottom: 12px; }

    #toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--navy-2); color: #fff; padding: 10px 18px; border-radius: 6px; display: none; z-index: 300; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(0, 0, 0, .2); }
    #toast.err { background: var(--red); }
    #busy { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 400; background: var(--gold); transform-origin: left; animation: busy 1.2s ease-in-out infinite; display: none; }
    @keyframes busy { 0% { transform: scaleX(0); } 50% { transform: scaleX(.7); } 100% { transform: scaleX(1); opacity: 0; } }

    @media (max-width: 900px) {
      .stats { grid-template-columns: repeat(2, 1fr); }
      .two, .row, .row.r3 { grid-template-columns: 1fr; }
      .who .n { display: none; }
      .hide-m { display: none; }
      .link-row { grid-template-columns: 1fr; }
      .img-box { flex-direction: column; }
      .modal { padding: 0; } .sheet { border-radius: 0; min-height: 100%; }
    }
  </style>
</head>
