    .header::after { content: ''; display: block; height: 3px; background: var(--gold); }
    .header .wrap { display: flex; align-items: center; height: 72px; gap: 24px; }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; min-width: 0; }
    .brand img { width: 46px; height: 46px; object-fit: contain; }
    .brand b { display: block; font-family: 'IBM Plex Sans Thai'; font-size: 17px; color: var(--navy); font-weight: 700; white-space: nowrap; }
    .brand small { display: block; font-size: 13px; color: var(--muted); white-space: nowrap; }
    .nav { margin-left: auto; display: flex; align-items: center; gap: 2px; }
    .nav a { text-decoration: none; font-size: 15px; color: var(--text); padding: 8px 12px; border-radius: 6px; white-space: nowrap; }
    .nav a:hover { background: var(--navy-soft); color: var(--navy); }
    .btn-staff { display: inline-flex; align-items: center; gap: 8px; margin-left: 10px; padding: 8px 16px; border-radius: 6px;
      background: var(--navy); color: #fff !important; text-decoration: none; font-size: 15px; font-weight: 500; white-space: nowrap; }
    .btn-staff:hover { background: var(--navy-2) !important; }
    .menu-btn { display: none; margin-left: auto; background: none; border: 1px solid var(--line); border-radius: 6px; padding: 7px; color: var(--navy); }

    /* ส่วนแนะนำ */
    .hero { position: relative; color: #fff; background: var(--navy) url('https://drive.google.com/thumbnail?id=1z1tiStUX6sSO5Fg1by-5HPU7mJ2oX8No&sz=w1920-h1080') center 40% / cover no-repeat; }
    .hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12, 29, 56, .94) 0%, rgba(12, 29, 56, .82) 55%, rgba(12, 29, 56, .6) 100%); }
    .hero .wrap { position: relative; padding-top: 64px; padding-bottom: 120px; display: flex; align-items: center; gap: 32px; }
    .hero img { width: 124px; height: 124px; object-fit: contain; flex: none; }
    .hero .eyebrow { font-size: 13px; letter-spacing: 2px; color: #d9c48f; text-transform: uppercase; }
    .hero h1 { font-size: 40px; font-weight: 700; margin: 4px 0 6px; }
    .hero p { font-size: 18px; color: #dbe3ee; max-width: 640px; }

    /* การ์ดบริการ */
    .services { position: relative; margin-top: -76px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .svc { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; text-decoration: none;
      display: flex; flex-direction: column; gap: 10px; border-top: 3px solid var(--navy); transition: border-color .15s, box-shadow .15s; }
    .svc:hover { border-top-color: var(--gold); box-shadow: 0 6px 16px rgba(16, 24, 40, .1); }
    .svc .ico { width: 44px; height: 44px; border-radius: 8px; background: var(--navy-soft); color: var(--navy); display: grid; place-items: center; }
    .svc h3 { font-size: 17px; color: var(--navy); font-weight: 600; }
    .svc p { font-size: 14.5px; color: var(--muted); flex: 1; }
    .svc .go { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--navy); font-weight: 600; }
    .svc:hover .go { color: var(--gold); }

    /* หัวข้อส่วน */
    section { padding: 48px 0 8px; }
    .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
    .sec-head h2 { font-size: 24px; color: var(--navy); display: flex; align-items: center; gap: 10px; }
    .sec-head h2 .ic { color: var(--gold); }
    .sec-head .sub { color: var(--muted); font-size: 15px; }

    /* ลิงก์บริการข้อมูล */
    .quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .q { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; }
    .q:hover { border-color: var(--navy); }
    .q .ic { color: var(--navy); }
    .q b { font-weight: 600; font-size: 15px; display: block; line-height: 1.35; }
    .q small { color: var(--muted); font-size: 13px; }

    /* ข่าว: แถบเครื่องมือ */
    .toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
    .chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .chip { border: 1px solid var(--line); background: #fff; color: var(--text); padding: 6px 14px; border-radius: 999px; font-size: 14px; }
    .chip:hover { border-color: var(--navy); }
    .chip.on { background: var(--navy); border-color: var(--navy); color: #fff; }
    .chip .n { opacity: .7; margin-left: 4px; font-size: 12.5px; }
    .search { margin-left: auto; position: relative; min-width: 260px; }
    .search .ic { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--muted); }
    .search input { width: 100%; height: 38px; border: 1px solid var(--line); border-radius: 6px; padding: 0 12px 0 38px; font: inherit; font-size: 15px; background: #fff; }
    .search input:focus { outline: 2px solid rgba(19, 41, 75, .2); border-color: var(--navy); }

    /* ข่าวปักหมุด */
    .pinned { display: grid; gap: 12px; margin-bottom: 16px; }
    .pin-card { display: grid; grid-template-columns: 240px 1fr; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--gold); border-radius: var(--radius); overflow: hidden; cursor: pointer; text-align: left; box-shadow: var(--shadow); }
    .pin-card:hover h3 { color: var(--gold); }
    .pin-card .thumb { height: 100%; min-height: 150px; }
    .pin-card .body { padding: 18px 22px; display: flex; flex-direction: column; gap: 8px; }
    .pin-card h3 { font-size: 20px; color: var(--navy); }

    /* ข่าว: การ์ด */
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .news { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; cursor: pointer; text-align: left; box-shadow: var(--shadow); transition: box-shadow .15s, border-color .15s; padding: 0; color: inherit; }
    .news:hover { border-color: #b9c4d3; box-shadow: 0 6px 16px rgba(16, 24, 40, .1); }
    .news:hover h3 { color: var(--gold); }
    .news:focus-visible, .pin-card:focus-visible { outline: 3px solid rgba(199, 154, 46, .5); outline-offset: 2px; }
    .thumb { aspect-ratio: 16 / 9; background: var(--navy-soft) center / cover no-repeat; display: grid; place-items: center; color: #8a9ab0; width: 100%; }
    .thumb .ic { width: 40px; height: 40px; stroke-width: 1.4; }
    .news .body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13.5px; color: var(--muted); }
    .meta .d { display: inline-flex; align-items: center; gap: 4px; }
    .tag { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 600; padding: 2px 8px; border-radius: 4px; border: 1px solid; }
    .t-alert { color: #b42318; background: #fef3f2; border-color: #fecdca; }
    .t-finance-alert { color: #93370d; background: #fffaeb; border-color: #fedf89; }
    .t-supplies-alert { color: #05603a; background: #ecfdf3; border-color: #abefc6; }
    .t-general { color: #1f3a68; background: #eef2f8; border-color: #c9d5e8; }
    .t-document { color: #3e4784; background: #f4f3ff; border-color: #d9d6fe; }
    .t-new { color: #fff; background: var(--gold); border-color: var(--gold); }
    .news h3 { font-size: 17px; color: var(--navy); font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .excerpt { color: var(--muted); font-size: 14.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; color: var(--muted); padding-top: 6px; border-top: 1px solid #eef1f5; }
    .foot .more { color: var(--navy); font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
    .foot .att { display: inline-flex; align-items: center; gap: 4px; }

    .empty { text-align: center; padding: 48px 16px; color: var(--muted); background: #fff; border: 1px dashed var(--line); border-radius: var(--radius); }
    .empty .ic { width: 36px; height: 36px; color: #a3afbf; margin-bottom: 8px; }
    .more-wrap { text-align: center; margin-top: 20px; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 18px; border-radius: 6px; border: 1px solid var(--line); background: #fff; color: var(--navy); font-weight: 500; font-size: 15px; text-decoration: none; }
    .btn:hover { border-color: var(--navy); }
    .btn.pri { background: var(--navy); color: #fff; border-color: var(--navy); }
    .btn.pri:hover { background: var(--navy-2); }

    /* โครงโหลด */
    .sk { background: linear-gradient(90deg, #eceff3 25%, #f6f7f9 50%, #eceff3 75%); background-size: 200% 100%; animation: sk 1.4s infinite linear; border-radius: 4px; }
    @keyframes sk { to { background-position: -200% 0; } }

    /* หน้าต่างอ่านข่าว */
    .modal { position: fixed; inset: 0; z-index: 100; background: rgba(12, 22, 40, .55); display: none; align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto; }
    .modal.on { display: flex; }
    .sheet { background: #fff; border-radius: 10px; width: 100%; max-width: 820px; box-shadow: 0 20px 50px rgba(0, 0, 0, .25); overflow: hidden; }
    .sheet-h { display: flex; align-items: flex-start; gap: 12px; padding: 20px 24px 14px; border-bottom: 1px solid var(--line); }
