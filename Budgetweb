    footer { margin-top: 56px; background: var(--navy-2); color: #c5d0e0; font-size: 15px; }
    footer .cols { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 32px; padding: 40px 24px 28px; }
    footer h4 { color: #fff; font-size: 16px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    footer h4 .ic { color: var(--gold); }
    footer ul { list-style: none; }
