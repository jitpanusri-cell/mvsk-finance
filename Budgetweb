    .wrap { max-width: 1280px; margin: 0 auto; padding: 0 32px; }


    .dynamic-header-wrapper { position: fixed; top: 24px; left: 50%; transform: translateX(-50%); width: 95%; max-width: 1400px; z-index: 60; transition: all .5s cubic-bezier(.4, 0, .2, 1); }
    .dynamic-island { background: rgba(15, 23, 42, .65); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, .12); border-radius: 60px; padding: 8px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 32px rgba(0, 0, 0, .3); }
    .dynamic-header-wrapper.scrolled { top: 12px; max-width: 1200px; }
    .dynamic-header-wrapper.scrolled .dynamic-island { background: rgba(15, 23, 42, .9); }
    .island-brand { display: flex; align-items: center; gap: 12px; padding-right: 20px; border-right: 1px solid rgba(255, 255, 255, .1); }
    .island-logo-img { width: 38px; height: 38px; object-fit: contain; transition: transform .3s; }
    .island-brand:hover .island-logo-img { transform: scale(1.1) rotate(5deg); }
    .brand-group { color: #fff; font-weight: 600; font-size: 14px; display: block; font-family: 'IBM Plex Sans Thai'; }
    .brand-school { color: #fbbc04; font-size: 11px; display: block; }
    .island-menu-container { display: flex; align-items: center; flex-grow: 1; justify-content: flex-end; }
    .island-nav { display: flex; gap: 8px; align-items: center; }
    .island-nav a { color: rgba(255, 255, 255, .8); font-size: 14px; padding: 8px 16px; border-radius: 30px; transition: all .3s; font-family: 'IBM Plex Sans Thai'; }
    .island-nav a:hover { color: #0f172a; background: #fbbc04; font-weight: 500; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(251, 188, 4, .3); }
    .island-staff-area { margin-left: 12px; padding-left: 12px; border-left: 1px solid rgba(255, 255, 255, .1); }
    .island-staff-btn { display: inline-block; background: rgba(251, 188, 4, .1); color: #fbbc04; border: 1px solid rgba(251, 188, 4, .4); padding: 8px 20px; border-radius: 30px; font-family: 'IBM Plex Sans Thai'; font-size: 13px; transition: all .3s cubic-bezier(.4, 0, .2, 1); }
    .island-staff-btn:hover { background: #fbbc04; color: #0f172a; box-shadow: 0 6px 15px rgba(251, 188, 4, .4); transform: translateY(-2px); font-weight: 600; }
    .mobile-menu-toggle { display: none; color: #fbbc04; padding: 4px; }
    .mobile-menu-toggle .ic { width: 26px; height: 26px; }
    @keyframes slideDownNav { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
    @media (max-width: 1024px) {
      .island-menu-container { display: none; flex-direction: column; position: absolute; top: 75px; left: 5%; width: 90%; background: rgba(15, 23, 42, .98); border-radius: 24px; padding: 20px; box-shadow: 0 10px 25px rgba(0, 0, 0, .5); }
      .island-menu-container.show { display: flex; animation: slideDownNav .3s cubic-bezier(.16, 1, .3, 1) forwards; }
      .island-nav { flex-direction: column; width: 100%; gap: 8px; }
      .island-nav a, .island-staff-btn { width: 100%; text-align: center; padding: 12px; }
      .island-staff-area { width: 100%; border-left: 0; padding: 10px 0 0; margin: 10px 0 0; border-top: 1px solid rgba(255, 255, 255, .1); }
      .mobile-menu-toggle { display: block; }
    }
    @media (max-width: 640px) { .dynamic-header-wrapper { top: 12px; } .dynamic-island { padding: 8px 16px; } .island-brand { border-right: 0; padding-right: 0; } }

    .hero { position: relative; height: min(92vh, 860px); min-height: 520px; overflow: hidden; background: var(--navy-2); }
    .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s var(--ease); }
    .slide.on { opacity: 1; z-index: 1; }
    .slide .bg { position: absolute; inset: 0; background: center / cover no-repeat; transform: scale(1.06); }
    .slide.on .bg { animation: kb 9s linear forwards; }
    @keyframes kb { from { transform: scale(1.06); } to { transform: scale(1.0); } }
    .slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 26, 51, .45) 0%, rgba(11, 26, 51, 0) 28%, rgba(11, 26, 51, 0) 50%, rgba(11, 26, 51, .55) 100%); }
    .cap { position: absolute; z-index: 3; left: 0; right: 0; bottom: 72px; }
    .cap .box { max-width: 620px; background: rgba(255, 255, 255, .96); padding: 26px 32px 28px; border-left: 4px solid var(--gold); }
    .cap .kick { font-size: 13px; letter-spacing: 1.5px; color: var(--gold); font-weight: 600; text-transform: uppercase; }
    .cap h1 { font-size: 32px; font-weight: 600; color: var(--navy); margin-top: 2px; }
    .cap p { color: var(--ink-2); margin-top: 6px; font-size: 16.5px; }
    .cap .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; font-weight: 600; color: var(--navy); font-family: 'IBM Plex Sans Thai'; }
    .cap .more:hover { color: var(--gold); }
    .cap .box > * { opacity: 0; transform: translateY(14px); }
    .cap.in .box > * { opacity: 1; transform: none; transition: opacity .7s var(--ease), transform .7s var(--ease); }
    .cap.in .box > *:nth-child(2) { transition-delay: .08s; } .cap.in .box > *:nth-child(3) { transition-delay: .16s; } .cap.in .box > *:nth-child(4) { transition-delay: .24s; }
    .hctl { position: absolute; z-index: 3; left: 0; right: 0; bottom: 26px; }
    .hctl .wrap { display: flex; align-items: center; gap: 18px; }
    .bars { display: flex; gap: 8px; flex: 1; max-width: 360px; }
    .bars button { flex: 1; height: 3px; background: rgba(255, 255, 255, .35); position: relative; overflow: hidden; padding: 6px 0; background-clip: content-box; }
    .bars button i { position: absolute; left: 0; top: 6px; height: 3px; width: 0; background: #fff; }
    .bars button.on i { animation: fill var(--dur, 7s) linear forwards; }
    .bars button.done i { width: 100%; }
    @keyframes fill { to { width: 100%; } }
    .arr { width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .55); color: #fff; display: grid; place-items: center; transition: background .2s; }
    .arr:hover { background: rgba(255, 255, 255, .15); }
    .count { color: #fff; font-family: 'IBM Plex Sans Thai'; font-size: 14px; letter-spacing: 1px; margin-left: auto; }

    section { padding: 72px 0; }
    .sh { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
    .sh h2 { font-size: 34px; font-weight: 600; color: var(--navy); position: relative; padding-bottom: 10px; }
    .sh h2::after { content: ''; position: absolute; left: 0; bottom: 0; width: 56px; height: 3px; background: var(--gold); }
    .link-more { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Sans Thai'; font-weight: 500; color: var(--navy); }
    .link-more .ic { transition: transform .25s var(--ease); }
    .link-more:hover .ic { transform: translateX(4px); }

    .cat { font-size: 13px; font-weight: 600; letter-spacing: .3px; font-family: 'IBM Plex Sans Thai'; }
    .c-alert { color: #b42318; } .c-finance-alert { color: #a15c07; } .c-supplies-alert { color: #067647; } .c-general { color: var(--navy); } .c-document { color: #4e46a5; }
    .date { font-size: 13.5px; color: var(--ink-3); }
    .ph { position: relative; overflow: hidden; background: var(--soft); aspect-ratio: 4 / 3; }
    .ph .im { position: absolute; inset: 0; background: center / cover no-repeat; transition: transform .8s var(--ease); }
    .ph .none { position: absolute; inset: 0; display: grid; place-items: center; color: #b3bccb; }
    .ph .none .ic { width: 44px; height: 44px; stroke-width: 1.2; }
    .ph .pin { position: absolute; left: 0; top: 16px; background: var(--gold); color: #fff; font-size: 12.5px; font-weight: 600; padding: 3px 12px 3px 10px; display: inline-flex; gap: 5px; align-items: center; }
    .ph .new { position: absolute; right: 12px; top: 12px; background: #fff; color: var(--navy); font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 99px; }
    .item { cursor: pointer; }
    .item:hover .im { transform: scale(1.05); }
    .item:hover .tt { color: var(--gold); }
    .tt { color: var(--navy); font-weight: 600; transition: color .2s; }
    .files { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .file { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; padding: 5px 12px; border: 1px solid var(--line); border-radius: 99px; color: var(--navy); background: #fff; transition: all .2s; max-width: 100%; }
    .file span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .file:hover { border-color: var(--navy); background: var(--navy); color: #fff; }
    .file.more { color: var(--ink-2); }

    .feat { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; }
    .lead .tt { font-size: 26px; margin-top: 8px; }
    .lead .meta { margin-top: 18px; display: flex; gap: 12px; align-items: center; }
    .lead .ex { color: var(--ink-2); margin-top: 8px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .side { display: flex; flex-direction: column; }
    .row { display: grid; grid-template-columns: 168px 1fr; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--line); }
    .row:first-child { padding-top: 0; }
    .row .tt { font-size: 17px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 2px; }
    .row .files { margin-top: 8px; }
    .row .file { padding: 3px 10px; font-size: 13px; }

    .all { margin-top: 64px; }
    .bar { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 10px 0; margin-bottom: 32px; }
    .tabs { display: flex; flex-wrap: wrap; gap: 4px; }
    .tabs button { padding: 8px 14px; font-family: 'IBM Plex Sans Thai'; font-size: 15px; color: var(--ink-2); position: relative; }
    .tabs button::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: -11px; height: 3px; background: var(--gold); transform: scaleX(0); transition: transform .3s var(--ease); }
    .tabs button.on { color: var(--navy); font-weight: 600; }
    .tabs button.on::after { transform: scaleX(1); }
    .srch { position: relative; width: 300px; max-width: 100%; }
    .srch .ic { position: absolute; left: 0; top: 50%; transform: translateY(-50%); color: var(--ink-3); }
    .srch input { width: 100%; height: 40px; border: 0; border-bottom: 1px solid var(--line); padding: 0 0 0 28px; font: inherit; outline: none; background: transparent; transition: border-color .2s; }
    .srch input:focus { border-bottom-color: var(--navy); }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px 32px; }
    .card .tt { font-size: 18px; margin-top: 6px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .card .top { margin-top: 16px; display: flex; gap: 10px; align-items: center; }
    .empty { grid-column: 1 / -1; text-align: center; color: var(--ink-3); padding: 40px 0; }
    .btn-out { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--navy); color: var(--navy); padding: 11px 26px; font-family: 'IBM Plex Sans Thai'; font-weight: 500; transition: all .25s; }
    .btn-out:hover { background: var(--navy); color: #fff; }
    .center { text-align: center; margin-top: 44px; }

    .svc { background: var(--soft); }
    .svcs { display: grid; grid-template-columns: repeat(4, 1fr); }
    .sv { padding: 10px 28px 14px; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; }
    .sv:first-child { border-left: 0; padding-left: 0; }
    .sv .ic.lg { color: var(--gold); transition: transform .4s var(--ease); }
    .sv h3 { font-size: 20px; font-weight: 600; color: var(--navy); }
    .sv .go { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); font-size: 14.5px; }
    .sv:hover .ic.lg { transform: translateY(-4px); }
    .sv:hover .go { color: var(--gold); }
    .quick { margin-top: 56px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0 32px; }
    .quick a { display: flex; align-items: center; gap: 12px; padding: 16px 0; border-top: 1px solid #d6dbe3; font-family: 'IBM Plex Sans Thai'; font-weight: 500; color: var(--navy); }
    .quick a .ic:last-child { margin-left: auto; color: var(--ink-3); transition: transform .25s var(--ease); }
    .quick a:hover .ic:last-child { transform: translateX(4px); color: var(--gold); }

    footer { background: var(--navy-2); color: #aab5c7; font-size: 15px; }
    footer .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 48px; padding: 56px 32px 40px; }
    footer .fb { display: flex; gap: 14px; align-items: center; margin-bottom: 18px; }
    footer .fb img { width: 52px; height: 52px; object-fit: contain; }
    footer .fb b { color: #fff; font-family: 'IBM Plex Sans Thai'; font-weight: 600; font-size: 18px; display: block; }
    footer h4 { color: #fff; font-size: 15px; font-weight: 600; margin-bottom: 14px; letter-spacing: .3px; }
    footer li { list-style: none; margin-bottom: 6px; }
    footer a:hover { color: #fff; }
    footer .bt { border-top: 1px solid rgba(255, 255, 255, .08); }
    footer .bt .wrap { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 16px; padding-bottom: 16px; font-size: 13.5px; }

    .rv { opacity: 0; transform: translateY(24px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    .rv.in { opacity: 1; transform: none; }

    .modal { position: fixed; inset: 0; z-index: 100; background: rgba(11, 26, 51, .6); display: none; justify-content: center; align-items: flex-start; padding: 48px 16px; overflow-y: auto; opacity: 0; transition: opacity .25s; }
    .modal.on { display: flex; }
    .modal.show { opacity: 1; }
    .sheet { background: #fff; width: 100%; max-width: 860px; transform: translateY(16px); transition: transform .3s var(--ease); }
    .modal.show .sheet { transform: none; }
    .sheet .ph { aspect-ratio: 4 / 3; max-height: 560px; width: 100%; }
    .sheet .bd { padding: 28px 36px 36px; }
    .sheet h2 { font-size: 26px; color: var(--navy); font-weight: 600; margin: 6px 0 4px; }
    .sheet .content { margin-top: 18px; font-size: 16.5px; line-height: 1.8; overflow-wrap: anywhere; }
    .sheet .content ul, .sheet .content ol { padding-left: 1.4em; }
    .sheet .content a { color: #1d4ed8; text-decoration: underline; }
    .sheet .dl { margin-top: 24px; border-top: 1px solid var(--line); }
    .sheet .dl a { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--navy); font-weight: 500; }
    .sheet .dl a:hover { color: var(--gold); }
    .sheet .dl a .ic:last-child { margin-left: auto; }
    .sheet .ft { display: flex; justify-content: space-between; gap: 10px; margin-top: 28px; }
    .x { position: fixed; top: 16px; right: 20px; width: 44px; height: 44px; border-radius: 50%; background: #fff; display: grid; place-items: center; color: var(--navy); z-index: 101; }
    #toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); background: var(--navy-2); color: #fff; padding: 10px 20px; display: none; z-index: 200; }

    @media (max-width: 1080px) {
      .feat { grid-template-columns: 1fr; gap: 32px; }
      .grid { grid-template-columns: repeat(2, 1fr); }
      .svcs { grid-template-columns: repeat(2, 1fr); gap: 32px 0; }
      .sv:nth-child(3) { border-left: 0; padding-left: 0; }
      .quick { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .wrap { padding: 0 18px; }
      .hero { height: 70vh; min-height: 420px; }
      .cap { bottom: 64px; }
      .cap .box { padding: 18px 20px; margin-right: 12px; }
      .cap h1 { font-size: 23px; } .cap p { font-size: 15px; }
      .count { display: none; }
      section { padding: 52px 0; }
      .sh h2 { font-size: 27px; }
      .lead .tt { font-size: 21px; }
      .row { grid-template-columns: 120px 1fr; gap: 14px; }
      .grid, .svcs, .quick { grid-template-columns: 1fr; }
      .sv { border-left: 0; padding-left: 0; }
      footer .cols { grid-template-columns: 1fr; gap: 28px; padding: 40px 18px 28px; }
      .modal { padding: 0; } .sheet .bd { padding: 20px 18px 28px; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } .rv { opacity: 1; transform: none; } }
  </style>
</head>
