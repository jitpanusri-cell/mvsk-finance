    .att-list a:hover { border-color: var(--navy); background: #fafbfc; }
    .att-list a .ic { color: var(--navy); }
    .att-list a span { flex: 1; font-weight: 500; }
    .sheet-f { display: flex; gap: 8px; justify-content: flex-end; padding: 14px 24px; border-top: 1px solid var(--line); background: #fafbfc; }

