  <style>
    :root {
      --navy: #13294b; --navy-2: #0b1a33; --gold: #c79a2e; --gold-2: #e0b85a;
      --ink: #1b2432; --ink-2: #4a5568; --ink-3: #8a94a6; --line: #e3e7ed; --soft: #f5f6f8;
