            showToast(res.message, "success");
          } else {
            showToast(res.message, "error");
          }
        })
        .withFailureHandler(function(){ 
          btn.innerText = "💾 บันทึกการเปลี่ยนแปลง"; btn.disabled = false; 
          showToast("ระบบขัดข้องทางเทคนิค", "error"); 
