      var o = t.closest('[data-open]'); if (o) { openNews(o.dataset.open); return; }
      if (t.closest('[data-close]') || t === $('modal')) { closeNews(); return; }
      if (t.closest('#copyLink')) { copy(BASE + '?news=' + encodeURIComponent(ST.openId)); return; }
      var ty = t.closest('[data-type]'); if (ty) { ST.type = ty.dataset.type; ST.shown = PAGE; renderAll(); return; }
      var bi = t.closest('#bars [data-i]'); if (bi) show(Number(bi.dataset.i));
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeNews(); });
    $('prev').onclick = function () { show(ST.cur - 1); };
    $('next').onclick = function () { show(ST.cur + 1); };
    $('moreBtn').onclick = function () { ST.shown += PAGE; renderAll(); };
    var qt; $('q').oninput = function () { var v = this.value; clearTimeout(qt); qt = setTimeout(function () { ST.q = v.trim(); ST.shown = PAGE; renderAll(); }, 180); };
    var heroIn = document.querySelector('.hero-in'), ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () {
        var y = window.scrollY, H = document.documentElement.scrollHeight - innerHeight;
        $('head').classList.toggle('scrolled', y > 20);
        $('prog').style.transform = 'scaleX(' + (H > 0 ? y / H : 0) + ')';
        if (y < innerHeight) { heroIn.style.transform = 'translateY(' + y * 0.3 + 'px)'; heroIn.style.opacity = String(Math.max(0, 1 - y / (innerHeight * 0.8))); }
        ticking = false;
      });
    }, { passive: true });
    (function swipe() {
      var x0 = null, h = $('hero');
      h.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      h.addEventListener('touchend', function (e) { if (x0 == null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(ST.cur + (dx < 0 ? 1 : -1)); x0 = null; });
    })();
    document.addEventListener('visibilitychange', function () { if (document.hidden) clearTimeout(ST.timer); else show(ST.cur); });

    renderSlides(); observe();
    google.script.run.withSuccessHandler(function (d) {
      d = d || {};
      if (d.staffUrl) $('staffLink').setAttribute('href', d.staffUrl);
      ST.news = (d.news || []).map(function (a) { a.links = a.links || []; a._t = plain(a.details); return a; });
      ST.slides = (d.slides || []).filter(function (s) { return s.imageUrl; });
      if (ST.slides.length) renderSlides();
      renderFeat(); renderAll();
      if (google.script.url) google.script.url.getLocation(function (l) { if (l && l.parameter && l.parameter.news) openNews(l.parameter.news); });
    }).withFailureHandler(function () {
      $('feat').innerHTML = '<div class="empty">โหลดข่าวไม่สำเร็จ <button class="link-more" onclick="location.reload()">ลองใหม่</button></div>';
    }).getHomeData();
  </script>
</body>
</html>
