    .ic.sm { width: 16px; height: 16px; }
    .ic.lg { width: 26px; height: 26px; }
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    /* แถบบนสุด */
