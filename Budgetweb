    }
    @media (max-width: 680px) {
      .wrap { padding: 0 16px; }
      .topbar .hide-m { display: none; }
      .brand b { font-size: 15px; } .brand small { font-size: 12px; }
      .hero .wrap { flex-direction: column; text-align: center; padding-top: 36px; padding-bottom: 96px; gap: 12px; }
