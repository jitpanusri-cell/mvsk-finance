      .pin-card .thumb { aspect-ratio: 16 / 9; min-height: 0; }
      .search { margin-left: 0; width: 100%; min-width: 0; }
      footer .cols { grid-template-columns: 1fr; gap: 20px; }
      .modal { padding: 0; } .sheet { border-radius: 0; min-height: 100%; }
    }
    @media print { .topbar, .header, .hero, .services, #quick, .toolbar, footer { display: none; } }
  </style>
