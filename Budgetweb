      const btn = document.getElementById('btnPwdSubmit');
      const newName = document.getElementById('pwdName').value;
      const newPass = document.getElementById('pwdNew').value;
      
      btn.innerText = "⏳ กำลังบันทึกข้อมูล..."; btn.disabled = true;

      google.script.run
        .withSuccessHandler(function(res) {
