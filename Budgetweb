  <script>
    var TYPES = { 'alert': 'ด่วนที่สุด', 'finance-alert': 'งานการเงิน', 'supplies-alert': 'งานพัสดุ', 'general': 'ข่าวทั่วไป', 'document': 'เอกสาร/ดาวน์โหลด' };
    var DEF_SLIDE = { imageUrl: 'https:' + String.fromCharCode(47, 47) + 'drive.google.com/thumbnail?id=1z1tiStUX6sSO5Fg1by-5HPU7mJ2oX8No&sz=w1920', title: 'กลุ่มบริหารงานงบประมาณ', subtitle: 'โรงเรียนมหาวชิราวุธ จังหวัดสงขลา' };
    var PAGE = 6, DUR = 7000;
    var ST = { featIds: [], news: [], slides: [], type: 'all', q: '', shown: PAGE, cur: 0, timer: null, openId: '' };
    var BASE = (document.getElementById('baseUrl').textContent || '').trim();

    function $(id) { return document.getElementById(id); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function icon(n, c) { return '<svg class="ic ' + (c || '') + '"><use href="#i-' + n + '"/></svg>'; }
    function bg(u) { return 'background-image:url(&quot;' + esc(u) + '&quot;)'; }
    function safeUrl(u) { return /^(https?:|mailto:)/i.test(String(u || '').trim()) ? u : '#'; }
    function toast(m) { var t = $('toast'); t.textContent = m; t.style.display = 'block'; clearTimeout(t._h); t._h = setTimeout(function () { t.style.display = 'none'; }, 2400); }

    var OK = 'B STRONG I EM U BR P DIV SPAN FONT UL OL LI A H1 H2 H3 H4 BLOCKQUOTE HR SMALL SUB SUP'.split(' ');
    function clean(html) {
      var doc = new DOMParser().parseFromString('<div>' + (html || '') + '</div>', 'text/html'), root = doc.body.firstChild;
      (function walk(el) {
        Array.prototype.slice.call(el.children).forEach(function (c) {
          if (OK.indexOf(c.tagName) < 0) {
            if (/^(SCRIPT|STYLE|IFRAME|OBJECT|EMBED|FORM|INPUT|TEXTAREA|BUTTON)$/.test(c.tagName)) { c.remove(); return; }
            var s = doc.createElement('span'); while (c.firstChild) s.appendChild(c.firstChild); c.replaceWith(s); walk(s); return;
          }
          Array.prototype.slice.call(c.attributes).forEach(function (a) {
            var n = a.name.toLowerCase();
            if (n === 'href') { if (safeUrl(a.value) === '#') c.removeAttribute('href'); }
            else if (n === 'style') c.setAttribute('style', (a.value.match(/(color|font-weight|font-size|text-align)\s*:[^;]+/gi) || []).join(';'));
            else if (!(c.tagName === 'FONT' && /^(color|size|face)$/.test(n))) c.removeAttribute(a.name);
          });
          if (c.tagName === 'A') { c.setAttribute('target', '_blank'); c.setAttribute('rel', 'noopener'); }
          walk(c);
        });
      })(root);
      return root.innerHTML;
    }
    function plain(h) { var d = document.createElement('div'); d.innerHTML = clean(h).replace(/<br\s*\/?>/gi, ' ').replace(/<\/(p|div|li)>/gi, ' '); return (d.textContent || '').replace(/\s+/g, ' ').trim(); }
    function isNew(a) { return a.createdAt && Date.now() - a.createdAt < 7 * 864e5; }

    function photo(a) {
      return '<div class="ph">' + (a.imageUrl ? '<div class="im" style="' + bg(a.imageUrl) + '"></div>' : '<div class="none">' + icon('megaphone') + '</div>') +
        (a.pinned ? '<span class="pin">' + icon('pin', 'sm') + 'ปักหมุด</span>' : '') + (isNew(a) && !a.pinned ? '<span class="new">ใหม่</span>' : '') + '</div>';
    }
    function files(a, max) {
      if (!a.links.length) return '';
      var shown = a.links.slice(0, max);
      return '<div class="files">' + shown.map(function (l) {
        return '<a class="file" href="' + esc(safeUrl(l.url)) + '" target="_blank" rel="noopener">' + icon('download', 'sm') + '<span>' + esc(l.name) + '</span></a>';
      }).join('') + (a.links.length > max ? '<button class="file more" data-open="' + esc(a.id) + '">+' + (a.links.length - max) + ' ไฟล์</button>' : '') + '</div>';
    }
    function catDate(a) { return '<span class="cat c-' + esc(a.type) + '">' + esc(TYPES[a.type] || '') + '</span>' + (a.date ? '<span class="date">' + esc(a.date.replace(/^วันที่\s*/, '')) + '</span>' : ''); }

    function renderFeat() {
      var list = ST.news.slice().sort(function (a, b) { return (b.pinned ? 1 : 0) - (a.pinned ? 1 : 0); }).slice(0, 4);
      if (!list.length) { $('feat').innerHTML = '<div class="empty">ยังไม่มีข่าวประชาสัมพันธ์</div>'; return; }
      ST.featIds = list.map(function (x) { return x.id; });
      var a = list[0];
      $('feat').innerHTML = '<article class="lead item rv" data-open="' + esc(a.id) + '">' + photo(a) +
        '<div class="meta">' + catDate(a) + '</div><h3 class="tt">' + esc(a.title) + '</h3>' + (a._t ? '<p class="ex">' + esc(a._t) + '</p>' : '') + files(a, 4) + '</article>' +
        '<div class="side">' + list.slice(1).map(function (b) {
          return '<article class="row item rv" data-open="' + esc(b.id) + '">' + photo(b) + '<div><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">' + catDate(b) + '</div><h3 class="tt">' + esc(b.title) + '</h3>' + files(b, 2) + '</div></article>';
        }).join('') + '</div>';
    }

    function renderAll() {
      var c = { all: ST.news.length }; ST.news.forEach(function (a) { c[a.type] = (c[a.type] || 0) + 1; });
      $('tabs').innerHTML = ['all'].concat(Object.keys(TYPES).filter(function (k) { return c[k]; })).map(function (k) {
        return '<button class="' + (ST.type === k ? 'on' : '') + '" data-type="' + k + '">' + (k === 'all' ? 'ทั้งหมด' : TYPES[k]) + '</button>';
      }).join('');
      var q = ST.q.toLowerCase();
      var list = ST.news.filter(function (a) { return (ST.type === 'all' || a.type === ST.type) && (!q || (a.title + ' ' + a._t + ' ' + a.date).toLowerCase().indexOf(q) >= 0); });
      if (ST.type === 'all' && !q) list = list.filter(function (a) { return ST.featIds.indexOf(a.id) < 0; });
      $('grid').innerHTML = list.length ? list.slice(0, ST.shown).map(function (a) {
        return '<article class="card item rv" data-open="' + esc(a.id) + '">' + photo(a) + '<div class="top">' + catDate(a) + '</div><h3 class="tt">' + esc(a.title) + '</h3>' + files(a, 2) + '</article>';
      }).join('') : '<div class="empty">' + (ST.news.length > ST.featIds.length || ST.q || ST.type !== 'all' ? 'ไม่พบข่าวที่ค้นหา' : 'ข่าวทั้งหมดแสดงด้านบนแล้ว') + '</div>';
      $('moreWrap').hidden = list.length <= ST.shown;
      observe();
    }

    var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' }) : null;
    function observe() {
      var i = 0;
      document.querySelectorAll('.rv:not(.in)').forEach(function (el) {
        if (!io) { el.classList.add('in'); return; }
        if (el.parentNode && (el.parentNode.id === 'grid' || el.classList.contains('row') || el.classList.contains('sv'))) el.style.transitionDelay = (i++ % 4) * 0.08 + 's';
        io.observe(el);
      });
    }

    function renderSlides() {
      var S = ST.slides.length ? ST.slides : [DEF_SLIDE];
      $('slides').innerHTML = S.map(function (s, i) { return '<div class="slide' + (i ? '' : ' on') + '"><div class="bg" style="' + bg(s.imageUrl) + '"></div></div>'; }).join('');
      $('bars').innerHTML = S.map(function (s, i) { return '<button aria-label="ภาพที่ ' + (i + 1) + '" data-i="' + i + '"><i></i></button>'; }).join('');
      $('hctl').style.display = S.length > 1 ? '' : 'none';
      $('bars').style.setProperty('--dur', DUR + 'ms');
      show(0);
    }
    function show(i) {
      var S = ST.slides.length ? ST.slides : [DEF_SLIDE], n = S.length;
      ST.cur = (i + n) % n;
      var s = S[ST.cur];
      document.querySelectorAll('.slide').forEach(function (el, k) { el.classList.toggle('on', k === ST.cur); });
      document.querySelectorAll('#bars button').forEach(function (b, k) { b.classList.remove('on'); b.classList.toggle('done', k < ST.cur); void b.offsetWidth; if (k === ST.cur) b.classList.add('on'); });
      $('count').textContent = String(ST.cur + 1).padStart(2, '0') + ' / ' + String(n).padStart(2, '0');
      var title = s.title || DEF_SLIDE.title, sub = s.title ? s.subtitle : (s.subtitle || DEF_SLIDE.subtitle);
      $('cap').classList.remove('in');
      $('capBox').innerHTML = '<div class="kick">' + (s.title ? 'กลุ่มบริหารงานงบประมาณ' : 'Mahavajiravudh Changwatsongkhla School') + '</div><h1>' + esc(title) + '</h1>' +
        (sub ? '<p>' + esc(sub) + '</p>' : '') + (s.link ? '<a class="more" href="' + esc(safeUrl(s.link)) + '" target="_blank" rel="noopener">' + esc(s.linkText || 'อ่านเพิ่มเติม') + icon('arrow', 'sm') + '</a>' : '');
      requestAnimationFrame(function () { requestAnimationFrame(function () { $('cap').classList.add('in'); }); });
      clearTimeout(ST.timer);
      if (n > 1) ST.timer = setTimeout(function () { show(ST.cur + 1); }, DUR);
    }

    function openNews(id) {
      var a = ST.news.filter(function (x) { return x.id === id; })[0]; if (!a) return;
      ST.openId = id;
      $('sheet').innerHTML = (a.imageUrl ? '<div class="ph"><div class="im" style="' + bg(a.imageUrl) + '"></div></div>' : '') +
        '<div class="bd"><div style="display:flex;gap:12px;align-items:center">' + catDate(a) + '</div><h2>' + esc(a.title) + '</h2>' +
        '<div class="content">' + clean(a.details) + '</div>' +
        (a.links.length ? '<div class="dl">' + a.links.map(function (l) { return '<a href="' + esc(safeUrl(l.url)) + '" target="_blank" rel="noopener">' + icon('file') + esc(l.name) + icon('download', 'sm') + '</a>'; }).join('') + '</div>' : '') +
        '<div class="ft"><button class="link-more" id="copyLink">' + icon('copy', 'sm') + 'คัดลอกลิงก์ข่าว</button><button class="btn-out" data-close>ปิด</button></div></div>';
      var m = $('modal'); m.classList.add('on'); document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () { m.classList.add('show'); m.scrollTop = 0; });
    }
    function closeNews() { var m = $('modal'); m.classList.remove('show'); setTimeout(function () { m.classList.remove('on'); }, 250); document.body.style.overflow = ''; }
    function copy(txt) {
      var done = function () { toast('คัดลอกลิงก์แล้ว'); };
      try { if (navigator.clipboard) { navigator.clipboard.writeText(txt).then(done, fb); return; } } catch (e) { }
      fb();
      function fb() { var t = document.createElement('textarea'); t.value = txt; document.body.appendChild(t); t.select(); try { document.execCommand('copy'); done(); } catch (e) { } t.remove(); }
    }

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t.closest('a.file')) return;
      var g = t.closest('[data-go]'); if (g) { e.preventDefault(); $(g.dataset.go).scrollIntoView({ behavior: 'smooth' }); $('nav').classList.remove('show'); return; }
      var o = t.closest('[data-open]'); if (o) { openNews(o.dataset.open); return; }
      if (t.closest('[data-close]') || t === $('modal')) { closeNews(); return; }
      if (t.closest('#copyLink')) { copy(BASE + '?news=' + encodeURIComponent(ST.openId)); return; }
      var ty = t.closest('[data-type]'); if (ty) { ST.type = ty.dataset.type; ST.shown = PAGE; renderAll(); return; }
      var bi = t.closest('#bars [data-i]'); if (bi) show(Number(bi.dataset.i));
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeNews(); });
    $('prev').onclick = function () { show(ST.cur - 1); };
    $('next').onclick = function () { show(ST.cur + 1); };
    $('moreBtn').onclick = function () { ST.shown += PAGE; renderAll(); };
    $('burger').onclick = function () { $('nav').classList.toggle('show'); };
    var qt; $('q').oninput = function () { var v = this.value; clearTimeout(qt); qt = setTimeout(function () { ST.q = v.trim(); ST.shown = PAGE; renderAll(); }, 180); };
    window.addEventListener('scroll', function () { $('head').classList.toggle('scrolled', window.scrollY > 20); }, { passive: true });
    (function swipe() {
      var x0 = null, h = $('hero');
      h.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
      h.addEventListener('touchend', function (e) { if (x0 == null) return; var dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(ST.cur + (dx < 0 ? 1 : -1)); x0 = null; });
    })();
    document.addEventListener('visibilitychange', function () { if (document.hidden) clearTimeout(ST.timer); else show(ST.cur); });
    if (!$('staffLink').getAttribute('href')) $('staffLink').onclick = function (e) { e.preventDefault(); toast('ยังไม่ได้ผูกเว็บกับระบบการเงิน (ระบบการเงิน > เว็บไซต์ > ตั้งค่า)'); };

    renderSlides(); observe();
    google.script.run.withSuccessHandler(function (d) {
      d = d || {};
      ST.news = (d.news || []).map(function (a) { a.links = a.links || []; a._t = plain(a.details); return a; });
      ST.slides = (d.slides || []).filter(function (s) { return s.imageUrl; });
      if (ST.slides.length) renderSlides();
      renderFeat(); renderAll();
      if (google.script.url) google.script.url.getLocation(function (l) { if (l && l.parameter && l.parameter.news) openNews(l.parameter.news); });
    }).withFailureHandler(function () {
      $('feat').innerHTML = '<div class="empty">โหลดข่าวไม่สำเร็จ <button class="link-more" onclick="location.reload()">ลองใหม่</button></div>';
    }).getHomeData();
  </script>
