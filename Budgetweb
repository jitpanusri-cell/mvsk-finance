          "#ef4444", 
          logoutAdmin
        );
      } else {
        document.getElementById('loginUser').value = "admin";
        document.getElementById('loginPass').value = "";
        document.getElementById('loginModal').classList.add('active');
      }
    }

    function logoutAdmin() {
      google.script.run.logLogout(loggedInUserName);
      
      isAdminActive = false; loggedInUser = ""; loggedInUserName = "";
      toggleAdminUI(false);
      renderAnnouncements(globalAnnouncements); 
      document.getElementById('btnSaveOrder').style.display = 'none';
      showToast("ออกจากโหมดเจ้าหน้าที่เรียบร้อยแล้ว", "info");
    }

    function submitLogin(e) {
      e.preventDefault();
      const btn = document.getElementById('btnLoginSubmit');
      btn.innerText = "⏳ กำลังยืนยัน..."; btn.disabled = true;

      google.script.run
        .withSuccessHandler(function(res) {
          btn.innerText = "🔑 ยืนยันข้อมูล"; btn.disabled = false;
          if (res.success) {
            isAdminActive = true; 
            loggedInUser = res.username;
            loggedInUserName = res.name; 
            closeModal('loginModal');
            toggleAdminUI(true);
            renderAnnouncements(globalAnnouncements); 
            showToast("เข้าสู่ระบบสำเร็จ! ยินดีต้อนรับคุณ " + res.name, "success");
          } else { 
            showToast(res.message, "error"); 
          }
        })
        .withFailureHandler(function(){ 
          btn.innerText = "🔑 ยืนยันข้อมูล"; btn.disabled = false; 
          showToast("ไม่สามารถติดต่อระบบฐานข้อมูลได้", "error"); 
        })
        .verifyAdminLogin(document.getElementById('loginUser').value, document.getElementById('loginPass').value);
    }

