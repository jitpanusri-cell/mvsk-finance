<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>กลุ่มบริหารงานงบประมาณ - โรงเรียนมหาวชิราวุธ จังหวัดสงขลา</title>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&family=Mitr:wght@300;400;500&family=Chakra+Petch:wght@300;400;500;600&display=swap" rel="stylesheet">
  <base target="_top">
  
  <style>
    :root {
      --primary-navy: #0f172a;
      --primary-gold: #fbbc04;
      --alert-red: #ef4444;
      --bg-glass: rgba(15, 23, 42, 0.65);
      --card-glass: rgba(255, 255, 255, 0.08);
      --card-border: rgba(255, 255, 255, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { margin: 0; padding: 0; font-family: 'Prompt', sans-serif; color: #333; overflow-x: hidden; scroll-behavior: smooth; }
    
    .bg-layer {
      position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
      background-image: linear-gradient(rgba(15, 23, 42, 0.6), rgba(15, 23, 42, 0.85)), url('https://drive.google.com/thumbnail?id=1z1tiStUX6sSO5Fg1by-5HPU7mJ2oX8No&sz=w1920-h1080'); 
      background-size: cover; background-position: center; background-repeat: no-repeat; z-index: -1; filter: blur(4px); transform: scale(1.05);
    }

    /* 🔔 TOAST NOTIFICATIONS */
    #toast-container { position: fixed; top: 25px; right: 25px; z-index: 10001; display: flex; flex-direction: column; gap: 12px; }
    .toast-box { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-left: 5px solid var(--primary-gold); border-radius: 12px; padding: 18px 22px; display: flex; align-items: center; gap: 14px; box-shadow: 0 15px 35px rgba(0,0,0,0.3); transform: translateX(120%); opacity: 0; transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s ease; max-width: 380px; font-weight: 500;}
    .toast-box.show { transform: translateX(0); opacity: 1; }
    .toast-box.success { border-color: #10b981; }
    .toast-box.error { border-color: #ef4444; }
    .toast-box.info { border-color: #3b82f6; }
    .toast-box.warning { border-color: #f59e0b; }
    .toast-icon { font-size: 22px; }
    .toast-message { font-size: 14px; color: #1e293b; line-height: 1.5; }

    /* 🏝️ NAVIGATION BAR STYLES */
    .dynamic-header-wrapper { position: fixed; top: 24px; left: 50%; transform: translateX(-50%); width: 95%; max-width: 1400px; z-index: 9999; transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .dynamic-island { background: var(--bg-glass); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid var(--card-border); border-radius: 60px; padding: 8px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); }
    .dynamic-header-wrapper.scrolled { top: 12px; max-width: 1200px; }
    .dynamic-header-wrapper.scrolled .dynamic-island { background: rgba(15, 23, 42, 0.9); }

    .island-brand { display: flex; align-items: center; gap: 12px; padding-right: 20px; border-right: 1px solid rgba(255, 255, 255, 0.1); text-decoration: none; }
    .island-logo-img { width: 38px; height: 38px; object-fit: contain; transition: transform 0.3s; }
    .island-brand:hover .island-logo-img { transform: scale(1.1) rotate(5deg); }
    .brand-group { color: #ffffff; font-weight: 600; font-size: 14px; display: block; }
    .brand-school { color: var(--primary-gold); font-size: 11px; display: block; }

    .island-menu-container { display: flex; align-items: center; flex-grow: 1; justify-content: flex-end; }
    .island-nav { display: flex; gap: 8px; align-items: center; }
    .island-nav a { color: rgba(255, 255, 255, 0.8); text-decoration: none; font-size: 14px; padding: 8px 16px; border-radius: 30px; transition: all 0.3s; }
    .island-nav a:hover { color: var(--primary-navy); background: var(--primary-gold); font-weight: 500; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(251, 188, 4, 0.3); }
    
    .island-staff-area { margin-left: 12px; padding-left: 12px; border-left: 1px solid rgba(255, 255, 255, 0.1); }
    .island-staff-btn { background-color: rgba(251, 188, 4, 0.1); color: var(--primary-gold); border: 1px solid rgba(251, 188, 4, 0.4); padding: 8px 20px; border-radius: 30px; font-family: 'Prompt'; font-size: 13px; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .island-staff-btn:hover, .island-staff-btn.active { background-color: var(--primary-gold); color: var(--primary-navy); box-shadow: 0 6px 15px rgba(251, 188, 4, 0.4); transform: translateY(-2px); font-weight: 600;}

    .mobile-menu-toggle { display: none; background: none; border: none; color: var(--primary-gold); font-size: 24px; cursor: pointer; }

    /* CORE CONTENT ELEMENTS */
    .main-container { max-width: 1440px; margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; }
    .site-header { padding: 160px 20px 40px; display: flex; flex-direction: column; align-items: center; text-align: center; }
    .site-header img.logo { width: 160px; margin-bottom: 24px; filter: drop-shadow(0 8px 16px rgba(0,0,0,0.4)); transition: transform 0.5s ease; }
    .site-header img.logo:hover { transform: scale(1.08) translateY(-5px); }
    .finance-title { font-size: 32px; font-weight: 700; color: var(--primary-gold); margin-bottom: 8px; letter-spacing: 0.5px; text-shadow: 0 2px 10px rgba(251, 188, 4, 0.2); }
    .school-subtitle-th { font-size: 18px; font-weight: 500; color: #ffffff; opacity: 0.95; }
    .school-subtitle-en { font-size: 12px; font-weight: 400; color: #94a3b8; letter-spacing: 1.5px; margin-top: 8px; text-transform: uppercase; }

    .content-wrapper { padding: 0 20px 60px; flex-grow: 1; }
    .menu-grid { display: grid; grid-template-columns: repeat(1, 1fr); gap: 20px; margin-bottom: 40px; max-width: 1000px; margin-left: auto; margin-right: auto; }
    
    /* MENU LINK CARDS STYLE */
    .menu-card { background: var(--card-glass); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--card-border); border-radius: 24px; padding: 24px; text-decoration: none; display: flex; align-items: center; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); position: relative; overflow: hidden; }
    .menu-card::before { content: ''; position: absolute; top: 0; left: 0; width: 6px; height: 100%; background: var(--primary-gold); border-radius: 24px 0 0 24px; transition: width 0.3s ease; }
    .menu-card:hover { transform: translateY(-8px) scale(1.02); background: rgba(255, 255, 255, 0.12); border-color: rgba(251, 188, 4, 0.5); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4); }
    
    .card-content { display: flex; align-items: center; gap: 20px; width: 100%; margin-left: 10px; z-index: 2; }
    .icon-wrapper { width: 56px; height: 56px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; transition: all 0.4s ease; flex-shrink: 0; }
    .icon-svg { width: 28px; height: 28px; fill: #ffffff; transition: fill 0.4s; }
    .card-title { font-size: 20px; font-weight: 500; color: #ffffff; flex-grow: 1; transition: color 0.3s ease; }
    .arrow-circle { width: 40px; height: 40px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); font-size: 18px; }
    
    .menu-card:hover .icon-wrapper { background: rgba(251, 188, 4, 0.15); border-color: var(--primary-gold); transform: rotate(5deg) scale(1.1); }
    .menu-card:hover .icon-svg { fill: var(--primary-gold); }
    .menu-card:hover .arrow-circle { background: var(--primary-gold); color: var(--primary-navy); border-color: var(--primary-gold); transform: translateX(8px) scale(1.1); box-shadow: 0 0 15px rgba(251, 188, 4, 0.5); }

    /* STAFF ACTIVE PANEL CONTROL BAR */
    .admin-dash-bar { background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(10px); border: 1px dashed var(--primary-gold); padding: 18px 24px; border-radius: 16px; margin-bottom: 30px; display: none; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; box-shadow: 0 10px 30px rgba(0,0,0,0.5); animation: slideDown 0.4s ease forwards;}
    @keyframes slideDown { from {opacity: 0; transform: translateY(-20px);} to {opacity: 1; transform: translateY(0);} }
    
    .admin-actions-group { display: flex; gap: 10px; flex-wrap: wrap;}
    
    .btn-create-announcement { background: #10b981; color: white; border: none; padding: 10px 16px; border-radius: 12px; font-family: 'Prompt'; font-weight: 500; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
    .btn-create-announcement:hover { background: #059669; transform: translateY(-3px) scale(1.05); box-shadow: 0 6px 15px rgba(16, 185, 129, 0.5); }
    
    .btn-action-outline { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 10px 16px; border-radius: 12px; font-family: 'Prompt'; cursor: pointer; transition: all 0.3s; }
    .btn-action-outline:hover { background: white; color: var(--primary-navy); transform: translateY(-2px); box-shadow: 0 4px 10px rgba(255,255,255,0.2);}
    
    .btn-save-order { background: #f59e0b; color: white; border: none; padding: 10px 16px; border-radius: 12px; font-family: 'Prompt'; font-weight: 500; cursor: pointer; transition: all 0.3s; display: none; animation: pulse 1.5s infinite; }
    .btn-save-order:hover { background: #d97706; animation: none; transform: translateY(-2px); }
    
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); } 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); } }

    /* 📢 GRID LAYOUT FOR ANNOUNCEMENTS */
    #announcementBlock { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: start; }
    @media (min-width: 992px) { #announcementBlock { grid-template-columns: repeat(2, 1fr); gap: 32px; } }

    /* DRAG AND DROP STYLES */
    .alert-card.draggable-mode { cursor: grab; }
    .alert-card.draggable-mode:active { cursor: grabbing; }
    .alert-card.dragging { opacity: 0.5; border: 2px dashed var(--primary-gold); transform: scale(0.98) !important; }
    .alert-card.drag-over { border: 2px solid var(--primary-gold); box-shadow: 0 20px 40px rgba(251, 188, 4, 0.2); }
    .drag-handle-icon { display: none; margin-right: 10px; font-size: 18px; color: #94a3b8; cursor: grab; }
    .draggable-mode .drag-handle-icon { display: inline-block; }

    /* CARD CORE STYLES & SCROLL ANIMATION (นำ Shine & Glow ออก เลื่อนขึ้นช้าลง) */
    .alert-card { 
      background: #ffffff; border-radius: 18px; padding: 32px; 
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12); display: flex; flex-direction: column;
      position: relative; 
      border-top: 5px solid #dc2626; border-left: 2px solid transparent;
      border-right: 2px solid transparent; border-bottom: 2px solid transparent;
      
      /* ทำให้การเลื่อนจอขึ้นมา ช้าลงและนุ่มขึ้น (เพิ่มเวลา transition เป็น 1s และ 1.2s) */
      opacity: 0; transform: translateY(80px); 
      transition: opacity 1s ease-out, transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
    }
    
    /* เมื่อเลื่อนจอมาเจอ */
    .alert-card.is-visible { opacity: 1; transform: translateY(0); }
    .alert-card.is-visible:hover { transform: translateY(-8px); box-shadow: 0 20px 45px rgba(0, 0, 0, 0.15); }

    /* โหมดซ่อนประกาศ (Grayscale) */
    .hidden-card { filter: grayscale(100%); opacity: 0.65; border-top-color: #64748b !important; }
    .hidden-card.is-visible:hover { filter: grayscale(40%); opacity: 0.95; }

    .alert-card.finance-alert { border-top: 5px solid #d97706; }
    .alert-card.supplies-alert { border-top: 5px solid #10b981; }
    
    .card-header-area { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 10px; flex-wrap: wrap; }
    .badge-group { display: flex; align-items: center; }
    .badge { padding: 5px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; }
    .badge.urgent { background: #fee2e2; color: #dc2626; }
    .badge.finance { background: #fef3c7; color: #b45309; }
    .badge.supplies { background: #d1fae5; color: #059669; }
    
    .card-date-tag { font-size: 13px; color: #64748b; display: flex; align-items: center; gap: 5px; }
    .card-title-text { font-size: 22px; font-weight: 600; color: #0f172a; margin-bottom: 16px; line-height: 1.4; transition: color 0.3s;}
    .alert-card:hover .card-title-text { color: #d97706; }

    .alert-embedded-img { width: 100%; height: auto; max-height: 550px; object-fit: contain; border-radius: 12px; margin-bottom: 20px; display: block; background: #f8fafc; border: 1px solid #e2e8f0; transition: transform 0.4s; }
    .alert-embedded-img:hover { transform: scale(1.02); }
    
    .card-desc { font-size: 16px; color: #334155; line-height: 1.7; margin-bottom: 24px; flex-grow: 1; }
    .card-desc strong { color: #0f172a; font-weight: 600; }
    .card-desc a { color: #b45309; text-decoration: none; font-weight: 500; }
    .card-desc a:hover { text-decoration: underline; }

    .button-group-container { display: flex; flex-direction: column; gap: 10px; }
    .download-btn { display: flex; align-items: center; justify-content: center; background: #f8fafc; border: 1px solid #cbd5e1; color: #334155; padding: 12px 14px; border-radius: 10px; text-decoration: none; font-weight: 500; font-size: 14px; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .download-btn:hover { background: #f59e0b; border-color: #f59e0b; color: #ffffff; transform: translateY(-3px) scale(1.02); box-shadow: 0 6px 15px rgba(245, 158, 11, 0.3); }
    
    .card-admin-footer { margin-top: 20px; font-size: 12px; color: #94a3b8; text-align: right; border-top: 1px dashed #e2e8f0; padding-top: 12px; display: none; }
    .card-admin-actions { margin-top: 12px; display: none; gap: 8px; justify-content: flex-end; flex-wrap: wrap;}
    
    .btn-edit-card, .btn-delete-card, .btn-hide-card { border: none; padding: 6px 14px; border-radius: 6px; font-family: 'Prompt'; font-size: 13px; cursor: pointer; transition: all 0.2s; color: white; font-weight: 500; z-index: 2;}
    .btn-edit-card { background: #3b82f6; } .btn-edit-card:hover { background: #2563eb; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(59, 130, 246, 0.3);}
    .btn-delete-card { background: #ef4444; } .btn-delete-card:hover { background: #dc2626; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);}
    .btn-hide-card { background: #64748b; } .btn-hide-card:hover { background: #475569; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(100, 116, 139, 0.3);}

    /* 🔄 CSS LOADER */
    .loader-wrapper { grid-column: 1 / -1; display: flex; justify-content: center; align-items: center; padding: 80px 0; }
    .loader { height: 15px; aspect-ratio: 5; display: grid; }
    .loader:before, .loader:after { content: ""; grid-area: 1/1; height: inherit; --_g: no-repeat radial-gradient(farthest-side, #fbbc04 94%, #0000); background: var(--_g) left, var(--_g) right; background-size: 15px 100%; animation: l35 1s infinite linear; }
    .loader:after { margin-left: auto; --s:-1; }
    @keyframes l35 { 0% {transform:translateY(calc(var(--s,1)*0px));aspect-ratio: 2.3} 33% {transform:translateY(calc(var(--s,1)*8px));aspect-ratio: 2.3} 66% {transform:translateY(calc(var(--s,1)*8px));aspect-ratio: 3.7} 100% {transform:translateY(calc(var(--s,1)*0px));aspect-ratio: 3.7} }

    /* RICH TEXT EDITOR */
    .editor-toolbar { display: flex; gap: 4px; flex-wrap: wrap; background: #f8fafc; padding: 8px; border: 1px solid #cbd5e1; border-radius: 12px 12px 0 0; border-bottom: none; align-items: center; }
    .editor-btn { background: white; border: 1px solid #cbd5e1; color: #334155; padding: 5px 10px; border-radius: 6px; font-family: 'Prompt'; font-size: 12px; cursor: pointer; transition: all 0.2s; font-weight: 500; }
    .editor-btn:hover { background: #e2e8f0; border-color: #94a3b8; transform: translateY(-1px); }
    .editor-select { background: white; border: 1px solid #cbd5e1; padding: 5px; border-radius: 6px; font-family: 'Prompt'; font-size: 12px; cursor: pointer; transition: all 0.2s;}
    .editor-color { width: 30px; height: 28px; padding: 0; border: 1px solid #cbd5e1; border-radius: 6px; background: white; cursor: pointer; transition: all 0.2s;}
    .rich-editor-box { min-height: 160px; max-height: 300px; overflow-y: auto; background: white; border: 1px solid #cbd5e1; border-radius: 0 0 12px 12px; padding: 12px; outline: none; text-align: left; font-size: 14px; line-height: 1.6; transition: all 0.3s;}
    .rich-editor-box:focus { border-color: var(--primary-gold); box-shadow: 0 0 0 4px rgba(251, 188, 4, 0.15); }

    /* SYSTEM MODALS */
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 10000; display: none; justify-content: center; align-items: center; padding: 20px; opacity: 0; transition: opacity 0.3s ease; overflow-y: auto;}
    .modal-overlay.active { display: flex; opacity: 1; }
    .modal-box { background: #ffffff; border-radius: 24px; width: 100%; max-width: 750px; max-height: 90vh; overflow-y: auto; padding: 32px; box-shadow: 0 25px 50px rgba(0,0,0,0.3); transform: translateY(30px) scale(0.95); transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); margin: auto;}
    .modal-overlay.active .modal-box { transform: translateY(0) scale(1); }
    .modal-header { font-size: 22px; font-weight: 600; color: var(--primary-navy); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px; }
    .btn-close-modal { background: none; border: none; font-size: 28px; cursor: pointer; color: #94a3b8; line-height: 1; transition: transform 0.3s; }
    .btn-close-modal:hover { color: #ef4444; transform: rotate(90deg); }
    
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 14px; font-weight: 500; color: #475569; margin-bottom: 6px; }
    .form-control { width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 12px; font-family: 'Prompt'; font-size: 14px; outline: none; transition: all 0.3s; color: #334155; }
    .form-control:focus { border-color: var(--primary-gold); box-shadow: 0 0 0 4px rgba(251, 188, 4, 0.15); transform: translateY(-1px);}
    
    .dynamic-link-row { display: flex; gap: 6px; margin-bottom: 10px; align-items: center; background: #f8fafc; padding: 8px; border-radius: 12px; border: 1px solid #e2e8f0; transition: all 0.3s;}
    .dynamic-link-row:hover { border-color: #cbd5e1; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .btn-move-link { background: #e2e8f0; color: #334155; border: none; padding: 10px; border-radius: 8px; cursor: pointer; font-size: 12px; transition: all 0.2s;}
    .btn-move-link:hover { background: #cbd5e1; transform: scale(1.05);}
    .btn-del-link { background: #fee2e2; color: #ef4444; border: none; padding: 10px 14px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: all 0.2s;}
    .btn-del-link:hover { background: #fca5a5; transform: scale(1.05);}
    
    .btn-add-link-row { background: #f1f5f9; color: #475569; border: 1px dashed #cbd5e1; padding: 12px; border-radius: 12px; cursor: pointer; font-family: 'Prompt'; width: 100%; text-align: center; margin-bottom: 15px; font-weight: 500; transition: all 0.3s; }
    .btn-add-link-row:hover { background: #e2e8f0; border-color: #94a3b8; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.05);}
    
    .btn-submit-form { background: var(--primary-navy); color: white; width: 100%; padding: 16px; border: none; border-radius: 12px; font-family: 'Prompt'; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); box-shadow: 0 4px 15px rgba(15, 23, 42, 0.2); }
    .btn-submit-form:hover { background: #1e293b; transform: translateY(-4px) scale(1.01); box-shadow: 0 10px 25px rgba(15, 23, 42, 0.35); }

    /* FOOTER DESIGN ELEMENTS */
    .site-footer { background: rgba(15, 23, 42, 0.95); border-top: 1px solid rgba(255,255,255,0.1); color: #94a3b8; padding: 50px 20px 30px; font-size: 14px; line-height: 1.7; text-align: center; position: relative; }
    .site-footer::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, transparent, var(--primary-gold), transparent); }
    .footer-grid { display: grid; grid-template-columns: 1fr; gap: 30px; max-width: 1200px; margin: 0 auto; text-align: left; }
    .footer-col h3 { color: #ffffff; font-size: 16px; margin-bottom: 16px; font-weight: 500; }
    .footer-col p, .footer-col ul { list-style: none; }
    .footer-col li { margin-bottom: 10px; }
    .footer-col strong { color: #cbd5e1; font-weight: 500;}
    .site-footer a { color: var(--primary-gold); text-decoration: none; transition: opacity 0.3s ease; }
    .site-footer a:hover { opacity: 0.8; text-decoration: underline;}

