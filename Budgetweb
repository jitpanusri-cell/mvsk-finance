    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Sarabun', sans-serif; font-size: 16px; line-height: 1.65; color: var(--ink); background: #fff; }
    h1, h2, h3, h4, .hd { font-family: 'IBM Plex Sans Thai', 'Sarabun', sans-serif; line-height: 1.35; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; background: none; border: 0; color: inherit; }
    img { display: block; max-width: 100%; }
    .ic { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
