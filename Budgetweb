    /* แจ้งเตือน */
    #toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--navy-2); color: #fff; padding: 10px 18px; border-radius: 6px; font-size: 15px; display: none; z-index: 200; }

    @media (max-width: 1080px) {
