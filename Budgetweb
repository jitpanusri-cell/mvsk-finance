    // --- CRUD ---
    function openCreateModal() {
      document.getElementById('modalTitle').innerText = "สร้างประชาสัมพันธ์ใหม่";
      document.getElementById('formId').value = "";
      document.getElementById('announcementForm').reset();
      document.getElementById('formDetails').innerHTML = ""; 
      document.getElementById('linksContainer').innerHTML = "";
      document.getElementById('announcementModal').classList.add('active');
    }

    function openEditModal(id) {
      const item = globalAnnouncements.find(a => a.id === id);
      if (!item) return;

      document.getElementById('modalTitle').innerText = "✏️ แก้ไขข้อมูลประกาศประชาสัมพันธ์";
      document.getElementById('formId').value = item.id;
      document.getElementById('formTitle').value = item.title;
      document.getElementById('formType').value = item.type;
      document.getElementById('formDetails').innerHTML = item.details; 
      document.getElementById('formDate').value = item.date || "";
      document.getElementById('formCalendarHelper').value = "";
      document.getElementById('formImageUrl').value = item.imageUrl || "";
      
      const container = document.getElementById('linksContainer');
      container.innerHTML = "";
      if (item.links && item.links.length > 0) { item.links.forEach(lnk => addLinkRow(lnk.name, lnk.url)); }
      document.getElementById('announcementModal').classList.add('active');
    }

    function fireToggleHide(id, isCurrentlyHidden) {
      const title = isCurrentlyHidden ? "👁️ ยืนยันเปิดแสดงประกาศ" : "🙈 ยืนยันซ่อนประกาศ";
      const msg = isCurrentlyHidden ? "ต้องการเปิดแสดงประกาศนี้สู่สาธารณะบนหน้าเว็บไซต์ใช่หรือไม่?" : "ต้องการซ่อนประกาศนี้จากคนทั่วไปใช่หรือไม่? (การ์ดจะกลายเป็นสีเทาและถูกซ่อนจากหน้าเว็บ)";
      
      showConfirm(title, msg, isCurrentlyHidden ? "เปิดแสดง" : "ซ่อนประกาศ", isCurrentlyHidden ? "#10b981" : "#64748b", function() {
        google.script.run
          .withSuccessHandler(function(res) {
             showToast(res.message, res.success ? "success" : "error");
             loadAnnouncements();
          })
          .toggleVisibility(id, !isCurrentlyHidden, loggedInUserName);
      });
    }

    function fireDelete(id) {
      showConfirm(
        "🗑️ ยืนยันการลบประกาศ", 
        "คำเตือน: คุณยืนยันต้องการลบข้อความประกาศนี้ใช่หรือไม่? ข้อมูลจะถูกลบออกอย่างถาวรและไม่สามารถกู้คืนได้!", 
        "ลบข้อมูลถาวร", 
        "#ef4444", 
        function() {
          google.script.run.withSuccessHandler(function(res) { 
            showToast(res.message, res.success ? "success" : "error"); 
            loadAnnouncements(); 
          }).deleteAnnouncement(id, loggedInUserName);
        }
      );
    }

    // --- LINK ROWS ---
    function moveRowUp(btn) { const row = btn.closest('.dynamic-link-row'); if (row.previousElementSibling) row.parentNode.insertBefore(row, row.previousElementSibling); }
    function moveRowDown(btn) { const row = btn.closest('.dynamic-link-row'); if (row.nextElementSibling) row.parentNode.insertBefore(row.nextElementSibling, row); }
    
    function addLinkRow(name = "", url = "") {
      const container = document.getElementById('linksContainer');
      if (container.children.length >= 6) { showToast("เพิ่มปุ่มกดได้สูงสุด 6 ปุ่มครับ", "warning"); return; }
      const row = document.createElement('div'); row.className = 'dynamic-link-row';
      row.innerHTML = `
        <button type="button" class="btn-move-link" onclick="moveRowUp(this)" title="เลื่อนขึ้น">↑</button>
        <button type="button" class="btn-move-link" onclick="moveRowDown(this)" title="เลื่อนลง">↓</button>
        <input type="text" class="form-control lnk-name" placeholder="ชื่อปุ่มเอกสาร" value="${name}" required style="flex: 1;">
        <input type="url" class="form-control lnk-url" placeholder="https://ลิงก์ไฟล์หรือเอกสารดาวน์โหลด" value="${url}" required style="flex: 2;">
        <button type="button" class="btn-del-link" onclick="this.parentElement.remove()" title="ลบลิงก์นี้">✕</button>
      `;
      container.appendChild(row);
    }

    // --- SUBMIT FORM ---
    function submitForm(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('btnSubmitForm');
      submitBtn.innerText = "⏳ กำลังดำเนินการ..."; submitBtn.disabled = true;

      const fileInput = document.getElementById('formImageFile');
      if (fileInput.files.length > 0) {
        submitBtn.innerText = "📤 กำลังอัปโหลดภาพ...";
        const reader = new FileReader();
        reader.onload = function(event) {
          google.script.run
            .withSuccessHandler(function(uploadRes) {
              if (uploadRes.success) { document.getElementById('formImageUrl').value = uploadRes.url; executeFinalSave(); } 
              else { showToast(uploadRes.message, "error"); submitBtn.innerText = "💾 บันทึกข้อมูลและอัปโหลดขึ้นระบบ"; submitBtn.disabled = false; }
            })
            .withFailureHandler(function() { showToast("อัปโหลดภาพล้มเหลว", "error"); submitBtn.innerText = "💾 บันทึกข้อมูลและอัปโหลดขึ้นระบบ"; submitBtn.disabled = false; })
            .uploadImageToDrive(event.target.result, fileInput.files[0].name);
        };
        reader.readAsDataURL(fileInput.files[0]);
      } else { executeFinalSave(); }
    }

    function executeFinalSave() {
      const submitBtn = document.getElementById('btnSubmitForm');
      submitBtn.innerText = "💾 กำลังบันทึกลงฐานข้อมูล...";

      let linksArray = [];
      document.querySelectorAll('.dynamic-link-row').forEach(row => {
        const n = row.querySelector('.lnk-name').value;
        const u = row.querySelector('.lnk-url').value;
        if (n && u) linksArray.push({ name: n, url: u });
      });

      const payload = {
        id: document.getElementById('formId').value,
        title: document.getElementById('formTitle').value,
        type: document.getElementById('formType').value,
        details: document.getElementById('formDetails').innerHTML,
        date: document.getElementById('formDate').value,
        imageUrl: document.getElementById('formImageUrl').value,
        links: linksArray,
        adminName: loggedInUserName 
      };

      google.script.run
        .withSuccessHandler(function(res) {
          showToast(res.message, res.success ? "success" : "error");
          submitBtn.innerText = "💾 บันทึกข้อมูลและอัปโหลดขึ้นระบบ"; submitBtn.disabled = false;
          closeModal('announcementModal'); document.getElementById('formImageFile').value = ""; 
          loadAnnouncements();
        })
        .withFailureHandler(function(){
          submitBtn.innerText = "💾 บันทึกข้อมูลและอัปโหลดขึ้นระบบ"; submitBtn.disabled = false; 
          showToast("บันทึกข้อมูลล้มเหลว กรุณาลองใหม่", "error");
        })
        .saveAnnouncement(payload);
    }
  </script>
