  <div id="toast" role="status"></div>
  <span id="baseUrl" hidden><?= getScriptUrl(); ?></span>

  <script>
    var TYPES = {
      'alert': { label: 'ด่วนที่สุด', icon: 'alert' },
      'finance-alert': { label: 'งานการเงิน', icon: 'coins' },
      'supplies-alert': { label: 'งานพัสดุ', icon: 'box' },
      'general': { label: 'ข่าวทั่วไป', icon: 'megaphone' },
      'document': { label: 'เอกสาร/ดาวน์โหลด', icon: 'file' }
    };
    var PAGE = 9;
    var ST = { all: [], type: 'all', q: '', shown: PAGE, openId: '' };
    var BASE = (document.getElementById('baseUrl').textContent || '').trim();

    function $(id) { return document.getElementById(id); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function icon(n, cls) { return '<svg class="ic ' + (cls || '') + '"><use href="#i-' + n + '"/></svg>'; }
    function toast(msg) { var t = $('toast'); t.textContent = msg; t.style.display = 'block'; clearTimeout(t._h); t._h = setTimeout(function () { t.style.display = 'none'; }, 2600); }

    /* ล้างเนื้อหา HTML ให้ปลอดภัยก่อนแสดง */
    var OK_TAGS = 'B STRONG I EM U BR P DIV SPAN FONT UL OL LI A H1 H2 H3 H4 BLOCKQUOTE HR SMALL SUB SUP'.split(' ');
    function clean(html) {
      var doc = new DOMParser().parseFromString('<div>' + (html || '') + '</div>', 'text/html');
      var root = doc.body.firstChild;
      (function walk(el) {
        Array.prototype.slice.call(el.children).forEach(function (c) {
          if (OK_TAGS.indexOf(c.tagName) < 0) {
            if (/^(SCRIPT|STYLE|IFRAME|OBJECT|EMBED|FORM|INPUT|TEXTAREA|BUTTON)$/.test(c.tagName)) { c.remove(); return; }
            var span = doc.createElement('span'); while (c.firstChild) span.appendChild(c.firstChild); c.replaceWith(span); walk(span); return;
          }
          Array.prototype.slice.call(c.attributes).forEach(function (a) {
            var n = a.name.toLowerCase();
            if (n === 'href') { if (!/^(https?:|mailto:|tel:)/i.test(a.value.trim())) c.removeAttribute('href'); }
            else if (n === 'style') { var keep = (a.value.match(/(color|font-weight|font-size|text-align|font-family)\s*:[^;]+/gi) || []).join(';'); c.setAttribute('style', keep); }
            else if (!(c.tagName === 'FONT' && /^(color|size|face)$/.test(n))) c.removeAttribute(a.name);
          });
          if (c.tagName === 'A') { c.setAttribute('target', '_blank'); c.setAttribute('rel', 'noopener'); }
          walk(c);
        });
      })(root);
      return root.innerHTML;
    }
    function plain(html) { var d = document.createElement('div'); d.innerHTML = clean(html).replace(/<br\s*\/?>/gi, ' ').replace(/<\/(p|div|li)>/gi, ' '); return (d.textContent || '').replace(/\s+/g, ' ').trim(); }
    function isNew(a) { return a.createdAt && (Date.now() - a.createdAt) < 7 * 86400000; }

    function thumb(a) {
      if (a.imageUrl) return '<div class="thumb" style="background-image:url(\'' + esc(a.imageUrl).replace(/'/g, '%27') + '\')"></div>';
      return '<div class="thumb">' + icon((TYPES[a.type] || TYPES.general).icon) + '</div>';
    }
    function tags(a) {
      var t = TYPES[a.type] || TYPES.general;
      return (a.pinned ? '<span class="tag t-new">' + icon('pin', 'sm') + 'ปักหมุด</span>' : '') +
        '<span class="tag t-' + esc(a.type) + '">' + esc(t.label) + '</span>' +
        (isNew(a) && !a.pinned ? '<span class="tag t-new">ใหม่</span>' : '') +
        (a.date ? '<span class="d">' + icon('calendar', 'sm') + esc(a.date) + '</span>' : '');
    }

    function filtered() {
      var q = ST.q.toLowerCase();
      return ST.all.filter(function (a) {
        if (ST.type !== 'all' && a.type !== ST.type) return false;
        if (!q) return true;
        return (a.title + ' ' + a._text + ' ' + a.date + ' ' + a.links.map(function (l) { return l.name; }).join(' ')).toLowerCase().indexOf(q) >= 0;
      });
    }

    function renderChips() {
      var counts = { all: ST.all.length };
      ST.all.forEach(function (a) { counts[a.type] = (counts[a.type] || 0) + 1; });
      var keys = ['all'].concat(Object.keys(TYPES).filter(function (k) { return counts[k]; }));
      $('chips').innerHTML = keys.map(function (k) {
        return '<button class="chip' + (ST.type === k ? ' on' : '') + '" role="tab" aria-selected="' + (ST.type === k) + '" data-type="' + k + '">' +
          (k === 'all' ? 'ทั้งหมด' : esc(TYPES[k].label)) + '<span class="n">' + (counts[k] || 0) + '</span></button>';
      }).join('');
    }

    function render() {
      renderChips();
      var list = filtered();
      var pins = (ST.type === 'all' && !ST.q) ? list.filter(function (a) { return a.pinned; }) : [];
      var rest = list.filter(function (a) { return pins.indexOf(a) < 0; });

      $('pinned').innerHTML = pins.map(function (a) {
        return '<button class="pin-card" data-id="' + esc(a.id) + '">' + thumb(a) +
          '<div class="body"><div class="meta">' + tags(a) + '</div><h3>' + esc(a.title) + '</h3>' +
          '<div class="excerpt">' + esc(a._text) + '</div>' +
          '<div class="foot" style="border:0">' + (a.links.length ? '<span class="att">' + icon('download', 'sm') + 'เอกสารแนบ ' + a.links.length + ' รายการ</span>' : '<span></span>') +
          '<span class="more">อ่านต่อ ' + icon('arrow', 'sm') + '</span></div></div></button>';
      }).join('');

      if (!list.length) {
        $('grid').innerHTML = '<div class="empty" style="grid-column:1/-1">' + icon(ST.all.length ? 'search' : 'megaphone') + '<div>' +
          (ST.all.length ? 'ไม่พบข่าวที่ตรงกับเงื่อนไข' : 'ยังไม่มีข่าวประชาสัมพันธ์ในขณะนี้') + '</div></div>';
        $('moreWrap').hidden = true;
        return;
      }
      var page = rest.slice(0, ST.shown);
      $('grid').innerHTML = page.map(function (a) {
        return '<button class="news" data-id="' + esc(a.id) + '">' + thumb(a) + '<div class="body">' +
          '<div class="meta">' + tags(a) + '</div><h3>' + esc(a.title) + '</h3>' +
          (a._text ? '<div class="excerpt">' + esc(a._text) + '</div>' : '') +
          '<div class="foot">' + (a.links.length ? '<span class="att">' + icon('download', 'sm') + a.links.length + ' ไฟล์</span>' : '<span></span>') +
          '<span class="more">อ่านต่อ ' + icon('arrow', 'sm') + '</span></div></div></button>';
      }).join('');
      $('moreWrap').hidden = rest.length <= ST.shown;
      $('newsSub').textContent = 'ทั้งหมด ' + ST.all.length + ' รายการ' + (list.length !== ST.all.length ? ' · ตรงเงื่อนไข ' + list.length + ' รายการ' : '');
    }

    function openNews(id) {
      var a = ST.all.filter(function (x) { return x.id === id; })[0];
      if (!a) return;
      ST.openId = id;
      $('mMeta').innerHTML = tags(a);
      $('mTitle').textContent = a.title;
      $('mBody').innerHTML = (a.imageUrl ? '<img class="cover" src="' + esc(a.imageUrl) + '" alt="" onerror="this.remove()">' : '') +
        '<div class="content">' + (clean(a.details) || '<span style="color:#5d6b7e">ไม่มีรายละเอียดเพิ่มเติม</span>') + '</div>' +
        (a.links.length ? '<div class="att-list"><h4>เอกสารแนบ / ลิงก์ที่เกี่ยวข้อง</h4>' + a.links.map(function (l) {
          return '<a href="' + esc(/^(https?:|mailto:)/i.test(l.url) ? l.url : '#') + '" target="_blank" rel="noopener">' + icon('file') + '<span>' + esc(l.name) + '</span>' + icon('external', 'sm') + '</a>';
        }).join('') + '</div>' : '');
      $('modal').classList.add('on');
      document.body.style.overflow = 'hidden';
      $('modal').querySelector('.x').focus();
    }
    function closeNews() { $('modal').classList.remove('on'); document.body.style.overflow = ''; ST.openId = ''; }

    function copyText(txt) {
      try { if (navigator.clipboard) return navigator.clipboard.writeText(txt).then(function () { toast('คัดลอกลิงก์แล้ว'); }, function () { fallbackCopy(txt); }); } catch (e) { }
      fallbackCopy(txt);
    }
    function fallbackCopy(txt) {
      var ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); toast('คัดลอกลิงก์แล้ว'); } catch (e) { toast('คัดลอกไม่สำเร็จ'); }
      ta.remove();
    }

    function skeleton() {
      var s = '';
      for (var i = 0; i < 3; i++) s += '<div class="news" style="cursor:default"><div class="thumb sk"></div><div class="body"><div class="sk" style="height:14px;width:40%"></div><div class="sk" style="height:18px;width:90%"></div><div class="sk" style="height:14px;width:75%"></div></div></div>';
      $('grid').innerHTML = s;
    }

    function load() {
      skeleton();
      google.script.run
        .withSuccessHandler(function (data) {
          ST.all = (Array.isArray(data) ? data : []).map(function (a) { a.links = a.links || []; a._text = plain(a.details); return a; });
          render();
          if (google.script.url) google.script.url.getLocation(function (loc) {
            var id = loc && loc.parameter && loc.parameter.news;
            if (id) { openNews(id); setTimeout(function () { $('news').scrollIntoView(); }, 50); }
          });
        })
        .withFailureHandler(function () {
          $('grid').innerHTML = '<div class="empty" style="grid-column:1/-1">' + icon('alert') + '<div>โหลดข่าวไม่สำเร็จ</div><div style="margin-top:10px"><button class="btn" onclick="load()">' + icon('refresh', 'sm') + 'ลองอีกครั้ง</button></div></div>';
        })
        .getAnnouncements();
    }

    /* เหตุการณ์ */
    $('chips').addEventListener('click', function (e) { var b = e.target.closest('[data-type]'); if (!b) return; ST.type = b.dataset.type; ST.shown = PAGE; render(); });
    var qTimer;
    $('q').addEventListener('input', function () { clearTimeout(qTimer); var v = this.value; qTimer = setTimeout(function () { ST.q = v.trim(); ST.shown = PAGE; render(); }, 180); });
    $('moreBtn').addEventListener('click', function () { ST.shown += PAGE; render(); });
    document.addEventListener('click', function (e) {
      var card = e.target.closest('[data-id]'); if (card) { openNews(card.dataset.id); return; }
      if (e.target.closest('[data-close]') || e.target === $('modal')) closeNews();
      var sc = e.target.closest('[data-scroll]'); if (sc) { e.preventDefault(); $(sc.dataset.scroll).scrollIntoView({ behavior: 'smooth' }); $('nav').classList.remove('open'); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && $('modal').classList.contains('on')) closeNews(); });
    $('mCopy').addEventListener('click', function () { copyText(BASE + '?news=' + encodeURIComponent(ST.openId)); });
    $('menuBtn').addEventListener('click', function () { var o = $('nav').classList.toggle('open'); this.setAttribute('aria-expanded', String(o)); });

    load();
  </script>
