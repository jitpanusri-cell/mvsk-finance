      google.script.run
        .withSuccessHandler(renderAnnouncements)
        .withFailureHandler(function(err){
          document.getElementById('announcementBlock').innerHTML = '<div style="grid-column: 1 / -1; text-align:center;color:#ef4444;padding:20px;">เกิดข้อผิดพลาดเชื่อมต่อฐานข้อมูล กรุณารีเฟรชใหม่อีกครั้ง</div>';
          showToast("ไม่สามารถเชื่อมต่อฐานข้อมูลได้", "error");
        })
        .getAnnouncements();
    }

    function renderAnnouncements(data) {
      if (Array.isArray(data)) { globalAnnouncements = data; }
      
      const block = document.getElementById('announcementBlock');
      block.innerHTML = '';

      let displayData = globalAnnouncements;
      if (!isAdminActive) {
        displayData = globalAnnouncements.filter(item => !item.isHidden);
      }

      if (!displayData || displayData.length === 0) {
        block.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; color:rgba(255,255,255,0.7); padding:40px; border:1px dashed rgba(255,255,255,0.2); border-radius:16px;">ขณะนี้ยังไม่มีข้อมูลประกาศประชาสัมพันธ์บนบอร์ดหน้าหลัก</div>';
        return;
      }

      displayData.forEach((item, index) => {
        let linksHtml = '';
        if (item.links && item.links.length > 0) {
          linksHtml = '<div class="button-group-container">';
          item.links.forEach(lnk => { linksHtml += `<a href="${lnk.url}" class="download-btn" target="_blank">📄 ${lnk.name}</a>`; });
          linksHtml += '</div>';
        }

        let imgHtml = item.imageUrl ? `<img src="${item.imageUrl}" class="alert-embedded-img" alt="ข่าวสาร" onerror="this.style.display='none'">` : '';
        
        let badgeHtml = '';
        if (item.type === 'finance-alert') { badgeHtml = `<span class="badge finance">ด่วนงานการเงิน</span>`; } 
        else if (item.type === 'supplies-alert') { badgeHtml = `<span class="badge supplies">งานพัสดุและสินทรัพย์</span>`; } 
        else { badgeHtml = `<span class="badge urgent">ด่วนที่สุด</span>`; }
        
        let dateHtml = item.date ? `<div class="card-date-tag">🗓️ ${item.date}</div>` : '';
        
        // ซ่อนชื่อผู้แก้ไขในโหมดปกติ และแสดงเฉพาะโหมดแอดมิน
        let adminFooterHtml = `<div class="card-admin-footer" style="display: ${isAdminActive ? 'block' : 'none'};">✏️ อัปเดตล่าสุดโดย: ${item.adminName || 'ไม่ระบุ'}</div>`;

        let card = document.createElement('div');
        card.style.animationDelay = `${index * 0.1}s`;
        
        card.className = `alert-card ${item.type} ${isAdminActive ? 'draggable-mode' : ''} ${item.isHidden ? 'hidden-card' : ''}`;
        if (isAdminActive) card.setAttribute('draggable', 'true');
        card.setAttribute('data-id', item.id);
        
        let hiddenTag = item.isHidden && isAdminActive ? `<span style="color:#ef4444; font-size:12px; font-weight:bold;">[ถูกซ่อนจากสาธารณะ]</span>` : '';

        card.innerHTML = `
          <div class="card-header-area">
            <div class="badge-group">
              <span class="drag-handle-icon" title="ลากเพื่อสลับตำแหน่ง">⠿</span>
              ${badgeHtml}
            </div>
            ${dateHtml}
          </div>
          <h3 class="card-title-text">${hiddenTag} ${item.title}</h3>
          ${imgHtml}
          <div class="card-desc">${item.details}</div>
          ${linksHtml}
          ${adminFooterHtml}
          <div class="card-admin-actions" style="display: ${isAdminActive ? 'flex' : 'none'}">
            <button class="btn-hide-card" onclick="fireToggleHide('${item.id}', ${item.isHidden})">${item.isHidden ? '👁️ ยกเลิกซ่อน' : 'ซ่อนประกาศ'}</button>
            <button class="btn-edit-card" onclick="openEditModal('${item.id}')">✏️ แก้ไข</button>
            <button class="btn-delete-card" onclick="fireDelete('${item.id}')">🗑️ ลบ</button>
          </div>
        `;

        if (isAdminActive) {
          card.addEventListener('dragstart', handleDragStart);
          card.addEventListener('dragover', handleDragOver);
          card.addEventListener('dragenter', handleDragEnter);
          card.addEventListener('dragleave', handleDragLeave);
          card.addEventListener('drop', handleDrop);
          card.addEventListener('dragend', handleDragEnd);
        }

        block.appendChild(card);
        scrollObserver.observe(card); // แจกจ่ายแอนิเมชันตอนเลื่อนจอ
      });
    }

    // --- HTML5 DRAG AND DROP ---
    function handleDragStart(e) { dragSrcEl = this; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', this.getAttribute('data-id')); this.classList.add('dragging'); }
    function handleDragOver(e) { if (e.preventDefault) { e.preventDefault(); } e.dataTransfer.dropEffect = 'move'; return false; }
    function handleDragEnter(e) { if (dragSrcEl !== this) { this.classList.add('drag-over'); } }
    function handleDragLeave(e) { this.classList.remove('drag-over'); }
    function handleDrop(e) {
      if (e.stopPropagation) { e.stopPropagation(); }
      if (dragSrcEl !== this) {
        const draggedId = dragSrcEl.getAttribute('data-id');
        const targetId = this.getAttribute('data-id');
        const draggedIndex = globalAnnouncements.findIndex(a => a.id === draggedId);
        const targetIndex = globalAnnouncements.findIndex(a => a.id === targetId);
        if (draggedIndex !== -1 && targetIndex !== -1) {
          const [movedItem] = globalAnnouncements.splice(draggedIndex, 1);
          globalAnnouncements.splice(targetIndex, 0, movedItem);
          renderAnnouncements(globalAnnouncements);
          document.getElementById('btnSaveOrder').style.display = 'block';
        }
      }
      return false;
    }
    function handleDragEnd(e) {
      document.querySelectorAll('.alert-card').forEach(card => {
        card.classList.remove('drag-over');
        card.classList.remove('dragging');
      });
    }

    function saveNewOrder() {
      const btn = document.getElementById('btnSaveOrder');
      btn.innerText = "⏳ กำลังบันทึก..."; btn.disabled = true;
      const newOrderIds = globalAnnouncements.map(a => a.id);
      google.script.run
        .withSuccessHandler(function(res) {
          btn.innerText = "💾 บันทึกการเรียงลำดับ"; btn.disabled = false; btn.style.display = 'none'; 
          showToast("บันทึกการจัดเรียงตำแหน่งใหม่เรียบร้อยแล้ว", "success");
        })
        .withFailureHandler(function() { 
          btn.innerText = "💾 บันทึกการเรียงลำดับ"; btn.disabled = false; 
          showToast("ไม่สามารถบันทึกลำดับได้", "error"); 
        })
        .updateAnnouncementOrder(newOrderIds, loggedInUserName); 
    }

    // --- UTILS ---
    function execEditorCmd(command, value = null) { document.execCommand(command, false, value); document.getElementById('formDetails').focus(); }
    function setLightWeightText() {
      const selection = window.getSelection();
      if (!selection.rangeCount) return;
      const range = selection.getRangeAt(0);
      const span = document.createElement('span');
      span.style.fontWeight = '300';
      span.appendChild(range.extractContents());
      range.insertNode(span);
    }
    function convertAndSyncThaiDate(dateValue) {
      if (!dateValue) return;
      const parts = dateValue.split('-');
      const monthsTH = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
      document.getElementById('formDate').value = `วันที่ ${parseInt(parts[2], 10)} ${monthsTH[parseInt(parts[1], 10) - 1]} พ.ศ. ${parseInt(parts[0], 10) + 543}`;
    }

    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    // --- ADMIN LOGIC ---
