  return withLock_(() => {
    const sh = pwFinSheet_(ss, kind), row = pwFind_(sh, id);
    if (!row) throw new Error('ไม่พบรายการนี้');
    sh.deleteRow(row);
    return true;
  });
}
function pwFlagFin(id, hidden, kind) {
  pwUser_();
  const ss = pwSs_();
  pwBump_(ss);
  return withLock_(() => {
    const sh = pwFinSheet_(ss, kind), row = pwFind_(sh, id);
    if (!row) throw new Error('ไม่พบรายการนี้');
