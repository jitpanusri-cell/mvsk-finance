function pwUpload(dataUrl, fileName) {
  pwUser_();
  const parts = String(dataUrl).split(',');
  const type = (parts[0].match(/:(.*?);/) || [])[1] || '';
  if (type.indexOf('image') !== 0) throw new Error('รองรับเฉพาะไฟล์รูปภาพ');
  const blob = Utilities.newBlob(Utilities.base64Decode(parts[1]), type, fileName || 'image.jpg');
  let folder;
  try { folder = DriveApp.getFolderById(PW_IMG_FOLDER); } catch (e) { folder = DriveApp.getRootFolder(); }
  const f = folder.createFile(blob);
  f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return { url: 'https://drive.google.com/thumbnail?id=' + f.getId() + '&sz=w2000' };
}
