function pwReorder_(sh, ids, width, reverse) {
  const n = sh.getLastRow() - 1;
  if (n < 2) return;
  width = Math.max(width, sh.getLastColumn());
  const rows = sh.getRange(2, 1, n, width).getValues();
  const pos = {};
  (reverse ? ids.slice().reverse() : ids).forEach((id, i) => { pos[pwStr_(id)] = i; });
  const big = reverse ? -1 : 1e9;
  rows.sort((a, b) => (pos.hasOwnProperty(pwStr_(a[0])) ? pos[pwStr_(a[0])] : big) - (pos.hasOwnProperty(pwStr_(b[0])) ? pos[pwStr_(b[0])] : big));
  sh.getRange(2, 1, n, width).setValues(rows);
}
