function getPwData() {
  const u = pwUser_();
  const id = pwStr_(getSetting_('prSheetId'));
  const out = { linked: !!id, canAdmin: u.role === 'admin', today: todayIso_(), items: [], slides: [], sheetUrl: '', sheetName: '', webUrl: '' };
  if (!id) return out;
  const ss = pwSs_();
  pwSetConf_(ss, 'staffUrl', ScriptApp.getService().getUrl() || '');
  out.sheetUrl = ss.getUrl();
  out.sheetName = ss.getName();
  out.webUrl = pwStr_(getSetting_('prWebUrl'));
  out.items = pwReadNews_(pwNewsSheet_(ss));
  out.slides = pwReadSlides_(pwSlideSheet_(ss));
  out.fin = pwReadFin_(pwFinSheet_(ss));
  out.sup = pwReadFin_(pwFinSheet_(ss, 'sup'));
  out.pay = pwReadFin_(pwFinSheet_(ss, 'pay'));
  return out;
}

function pwSetSetting_(key, label, value) {
  withLock_(() => {
