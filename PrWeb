}
function setPwSheet(urlOrId, webUrl) {
  const u = pwUser_();
  if (u.role !== 'admin') throw new Error('เฉพาะผู้ดูแลระบบ');
  const s = pwStr_(urlOrId);
  const m = s.match(/\/d\/([a-zA-Z0-9_-]{20,})/);
  const id = m ? m[1] : s;
  if (id) {
    let ss;
    try { ss = SpreadsheetApp.openById(id); } catch (e) { throw new Error('เปิดชีตไม่ได้ ตรวจลิงก์และสิทธิ์แก้ไข'); }
    pwNewsSheet_(ss); pwSlideSheet_(ss); pwFinSheet_(ss); pwFinSheet_(ss, 'sup'); pwFinSheet_(ss, 'pay');
  }
  pwSetSetting_('prSheetId', 'ชีตเว็บไซต์กลุ่มบริหารงานงบประมาณ (ID)', id);
  pwSetSetting_('prWebUrl', 'ลิงก์เว็บไซต์กลุ่มบริหารงานงบประมาณ', pwStr_(webUrl));
  audit_('update', 'Settings', 'prSheetId', { value: id });
  return getPwData();
}

function pwSaveNews(o) {
  const u = pwUser_();
  o = o || {};
  const title = pwStr_(o.title);
  if (!title) throw new Error('กรุณากรอกหัวข้อ');
  const links = (o.links || []).filter(l => l && pwStr_(l.url) && pwStr_(l.name)).slice(0, 6);
  const flat = [];
  for (let i = 0; i < 6; i++) flat.push(links[i] ? pwStr_(links[i].url) : '', links[i] ? pwStr_(links[i].name) : '');
  const type = PW_TYPES.indexOf(o.type) >= 0 ? o.type : 'general';
  const ss = pwSs_();
  pwBump_(ss);
  return withLock_(() => {
    const sh = pwNewsSheet_(ss);
    const body = [pwStr_(o.date), title, String(o.details || ''), pwStr_(o.imageUrl), type, JSON.stringify(links)].concat(flat)
      .concat([u.name, o.isHidden ? 'HIDDEN' : 'VISIBLE', o.pinned ? 'PIN' : '', pwYmd_(o.expire), pwNow_()]);
    const row = o.id ? pwFind_(sh, o.id) : 0;
    let id = o.id;
    if (row) sh.getRange(row, 2, 1, body.length).setValues([body]);
    else { id = 'ANN-' + Date.now(); sh.appendRow([id].concat(body)); }
    audit_(row ? 'update' : 'create', 'WebNews', id, { title: title });
    return { id: id };
  });
}

