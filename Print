/** ข้อมูลหน้าศูนย์รวมพิมพ์เอกสาร */
function getPrintCatalog() {
  requirePage_('print');
  return { catalog: PRINT_CATALOG, folderLinked: !!getSettingsMap_().driveFolderId };
}

/**
 * บันทึกสำเนา PDF ของเอกสารที่พิมพ์ล่าสุด ลงโฟลเดอร์ "เอกสารที่พิมพ์" ใต้ Settings.driveFolderId
 * (ถ้ายังไม่ได้ตั้งค่าโฟลเดอร์ จะเก็บไว้ที่ไดรฟ์ของบัญชีที่ Deploy เว็บแอปแทน)
 * ไม่จำกัดสิทธิ์ตามเมนู "print" เพราะทุกคนที่มีปุ่มพิมพ์อยู่แล้วควรบันทึกสำเนาของตัวเองได้
 */
function savePrintPdf(title, page, base64Pdf) {
  const u = currentUser_();
  if (!u.role) throw new Error('ไม่มีสิทธิ์ใช้งาน');
  if (!base64Pdf) throw new Error('ไม่มีข้อมูล PDF ส่งมา');
  return withLock_(() => {
    const s = getSettingsMap_();
    const bytes = Utilities.base64Decode(base64Pdf);
    const safe = String(title || 'เอกสาร').replace(/[\\\/:*?"<>|]/g, '-').trim().slice(0, 120) || 'เอกสาร';
    const stamp = Utilities.formatDate(new Date(), 'GMT+7', 'yyyyMMdd-HHmmss');
    const blob = Utilities.newBlob(bytes, 'application/pdf', safe + ' ' + stamp + '.pdf');
    let file, folderUrl = '';
    if (s.driveFolderId) {
      let root;
      try { root = DriveApp.getFolderById(String(s.driveFolderId).trim()); }
      catch (e) { throw new Error('ไม่พบโฟลเดอร์ Drive ตาม ID ที่ตั้งค่าไว้ — ตรวจสอบ "ID โฟลเดอร์ Drive เก็บเอกสาร" ในหน้าตั้งค่า'); }
      const it = root.getFoldersByName('เอกสารที่พิมพ์');
      const sub = it.hasNext() ? it.next() : root.createFolder('เอกสารที่พิมพ์');
      file = sub.createFile(blob);
      folderUrl = sub.getUrl();
    } else {
      file = DriveApp.createFile(blob);
    }
    file.setDescription('พิมพ์โดย ' + u.email + (page ? ' · หน้า ' + page : ''));
    const rec = { id: newId_('PL'), title: safe, page: String(page || ''), fileUrl: file.getUrl(),
      createdBy: u.email, createdAt: new Date() };
    appendObject_('PrintLog', rec);
    audit_('print', 'PrintLog', rec.id, { title: safe, page: page });
    return { fileUrl: file.getUrl(), folderUrl: folderUrl, hasFolder: !!s.driveFolderId };
  });
}

/** ประวัติการพิมพ์ / บันทึก PDF ล่าสุด ของทุกเมนูรวมกัน */
function getPrintHistory(limit) {
  requirePage_('print');
  const rows = readObjects_('PrintLog').sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  return rows.slice(0, Number(limit) || 30).map(r => ({
    id: r.id, title: r.title, page: r.page, fileUrl: r.fileUrl, createdBy: r.createdBy, createdAt: r.createdAt
  }));
}
