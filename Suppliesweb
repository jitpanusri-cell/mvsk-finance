    .pg a { color: inherit; text-decoration: none; }
    .pg section { padding: 72px 0; scroll-margin-top: 90px; }
    .sh { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
    .sh h2 { font-size: 34px; font-weight: 600; color: var(--navy); position: relative; padding-bottom: 10px; }
