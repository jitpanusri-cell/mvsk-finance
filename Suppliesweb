    .dt { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; background: #eef1f7; color: var(--navy); font-family: 'IBM Plex Sans Thai'; font-weight: 600; font-size: 14px; padding: 6px 14px 6px 12px; border-radius: 99px; margin-bottom: 14px; transition: background .3s, color .3s; }
    .dt .ic { width: 17px; height: 17px; }
    .nc:hover .dt { background: var(--navy); color: #fff; }
    .ngrid .tt { font-size: 18px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ngrid .ex { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .nc:hover .rm { color: var(--gold); }
    .nc:hover .rm .ic { transform: translateX(6px); }

    /* ป๊อปอัพอ่านข่าว */
    .modal { position: fixed; inset: 0; z-index: 10001; background: rgba(11, 26, 51, .6); display: none; justify-content: center; align-items: flex-start; padding: 48px 16px; overflow-y: auto; opacity: 0; transition: opacity .25s; }
