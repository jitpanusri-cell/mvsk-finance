    .mx { position: fixed; top: 16px; right: 20px; width: 44px; height: 44px; border: 0; cursor: pointer; border-radius: 50%; background: #fff; display: grid; place-items: center; color: var(--navy); z-index: 10002; }
    @media (max-width: 640px) { .modal { padding: 0; } .sheet { border-radius: 0; } .sheet .bd { padding: 20px 18px 28px; } .sheet h2 { font-size: 22px; } }

    /* คู่มือ / หลักเกณฑ์ (การ์ดแบบเดียวกับข่าว) */
