    .sheet .dl { margin-top: 24px; border-top: 1px solid var(--line); }
    .sheet .dl a { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--navy); font-weight: 500; text-decoration: none; }
