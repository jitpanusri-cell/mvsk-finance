    .sheet { background: #fff; width: 100%; max-width: 860px; border-radius: 22px; overflow: hidden; transform: translateY(16px); transition: transform .3s var(--ease); font-family: 'Sarabun', sans-serif; color: var(--ink); line-height: 1.65; }
