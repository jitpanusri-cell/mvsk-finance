}

/* ---------- ฟอร์มแบ่งส่วนเป็นสี (สัญญายืม / ส่งคืน / เบิก) ---------- */
.dc-sec{border:1px solid var(--line);border-left:6px solid var(--pri);border-radius:14px;padding:14px 16px 16px;margin-bottom:14px;background:#fff}
