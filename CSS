  .recvdoc table.rc2 td.num{text-align:right} .recvdoc table.rc2 td.ct{text-align:center}
  .recvdoc table.rc2 tr.tot td{font-weight:700}
  .recvdoc .rsig2{margin-top:10mm;text-align:right;line-height:1.6}
}
