  .nav-group{color:#A9B6E8}
  .page-head h1{background:linear-gradient(90deg,#1F3A8F,#7C4DDB 60%,#D6407A);-webkit-background-clip:text;background-clip:text;color:transparent;padding-bottom:2px}
  .page-head{position:relative;padding-bottom:12px}
  .page-head::after{content:"";position:absolute;left:0;bottom:0;width:120px;height:4px;border-radius:4px;background:linear-gradient(90deg,var(--c-blue),var(--c-purple),var(--c-pink),var(--c-orange))}
  .btnx.pri{background:linear-gradient(135deg,#2F6FEB,#6A4FE0);border-color:transparent;box-shadow:0 3px 10px rgba(63,90,230,.25)}
  .btnx.pri:hover{filter:brightness(1.07)}
  .btnx.sec{border-color:#C9D6F5;color:#2447A8}
  .cardx{border-color:#E3E8F3;box-shadow:0 2px 10px rgba(30,50,110,.05)}
  .card-h h3{display:flex;align-items:center;gap:10px}
  .card-h h3::before{content:"";width:6px;height:20px;border-radius:3px;background:linear-gradient(180deg,var(--c-blue),var(--c-purple));flex:none}
  .mb-grid:nth-of-type(3n+2) .card-h h3::before{background:linear-gradient(180deg,var(--c-green),var(--c-teal))}
  .mb-grid:nth-of-type(3n+3) .card-h h3::before{background:linear-gradient(180deg,var(--c-orange),var(--c-pink))}
