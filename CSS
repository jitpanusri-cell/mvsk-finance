/* ฟอนต์แบบฟอร์มชุดใหม่ (mv): ปรับขนาดให้ 15px บนจอ = TH Sarabun 16pt ตอนพิมพ์ (จัดหน้าเป็นพิกเซลตรงกับภาพออกแบบ) */
@font-face{font-family:'THSarabunMV';font-weight:400;size-adjust:142.2%;src:local('TH SarabunPSK'),local('THSarabunPSK'),local('TH Sarabun New'),local('THSarabunNew')}
@font-face{font-family:'THSarabunMV';font-weight:700;size-adjust:142.2%;src:local('TH SarabunPSK Bold'),local('THSarabunPSK-Bold'),local('TH Sarabun New Bold'),local('THSarabunNew-Bold')}
@font-face{font-family:'THSarabunMVW';font-weight:400;size-adjust:98.1%;src:url('https://cdn.jsdelivr.net/npm/font-th-sarabun-new@1.0.0/fonts/THSarabunNew-webfont.woff') format('woff')}
@font-face{font-family:'THSarabunMVW';font-weight:700;size-adjust:98.1%;src:url('https://cdn.jsdelivr.net/npm/font-th-sarabun-new@1.0.0/fonts/THSarabunNew_bold-webfont.woff') format('woff')}
