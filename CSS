  .print-doc .tbl td{padding:1pt 5pt;border:.75pt solid #000}
  .print-doc .tbl tr.tot td{border-top:.75pt solid #000;font-family:inherit}
  .print-doc .warnbox{border:.75pt solid #000;background:#fff;color:#000;border-radius:0;padding:2pt 6pt;font-size:16pt}
  .print-doc .small-x,.print-doc .mt-2,.print-doc .mt-3{font-size:16pt}
  .print-doc .table-responsive{overflow:visible}
  .print-doc .tbl{font-size:14pt;width:100%;margin-top:6pt}
  .print-doc .tbl th,.print-doc .tbl td{font-size:14pt;white-space:nowrap;border:.75pt solid #000;padding:2.5pt 4pt}
  .print-doc .tbl.disb th:first-child,.print-doc .tbl.disb td:first-child{white-space:nowrap}
  .print-doc .tbl tr.tot td{font-weight:700}

  /* ---- เอกสารหมายเลข 2 แบบหลักฐานยืนยันการจัดหา (ตามต้นฉบับ: TH Sarabun 16, A4 ขอบบน 19 ซ้าย-ขวา 10 มม.) ---- */
  .f2doc{font-size:13.7pt;line-height:7.3mm}
  .f2doc .docno{text-align:right;font-weight:700;margin:0 1mm 3.3mm 0}
  .f2doc .ttl{text-align:center;font-weight:700}
  .f2doc .ttl + .ttl{margin-bottom:4.9mm}
  .f2doc .hd{font-weight:700;margin-top:1mm}
  .f2doc .docno,.f2doc .ttl,.f2doc .hd,.f2doc table.f2 th,.f2doc table.f2 tr.tot td{-webkit-text-stroke:.25pt #000}
  .f2doc table.f2 td{-webkit-text-stroke:.1pt #000}
  .f2doc .sigs{-webkit-text-stroke:.1pt #000}
  .f2doc .frow{display:flex;flex-wrap:nowrap;white-space:nowrap;margin:0}
  .f2doc .frow > span{flex:none}
  .f2doc .frow.fund .c1{width:31%} .f2doc .frow.fund .c2{width:38%} .f2doc .frow.fund .c3{width:31%}
  .f2doc .frow.lvl .c0{width:16.6%} .f2doc .frow.lvl .c1{width:26.4%} .f2doc .frow.lvl .c2{width:57%}
  .f2doc .cb{display:inline-block;width:2.9mm;height:2.9mm;border:1pt solid #000;margin-right:1.5mm;position:relative;top:.3mm;-webkit-text-stroke:0}
  .f2doc .cb.on::after{content:'';position:absolute;left:.85mm;top:0;width:.85mm;height:1.8mm;border:solid #000;border-width:0 1.2pt 1.2pt 0;transform:rotate(45deg)}
  .f2doc .para{margin:0;white-space:nowrap;letter-spacing:-.05pt}
  .f2doc table.f2{table-layout:fixed;width:100%;margin-top:5.2mm;border-collapse:collapse;font-size:13.7pt}
  .f2doc table.f2 th{font-weight:700;line-height:7.1mm;padding:0 .3mm;white-space:nowrap;letter-spacing:-.1pt;text-align:center;vertical-align:middle;border:.75pt solid #000}
  .f2doc table.f2 td{height:7.45mm;padding:0 1.2mm;white-space:nowrap;overflow:hidden;border:.75pt solid #000;vertical-align:middle;line-height:1.1}
  .f2doc table.f2 td.ct,.f2doc table.f2 td.num{text-align:center}
  .f2doc table.f2 td.sm{font-size:12.6pt}
  .f2doc table.f2 tr.tot td{font-weight:700;text-align:center}
  .f2doc table.f2.cont{margin-top:0}
  .f2doc .pbreak{break-after:page;height:0}
  .f2doc .sigs{margin-top:10.8mm;text-align:center;line-height:7.3mm;break-inside:avoid;white-space:nowrap}
  .f2doc .sigs .s + .s{margin-top:9.7mm}

  /* ---- บันทึกข้อความ (ระเบียบงานสารบรรณ: ครุฑ 1.5 ซม., "บันทึกข้อความ" 29 pt, หัวข้อ 20 pt, เนื้อหา 16 pt) ---- */
  .memo{font-size:16pt;line-height:1.35}
  .memo .mhead{position:relative;height:17mm;margin-bottom:2mm}
  .memo .garuda{position:absolute;left:0;top:0;width:15mm;height:15mm;object-fit:contain}
  .memo .mtitle{text-align:center;font-size:29pt;font-weight:700;line-height:17mm}
  .memo .mline{display:flex;align-items:baseline;gap:2mm;margin-bottom:.8mm}
  .memo .mline.two{gap:0} .memo .mline.two>span{display:flex;align-items:baseline;gap:2mm;flex:1}
  .memo .mline.two>span:first-child{flex:0 0 52%}
  .memo .lb{font-size:20pt;font-weight:700;white-space:nowrap}
  .memo .fillline{flex:1;border-bottom:.8pt dotted #000;padding-left:1mm;line-height:1.1}
  .memo .mto{margin:4mm 0 2mm}
  .memo .ind{text-indent:25mm;margin:0 0 1.5mm;text-align:left}
  .memo table.mt{width:92%;margin:2mm 0 3mm 8%;border-collapse:collapse;font-size:15pt}
  .memo table.mt th,.memo table.mt td{border:.75pt solid #000;padding:.5mm 2mm;line-height:1.2}
