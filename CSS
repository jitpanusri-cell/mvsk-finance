table.dc-it tfoot .dc-it-total{color:#A5500C;font-size:16px}
.dc-chk .dc-chk-it{padding:8px 0;border-top:1px dashed rgba(0,0,0,.08)}
.dc-chk .dc-chk-it:first-of-type{border-top:0}
.dc-chk label{display:flex;gap:8px;align-items:flex-start;cursor:pointer;line-height:1.45}
.dc-chk input[type=checkbox]{width:18px;height:18px;margin-top:2px;flex:none;accent-color:var(--c-green)}
.dc-chk-sub{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:4px 14px;margin:6px 0 0 30px;font-size:13.5px;color:var(--ink2)}
