  --c-green:#15935B; --c-green-bg:#E6F6EE; --c-orange:#E0751B; --c-orange-bg:#FFF1E4;
  --c-pink:#D6407A; --c-pink-bg:#FDEBF2; --c-teal:#0E9AA7; --c-teal-bg:#E3F6F7;
}
@media screen{
  body{background:linear-gradient(180deg,#F4F7FD 0,#F7F4EE 420px) fixed}
  .sidebar{background:linear-gradient(185deg,#1B2D6B 0%,#20306E 35%,#3A2A78 75%,#4B2472 100%)}
  .brand-logo{background:linear-gradient(135deg,#FFC94D,#FF8A3D);color:#1B2D6B}
