  .report .keep{break-inside:avoid}
  .report .rsig{display:flex;justify-content:space-around;margin-top:9mm;text-align:center;line-height:1.45;break-inside:avoid}

  /* ---- แบบ 8708 ส่วนที่ 1/2 และใบขวางนักเรียน (A4 แนวตั้ง/แนวนอน) ---- */
  .f8708{font-size:15pt;line-height:1.3}
  .f8708 .fhead{text-align:center;font-weight:700;margin-bottom:2mm}
