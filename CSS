  .memo table.mt.rf th:first-child{width:9mm} .memo table.mt.rf th:nth-child(3){width:34mm} .memo table.mt.rf th:nth-child(4){width:42mm}
  .memo table.mt.rf tr.grp td{border-bottom:none;padding-top:1mm}
  .memo .msig{margin:8mm 0 0 45%;text-align:center;line-height:1.45}
  .memo .msig.in{margin-top:6mm}
  .memo .mcomment{margin-top:7mm;line-height:1.5;break-inside:avoid}
  .memo .cb2{display:inline-block;width:3.5mm;height:3.5mm;border:.9pt solid #000;vertical-align:-.3mm}

  /* ---- รายงานการจัดสรรงบประมาณ (A4 แนวนอน) ---- */
  .report{font-size:15pt;line-height:1.3}
  .report .rhead{text-align:center;font-weight:700;font-size:17pt;margin-bottom:3mm}
  .report .rtitle{text-align:center;font-weight:700;margin:4mm 0 1.5mm}
  .report .rnote{font-weight:400;font-size:14pt}
  .report table.rt{width:100%;border-collapse:collapse;font-size:13.5pt;break-inside:avoid;margin:0}
  .report table.rt th{border:.75pt solid #000;font-weight:700;padding:.6mm 1.2mm;line-height:1.15;text-align:center;vertical-align:middle}
