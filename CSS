/* ---------- เอกสารพิมพ์ราชการ ----------
 * ฟอนต์ TH Sarabun (ใช้ฟอนต์ในเครื่องก่อน: TH SarabunPSK / TH Sarabun New / TH SarabunIT๙
 * ถ้าไม่มี โหลด TH Sarabun New จาก jsDelivr) ขนาด 16 pt ตามระเบียบงานสารบรรณ */
/* 1) ฟอนต์ในเครื่อง (TH SarabunPSK / TH Sarabun New / TH SarabunIT๙) ขนาดจริง */
@font-face{font-family:'THSarabunLocal';font-weight:400;src:local('TH SarabunPSK'),local('THSarabunPSK'),local('TH Sarabun New'),local('THSarabunNew'),local('TH SarabunIT๙')}
@font-face{font-family:'THSarabunLocal';font-weight:700;src:local('TH SarabunPSK Bold'),local('THSarabunPSK-Bold'),local('TH Sarabun New Bold'),local('THSarabunNew-Bold'),local('TH SarabunIT๙ Bold')}
/* 2) ถ้าเครื่องไม่มี ใช้ TH Sarabun New จาก jsDelivr — ไฟล์นี้ตัวอักษรกว้างกว่าของจริง จึงปรับขนาด 69% ให้เท่าฟอนต์จริง */
@font-face{font-family:'THSarabunWeb';font-weight:400;size-adjust:69%;src:url('https://cdn.jsdelivr.net/npm/font-th-sarabun-new@1.0.0/fonts/THSarabunNew-webfont.woff') format('woff')}
@font-face{font-family:'THSarabunWeb';font-weight:700;size-adjust:69%;src:url('https://cdn.jsdelivr.net/npm/font-th-sarabun-new@1.0.0/fonts/THSarabunNew_bold-webfont.woff') format('woff')}
.print-doc,.print-doc *{font-family:'THSarabunLocal','THSarabunWeb',sans-serif}
@media print{
  body.doc-mode .main,body.doc-mode .sidebar,body.doc-mode .modal,body.doc-mode .modal-backdrop{display:none!important}
