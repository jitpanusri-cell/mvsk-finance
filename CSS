@media print{
  .print-doc .mvs{break-after:page;break-inside:avoid;margin:0}
  .print-doc .mvs:last-child{break-after:auto}
  .print-doc .mvv{background:none!important}
  /* แบบฟอร์มเดิม (.gf) ที่พิมพ์ร่วมชุด mv (ขอบกระดาษ 0) — ใส่ขอบในตัวแผ่นแทน */
  .print-doc.mv .sheet.gf,.print-doc.mvl .sheet.gf{box-sizing:border-box;width:210mm;padding:15mm 15mm 12mm 25mm}
