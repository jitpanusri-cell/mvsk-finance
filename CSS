.dc-save-gh{font-weight:700;color:#0E6E43;font-size:13.5px;margin:8px 0 4px}
.dc-save-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:6px}
.dc-save-it{display:flex;justify-content:space-between;gap:8px;align-items:center;text-align:left;border:1px solid #D5EDE0;background:#fff;border-radius:10px;padding:7px 10px;font:inherit;font-size:13.5px;cursor:pointer}
