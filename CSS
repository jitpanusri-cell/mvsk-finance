  .tbl th:first-child{border-top-left-radius:8px} .tbl th:last-child{border-top-right-radius:8px}
  .grid-kpi .kpi{position:relative;overflow:hidden;border-top:4px solid var(--c-blue)}
  .grid-kpi .kpi:nth-child(4n+2){border-top-color:var(--c-green)}
  .grid-kpi .kpi:nth-child(4n+3){border-top-color:var(--c-orange)}
  .grid-kpi .kpi:nth-child(4n+4){border-top-color:var(--c-pink)}
  .grid-kpi .kpi:not(.dark):not(.alert) .l svg.i{color:var(--c-blue)}
  .grid-kpi .kpi:nth-child(4n+2):not(.dark):not(.alert) .l svg.i{color:var(--c-green)}
  .grid-kpi .kpi:nth-child(4n+3):not(.dark):not(.alert) .l svg.i{color:var(--c-orange)}
  .grid-kpi .kpi:nth-child(4n+4):not(.dark):not(.alert) .l svg.i{color:var(--c-pink)}
  .kpi.dark{background:linear-gradient(135deg,#1F3A8F,#5B3FC4);border-color:transparent}
  .kpi.cream{background:linear-gradient(135deg,#FFF8E6,#FFEFD6)}
  .seg button.on{color:#2447A8}
  .dc-tabs [data-tab].on{background:linear-gradient(135deg,#2F6FEB,#6A4FE0)!important;color:#fff!important;border-color:transparent!important}
  .dc-step .n{background:linear-gradient(135deg,var(--c-blue),var(--c-purple))}
