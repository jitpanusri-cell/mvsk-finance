  .print-doc .sheet{break-after:page}
  .print-doc .sheet:last-child{break-after:auto}
  .print-doc h2{font-size:18pt;text-align:center;margin:0 0 2pt;font-weight:700}
  .print-doc .c{text-align:center}
  .print-doc p{margin:0}
  .print-doc b{font-weight:700}
  .print-doc table{width:100%;border-collapse:collapse;margin-top:6pt;font-size:16pt}
  .print-doc th,.print-doc td{border:.75pt solid #000;padding:1pt 5pt;line-height:1.15;vertical-align:middle}
  .print-doc th{font-weight:700;text-align:center;background:none}
  .print-doc td.r,.print-doc td.num,.print-doc th.num{text-align:right}
  .print-doc td.ct{text-align:center}
  .print-doc tr{break-inside:avoid}
  .print-doc .sig{display:flex;justify-content:space-between;margin-top:18pt;text-align:center;line-height:1.4}
