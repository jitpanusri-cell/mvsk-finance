  if (foot && foot.length) b.footer = { type: 'box', layout: 'vertical', spacing: 'sm', paddingStart: '20px', paddingEnd: '20px', paddingBottom: '20px', paddingTop: '0px', contents: foot };
  return b;
}
function incFlex_(alt, contents, quick) {
