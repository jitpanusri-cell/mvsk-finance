/*******************************************************************
 * Incoming.gs — หนังสือเข้า (ทะเบียนหนังสือรับ) + รับไฟล์ PDF ผ่าน LINE OA
 * ----------------------------------------------------------------
 * ทางเข้า 2 ทาง
 *   1) LINE OA : ส่งไฟล์ PDF เข้าแชต OA → doPost (webhook) บันทึกไฟล์ลงโฟลเดอร์ "หนังสือเข้า"
 *      ออกเลขรับอัตโนมัติ แล้วตอบกลับเลขรับ · พิมพ์ข้อความตามหลังภายใน 15 นาที = ใช้เป็น "เรื่อง"
 *   2) หน้าเว็บ : เมนู "หนังสือเข้า" อัปโหลด PDF เอง / แก้รายละเอียด / พิมพ์ทะเบียนรับ
 * ชีต IncomingDocs (สร้างเองครั้งแรก) · เลขรับนับใหม่ทุกปีปฏิทิน (พ.ศ.) เช่น 12/2569
 *
 * ตั้งค่า (Script Properties — ตั้งจากหน้าเว็บ ปุ่ม "ตั้งค่า LINE" ได้)
 *   LINE_TOKEN          Channel access token (long-lived) ของ LINE OA
 *   LINE_HOOK_KEY       รหัสต่อท้าย webhook URL (?k=...) กันคนอื่นยิงเข้ามา
 *   LINE_ALLOWED_USERS  userId ที่อนุญาตให้ส่งหนังสือ คั่นด้วยจุลภาค (ว่าง = ทุกคนที่แอด OA)
 * โฟลเดอร์ปลายทาง: Settings คีย์ incomingFolderId (ว่าง = INC_FOLDER_DEFAULT)
 *
 * การ deploy webhook: Deploy > New deployment > Web app
 *   Execute as: Me · Who has access: Anyone  (เป็น deployment แยกจากหน้าเว็บเดิม)
 *   Webhook URL ใน LINE Developers = ลิงก์ /exec ของ deployment นี้ + ?k=<LINE_HOOK_KEY>
 * รัน incomingSetupCheck() ใน editor 1 ครั้งเพื่ออนุญาตสิทธิ์ Drive/UrlFetch
 *******************************************************************/

const INC_SHEET = 'IncomingDocs';
const INC_HEAD = ['id', 'recvYear', 'recvSeq', 'recvDate', 'recvAt', 'docNo', 'docDate', 'fromOrg', 'toWhom', 'subject',
  'action', 'status', 'fileId', 'fileName', 'fileUrl', 'source', 'lineUser', 'senderName', 'lineMsgId', 'note',
  'createdBy', 'updatedAt'];
const INC_TEXT = ['recvAt', 'docNo', 'lineUser', 'lineMsgId'];
const INC_FOLDER_DEFAULT = '1znhpmmLuuPF8sxm4mPpttWQ36chc2drB';
const INC_VIEW_ROLES = ['admin', 'finance', 'exec', 'account'];
const INC_EDIT_ROLES = ['admin', 'finance'];
const INC_STATUS = ['ใหม่', 'กำลังดำเนินการ', 'เสร็จสิ้น'];
const INC_SUBJECT_WINDOW_MS = 15 * 60 * 1000;

function incEnsure_() {
  if (_findSheet_(INC_SHEET)) return;
  const sh = ss_().insertSheet(INC_SHEET);
  sh.getRange(1, 1, 1, INC_HEAD.length).setValues([INC_HEAD])
    .setFontWeight('bold').setBackground('#16263D').setFontColor('#FFFFFF');
  sh.setFrozenRows(1);
}
function incCell_(o) {
  const out = Object.assign({}, o);
  INC_TEXT.forEach(k => { if (out[k] !== undefined && out[k] !== '') out[k] = "'" + String(out[k]).replace(/^'/, ''); });
  return out;
}
function incProps_() { return PropertiesService.getScriptProperties(); }
function incFolder_() { return DriveApp.getFolderById(String(getSetting_('incomingFolderId') || INC_FOLDER_DEFAULT).trim()); }
function incNowParts_() {
  const tz = Session.getScriptTimeZone(), d = new Date();
  return { date: Utilities.formatDate(d, tz, 'yyyy-MM-dd'), at: Utilities.formatDate(d, tz, "yyyy-MM-dd'T'HH:mm"), yearBE: Number(Utilities.formatDate(d, tz, 'yyyy')) + 543 };
}
function incSafeName_(s) { return String(s || 'หนังสือ.pdf').replace(/[\\\/:*?"<>|\r\n]+/g, ' ').trim().slice(0, 150) || 'หนังสือ.pdf'; }

/** บันทึกไฟล์ + ออกเลขรับ (เรียกภายใน withLock_) */
function incCreate_(blob, meta) {
  incEnsure_();
  const now = incNowParts_();
  const rows = readObjects_(INC_SHEET);
  const seq = rows.filter(r => Number(r.recvYear) === now.yearBE).reduce((m, r) => Math.max(m, Number(r.recvSeq) || 0), 0) + 1;
  let name = incSafeName_(meta.fileName);
  if (!/\.pdf$/i.test(name)) name += '.pdf';
  const file = incFolder_().createFile(blob.setName(seq + '-' + now.yearBE + ' ' + name));
  const o = {
    id: newId_('IN'), recvYear: now.yearBE, recvSeq: seq, recvDate: now.date, recvAt: now.at,
    docNo: meta.docNo || '', docDate: meta.docDate || '', fromOrg: meta.fromOrg || '', toWhom: meta.toWhom || 'ผู้อำนวยการโรงเรียน',
    subject: meta.subject || '', action: meta.action || '', status: 'ใหม่',
    fileId: file.getId(), fileName: name, fileUrl: file.getUrl(), source: meta.source || 'web',
    lineUser: meta.lineUser || '', senderName: meta.senderName || '', lineMsgId: meta.lineMsgId || '',
    note: meta.note || '', createdBy: meta.createdBy || '', updatedAt: new Date()
  };
  appendObject_(INC_SHEET, incCell_(o));
  return o;
}

/* ================================================================
 * LINE webhook — ข้อความแบบการ์ด (Flex) + ริชเมนู + คำสั่งพิมพ์
 * ----------------------------------------------------------------
 * คำสั่งในแชต (ใช้กับ "ฉบับปัจจุบัน" = ฉบับล่าสุดที่ส่ง/เลือก หรือใส่ #เลขรับ นำหน้า)
 *   เรื่อง ...        มอบ ... / มอบหมาย ... / ปฏิบัติ ...      จาก ...      ที่ ...      หมายเหตุ ...
 *   เสร็จ  (สถานะเสร็จสิ้น)   ล่าสุด   วันนี้   เมนู   #12 (เลือกเลขรับ 12)   #12 มอบ งานการเงิน
 * ริชเมนู: รัน incomingSetupRichMenu() ใน editor 1 ครั้ง (ใช้รูป INC_RICHMENU_IMG ในโฟลเดอร์หนังสือเข้า)
 * ================================================================ */
const INC_RICHMENU_IMG = '1-TfLusxvp4_oKs47x4znQth90MvAmUZe';
const INC_WEB_URL = 'https://script.google.com/macros/s/AKfycbyojreXlCAXWGrAfQ2_BvBtHkADxBgesrznJDBJXLnEq1X29niDhPRYGHSnWIoAsmnbSQ/exec';
const INC_C = { navy: '#1F3A5F', ink: '#1B2433', sub: '#6B7385', line: '#E6E9F0', soft: '#F4F6FB', red: '#D0452F', green: '#12A150', gold: '#C99A3E' };
const INC_ST_COLOR = { 'ใหม่': '#E08A00', 'กำลังดำเนินการ': '#2F5BD3', 'เสร็จสิ้น': '#12A150' };
const INC_FIELD = { subject: 'เรื่อง', action: 'การปฏิบัติ / มอบหมาย', fromOrg: 'จาก', docNo: 'ที่ (เลขที่หนังสือ)', note: 'หมายเหตุ', toWhom: 'ถึง' };
const INC_FIELD_SHORT = { subject: 'เรื่อง', action: 'การปฏิบัติ', fromOrg: 'หน่วยงานที่ส่ง', docNo: 'เลขที่หนังสือ', note: 'หมายเหตุ', toWhom: 'ผู้รับ', status: 'สถานะ' };
const INC_ACTION_PRESET = ['เสนอผู้อำนวยการ', 'เพื่อทราบ', 'มอบงานการเงิน', 'แจ้งครูทุกคน', 'มอบรองฯ งบประมาณ'];
const INC_TH_MON = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];

function doPost(e) {
  const out = ContentService.createTextOutput(JSON.stringify({ ok: true })).setMimeType(ContentService.MimeType.JSON);
  try {
    const P = incProps_();
    const key = P.getProperty('LINE_HOOK_KEY') || '';
    const keyOk = !key || String((e && e.parameter && e.parameter.k) || '') === key;
    const body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    const evs = body.events || [];
    console.log('LINE webhook keyOk=' + keyOk + ' events=' +
      evs.map(ev => ev.type + ':' + (ev.message ? ev.message.type : (ev.postback ? ev.postback.data : ''))).join(', '));
    if (!keyOk) return out;
    evs.forEach(ev => {
      try { incHandleEvent_(ev); } catch (err) {
        console.error('incoming event', err && err.stack || err);
        try { incSend_(ev.replyToken, [incErrMsg_('ทำรายการไม่สำเร็จ', String(err && err.message || err))]); } catch (e2) { }
      }
    });
  } catch (err) { console.error('doPost', err); }
  return out;
}

function incHandleEvent_(ev) {
  const P = incProps_(), token = P.getProperty('LINE_TOKEN');
  if (!token) { console.warn('ยังไม่ได้ตั้ง LINE_TOKEN'); return; }
  const uid = (ev.source && ev.source.userId) || '';
  const allowed = String(P.getProperty('LINE_ALLOWED_USERS') || '').split(/[,\s]+/).filter(String);
  const ctx = { uid: uid, token: token, rt: ev.replyToken, all: allowed.length > 0 };
  if (ev.type === 'follow') return incSend_(ctx.rt, [incHelpMsg_(true)]);
  if (ev.type !== 'message' && ev.type !== 'postback') return;
  if (allowed.length && allowed.indexOf(uid) < 0) {
    return incSend_(ctx.rt, [incErrMsg_('ยังไม่ได้รับสิทธิ์', 'แจ้งรหัสนี้ให้ผู้ดูแลระบบเพื่อเปิดสิทธิ์ส่งหนังสือ\n' + uid)]);
  }
  incEnsure_();
  if (ev.type === 'postback') return incPostback_(ctx, String(ev.postback.data || ''));
  const m = ev.message;
  if (m.type === 'file') return incReceive_(ctx, m);
  if (m.type === 'text') return incText_(ctx, String(m.text || '').trim());
  if (m.type === 'image') return incSend_(ctx.rt, [incErrMsg_('รับเฉพาะไฟล์ PDF', 'สแกนหนังสือเป็น PDF แล้วแนบเป็น "ไฟล์" ในแชตนี้')]);
}

/* ---------- รับไฟล์ ---------- */
function incReceive_(ctx, m) {
  if (!/\.pdf$/i.test(m.fileName || '')) return incSend_(ctx.rt, [incErrMsg_('รับเฉพาะไฟล์ PDF', 'ไฟล์ "' + (m.fileName || '') + '" ไม่ใช่ PDF')]);
  const row = withLock_(() => {
    const dup = readObjects_(INC_SHEET).find(r => String(r.lineMsgId) === String(m.id));
    if (dup) return dup;
    const blob = UrlFetchApp.fetch('https://api-data.line.me/v2/bot/message/' + m.id + '/content',
      { headers: { Authorization: 'Bearer ' + ctx.token } }).getBlob().setContentType('application/pdf');
    return incCreate_(blob, { fileName: m.fileName, source: 'line', lineUser: ctx.uid, senderName: incLineName_(ctx.uid, ctx.token), lineMsgId: m.id, createdBy: 'LINE' });
  });
  const r = incRow_(row);
  incState_(ctx.uid, { cur: r.id, field: r.subject ? '' : 'subject', auto: 1, at: Date.now() });
  incSend_(ctx.rt, [incFlex_('รับหนังสือแล้ว เลขรับ ' + incNo_(r), incDocBubble_(r, 'new'), incQuick_(r))]);
}

/* ---------- ข้อความพิมพ์ ---------- */
function incText_(ctx, t) {
  if (!t) return;
  if (/^(เมนู|วิธีใช้|ช่วยเหลือ|help|\?)$/i.test(t)) return incSend_(ctx.rt, [incHelpMsg_()]);
  if (/^(ล่าสุด|รายการ|ดูรายการ)$/.test(t)) return incSend_(ctx.rt, [incLatestMsg_(ctx)]);
  if (/^(วันนี้|สรุป|สรุปวันนี้)$/.test(t)) return incSend_(ctx.rt, [incTodayMsg_(ctx)]);
  if (/^(ส่งหนังสือ)$/.test(t)) return incSend_(ctx.rt, [incSendGuideMsg_()]);
  const st = incState_(ctx.uid);
  if (/^ยกเลิก$/.test(t)) {
    incState_(ctx.uid, { cur: st.cur || '', field: '', at: Date.now() });
    return incSend_(ctx.rt, [incFlex_('ยกเลิกแล้ว', incNoticeBubble_('ยกเลิกแล้ว', 'ไม่มีการเปลี่ยนแปลงข้อมูล', '#5B6678', '#8A93A3'))]);
  }
  if (st.field && !st.auto && st.cur && !/^#/.test(t)) {
    const pr0 = incById_(ctx, st.cur);
    if (pr0) return incSaveSend_(ctx, pr0, st.field, t);
  }
  let target = null, rest = t;
  const mm = t.match(/^#\s*(\d+)\s*/);
  if (mm) {
    target = incBySeq_(ctx, Number(mm[1]));
    if (!target) return incSend_(ctx.rt, [incErrMsg_('ไม่พบเลขรับ ' + mm[1], 'ไม่มีหนังสือเลขนี้ในปีปัจจุบัน หรือไม่ใช่ฉบับที่ท่านส่ง')]);
    rest = t.slice(mm[0].length).trim();
    if (!rest) { incState_(ctx.uid, { cur: target.id, field: '', at: Date.now() }); return incSend_(ctx.rt, [incFlex_('เลขรับ ' + incNo_(target), incDocBubble_(target, 'view'), incQuick_(target))]); }
  }
  const doc = () => target || incById_(ctx, st.cur) || incMine_(ctx)[0];
  if (/^(เสร็จ|เสร็จสิ้น|เสร็จแล้ว|กำลังดำเนินการ|ดำเนินการ)$/.test(rest)) {
    const r = doc(); if (!r) return incSend_(ctx.rt, [incErrMsg_('ยังไม่มีหนังสือ', 'ส่งไฟล์ PDF เข้ามาก่อน')]);
    return incSaveSend_(ctx, r, 'status', /^เสร็จ/.test(rest) ? 'เสร็จสิ้น' : 'กำลังดำเนินการ');
  }
  const cmd = rest.match(/^(เรื่อง|การปฏิบัติ|ปฏิบัติ|มอบหมาย|มอบ|จาก|หมายเหตุ|ถึง|เลขที่\s|ที่\s)\s*[:：]?\s*([\s\S]+)$/);
  if (cmd) {
    const k = cmd[1].trim(), v = cmd[2].trim();
    const field = k === 'เรื่อง' ? 'subject' : (k === 'จาก' ? 'fromOrg' : (k === 'หมายเหตุ' ? 'note' : (k === 'ถึง' ? 'toWhom' :
      (k === 'ที่' || k === 'เลขที่' ? 'docNo' : 'action'))));
    const val = k === 'มอบหมาย' && !/^มอบ/.test(v) ? 'มอบหมาย ' + v : (k === 'มอบ' && !/^มอบ/.test(v) ? 'มอบ' + v : v);
    const r = doc(); if (!r) return incSend_(ctx.rt, [incErrMsg_('ยังไม่มีหนังสือ', 'ส่งไฟล์ PDF เข้ามาก่อน แล้วค่อยพิมพ์คำสั่ง')]);
    return incSaveSend_(ctx, r, field, val);
  }
  const pend = st.field && !(st.auto && Date.now() - (st.at || 0) > INC_SUBJECT_WINDOW_MS);
  const pr = pend ? (target || incById_(ctx, st.cur)) : null;
  if (pr) return incSaveSend_(ctx, pr, st.field, rest);
  return incSend_(ctx.rt, [incHelpMsg_(false, 'ไม่พบคำสั่ง "' + t.slice(0, 30) + '"')]);
}

/* ---------- ปุ่ม (postback) ---------- */
function incPostback_(ctx, data) {
  const q = {};
  data.split('&').forEach(p => { const i = p.indexOf('='); if (i > 0) q[p.slice(0, i)] = decodeURIComponent(p.slice(i + 1)); });
  const st = incState_(ctx.uid);
  const cur = () => incById_(ctx, q.id || st.cur) || incMine_(ctx)[0];
  if (q.a === 'help') return incSend_(ctx.rt, [incHelpMsg_()]);
  if (q.a === 'latest') return incSend_(ctx.rt, [incLatestMsg_(ctx)]);
  if (q.a === 'today') return incSend_(ctx.rt, [incTodayMsg_(ctx)]);
  if (q.a === 'send') return incSend_(ctx.rt, [incSendGuideMsg_()]);
  const r = cur();
  if (!r) return incSend_(ctx.rt, [incErrMsg_('ยังไม่มีหนังสือ', 'ส่งไฟล์ PDF เข้ามาในแชตนี้ ระบบจะออกเลขรับให้ทันที')]);
  if (q.a === 'pick') {
    incState_(ctx.uid, { cur: r.id, field: '', at: Date.now() });
    return incSend_(ctx.rt, [incFlex_('เลขรับ ' + incNo_(r), incDocBubble_(r, 'view'), incQuick_(r))]);
  }
  if (q.a === 'set' && INC_FIELD[q.f]) {
    incState_(ctx.uid, { cur: r.id, field: q.f, at: Date.now() });
    return incSend_(ctx.rt, [incFlex_('พิมพ์' + INC_FIELD[q.f], incPromptBubble_(r, q.f), incPromptQuick_(q.f))]);
  }
  if (q.a === 'st' && INC_STATUS[Number(q.s)]) return incSaveSend_(ctx, r, 'status', INC_STATUS[Number(q.s)]);
}

/* ---------- ข้อมูล ---------- */
function incState_(uid, v) {
  const c = CacheService.getScriptCache(), k = 'incst_' + uid;
  if (v === undefined) { try { return JSON.parse(c.get(k) || '{}'); } catch (e) { return {}; } }
  if (v === null) c.remove(k); else c.put(k, JSON.stringify(v), 21600);
}
function incRow_(r) {
  return {
    id: r.id, recvYear: Number(r.recvYear), recvSeq: Number(r.recvSeq), recvDate: r.recvDate, recvAt: String(r.recvAt || ''),
    docNo: String(r.docNo || ''), fromOrg: String(r.fromOrg || ''), toWhom: String(r.toWhom || ''), subject: String(r.subject || ''),
    action: String(r.action || ''), status: String(r.status || 'ใหม่'), fileName: String(r.fileName || ''), fileUrl: String(r.fileUrl || ''),
    lineUser: String(r.lineUser || ''), senderName: String(r.senderName || ''), note: String(r.note || '')
  };
}
function incMine_(ctx) {
  return readObjects_(INC_SHEET).map(incRow_).filter(r => ctx.all || r.lineUser === ctx.uid)
    .sort((a, b) => (b.recvYear - a.recvYear) || (b.recvSeq - a.recvSeq));
}
function incById_(ctx, id) { return id ? incMine_(ctx).find(r => r.id === id) || null : null; }
function incBySeq_(ctx, seq) {
  const y = incNowParts_().yearBE;
  return incMine_(ctx).find(r => r.recvYear === y && r.recvSeq === seq) || null;
}
function incSaveSend_(ctx, r, field, value) {
  const upd = { updatedAt: new Date() };
  upd[field] = String(value).slice(0, 500);
  if (field === 'action' && r.status === 'ใหม่') upd.status = 'กำลังดำเนินการ';
  withLock_(() => updateObject_(INC_SHEET, r.id, incCell_(upd)));
  audit_('update', INC_SHEET, r.id, { via: 'LINE', user: ctx.uid, field: field, value: upd[field] });
  incState_(ctx.uid, { cur: r.id, field: '', at: Date.now() });
  const nr = incById_(ctx, r.id) || Object.assign({}, r, upd);
  const label = INC_FIELD_SHORT[field] || field;
  incSend_(ctx.rt, [incFlex_('บันทึก' + label + ' เลขรับ ' + incNo_(nr), incDocBubble_(nr, 'saved', label), incQuick_(nr))]);
}

/* ---------- ส่งข้อความ ---------- */
function incSend_(replyToken, messages) {
  const token = incProps_().getProperty('LINE_TOKEN');
  if (!token || !replyToken) return;
  const res = UrlFetchApp.fetch('https://api.line.me/v2/bot/message/reply', {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + token },
    payload: JSON.stringify({ replyToken: replyToken, messages: messages })
  });
  if (res.getResponseCode() !== 200) console.error('LINE reply ' + res.getResponseCode() + ' ' + res.getContentText());
}
function incReply_(replyToken, text) { incSend_(replyToken, [{ type: 'text', text: text }]); }
function incLineName_(uid, token) {
  try {
    const r = UrlFetchApp.fetch('https://api.line.me/v2/bot/profile/' + uid, { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true });
    return r.getResponseCode() === 200 ? JSON.parse(r.getContentText()).displayName || '' : '';
  } catch (e) { return ''; }
}

/* ---------- ชิ้นส่วนการ์ด ---------- */
function incNo_(r) { return r.recvSeq + '/' + r.recvYear; }
function incThDate_(r) {
  const p = String(r.recvDate || '').split('-').map(Number);
  const tm = String(r.recvAt || '').match(/(\d{1,2}):(\d{2})/);
  if (!p[0]) return '-';
  return p[2] + ' ' + INC_TH_MON[p[1] - 1] + ' ' + String(p[0] + 543).slice(-2) + (tm ? '  ' + ('0' + tm[1]).slice(-2) + ':' + tm[2] + ' น.' : '');
}
function fxT_(t, o) { return Object.assign({ type: 'text', text: (t === null || t === undefined || t === '') ? '-' : String(t), wrap: true }, o || {}); }
function fxRow_(label, value, o) {
  return { type: 'box', layout: 'horizontal', spacing: 'lg', contents: [
    fxT_(label, { size: 'sm', color: INC_C.sub, flex: 3 }),
    fxT_(value, Object.assign({ size: 'sm', color: INC_C.ink, flex: 7, align: 'end' }, o || {}))] };
}
function fxPost_(label, data, disp) { return { type: 'postback', label: label, data: data, displayText: disp || label }; }
function fxBtn_(action, color, style) { return { type: 'button', style: style || 'primary', color: style === 'secondary' ? '#E9EDF5' : (color || INC_C.navy), height: 'sm', action: action }; }
function fxSep_() { return { type: 'separator', color: INC_C.line, margin: 'lg' }; }
function fxHead_(kicker, title, c1, c2, mark) {
  const titleRow = [fxT_(title, { color: '#FFFFFF', weight: 'bold', size: 'xl', flex: 1, gravity: 'center' })];
  if (mark) titleRow.unshift({ type: 'box', layout: 'vertical', width: '38px', height: '38px', cornerRadius: '19px', backgroundColor: '#FFFFFF33',
    justifyContent: 'center', alignItems: 'center', flex: 0, contents: [fxT_(mark, { color: '#FFFFFF', weight: 'bold', size: 'lg', align: 'center', wrap: false })] });
  return { type: 'box', layout: 'vertical', paddingAll: '20px', spacing: 'md',
    background: { type: 'linearGradient', angle: '120deg', startColor: c1, endColor: c2 },
    contents: [
      { type: 'box', layout: 'horizontal', contents: [
        fxT_(kicker, { size: 'xs', color: '#FFFFFFD9', weight: 'bold', flex: 1, wrap: false }),
        fxT_('MVSK FINANCE', { size: 'xxs', color: '#FFFFFFA6', align: 'end', flex: 0, wrap: false })] },
      { type: 'box', layout: 'horizontal', spacing: 'md', alignItems: 'center', contents: titleRow }] };
}
function fxPill_(text, color) {
  return { type: 'box', layout: 'vertical', flex: 0, cornerRadius: '12px', paddingStart: '10px', paddingEnd: '10px', paddingTop: '3px', paddingBottom: '3px',
    backgroundColor: color + '22', contents: [fxT_(text, { size: 'xs', color: color, weight: 'bold', wrap: false })] };
}
function fxBubble_(head, body, foot, size) {
  const b = { type: 'bubble', size: size || 'mega', header: head,
