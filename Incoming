/* ---------- ริชเมนู (รันใน editor 1 ครั้ง) ---------- */
function incomingSetupRichMenu() {
  const P = incProps_(), token = P.getProperty('LINE_TOKEN');
  if (!token) throw new Error('ยังไม่ได้ใส่ LINE_TOKEN');
  const H = { Authorization: 'Bearer ' + token };
  const W = 1200, HH = 405, cw = W / 3, ch = HH / 2;
  const acts = [
    fxPost_('ส่งหนังสือ', 'a=send', 'ส่งหนังสือ'), fxPost_('ล่าสุด', 'a=latest', 'ล่าสุด'), fxPost_('สรุปวันนี้', 'a=today', 'สรุปวันนี้'),
    fxPost_('ใส่เรื่อง', 'a=set&f=subject', 'ใส่เรื่อง'), fxPost_('มอบหมาย', 'a=set&f=action', 'การปฏิบัติ / มอบหมาย'),
    { type: 'uri', label: 'เปิดระบบ', uri: INC_WEB_URL + '?openExternalBrowser=1' }];
  const areas = acts.map((a, i) => ({ bounds: { x: Math.round((i % 3) * cw), y: Math.round(Math.floor(i / 3) * ch), width: Math.round(cw), height: Math.round(ch) }, action: a }));
  const mk = UrlFetchApp.fetch('https://api.line.me/v2/bot/richmenu', { method: 'post', contentType: 'application/json', headers: H, muteHttpExceptions: true,
    payload: JSON.stringify({ size: { width: W, height: HH }, selected: true, name: 'MVSK หนังสือเข้า', chatBarText: 'เมนูหนังสือเข้า', areas: areas }) });
  if (mk.getResponseCode() !== 200) throw new Error('สร้างริชเมนูไม่ได้: ' + mk.getContentText());
  const id = JSON.parse(mk.getContentText()).richMenuId;
  const img = DriveApp.getFileById(INC_RICHMENU_IMG).getBlob();
  const up = UrlFetchApp.fetch('https://api-data.line.me/v2/bot/richmenu/' + id + '/content', { method: 'post', contentType: 'image/png', headers: H, payload: img.getBytes(), muteHttpExceptions: true });
  if (up.getResponseCode() !== 200) throw new Error('อัปโหลดรูปริชเมนูไม่ได้: ' + up.getContentText());
  const df = UrlFetchApp.fetch('https://api.line.me/v2/bot/user/all/richmenu/' + id, { method: 'post', headers: H, muteHttpExceptions: true });
  if (df.getResponseCode() !== 200) throw new Error('ตั้งเป็นเมนูหลักไม่ได้: ' + df.getContentText());
  const old = P.getProperty('LINE_RICHMENU_ID');
  if (old && old !== id) UrlFetchApp.fetch('https://api.line.me/v2/bot/richmenu/' + old, { method: 'delete', headers: H, muteHttpExceptions: true });
  P.setProperty('LINE_RICHMENU_ID', id);
  Logger.log('ตั้งริชเมนูแล้ว ✓ ' + id);
}

