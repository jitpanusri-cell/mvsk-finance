      return { id: it.id, name: it.name, amount: round2_(num_(it.amount)), date: b ? b.date : '', loanDueDate: it.loanDueDate,
        daysLeft: it.loanDueDate ? Math.ceil((isoToDate_(it.loanDueDate) - isoToDate_(todayIso_())) / 86400000) : null };
    }).filter(x => !fy || (x.date && fyOf_(x.date) === fy));
}

function addDays_(iso, n) {
  const d = isoToDate_(iso); d.setDate(d.getDate() + n);
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

/**
 * ข้อมูลแจ้งโอนทั้งเดือน สำหรับส่งออก Excel (ym = 'YYYY-MM', ไม่จำกัดปีงบ)
 * → { ym, school, days: [{ date, fy, arriveOther, rows: [{ bankAccount, fundSourceName, fundCat, budgetType, expenseCat, itemName, name, groupNames, amount, note }] }] }
 */
function getKtbMonthExport(ym) {
  requirePage_('ktb');
  ym = /^\d{4}-\d{2}$/.test(String(ym || '')) ? String(ym) : todayIso_().slice(0, 7);
  const school = getSettingsMap_();
  const batches = readObjects_('KTB_Batches').filter(b => String(b.date || '').slice(0, 7) === ym);
  const items = readObjects_('KTB_Items');
  const acts = readObjects_('Activities');
  const actName = id => { const a = acts.find(x => x.id === id); return a ? ((a.code ? a.code + ' ' : '') + a.name) : ''; };
  const balCache = {};
  const balOf = (fy, id) => { const L = balCache[fy] || (balCache[fy] = ktbBal25Options_(fy)); return L.find(x => String(x.id) === String(id)) || {}; };
  const byDate = {};
  batches.forEach(b => {
    const fy = Number(b.fy), bal = balOf(fy, b.fundSource);
    items.filter(it => it.batchId === b.id).sort((a, c) => num_(a.no) - num_(c.no)).forEach(it => {
      const cat = String(it.expenseCat || ''), custom = String(it.customName || '');
      const tail = it.activityId ? actName(it.activityId) : (custom || String(it.note || ''));
      const d = byDate[b.date] || (byDate[b.date] = { date: b.date, fy: fy, rows: [] });
      d.rows.push({
        bankAccount: String(b.bankAccount || ''), fundSourceName: bal.name || '', fundCat: Number(bal.category) || 0,
        budgetType: String(it.budgetType || ''), expenseCat: cat, itemName: [cat, tail].filter(Boolean).join(' - '),
        name: String(it.name || ''), isGroup: isTrue_(it.isGroup), groupCount: num_(it.groupCount),
        groupNames: String(it.groupNames || '').split('\n').map(s => s.trim()).filter(Boolean).join(', '),
        amount: round2_(num_(it.amount)), note: String(it.note || '')
      });
    });
  });
  const days = Object.keys(byDate).sort().map(k => Object.assign(byDate[k], { arriveOther: ktbArriveDate_(k, school) }));
  return { ym: ym, school: { name: school.schoolName || '' }, days: days };
}


/* =========================================================
 * ส่งข้อมูลแจ้งโอนเงินไปเก็บในชีตภายนอก (ชีต "แจ้งโอนเงิน KTB รายวัน")
 * ทุกครั้งที่บันทึก/แก้/ลบ: ลบแถวของวันโอนนั้นในชีตแล้วเขียนใหม่ทั้งวัน (ข้อมูลตรงกับระบบเสมอ)
 * เปลี่ยนไฟล์ปลายทางได้ที่ Settings → ktbLogSheetId
 * ========================================================= */
var KTB_SYNC_HOLD = false;
const KTB_LOG_SHEET_DEFAULT = '18cstdU7rgNJBvlsBC523Pqta2cZuT9-muu36qeGWdDY';
const KTB_LOG_TAB = 'ข้อมูลแจ้งโอน';
const KTB_LOG_HEAD = ['เดือน', 'วันที่โอน', 'ที่', 'รายการ', 'ชื่อ-สกุล', 'บัญชีปลายทาง', 'วันที่เงินเข้า', 'ประเภทงบ',
  'ตัดยอดจากประเภทเงิน', 'หมวดรายจ่าย', 'จำนวนเงิน', 'หมายเหตุ', 'ผู้บันทึก', 'วันเวลาที่บันทึก', 'วันที่โอน (ISO)', 'รหัสรายการ'];
function ktbItemDate_(it) {
  const b = readObjects_('KTB_Batches').find(x => x.id === it.batchId);
  return b ? b.date : '';
}
function ktbThDate_(iso) {
  const m = String(iso || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? Number(m[3]) + ' ' + TH_MONTHS[Number(m[2]) - 1] + ' ' + (Number(m[1]) + 543) : '';
}
function ktbLogSheet_() {
  const id = String(getSettingsMap_().ktbLogSheetId || KTB_LOG_SHEET_DEFAULT).trim();
  const ss = SpreadsheetApp.openById(id);
  let sh = ss.getSheetByName(KTB_LOG_TAB);
  if (!sh) {
    const first = ss.getSheets()[0];
    if (ss.getSheets().length === 1 && first.getLastRow() === 0) { sh = first; sh.setName(KTB_LOG_TAB); } else sh = ss.insertSheet(KTB_LOG_TAB);
  }
  if (sh.getLastRow() === 0 || String(sh.getRange(1, 1).getValue()) !== KTB_LOG_HEAD[0]) {
    if (sh.getLastRow() > 0) sh.insertRowBefore(1);
    sh.getRange(1, 1, 1, KTB_LOG_HEAD.length).setValues([KTB_LOG_HEAD]).setFontWeight('bold').setBackground('#D4D4D4').setHorizontalAlignment('center');
    sh.setFrozenRows(1);
    sh.hideColumns(KTB_LOG_HEAD.length - 1, 2);
  }
  return sh;
}
/** เขียนข้อมูลของวันโอน (และวันเดิม ถ้ารายการถูกย้ายวัน) ลงชีตภายนอก · คืนข้อความเตือนถ้าเขียนไม่ได้ (ไม่ทำให้การบันทึกล้ม) */
function ktbSyncLog_(date, date2) {
  const dates = [date, date2].filter((d, i, a) => d && a.indexOf(d) === i);
  if (!dates.length) return '';
  try {
    const sh = ktbLogSheet_(), isoCol = KTB_LOG_HEAD.length - 1;
    const school = getSettingsMap_();
    const users = {}; readObjects_('Users').forEach(x => { users[String(x.email || '').toLowerCase()] = String(x.name || ''); });
    const acts = readObjects_('Activities');
    const actName = id => { const a = acts.find(x => x.id === id); return a ? ((a.code ? a.code + ' ' : '') + a.name) : ''; };
    const items = readObjects_('KTB_Items'), batches = readObjects_('KTB_Batches');
    const BT = { bud: 'เงินงบประมาณ', rev: 'เงินรายได้แผ่นดิน', off: 'เงินนอกงบประมาณ' }, CAT_BT = { 1: 'bud', 3: 'bud', 2: 'rev', 4: 'off' };
    const balCache = {};
    const balOf = (fy, id) => { const L = balCache[fy] || (balCache[fy] = ktbBal25Options_(fy)); return L.find(x => String(x.id) === String(id)) || {}; };
    const out = [];
    dates.forEach(d => {
      const list = [];
      batches.filter(b => b.date === d).forEach(b => items.filter(it => it.batchId === b.id).forEach(it => list.push({ b: b, it: it })));
      list.sort((x, y) => num_(x.it.no) - num_(y.it.no));
      const m = d.match(/^(\d{4})-(\d{2})/), month = m ? TH_MONTHS[Number(m[2]) - 1] + ' ' + (Number(m[1]) + 543) : '';
      list.forEach((x, i) => {
        const b = x.b, it = x.it, fy = Number(b.fy), bal = balOf(fy, b.fundSource);
        const cat = String(it.expenseCat || ''), tail = it.activityId ? actName(it.activityId) : (String(it.customName || '') || String(it.note || ''));
        const other = !/กรุงไทย/.test(String(b.bankAccount || ''));
        const bt = BT[String(it.budgetType || '')] || BT[CAT_BT[Number(bal.category)]] || '';
        const who = String(it.createdBy || '').toLowerCase();
        const names = String(it.groupNames || '').split('\n').map(t => t.trim()).filter(Boolean).join(', ');
        out.push([month, ktbThDate_(d), i + 1, [cat, tail].filter(Boolean).join(' - '),
          isTrue_(it.isGroup) ? num_(it.groupCount) + ' ราย' + (names ? ': ' + names : '') : String(it.name || ''),
          other ? 'ต่างธนาคาร' : 'ธนาคารกรุงไทย', ktbThDate_(other ? ktbArriveDate_(d, school) : d), bt, bal.name || '', cat,
          round2_(num_(it.amount)), String(it.note || ''), users[who] || who, it.createdAt || '', d, String(it.id)]);
      });
    });
    // ลบแถวเดิมของวันเหล่านี้ (จากล่างขึ้นบน)
    const last = sh.getLastRow();
    if (last > 1) {
      const iso = sh.getRange(2, isoCol, last - 1, 1).getDisplayValues();
      for (let r = iso.length - 1; r >= 0; r--) {
        if (dates.indexOf(String(iso[r][0])) < 0) continue;
        let top = r; while (top > 0 && dates.indexOf(String(iso[top - 1][0])) >= 0) top--;
        sh.deleteRows(top + 2, r - top + 1); r = top;
      }
    }
    if (out.length) {
      const start = sh.getLastRow() + 1;
      sh.getRange(start, isoCol, out.length, 1).setNumberFormat('@');
      sh.getRange(start, 1, out.length, KTB_LOG_HEAD.length).setValues(out);
      sh.getRange(start, 11, out.length, 1).setNumberFormat('#,##0.00');
      sh.getRange(start, 14, out.length, 1).setNumberFormat('d/m/yyyy HH:mm');
      // เรียงทั้งชีตตามวันที่โอน แล้วตามลำดับ
      const n = sh.getLastRow() - 1;
      if (n > 1) sh.getRange(2, 1, n, KTB_LOG_HEAD.length).sort([{ column: isoCol, ascending: true }, { column: 3, ascending: true }]);
    }
    return '';
  } catch (e) {
    return 'บันทึกในระบบแล้ว แต่ส่งข้อมูลไปชีตภายนอกไม่ได้: ' + e.message;
  }
}
/** ส่งข้อมูลทั้งหมดของเดือน (หรือทุกวันที่มีข้อมูล) ไปชีตภายนอกครั้งเดียว (ใช้ครั้งแรก) — รันจากตัวแก้ไข Apps Script */
function ktbSyncAllLog() {
  const dates = readObjects_('KTB_Batches').map(b => String(b.date || '')).filter((d, i, a) => d && a.indexOf(d) === i).sort();
  const warns = dates.map(d => ktbSyncLog_(d)).filter(Boolean);
  return warns.length ? warns[0] : 'ส่งข้อมูลแล้ว ' + dates.length + ' วัน';
}
