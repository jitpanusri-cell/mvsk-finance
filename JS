const dcDebounce = (fn, ms) => { let t = 0; return () => { clearTimeout(t); t = setTimeout(fn, ms); }; };

function initDocsPage() {
  if (DC.inited) return;
  DC.inited = true; DC.fy = S.fy; DC.filter = 'all';
  $('dcFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === DC.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('dcFy').onchange = e => { DC.fy = +e.target.value; loadDocs(); };
  try { $('dcLogo').src = mvImg('logo'); } catch (e) { /* ไม่มีรูป */ }
  $('btnDcHelp').innerHTML = ic('info', 'sm') + '<span>แนวทางและระเบียบ</span>';
  $('btnDcHelp').onclick = () => dcToggleHelp();
  $('dcCards').querySelectorAll('[data-go]').forEach((b, i) => {
    b.querySelector('.dc2-ic').innerHTML = ic(['docs', 'check', 'receipt'][i] || 'docs');
    b.querySelector('.dc2-go').insertAdjacentHTML('beforeend', ic('chevron', 'sm'));
    b.onclick = () => { const g = b.dataset.go; if (g === 'loan') openDcModal(null, 'loanAct'); else if (g === 'adv') openDcModal(null, 'advance'); else openDcReturn(); };
  });
  $('btnDcBlank').innerHTML = ic('print', 'sm') + '<span>พิมพ์ฟอร์มเปล่า</span>';
  $('btnDcBlank').onclick = () => { const h = $('dcBlankMain'); h.hidden = !h.hidden; if (!h.hidden) dcBindBlank(h); };
  $('btnDcRegister').innerHTML = ic('docs', 'sm') + '<span>ทะเบียนคุม</span>';
  $('btnDcRegister').onclick = () => DC.filter === 'adv' ? printDcAdvRegister() : printDcLoanRegister();
  /* หน้ายืม / เบิก */
  $('btnDcSave').onclick = () => saveDcModal(false);
  $('btnDcPrintNow').onclick = () => saveDcModal(true);
  $('btnDcChecklist').onclick = () => dcToggleAttach();
  $('btnDcDel').onclick = deleteDcModal;
  $('btnDcToDocs').onclick = () => { dcRenderDocs(); dcStep('dcModal', 2); $('dcDocs').scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  $('btnDcBackForm').innerHTML = ic('edit', 'sm') + '<span>แก้ไขข้อมูล</span>';
  $('btnDcBackForm').onclick = () => { dcStep('dcModal', 1); $('dcForm').scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  DC.live = dcDebounce(() => { if ($('dcModal').classList.contains('show')) { dcRenderSide(); dcRenderDocs(); } }, 300);
  ['input', 'change'].forEach(ev => $('dcForm').addEventListener(ev, () => DC.live()));
  $('dcModal').addEventListener('shown.bs.modal', () => dcRenderDocs());
  $('dcModal').addEventListener('hidden.bs.modal', () => { if (DC.dirty) { DC.dirty = false; loadDocs(); } });
  /* หน้าส่งคืน */
  $('btnDrSave').onclick = () => saveDrModal(false);
  $('btnDrSavePrint').onclick = () => saveDrModal(true);
  $('btnDrToDocs').innerHTML = 'ถัดไป: ดูบันทึกข้อความ ' + ic('chevron', 'sm');
  $('btnDrToDocs').onclick = () => { dcDrDocs(); dcStep('dcReturnModal', 2); $('dcDrDocs').scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  DC.drLive = dcDebounce(() => { if ($('dcReturnModal').classList.contains('show')) dcDrDocs(); }, 300);
  $('fDrDate').addEventListener('change', () => { dcDrSum(); });
  $('dcReturnModal').addEventListener('shown.bs.modal', () => dcDrDocs());
  $('dcReturnModal').addEventListener('hidden.bs.modal', () => { if (DC.dirty) { DC.dirty = false; loadDocs(); } });
  /* สัญญาทำนอกระบบ (ในหน้าส่งคืน) */
  ['input', 'change'].forEach(ev => $('dcDrMan').addEventListener(ev, () => dcDrSum()));
  $('btnDrBack').innerHTML = ic('print', 'sm') + '<span>พิมพ์สัญญาด้านหลัง</span>';
  $('btnDrBack').onclick = () => { const r = dcDrRecord(); if (r) printDcF2B(dcDrBackRec(r)); };
  /* เลือกชื่อแล้วดึงตำแหน่ง/วิทยฐานะ/กลุ่มสาระ/ที่อยู่ จากรายการล่าสุดของคนเดิม (ถ้าช่องยังว่าง) */
  $('fDcTeacher').onchange = () => {
    const prev = (DC.data.list || []).find(x => x.teacherName === $('fDcTeacher').value.trim());
    if (!prev) return;
    [['fDcPos', 'teacherPos'], ['fDcLevel', 'teacherLevel'], ['fDcDept', 'teacherDept'], ['fDcAddress', 'address']]
      .forEach(([id, k]) => { if (!$(id).value && prev[k]) $(id).value = prev[k]; });
    DC.live();
  };
  $('fMrName').onchange = () => {
    const prev = (DC.data.list || []).find(x => x.teacherName === $('fMrName').value.trim());
    if (prev && !$('fMrPos').value) $('fMrPos').value = prev.teacherPos || '';
    dcDrSum();
  };
  $('fDcLoanDue').oninput = () => { DC.dueTouched = true; };
  /* วันครบกำหนด (ไม่บังคับ): เลือกจากปฏิทิน หรือปุ่มลัด +30 (กิจกรรม นับจากวันรับเงิน) / +15 (ไปราชการ นับจากวันกลับ) */
  document.querySelectorAll('#dcModal [data-due]').forEach(b => b.onclick = () => {
    const n = +b.dataset.due;
    $('fDcLoanDue').value = !n ? '' : n === 15 ? dcAddDays($('fDcTo').value || $('fDcLoanDate').value || S.boot.today, 15) : dcAddDays($('fDcLoanDate').value || S.boot.today, 30);
    DC.dueTouched = true; DC.live();
  });
  $('btnDrCopy').innerHTML = ic('docs', 'sm') + '<span>คัดลอกรายการจากที่ยืม</span>';
  $('btnDrCopy').onclick = () => { const r = DC.data.list.find(x => x.id === $('fDrReqId').value); if (r && DC.drUI) DC.drUI.set(dcItemsParse(r.itemsText)); };
  $('fDrCash').oninput = dcDrSum;
  ['fDcPeople', 'fDcPerdiem', 'fDcPerdiemDays', 'fDcLodge', 'fDcLodgeDays', 'fDcTransport', 'fDcTransportRoutes', 'fDcOtherAmt', 'fDcItems'].forEach(id => { const el = $(id); if (el) el.oninput = dcRecalc; });
}
/* ขั้นตอน 1 กรอกข้อมูล → 2 ดูเอกสาร */
function dcStep(modalId, n) {
  document.querySelectorAll('#' + modalId + ' .dc2-steps li').forEach((li, i) => li.classList.toggle('on', i === n - 1));
}

async function loadDocs() {
  initDocsPage();
  loading(true);
  try {
    // เดิมเรียก getDocsFormData แล้วรอ ต่อด้วย getDocsData เรียงกัน 2 รอบ
    const r = await api('getDocsPageData', DC.fy);
    DC.form = r.form; DC.data = r.data; renderDocs();
  } catch (e) { fail(e); }
  loading(false);
}

