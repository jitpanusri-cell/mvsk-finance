  initRefundPage();
  loading(true);
  try { RF.data = await api('getRefundData', RF.fy); renderRefund(); } catch (e) { fail(e); }
  loading(false);
}

const rfFund = code => (RF.data.funds.find(f => f.code === code) || { name: code, short: code, color: '#999' });
const rfN = v => Math.abs(v) < 0.005 ? '-' : money(v);
const rfSrcText = r => r.kind === 'student' ? `นักเรียน ภาค ${esc(r.term)}` : r.kind === 'balance' ? 'ยอดคงเหลือปลายปี' : 'บันทึกเอง';

function renderRefund() {
  const D = RF.data, R = D.fundRows, T = k => R.reduce((x, r) => x + r[k], 0);
  $('btnRfAdd').style.display = D.canEdit ? '' : 'none';
  const k = (cls, l, v, f) => `<div class="kpi ${cls}"><div class="l">${l}</div><div class="v">${money(v)}<small>บาท</small></div><div class="f">${f}</div></div>`;
  $('rfKpi').innerHTML =
    k('dark', 'เงินคงเหลือทั้งปีงบ', T('balance'), `ณ ${thDate(D.asOf)} · สิ้นปีงบ ${thDate(D.fyEnd)}`) +
    k('cream', 'รอดำเนินการ', T('pending'), `${D.list.filter(r => r.status === 'รอดำเนินการ').length} รายการ`) +
    k('', 'กันเงินไว้ใช้ต่อ', T('kept'), `${D.list.filter(r => r.status === 'กันเงินไว้ใช้ต่อ').length} รายการ`) +
    k('', 'ส่งคืนแล้ว', T('refunded'), `คงเหลือหลังส่งคืน ${money(T('after'))} บาท`);
  $('rfSum').innerHTML = `<thead><tr><th>ประเภทเงิน</th><th class="num">คงเหลือ</th><th class="num">ลงรายการแล้ว</th><th class="num">รอดำเนินการ</th><th class="num">กันไว้ใช้ต่อ</th><th class="num">ส่งคืนแล้ว</th><th class="num">ยังไม่ลงรายการ</th><th></th></tr></thead><tbody>
    ${R.map(r => `<tr><td><span class="fdot" style="background:${r.color}"></span>${esc(r.name)}</td>
      <td class="num">${rfN(r.balance)}</td><td class="num">${rfN(r.listed)}</td><td class="num">${rfN(r.pending)}</td><td class="num">${rfN(r.kept)}</td><td class="num">${rfN(r.refunded)}</td>
      <td class="num"><b>${rfN(r.unlisted)}</b></td>
      <td class="text-end">${D.canEdit && r.unlisted > 0.004 ? `<button class="btnx sec sm" data-bal="${r.code}" title="สร้างรายการจากยอดคงเหลือที่ยังไม่ลงรายการ">${ic('plus', 'sm')}ลงรายการ</button>` : ''}</td></tr>`).join('')}
    <tr class="tot"><td>รวม</td>${['balance', 'listed', 'pending', 'kept', 'refunded', 'unlisted'].map(x => `<td class="num">${rfN(T(x))}</td>`).join('')}<td></td></tr></tbody>`;
  $('rfSum').querySelectorAll('[data-bal]').forEach(b => b.onclick = async () => {
    const f = rfFund(b.dataset.bal);
    loading(true);
    try { const amt = await api('refundFromBalance', RF.fy, b.dataset.bal); toast(`ลงรายการ ${f.short} ${money(amt)} บาท`); await loadRefund(); } catch (e) { fail(e); }
    loading(false);
  });
  renderRefundList();
}

function renderRefundList() {
  const D = RF.data;
  const rows = D.list.filter(r => RF.filter === 'ALL' || r.status === RF.filter);
  [...RF.sel].forEach(id => { if (!D.list.some(r => r.id === id)) RF.sel.delete(id); });
  $('rfList').innerHTML = `<thead><tr>${D.canEdit ? `<th style="width:36px"><input type="checkbox" id="rfAll" aria-label="เลือกทั้งหมด" style="width:18px;height:18px"></th>` : ''}
    <th>ประเภทเงิน</th><th>รายละเอียด</th><th>ที่มา</th><th class="num">จำนวนเงิน</th><th>สถานะ</th><th>เลขที่ / วันที่</th><th></th></tr></thead><tbody>
    ${rows.map(r => { const f = rfFund(r.fund); return `<tr>
      ${D.canEdit ? `<td><input type="checkbox" data-sel="${r.id}" ${RF.sel.has(r.id) ? 'checked' : ''} aria-label="เลือก" style="width:18px;height:18px"></td>` : ''}
      <td><span class="fdot" style="background:${f.color}"></span>${esc(f.short)}</td>
      <td>${esc(r.note) || '-'}${r.evidenceUrl ? ` <a href="${esc(r.evidenceUrl)}" target="_blank" rel="noopener" class="small-x">หลักฐาน</a>` : ''}</td>
      <td class="small-x">${rfSrcText(r)}</td>
      <td class="num ${r.amount < 0 ? 'neg' : ''}"><b>${money(r.amount)}</b></td>
      <td><span class="st ${RF_ST[r.status]}">${esc(r.status)}</span></td>
      <td class="small-x">${esc(r.docNo) || '-'}${r.refundDate ? `<div class="act-sub">${thDate(r.refundDate, true)}</div>` : ''}</td>
      <td class="text-end">${D.canEdit ? `<button class="btnx sec icon sm" style="width:36px" data-edit="${r.id}" title="แก้ไข" aria-label="แก้ไข">${ic('edit', 'sm')}</button>` : ''}</td></tr>`; }).join('')
      || `<tr><td colspan="8" class="text-center muted py-4">ยังไม่มีรายการ · กด "ลงรายการ" ในตารางสรุปด้านบน หรือปิดยอดจากเมนูค่าอุปกรณ์/เครื่องแบบ</td></tr>`}
    ${rows.length ? `<tr class="tot"><td colspan="${D.canEdit ? 4 : 3}">รวม ${rows.length} รายการ</td><td class="num">${money(rows.reduce((x, r) => x + r.amount, 0))}</td><td colspan="3"></td></tr>` : ''}</tbody>`;
  $('rfList').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openRfForm(b.dataset.edit));
  $('rfList').querySelectorAll('[data-sel]').forEach(c => c.onchange = () => { c.checked ? RF.sel.add(c.dataset.sel) : RF.sel.delete(c.dataset.sel); renderRfBulk(); });
  if ($('rfAll')) $('rfAll').onchange = e => { rows.forEach(r => e.target.checked ? RF.sel.add(r.id) : RF.sel.delete(r.id)); renderRefundList(); };
  renderRfBulk();
}

function renderRfBulk() {
  const D = RF.data, n = RF.sel.size;
  if (!D.canEdit || !n) { $('rfBulk').innerHTML = ''; return; }
  const sum = D.list.filter(r => RF.sel.has(r.id)).reduce((x, r) => x + r.amount, 0);
  $('rfBulk').innerHTML = `<div class="rf-bar"><b>เลือก ${n} รายการ · ${money(sum)} บาท</b>
    <select class="sel" id="rfBSt">${D.status.map(s => `<option>${s}</option>`).join('')}</select>
    <input class="inp" id="rfBDoc" placeholder="เลขที่หนังสือ" style="width:150px">
    <input class="inp" type="date" id="rfBDate" value="${S.boot.today}" style="width:auto">
    <button class="btnx pri sm" id="rfBGo">เปลี่ยนสถานะ</button>
    <button class="btnx sec sm" id="rfBPrint">${ic('print', 'sm')}พิมพ์เฉพาะที่เลือก</button></div>`;
  $('rfBGo').onclick = async () => {
    loading(true);
    try { const c = await api('setRefundStatus', [...RF.sel], $('rfBSt').value, $('rfBDoc').value, $('rfBDate').value); toast(`ปรับ ${c} รายการแล้ว`); RF.sel.clear(); await loadRefund(); } catch (e) { fail(e); }
    loading(false);
  };
  $('rfBPrint').onclick = printRfMemo;
}

function openRfForm(id) {
  const D = RF.data, r = id ? D.list.find(x => x.id === id) : null;
  $('rfModalTitle').textContent = r ? 'แก้ไขรายการเงินเหลือจ่าย' : 'เพิ่มรายการเงินเหลือจ่าย · ปีงบ ' + D.fy;
  $('fRfId').value = r ? r.id : '';
  $('fRfFund').innerHTML = D.funds.map(f => `<option value="${f.code}">${esc(f.name)}</option>`).join('');
  $('fRfFund').value = r ? r.fund : D.funds[0].code; $('fRfFund').disabled = !!r;
  $('fRfAmt').value = r ? r.amount : ''; $('fRfAmt').disabled = !!(r && r.kind === 'student');
  $('fRfNote').value = r ? r.note : '';
  $('fRfStatus').innerHTML = D.status.map(s => `<option>${s}</option>`).join('');
  $('fRfStatus').value = r ? r.status : 'รอดำเนินการ';
  $('fRfDoc').value = r ? r.docNo : '';
  $('fRfDate').value = r && r.refundDate ? r.refundDate : '';
  $('fRfUrl').value = r ? r.evidenceUrl : '';
  $('btnRfDel').style.display = r && r.kind !== 'student' ? '' : 'none';
  rfStatusHint();
  $('fRfHint').innerHTML += r && r.kind === 'student' ? '<br>ยอดนี้มาจากเมนูค่าอุปกรณ์/เครื่องแบบ (ปุ่ม "ปิดยอด") จึงแก้จำนวนเงินที่นี่ไม่ได้' : '';
  modal('rfModal').show();
}
function rfStatusHint() {
  const st = $('fRfStatus').value;
  if (st === 'ส่งคืนแล้ว' && !$('fRfDate').value) $('fRfDate').value = S.boot.today;
  $('fRfHint').textContent = st === 'ส่งคืนแล้ว' ? 'ยอดส่งคืนจะหักออกจากเงินคงเหลือในหน้านี้' : st === 'กันเงินไว้ใช้ต่อ' ? 'ยังอยู่ในบัญชีโรงเรียน ใช้ต่อได้ตามที่ได้รับอนุมัติ' : '';
}
async function saveRfForm() {
  const o = { id: $('fRfId').value, fy: RF.fy, fund: $('fRfFund').value, amount: +$('fRfAmt').value, note: $('fRfNote').value,
    status: $('fRfStatus').value, docNo: $('fRfDoc').value, refundDate: $('fRfStatus').value === 'รอดำเนินการ' ? '' : $('fRfDate').value, evidenceUrl: $('fRfUrl').value };
  loading(true);
  try { await api('saveRefund', o); modal('rfModal').hide(); toast('บันทึกแล้ว'); await loadRefund(); } catch (e) { fail(e); }
  loading(false);
}
async function deleteRfForm() {
  const id = $('fRfId').value;
  if (!id || !window.confirm('ลบรายการนี้?')) return;
  loading(true);
  try { await api('deleteRefund', id); modal('rfModal').hide(); toast('ลบแล้ว'); await loadRefund(); } catch (e) { fail(e); }
  loading(false);
}

