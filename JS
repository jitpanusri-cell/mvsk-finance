/* CSS ของแบบฟอร์มราชการ (ใช้ทั้งพิมพ์และแปลง PDF) */
/* =========================================================
 * แบบฟอร์มราชการชุดใหม่ (ตรงตามตัวอย่างของโรงเรียน) — คลาส .gv
 * เอกสารหลัก (บันทึกขอเบิก / บันทึกส่งใช้ / ประมาณการ / 8708 ส่วนที่ 1) กรอกจากข้อมูลให้
 * เอกสารประกอบ (ใบขวางครู/นักเรียน ใบสำคัญรับเงิน วิทยากร บก.111 บัญชีลงเวลา) = แบบฟอร์มเปล่า
 *   หรือกรอกหัวเอกสาร/ผู้ลงนามคร่าว ๆ ผ่านหน้าต่าง "กรอกคร่าว ๆ ก่อนพิมพ์" (DC_QF)
 * ย่อหน้าที่มีคลาส tj จัดแบบ "กระจายแบบไทย" + ดึงบรรทัดสุดท้ายที่ตกมานิดเดียวกลับขึ้นไป (dcTypesetDoc)
 * ========================================================= */
const gvHas = v => v === 0 || (v != null && String(v).trim() !== '');
/* เส้นประเว้นว่าง (กว้าง w มม.) */
const gvD = w => `<span class="dt" style="width:${w || 30}mm"></span>`;
/* ค่าในย่อหน้า: มีข้อมูล = พิมพ์ตรง ๆ, ว่าง = เส้นประ */
const gvV = (v, w) => gvHas(v) ? `<span class="v">${esc(v)}</span>` : gvD(w);
/* ช่องในบรรทัดแบบยืดเต็มบรรทัด (flex): ว่าง = เส้นประยาวเต็มช่อง */
const gvF = (v, grow, cls) => `<span class="fx${gvHas(v) ? ' has' + (/^[\d,.\-–:\s]+$/.test(String(v)) ? ' c' : '') : ''}${cls ? ' ' + cls : ''}" style="flex:${grow == null ? 1 : grow}">${gvHas(v) ? esc(v) : '&nbsp;'}</span>`;
/* ช่องขีดเส้นใต้ทึบ (แบบ 8708 ส่วนที่ 2 / ใบขวางนักเรียน) */
const gvU = (v, w) => `<span class="ul" style="min-width:${w || 30}mm">${gvHas(v) ? esc(v) : ''}</span>`;
const gvCb = on => `<span class="cbx${on ? ' on' : ''}"></span>`;
const gvName = (n, w) => `(${gvHas(n) ? esc(n) : gvD(w || 48)})`;
const gvThD = iso => iso ? thDate(iso) : '';
/* แยก "412/2569 ลงวันที่ 19 พฤษภาคม 2569" → เลขที่ / วัน / เดือน / ปี */
function gvOrder(ref) {
  const s = String(ref || '').trim(), m = s.match(/^(.*?)\s*ลง(?:วันที่|วันที)\s*(\d{1,2})\s+(\S+)\s+(\d{4})/);
  return m ? { no: m[1].replace(/^ที่\s*/, ''), d: m[2], m: m[3], y: m[4] } : { no: s.replace(/^ที่\s*/, ''), d: '', m: '', y: '' };
}
/* หัวบันทึกข้อความ (ครุฑ + ส่วนราชการ/ที่/วันที่/เรื่อง/เรียน) */
function gvHead(subject, dateIso) {
  const sc = dcSchoolInfo(), pre = String(sc.docPrefix || '').trim();
  return `<div class="gvh">${dcGaruda()}<div class="gvt">บันทึกข้อความ</div></div>
    <div class="gl"><b class="lb">ส่วนราชการ</b><span class="gv1">${esc(sc.name)}</span></div>
    <div class="gl two"><span><b class="lb">ที่</b>${pre ? `<span class="gv1">${esc(pre)}</span>` : ''}<span class="fx" style="flex:1"></span></span>
      <span><b class="lb">วันที่</b>${dateIso ? `<span class="gv1">${thDate(dateIso)}</span>` : '<span class="fx" style="flex:1"></span>'}</span></div>
    <div class="gl"><b class="lb">เรื่อง</b><span class="gv2">${esc(subject)}</span></div>
    <div class="gl"><b class="lb">เรียน</b><span class="gv2">${esc(dcDirTitle())}</span></div>`;
}
/* ลายเซ็นผู้ขอ (ชิดขวาครึ่งหน้า ตามตัวอย่าง) */
function gvSign(role, name, pos, left) {
  return `<div class="sgb" style="margin-left:${left == null ? 50 : left}%">
    <div>(ลงชื่อ)${gvD(48)}${esc(role || '')}</div><div>${gvName(name)}</div><div>ตำแหน่ง${gvHas(pos) ? ' ' + esc(pos) : gvD(46)}</div></div>`;
}
/* ส่วนตรวจสอบของเจ้าหน้าที่การเงิน + อนุมัติ (ท้ายบันทึกขอเบิก / ขอส่งใช้) */
function gvApprove(lines) {
  const sg = dcSigners();
  return `<div class="gvapv">
    <div>เรียน&nbsp;&nbsp;${esc(dcDirTitle())}</div>
    <div class="ap-l">${lines.map(l => `<div>${l}</div>`).join('')}</div>
    <div class="ap2">
      <div class="ap-fin"><div>(ลงชื่อ)${gvD(44)}เจ้าหน้าที่การเงิน</div><div class="ap-n">${gvName(sg.finOfficer, 50)}</div><div>วันที่${gvD(50)}</div></div>
      <div class="ap-dir"><div class="ap-ok">-&nbsp;&nbsp;&nbsp;อนุมัติ</div><div>(ลงชื่อ)${gvD(40)}</div><div class="ap-n">${gvName(sg.director, 44)}</div>
        <div>ตำแหน่ง${gvD(42)}</div><div>วันที่${gvD(46)}</div></div>
    </div></div>`;
}
/* รายการเงิน "1. ...... จำนวน ...... บาท" (พิมพ์เฉพาะรายการที่กรอก — ว่างทั้งหมด = เว้น 1 บรรทัดให้เขียนเอง) */
function gvItemRows(L, numFmt, cls) {
  const rows = L.length ? L : [{ t: '', amt: 0 }];
  return `<div class="gvits ${cls || ''}">${rows.map((x, i) => `<div class="gvit"><span class="n">${numFmt(i)}</span>
    <span class="t fit1">${gvHas(x.t) ? esc(x.t) : '<span class="fx" style="display:block">&nbsp;</span>'}</span><span class="k">จำนวน</span>
    <span class="a">${x.amt ? money(x.amt) : '<span class="fx" style="display:block">&nbsp;</span>'}</span><span class="u">บาท</span></div>`).join('')}</div>`;
}

