/* =========================================================
 * ข้อมูลฝ่ายบัญชี (ทะเบียนคุมเงิน แยก 5 รายการ) — เทียบกับฝ่ายการเงิน
 * ========================================================= */
const AC = { fy: null, data: null, tab: 'receipt', imp: null };
const AC_TYPE_TH = { receipt: 'เงินเข้า', expense: 'รายจ่าย' };

function initAccountPage() {
  if (AC.inited) return;
  AC.inited = true; AC.fy = S.fy;
  $('acFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === AC.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('acFy').onchange = e => { AC.fy = +e.target.value; loadAccount(); };
  $('btnAcAdd').innerHTML = ic('plus') + '<span>เพิ่มรายการ</span>';
  $('btnAcImport').innerHTML = ic('upload') + '<span>นำเข้า Excel/CSV</span>';
  $('btnAcAdd').onclick = () => openAcForm();
  $('btnAcImport').onclick = openAcImport;
  $('acTabs').querySelectorAll('button').forEach(b => b.onclick = () => {
    AC.tab = b.dataset.k;
    $('acTabs').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    renderAcList();
  });
  $('btnAcSave').onclick = saveAcForm;
  $('btnAcDel').onclick = deleteAcForm;
  $('acImpFile').onchange = readAcImpFile;
  $('acImpPaste').oninput = () => parseAcImpText($('acImpPaste').value);
  $('btnAcDoImport').onclick = doAcImport;
}

async function loadAccount() {
  initAccountPage();
  loading(true);
  try { AC.data = await api('getAccountData', AC.fy); renderAccount(); }
  catch (e) { fail(e); }
  loading(false);
}

function renderAccount() {
  const D = AC.data;
  $('btnAcAdd').style.display = D.canEdit ? '' : 'none';
  $('btnAcImport').style.display = D.canEdit ? '' : 'none';
  const nMatch = D.matchCount, nDiff = D.diffCount;
  $('acKpi').innerHTML = `
    <div class="kpi dark"><div class="l">${ic('receipt','sm')}เงินเข้า (บัญชี)</div>
      <div class="v">${moneyKpi(D.totalIn)}<small>บาท</small></div><div class="f">${D.receipts.length} รายการ</div></div>
    <div class="kpi"><div class="l">${ic('expense','sm')}รายจ่าย (บัญชี)</div>
      <div class="v">${moneyKpi(D.totalOut)}<small>บาท</small></div><div class="f">${D.expenses.length} รายการ</div></div>
    <div class="kpi cream"><div class="l">${ic('check','sm')}ตรงกับการเงิน</div>
      <div class="v">${nMatch}<small>/ ${D.rows.length} รายการเงิน</small></div><div class="f">เทียบยอดรับ+จ่ายทั้งปีงบ</div></div>
    <div class="kpi ${nDiff ? 'alert' : 'cream'}"><div class="l">${ic('danger','sm')}ยอดต่างกัน</div>
      <div class="v ${nDiff ? 'neg' : ''}">${nDiff}<small>รายการเงิน</small></div>
      <div class="f">${nDiff ? D.rows.filter(r => r.match === 'diff').map(r => r.short).join(', ') : 'ไม่มี'}</div></div>`;
  renderAcSum(); renderAcList();
}

function acBadge(m) {
  if (m === 'match') return `<span class="st ok">${ic('check','sm')}ตรง</span>`;
  if (m === 'diff') return `<span class="st bad">${ic('danger','sm')}ต่าง</span>`;
  return `<span class="st none">ยังไม่บันทึก</span>`;
}
function renderAcSum() {
  const D = AC.data;
  $('acSum').innerHTML = `<thead><tr><th>รายการเงิน</th><th class="num">รับ (การเงิน)</th><th class="num">รับ (บัญชี)</th><th class="num">ผลต่างรับ</th>
    <th class="num">จ่าย (การเงิน)</th><th class="num">จ่าย (บัญชี)</th><th class="num">ผลต่างจ่าย</th><th>สถานะ</th></tr></thead><tbody>
    ${D.rows.map(r => `<tr><td><span class="fdot" style="background:${r.color}"></span>${esc(r.name)}</td>
      <td class="num">${money(r.finIn)}</td><td class="num">${money(r.accIn)}</td><td class="num ${Math.abs(r.diffIn) > 0.004 ? 'neg' : ''}">${money(r.diffIn)}</td>
      <td class="num">${money(r.finOut)}</td><td class="num">${money(r.accOut)}</td><td class="num ${Math.abs(r.diffOut) > 0.004 ? 'neg' : ''}">${money(r.diffOut)}</td>
      <td>${acBadge(r.match)}</td></tr>`).join('')}</tbody>`;
}

function renderAcList() {
  const D = AC.data, type = AC.tab, list = D[type === 'receipt' ? 'receipts' : 'expenses'];
  const fundOfCode = code => (D.funds.find(f => f.code === code) || { name: code, short: code, color: '#999' });
  $('acList').innerHTML = `<thead><tr><th>วันที่</th><th>รายการเงิน</th><th class="num">จำนวนเงิน</th><th>เลขที่อ้างอิง</th><th>หมายเหตุ</th><th></th></tr></thead><tbody>
    ${list.map(r => { const f = fundOfCode(r.fund); return `<tr>
      <td style="white-space:nowrap">${thDate(r.date, true)}</td>
      <td><span class="fdot" style="background:${f.color}"></span>${esc(f.short)}</td>
      <td class="num">${money(r.amount)}</td><td>${esc(r.refNo) || '-'}</td><td>${esc(r.note) || '-'}</td>
