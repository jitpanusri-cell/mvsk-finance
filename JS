<script>
/* =========================================================
 * JS.html — การทำงานฝั่งหน้าเว็บ
 * ========================================================= */
const $ = id => document.getElementById(id);
const S = { boot: null, fy: null, term: 'ALL', dash: null, page: 'dashboard', chartTable: false, _lastLoad: {} };
/* ระยะเวลาที่ถือว่าข้อมูลของหน้ายังใหม่อยู่ (ไม่ต้องดึงจากเซิร์ฟเวอร์ซ้ำถ้าเพิ่งคลิกเข้าเมนูนี้ไปไม่นาน) */
const PAGE_CACHE_TTL_MS = 20000;
/* เรียก loadXxx() ของหน้านั้นเฉพาะเมื่อข้อมูลเก่าเกิน TTL แล้ว (ใช้เฉพาะตอนคลิกเปลี่ยนเมนู
   ส่วนการเรียก loadXxx() ตรงๆ หลังบันทึก/ลบ/เปลี่ยนตัวกรอง ยังคงดึงข้อมูลใหม่เสมอตามปกติ) */
function loadPageIfStale(page, fn) {
  const now = Date.now();
  if (now - (S._lastLoad[page] || 0) < PAGE_CACHE_TTL_MS) return;
  S._lastLoad[page] = now;
  const p = fn();
  if (p && typeof p.catch === 'function') p.catch(() => { S._lastLoad[page] = 0; });
}

/* ---------- เรียกฟังก์ชันฝั่งเซิร์ฟเวอร์ ---------- */
const rawApi = (fn, ...args) => new Promise((ok, fail) =>
  google.script.run.withSuccessHandler(ok).withFailureHandler(fail)[fn](...args));

/* =========================================================
 * แคชข้อมูลฝั่งเบราว์เซอร์ (stale-while-revalidate) — คลิกปุ๊บแสดงปั๊บ
 * - คำสั่งอ่านข้อมูล (get...) ที่เคยโหลดแล้ว: แสดงข้อมูลชุดล่าสุดที่จำไว้ทันที แล้วดึงข้อมูลใหม่เบื้องหลัง
 *   ถ้าข้อมูลใหม่ต่างจากเดิม จะวาดหน้านั้นใหม่ให้เอง (มีป้าย "กำลังอัปเดต…" มุมขวาบนระหว่างดึง)
 * - จำไว้ใน localStorage แยกตามอีเมลผู้ใช้ ปิดเบราว์เซอร์แล้วเปิดใหม่ก็ยังแสดงทันที
 * - หลังบันทึก/ลบ/แก้ไข (คำสั่งที่ไม่ใช่ get...) การโหลดหน้าครั้งถัดไปภายใน 5 วิ จะรอข้อมูลจริงจากเซิร์ฟเวอร์เสมอ
 * - เปิดเว็บแล้วโหลดข้อมูลทุกเมนูที่มีสิทธิ์ไว้ล่วงหน้าเบื้องหลัง (prefetch) ครั้งแรกที่คลิกก็เร็ว
 * ========================================================= */
const SWR = {
  pfx: 'swr1|', mem: {}, inflight: {}, writeAt: 0,
  FRESH_MS: 60000, DIRTY_WAIT_MS: 5000, MAX_AGE_MS: 7 * 864e5,
  NO_CACHE: { getDisbMemoData: 1 },
  MEM_ONLY: { getStudentPageData: 1, getUsersData: 1 },
  syncing: 0
};
const swrIsRead = fn => /^get/.test(fn) && !SWR.NO_CACHE[fn] && !(fn === 'getBootstrapFy' && !swrUser());
const swrUser = () => String(window.__ME || (S.boot && S.boot.user && S.boot.user.email) || '').toLowerCase();
const swrKey = (fn, args) => SWR.pfx + swrUser() + '|' + fn + '|' + JSON.stringify(args);
function swrRead(k) {
  if (SWR.mem[k]) return SWR.mem[k];
  try {
    const v = localStorage.getItem(k);
    if (v) { const i = v.indexOf('|'); const e = { t: +v.slice(0, i), raw: v.slice(i + 1) }; SWR.mem[k] = e; return e; }
  } catch (e) { }
  return null;
}
function swrLsKeys() { try { return Object.keys(localStorage).filter(k => k.indexOf(SWR.pfx) === 0); } catch (e) { return []; } }
function swrWrite(k, raw) {
  const e = { t: Date.now(), raw: raw };
  SWR.mem[k] = e;
  if (SWR.MEM_ONLY[k.split('|')[2]]) return;
  try { localStorage.setItem(k, e.t + '|' + raw); }
  catch (er) {
    swrLsKeys().forEach(x => { try { localStorage.removeItem(x); } catch (e2) { } });
    try { localStorage.setItem(k, e.t + '|' + raw); } catch (e3) { }
  }
}
function swrPrune() {
  const now = Date.now();
  swrLsKeys().forEach(k => {
    try { const v = localStorage.getItem(k) || ''; if (now - +v.slice(0, v.indexOf('|')) > SWR.MAX_AGE_MS) localStorage.removeItem(k); } catch (e) { }
  });
}
function swrBadge(d) {
  SWR.syncing = Math.max(0, SWR.syncing + d);
  let b = document.getElementById('swrBadge');
  if (!b) {
    b = document.createElement('div'); b.id = 'swrBadge'; b.className = 'no-print'; b.setAttribute('role', 'status');
    b.style.cssText = 'position:fixed;top:10px;right:14px;z-index:2000;background:rgba(22,38,61,.88);color:#fff;font-size:12px;padding:4px 12px;border-radius:999px;pointer-events:none;transition:opacity .2s;opacity:0';
    b.textContent = 'กำลังอัปเดตข้อมูล…';
    document.body.appendChild(b);
  }
  b.style.opacity = SWR.syncing > 0 ? '1' : '0';
}
/* ดึงจากเซิร์ฟเวอร์ + เก็บแคช (รวมคำขอซ้ำที่ยังไม่เสร็จเป็นคำขอเดียว) — คืน {raw, changed} */
function swrFetch(k, fn, args, quiet) {
  const cur = SWR.inflight[k];
  if (cur && cur._t >= SWR.writeAt) return cur;
  const old = swrRead(k);
  if (quiet) swrBadge(1);
  const p = rawApi(fn, ...args).then(d => {
    const raw = JSON.stringify(d === undefined ? null : d);
    swrWrite(k, raw);
    return { raw: raw, changed: !old || old.raw !== raw };
  }).finally(() => { if (SWR.inflight[k] === p) delete SWR.inflight[k]; if (quiet) swrBadge(-1); });
  p._t = Date.now();
  SWR.inflight[k] = p;
  return p;
}
/* หน้าที่ใช้ข้อมูลของคำสั่งนั้น (ใช้ตัดสินว่าต้องวาดหน้าใหม่ไหมเมื่อข้อมูลเบื้องหลังเปลี่ยน) */
const SWR_PAGE = {
  getDashboardFull: 'dashboard', getDashboard: 'dashboard', getBalance25: '', getAllocationReport: 'allocation',
  getReceiptData: 'receipt', getExpenseData: 'expense', getActivityData: 'activity', getStudentPageData: 'students',
  getAccountData: 'account', getReconcileData: 'reconcile', getBalancePageData: 'balance', getRefundData: 'refund',
  getSettingsData: 'settings', getUsersData: 'users', getKtbPageData: 'ktb', getKtbDay: 'ktb', getDocsPageData: 'docs',
  getPrintCatalog: 'print', getPrintHistory: 'print'
};
const SWR_LOADER = {
  dashboard: 'loadDashboard', allocation: 'loadAllocation', receipt: 'loadReceipt', expense: 'loadExpense',
  activity: 'loadActivity', students: 'loadStudents', account: 'loadAccount', reconcile: 'loadReconcile',
  balance: 'loadBalance', refund: 'loadRefund', settings: 'loadSettings', users: 'loadUsers', ktb: 'loadKtb',
  docs: 'loadDocs', print: 'loadPrintCenter'
};
let _swrRerenderT = null;
/* ข้อมูลเบื้องหลังเปลี่ยน → วาดหน้าใหม่ (ถ้ากำลังเปิดหน้านั้นอยู่) โดยไม่เลื่อนจอ ไม่ขัดตอนพิมพ์/เปิดหน้าต่างอยู่ */
function swrRerender(page, delay) {
  if (!page) return;
  S._lastLoad[page] = 0;
  if (page !== S.page) return;
  clearTimeout(_swrRerenderT);
  _swrRerenderT = setTimeout(() => {
    if (S.page !== page) return;
    const ae = document.activeElement;
    const busy = document.querySelector('.modal.show') || document.querySelector('.loading.on') ||
      (ae && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName) && ae.closest('.page.on'));
    if (busy) return swrRerender(page, 1500);
    const fnName = SWR_LOADER[page], fn = fnName && window[fnName];
    if (typeof fn === 'function') { S._lastLoad[page] = Date.now(); fn(); }
  }, delay || 60);
}

const api = (fn, ...args) => {
  if (!swrIsRead(fn)) {
    return rawApi(fn, ...args).then(r => {
      SWR.writeAt = Date.now(); S._lastLoad = {};
      clearTimeout(SWR._rewarm); SWR._rewarm = setTimeout(swrPrefetch, 4000);
      return r;
    });
  }
  const k = swrKey(fn, args);
  const e = swrRead(k);
  const now = Date.now();
  const dirty = e && e.t < SWR.writeAt;
  if (e && !(dirty && now - SWR.writeAt < SWR.DIRTY_WAIT_MS)) {
    if (now - e.t > SWR.FRESH_MS || dirty) {
      swrFetch(k, fn, args, true).then(r => { if (r.changed) swrRerender(SWR_PAGE[fn]); }).catch(() => { });
    }
    return Promise.resolve(JSON.parse(e.raw));
  }
  return swrFetch(k, fn, args, false).then(r => JSON.parse(r.raw));
};

/* โหลดข้อมูลทุกเมนูที่มีสิทธิ์ไว้ล่วงหน้า (ทีละ 2 คำสั่ง) — ใช้ค่าเริ่มต้นเดียวกับตอนเปิดหน้านั้นครั้งแรก */
async function swrPrefetch() {
  if (!S.boot || SWR._prefetching) return;
  SWR._prefetching = true;
  const fy = S.fy || S.boot.currentFy, pages = S.boot.user.pages || [];
  const L = [
    ['students', 'getStudentPageData', [(typeof ST !== 'undefined' && ST.term) || '1/' + S.boot.currentFy, (typeof ST !== 'undefined' && ST.fund) || 'EQUIP']],
    ['docs', 'getDocsPageData', [fy]], ['allocation', 'getAllocationReport', [fy]], ['receipt', 'getReceiptData', [fy]],
    ['expense', 'getExpenseData', [fy]], ['activity', 'getActivityData', [fy]], ['balance', 'getBalancePageData', [fy, undefined]],
    ['ktb', 'getKtbPageData', [fy, S.boot.today]], ['refund', 'getRefundData', [fy]], ['account', 'getAccountData', [fy]],
    ['reconcile', 'getReconcileData', [fy]], ['print', 'getPrintCatalog', []], ['print', 'getPrintHistory', [30]],
    ['settings', 'getSettingsData', [fy]], ['users', 'getUsersData', []]
  ].filter(x => pages.indexOf(x[0]) >= 0);
  const now = Date.now();
  const todo = L.filter(x => { const e = swrRead(swrKey(x[1], x[2])); return !e || e.t < SWR.writeAt || now - e.t > SWR.FRESH_MS; });
  const worker = async () => {
    while (todo.length) {
      const x = todo.shift();
      try { const r = await swrFetch(swrKey(x[1], x[2]), x[1], x[2], false); if (r.changed) swrRerender(x[0]); } catch (e) { }
    }
  };
  try { await Promise.all([worker(), worker()]); } finally { SWR._prefetching = false; }
}

