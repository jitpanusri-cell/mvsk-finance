/* แนวทางและระเบียบ (ซ่อนไว้ กดปุ่มแล้วคลิกหัวข้อที่ต้องการ) */
function dcToggleHelp(force) {
  const g = $('dcGuide'), show = force == null ? g.hidden : force;
  g.hidden = !show;
  $('btnDcHelp').setAttribute('aria-expanded', String(show));
  if (!show) return;
  const col = (k, c, t) => `<div class="dc2-help-col ${c}"><h4>${esc(t)}</h4>
    <ol class="dc2-help-steps">${DC_GUIDE[k].act.steps.map(st => `<li><b>${esc(st.t)}</b>${st.w ? `<span>${esc(st.w)}</span>` : ''}</li>`).join('')}</ol>
    ${DC_HELP[k].topics.map(tp => `<details class="dc-help-it"><summary>${esc(tp.t)}</summary><ul>${tp.d.map(x => `<li>${esc(x)}</li>`).join('')}</ul></details>`).join('')}</div>`;
  g.innerHTML = `<div class="card-h"><h3>แนวทางและระเบียบ</h3><button type="button" class="btnx sec sm" data-close>ปิด</button></div>
    <div class="dc2-help">${col('loan', 'blue', 'สัญญายืมเงิน')}${col('return', 'green', 'ส่งคืนเงินยืม')}${col('adv', 'orange', 'เบิกเงิน')}</div>`;
  g.querySelector('[data-close]').onclick = () => dcToggleHelp(false);
}

/* สถานะ/กำหนดของแต่ละรายการ (ใช้ในรายการของฉัน และหน้าส่งคืน) */
function dcDueInfo(r) {
  if (!dcIsLoan(r)) return null;
  if (r.status === 'closed') return { cls: 'closed', txt: 'ล้างหนี้แล้ว' };
  if (!r.loanDueDate) return { cls: 'due', txt: 'ค้างส่งคืน' };
  const d = Math.round((new Date(r.loanDueDate) - new Date(S.boot.today)) / 86400000);
  return d < 0 ? { cls: 'overdue', txt: 'เกินกำหนด ' + (-d) + ' วัน' } : { cls: 'due', txt: 'ค้างส่งคืน · ' + (d ? 'เหลือ ' + d + ' วัน' : 'ครบกำหนดวันนี้') };
}
const dcLastReturn = r => (r.returns || []).reduce((d, t) => String(t.date || '') > d ? String(t.date) : d, '');

function renderDocs() {
  const D = DC.data, L = D.list || [];
  $('dcOrg').textContent = 'งานการเงินและบัญชี' + (D.school && D.school.name ? ' · ' + D.school.name : '');
  const isOpen = r => dcIsLoan(r) && r.status !== 'closed', isClosed = r => dcIsLoan(r) && r.status === 'closed', isAdv = r => !dcIsLoan(r);
  const FL = { all: ['ทั้งหมด', () => true], open: ['ค้างส่งคืน', isOpen], closed: ['ล้างหนี้แล้ว', isClosed], adv: ['เบิก', isAdv] };
  if (!FL[DC.filter]) DC.filter = 'all';
  $('dcFilter').innerHTML = Object.keys(FL).map(k => `<button type="button" role="tab" data-f="${k}" class="${k === DC.filter ? 'on' : ''}" aria-selected="${k === DC.filter}">${FL[k][0]} <span class="dc2-cnt">${L.filter(FL[k][1]).length}</span></button>`).join('');
  $('dcFilter').querySelectorAll('[data-f]').forEach(b => b.onclick = () => { DC.filter = b.dataset.f; renderDocs(); });
  $('dcListTitle').textContent = D.seeAll === false ? 'รายการของฉัน' : 'รายการทั้งหมด';
  $('dcListHint').textContent = '';
  $('btnDcRegister').style.display = D.seeAll === false ? 'none' : '';
  const rows = L.filter(FL[DC.filter][1]);
  const typeOf = r => isOpen(r) ? 'ยืม · ' + (dcIsTravel(r) ? 'ไปราชการ' : 'กิจกรรม') : isClosed(r) ? 'ส่งคืน (ล้างหนี้)' : 'เบิก' + (dcIsTravel(r) ? ' · ไปราชการ' : '');
  const typeCls = r => isOpen(r) ? 'loan' : isClosed(r) ? 'ret' : 'adv';
  const dateOf = r => {
    if (isOpen(r)) return r.loanDueDate ? 'ส่งคืนภายใน ' + thDate(r.loanDueDate, true) : 'ยืมเมื่อ ' + (r.loanDate ? thDate(r.loanDate, true) : '-');
    if (isClosed(r)) { const d = dcLastReturn(r); return d ? 'ส่งคืนเมื่อ ' + thDate(d, true) : 'ล้างหนี้แล้ว'; }
    const d = r.docDate || String(r.createdAt || '').slice(0, 10) || r.dateFrom;
    return d ? 'ยื่นเมื่อ ' + thDate(d, true) : '-';
  };
  const stOf = r => {
    const x = dcDueInfo(r);
    if (x) return `<span class="dc-loan-pill ${x.cls}">${x.txt}</span>`;
    return r.status === 'transferred' ? '<span class="dc-loan-pill closed">โอนเงินแล้ว</span>' : r.status === 'closed' ? '<span class="dc-loan-pill closed">ปิดยอดแล้ว</span>' : '<span class="dc-loan-pill wait">รออนุมัติ</span>';
  };
  const ib = (attr, id, icon, title) => `<button type="button" class="btnx sec icon sm dc2-ib" data-${attr}="${id}" title="${title}" aria-label="${title}">${ic(icon, 'sm')}</button>`;
  $('dcList').innerHTML = `<thead><tr><th>เรื่อง</th><th>ประเภท</th><th class="num">ยอดเงิน (บาท)</th><th>กำหนด / วันที่</th><th>สถานะ</th><th class="text-end">จัดการ</th></tr></thead><tbody>
    ${rows.map(r => `<tr>
      <td><div class="nm">${esc(r.purpose) || '<span class="muted">(ไม่ระบุเรื่อง)</span>'}</div><div class="act-sub">${esc(r.teacherName)}${r.loanContractNo ? ' · สัญญาเลขที่ ' + esc(r.loanContractNo) : ''}</div></td>
      <td><span class="dc2-type ${typeCls(r)}">${typeOf(r)}</span></td>
      <td class="num">${money(r.total)}${isOpen(r) && r.returned ? `<div class="act-sub">คงค้าง ${money(r.remain)}</div>` : ''}</td>
      <td style="white-space:nowrap">${dateOf(r)}</td>
      <td>${stOf(r)}</td>
      <td class="text-end" style="white-space:nowrap">
        ${D.canEdit && isOpen(r) ? `<button type="button" class="btnx pri sm green" data-return="${r.id}">${ic('check', 'sm')}ส่งคืน</button>` : ''}
        ${D.canEdit && isClosed(r) ? ib('return', r.id, 'check', 'แก้ไขการส่งคืน') : ''}
        ${ib('edit', r.id, 'edit', D.canEdit ? 'แก้ไข' : 'เปิดดู')}
        ${ib('print', r.id, 'print', 'พิมพ์เอกสาร')}
      </td></tr>`).join('') || `<tr><td colspan="6" class="text-center muted py-4">${L.length ? 'ไม่มีรายการในกลุ่มนี้' : 'ยังไม่มีรายการ — เลือกเรื่องที่จะทำจากการ์ดด้านบน'}</td></tr>`}</tbody>`;
  $('dcList').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openDcModal(b.dataset.edit));
  $('dcList').querySelectorAll('[data-print]').forEach(b => b.onclick = () => openDcPrintModal(b.dataset.print));
  $('dcList').querySelectorAll('[data-return]').forEach(b => b.onclick = () => openDrModal(b.dataset.return));
}

/* เลือกประเภท (การ์ดตัวเลือก) + แสดง/ซ่อนช่องตามประเภท: ยืม → ช่องสัญญา, เดินทาง → เบี้ยเลี้ยง/ที่พัก/พาหนะ/วันเวลาเดินทาง */
