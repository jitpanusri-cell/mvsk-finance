/* =========================================================
 * แบบฟอร์มราชการ ชุดตรงตัวอย่างโรงเรียน (mv) — ต.ค. 69
 * ---------------------------------------------------------
 * จัดหน้าเป็นพิกเซลบนกระดาษ A4 (794 × 1122 px = 210 × 297 มม.) เหมือนภาพออกแบบที่ผู้ใช้อนุมัติ
 * ฟอนต์ THSarabunMV = TH Sarabun ที่ปรับขนาดให้ 15px บนจอ = 16pt ตอนพิมพ์ (ดู CSS.html)
 * r = รายการ (รูปแบบเดียวกับ getDocsData) · r เป็น null = พิมพ์ฟอร์มเปล่า
 * ห้ามเขียน "ทับทับ" (เครื่องหมาย / สองตัวติดกัน) ในไฟล์นี้ — Apps Script ตัดเป็นคอมเมนต์
 * ========================================================= */
const MV_B = '1px solid #000';
const mvE = v => esc(v == null ? '' : String(v));
const mvHas = v => v === 0 || (v != null && String(v).trim() !== '');
/* ค่าที่ดึงจากข้อมูล: พิมพ์บนเส้นประ (พื้นฟ้าเฉพาะตัวอย่างบนจอ) — ว่าง = เส้นประเปล่าให้เขียนมือ */
function mvV(v, o) {
  o = o || {};
  let st = 'border-bottom:1px dotted #000;white-space:nowrap;padding:0 ' + (o.pad == null ? 10 : o.pad) + 'px';
  if (o.grow) st += ';flex:' + o.grow + ' 1 0;min-width:0;overflow:hidden';
  if (o.w) st += ';display:inline-block;min-width:' + o.w + 'px;line-height:1.6';
  if (o.center) st += ';text-align:center';
  return `<span class="${mvHas(v) ? 'mvv' : ''}${o.grow ? ' mvfit' : ''}" style="${st}">${mvHas(v) ? mvE(v) : '&nbsp;'}</span>`;
}
/* เส้นประเปล่า */
function mvD(o) {
  o = o || {};
  let st = 'border-bottom:1px dotted #000';
  if (o.grow) st += ';flex:' + o.grow + ' 1 0;min-width:0';
  if (o.w) st += ';display:inline-block;min-width:' + o.w + 'px;height:1.4em';
  return `<span style="${st}"></span>`;
}
const mvL = t => `<span style="white-space:nowrap">${t}</span>`;
const mvRow = (parts, o) => { o = o || {}; return `<div style="display:flex;align-items:baseline;gap:${o.gap == null ? 6 : o.gap}px;padding-left:${o.indent || 0}px${o.extra || ''}">${parts.join('')}</div>`; };
/* ข้อความในประโยค: มีค่า = ตัวหนังสือ (พื้นฟ้าบนจอ), ว่าง = เส้นประตามความยาว */
const mvH = (v, dots) => mvHas(v) ? `<span class="mvv">${mvE(v)}</span>` : '.'.repeat(dots || 20);
const mvNW = s => `<span style="white-space:nowrap">${s}</span>`;
const mvDots = n => `<span class="mvd">${'.'.repeat(n)}</span>`;
function mvSheet(w, h, pad, body, extra) {
  return `<div class="mvs${w > h ? ' land' : ''}" style="width:${w}px;height:${h}px;box-sizing:border-box;background:#fff;font-size:15px;line-height:2;color:#000;padding:${pad};overflow:hidden;position:relative${extra || ''}">${body}</div>`;
}
const mvSchool = () => (dcSchoolInfo().name || 'โรงเรียนมหาวชิราวุธ จังหวัดสงขลา').trim();
const mvDir = () => 'ผู้อำนวยการ' + mvSchool();
const mvProv = () => dcProvince() || 'สงขลา';
const mvArea = () => (dcSchoolInfo().area || 'สำนักงานเขตพื้นที่การศึกษามัธยมศึกษา สงขลา สตูล').replace(/^สังกัด\s*/, '');
const mvN = v => { const n = +v || 0; return Number.isInteger(n) ? n.toLocaleString('en-US') : money(n); };
const mvMonthYear = iso => { const t = thParts(iso); return t.m ? t.m + ' ' + t.y : ''; };
/* รูปตราครุฑ / ตราโรงเรียน (ฝังในไฟล์ ไม่ต้องพึ่งลิงก์ Drive) */
const garudaImg = () => `<img class="garuda" src="${mvImg('garuda')}" alt="ตราครุฑ">`;
const mvImg = k => 'data:image/png;base64,' + MV_IMG[k].replace(/_/g, '/');

/* ---------- รายการค่าใช้จ่ายของเรื่อง (แยกชื่อ / จำนวน / เงิน) ---------- */
function mvCost(r) {
  const L = [];
  if (!r) return L;
  if (dcPerdiem(r)) L.push({ n: 'ค่าเบี้ยเลี้ยงเดินทาง', it: { p: r.perdiemRate, q1: r.perdiemDays, u1: 'วัน', q2: r.people, u2: 'คน' }, amt: dcPerdiem(r) });
