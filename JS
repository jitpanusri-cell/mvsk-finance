function initKtbPage() {
  if (KT.inited) return;
  KT.inited = true; KT.fy = S.fy; KT.date = S.boot.today;
  if (!$('ktStyle')) { const st = document.createElement('style'); st.id = 'ktStyle'; st.textContent = KT_CSS; document.head.appendChild(st); }
  $('ktFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === KT.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('ktFy').onchange = e => { KT.fy = +e.target.value; loadKtb(); };
  // แถบเลือกวัน: ‹ ย้อนดู | วันที่ (คลิกเปิดปฏิทิน) | › วันถัดไป | วันนี้
  const dIn = $('ktDate'); dIn.hidden = true; dIn.value = KT.date;
  dIn.onchange = e => ktGo(e.target.value);
  const nav = document.createElement('div'); nav.className = 'kt-nav'; nav.id = 'ktNav';
  nav.innerHTML = `<button type="button" class="kt-nb" id="btnKtPrev" title="ย้อนดูวันก่อนหน้า (ปุ่มลูกศรซ้าย)" aria-label="ย้อนดูวันก่อนหน้า">‹</button>
    <button type="button" class="kt-day" id="btnKtCal" aria-haspopup="dialog" aria-expanded="false" title="คลิกเพื่อเปิดปฏิทิน">${ic('calendar', 'sm')}<span class="dw" id="ktDayDow"></span><b id="ktDayLbl"></b><span class="tp" id="ktDayTag" hidden>วันนี้</span></button>
    <button type="button" class="kt-nb" id="btnKtNext" title="วันถัดไป (ปุ่มลูกศรขวา)" aria-label="วันถัดไป">›</button>
    <button type="button" class="kt-today" id="btnKtToday">วันนี้</button>
    <div class="kt-cal" id="ktCal" role="dialog" aria-label="ปฏิทินเลือกวันที่โอน" hidden></div>`;
  dIn.insertAdjacentElement('afterend', nav);
  $('btnKtPrev').onclick = () => ktGo(ktAddDays(KT.date, -1));
  $('btnKtNext').onclick = () => ktGo(ktAddDays(KT.date, 1));
  $('btnKtToday').onclick = () => ktGo(S.boot.today);
  $('btnKtCal').onclick = () => $('ktCal').hidden ? ktCalOpen() : ktCalClose();
  document.addEventListener('mousedown', e => { if (!$('ktCal').hidden && !$('ktNav').contains(e.target)) ktCalClose(); });
  document.addEventListener('keydown', e => {
    if (S.page !== 'ktb' || document.querySelector('.modal.show')) return;
    if (e.key === 'Escape' && !$('ktCal').hidden) { ktCalClose(); $('btnKtCal').focus(); return; }
    const ae = document.activeElement;
    if (ae && /^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName)) return;
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.key === 'ArrowLeft') { e.preventDefault(); ktGo(ktAddDays(KT.date, -1)); }
    if (e.key === 'ArrowRight') { e.preventDefault(); ktGo(ktAddDays(KT.date, 1)); }
  });
  // ตารางกรอกแบบ Excel (อยู่ระหว่างการ์ดสรุปกับเอกสาร)
  const sh = document.createElement('div'); sh.className = 'cardx mb-grid kt-sheet'; sh.id = 'ktSheet'; sh.hidden = true;
  $('ktKpi').insertAdjacentElement('afterend', sh);
  ktRenderNav();

  $('btnKtAdd').innerHTML = ic('plus') + '<span>เพิ่มรายการ</span>';
  $('btnKtAdd').onclick = () => openKtModal();
  const xb = document.createElement('button'); xb.type = 'button'; xb.className = 'btnx sec'; xb.id = 'btnKtXlsx';
  xb.innerHTML = ic('ktXls') + '<span>Excel รายเดือน</span>'; xb.title = 'ส่งออกข้อมูลแจ้งโอนทั้งเดือนเป็นไฟล์ Excel';
  xb.onclick = ktXlsxOpen; $('btnKtAdd').insertAdjacentElement('beforebegin', xb);
  const cp = document.createElement('button'); cp.className = 'btnx sec kt-ib'; cp.id = 'btnKtCopyImg';
  $('btnKtExportPng').insertAdjacentElement('beforebegin', cp);
  [['btnKtCopyImg', 'ktCopy', 'คัดลอกรูปภาพ (วางในไลน์ได้)', 'copy'], ['btnKtExportPng', 'ktSave', 'บันทึกรูปภาพ (PNG)', 'png'], ['btnKtExportPdf', 'ktPdf', 'บันทึกเป็น PDF', 'pdf']]
    .forEach(([id, icn, t, k]) => { const b = $(id); b.classList.add('kt-ib'); b.innerHTML = ic(icn); b.title = t; b.setAttribute('aria-label', t); b.onclick = () => exportKtb(k); });
  $('btnKtSave').onclick = saveKtModal;
  $('btnKtDel').onclick = deleteKtModal;
  $('btnKtBatchAdd').onclick = saveKtBatchPaste;
  $('fKtCat').onchange = ktCatChanged;
  $('fKtAct').onchange = ktUpdateItemPreview;
  $('fKtItemName').oninput = ktUpdateItemPreview;
  $('fKtGroup').onchange = () => { $('fKtGroupWrap').style.display = $('fKtGroup').checked ? '' : 'none'; $('fKtName').disabled = $('fKtGroup').checked; };
}

function ktRenderNav() {
  const d = ktParse(KT.date), isToday = KT.date === S.boot.today;
  $('ktDayDow').textContent = 'วัน' + KT_DOW_L[d.getDay()];
  $('ktDayLbl').textContent = thDate(KT.date);
  $('ktDayTag').hidden = !isToday;
  $('btnKtToday').disabled = isToday;
  $('ktDate').value = KT.date;
}

/* เปลี่ยนวันที่ — ข้ามปีงบ (1 ต.ค.) จะสลับปีงบให้เอง */
function ktGo(iso) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(iso || '')) || iso === KT.date) { ktCalClose(); return; }
  ktSaveDraft();
  KT.date = iso; ktCalClose(); ktRenderNav();
  const fy = ktFyOf(iso);
  if (fy !== KT.fy && (S.boot.fyList || []).map(Number).includes(fy)) { KT.fy = fy; $('ktFy').value = fy; loadKtb(); }
  else loadKtbDay();
}

function ktCalOpen() {
  KT.calYm = KT.date.slice(0, 7);
  $('ktCal').hidden = false; $('btnKtCal').setAttribute('aria-expanded', 'true');
  ktCalRender(); ktLoadMonth(KT.calYm);
}
function ktCalClose() {
  if (!$('ktCal') || $('ktCal').hidden) return;
  $('ktCal').hidden = true; $('btnKtCal').setAttribute('aria-expanded', 'false');
}
async function ktLoadMonth(ym, force) {
  if (KT.month[ym] && !force) return;
  try {
    const r = await api('getKtbMonth', ym);
    KT.month[ym] = (r && r.days) || {};
    if (!$('ktCal').hidden && KT.calYm === ym) ktCalRender();
  } catch (e) { KT.month[ym] = KT.month[ym] || null; }
}
function ktCalRender() {
  const [y, m] = KT.calYm.split('-').map(Number);
  const startDow = new Date(y, m - 1, 1).getDay(), nDays = new Date(y, m, 0).getDate();
  const data = KT.month[KT.calYm], today = S.boot.today;
  let cells = KT_DOW.map((t, i) => `<span class="hd${i === 0 || i === 6 ? ' we' : ''}">${t}</span>`).join('');
  for (let i = 0; i < startDow; i++) cells += '<span></span>';
  let sumN = 0, sumT = 0, sumD = 0;
  for (let d = 1; d <= nDays; d++) {
    const iso = `${KT.calYm}-${String(d).padStart(2, '0')}`, dow = (startDow + d - 1) % 7, x = data && data[iso];
    if (x) { sumN += x.n; sumT += x.total; sumD++; }
    const cls = ['d', dow === 0 || dow === 6 ? 'we' : '', x ? 'has' : '', iso === today ? 'today' : '', iso === KT.date ? 'sel' : ''].filter(Boolean).join(' ');
    const tip = x ? `${thDate(iso)} · ${x.n} รายการ · ${money(x.total)} บาท` : thDate(iso);
    cells += `<button type="button" class="${cls}" data-d="${iso}" title="${esc(tip)}" aria-label="${esc(tip)}"${iso === KT.date ? ' aria-current="date"' : ''}><span>${d}</span>${x ? `<i>${x.n}</i>` : ''}</button>`;
  }
  const foot = data === undefined ? 'กำลังโหลดข้อมูลเดือนนี้…'
    : data === null ? 'โหลดข้อมูลเดือนนี้ไม่ได้'
    : sumD ? `เดือนนี้โอน <b>${sumD}</b> วัน · <b>${sumN}</b> รายการ · <b>${money(sumT)}</b> บาท` : 'เดือนนี้ยังไม่มีรายการโอน';
  $('ktCal').innerHTML = `<div class="ch"><button type="button" data-m="-1" aria-label="เดือนก่อน">‹</button><b>${MTH[m - 1]} ${y + 543}</b><button type="button" data-m="1" aria-label="เดือนถัดไป">›</button></div>
    <div class="gw">${cells}</div>
    <div class="cf"><span>${foot}</span><span class="lg"><i></i>มีรายการ</span></div>`;
  $('ktCal').querySelectorAll('[data-d]').forEach(b => b.onclick = () => ktGo(b.dataset.d));
  $('ktCal').querySelectorAll('[data-m]').forEach(b => b.onclick = () => {
    const d = new Date(y, m - 1 + (+b.dataset.m), 1);
    KT.calYm = ktIso(d).slice(0, 7); ktCalRender(); ktLoadMonth(KT.calYm);
  });
}

async function loadKtb() {
  initKtbPage();
  loading(true);
  try {
    // เดิมเรียก getKtbFormData แล้วรอ ต่อด้วย getKtbDay (ผ่าน loadKtbDay) เรียงกัน 2 รอบ
    const r = await api('getKtbPageData', KT.fy, KT.date);
    KT.form = r.form; KT.day = r.day; renderKtb();
  } catch (e) { fail(e); }
  loading(false);
}
async function loadKtbDay() {
  const want = KT.date;
  $('ktDoc').classList.add('kt-busy'); $('ktKpi').classList.add('kt-busy');
  try { const d = await api('getKtbDay', KT.fy, want); if (KT.date === want) { KT.day = d; renderKtb(); } } catch (e) { fail(e); }
  if (KT.date === want) { $('ktDoc').classList.remove('kt-busy'); $('ktKpi').classList.remove('kt-busy'); }
}

const ktDaysLeft = due => due ? Math.round((new Date(due) - new Date(S.boot.today)) / 86400000) : null;
const ktIsPendingLoan = r => r.loanFlag && String(r.loanStatus || '').indexOf('รอ') === 0;

function renderKtb() {
  const D = KT.day, F = KT.form, B = D.batches || [];
  const canEdit = !!(F && F.canEdit);
  ktRenderNav();
  $('btnKtAdd').style.display = canEdit ? '' : 'none';
  ['btnKtExportPng', 'btnKtCopyImg', 'btnKtExportPdf'].forEach(id => { if ($(id)) $(id).style.display = 'none'; }); // ย้ายไปอยู่บนรูปเอกสาร
  const allRows = B.flatMap(b => b.rows);
  const total = D.grandTotal || 0;
  const loanCount = allRows.filter(ktIsPendingLoan).length;
  $('ktKpi').innerHTML = ''; $('ktKpi').style.display = 'none';
  ktSheetRender(canEdit);
  $('ktDoc').innerHTML = B.length ? ktDocHtml(B, canEdit) : `<div class="empty"><div class="ic">${ic('ktb')}</div><h3 style="font-size:16px">ยังไม่มีรายการแจ้งโอนวันที่ ${thDate(KT.date)}</h3><p class="muted">${canEdit ? 'กรอกในตารางด้านบนแล้วกด "บันทึก" หรือกด ‹ › เพื่อดูวันอื่น' : 'กด ‹ › หรือคลิกวันที่เพื่อเปิดปฏิทินดูวันอื่น'}</p></div>`;

  $('ktDoc').querySelectorAll('[data-exp]').forEach(b => b.onclick = () => exportKtb(b.dataset.exp));
