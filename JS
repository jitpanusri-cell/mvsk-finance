    <p class="mto">เรียน&nbsp;&nbsp;ผู้อำนวยการ${esc(sc.name)}</p>`;
}
function stMemoLaw(M) {
  return stSh('ระเบียบ/ข้อกฎหมาย') +
    stP('- คำสั่งหัวหน้า คสช.ที่ 28/2559 เรื่องการจัดการศึกษาขั้นพื้นฐาน 15 ปี โดยไม่เก็บค่าใช้จ่าย') +
    stP(`- แนวทางการดำเนินงานตามโครงการสนับสนุนค่าใช้จ่ายในการจัดการศึกษา, ปีงบประมาณ ${M.fy}`);
}
function stMemoSig(M) {
  const dots = '.........................................';
  return `<div class="msig" style="margin-top:10mm;break-inside:avoid">(${esc(M.signers.finOfficer) || dots})<br>เจ้าหน้าที่การเงิน</div>`;
}
/* ยอดจัดสรรแยกรายการเงิน: "เป็นเงินค่าอุปกรณ์การเรียน จำนวน ... และเงินค่าเครื่องแบบนักเรียน จำนวน ..." */
function stAllocText(M, sep, withTotal) {
  const e = `เป็นเงินค่าอุปกรณ์การเรียน จำนวน ${stBaht(M.alloc.EQUIP)}`;
  if (M.semester !== 1) return e;
  return e + `${sep}เงินค่าเครื่องแบบนักเรียน จำนวน ${stBaht(M.alloc.UNIFORM)}` + (withTotal ? ` รวมเป็นเงิน ${stBaht(M.allocTotal)}` : '');
}
/* ตารางแนบ: สรุปจำนวนการเบิกจ่าย แยกรายชั้น (จำนวนคน / ค่าเครื่องแบบ / ค่าอุปกรณ์ / รวม) */
function stGradeTable(M, line2, countG, fundG) {
  const G = M.grades, F = M.funds, W = stFundWords(M);
  const tot = o => G.reduce((x, g) => x + (+o[g] || 0), 0);
  const sumG = g => F.reduce((x, f) => x + (+fundG[f][g] || 0), 0);
  const all = G.reduce((x, g) => x + sumG(g), 0);
  const td = (v, b) => `<td class="ct" style="line-height:1.5">${b ? '<b>' + v + '</b>' : v}</td>`;
  return `<div style="text-align:center;font-weight:700;line-height:1.5;margin:8mm 0 6mm">สรุปจำนวนการเบิกจ่าย เงิน${W.subj}<br>${line2}</div>
    <table style="line-height:1.6"><colgroup><col style="width:5%"><col style="width:22%">${G.map(() => '<col style="width:9.5%">').join('')}<col style="width:16%"></colgroup>
    <thead><tr>${['ที่', 'รายการเบิกจ่าย'].concat(G, ['รวม']).map(h => `<th style="line-height:1.9">${h}</th>`).join('')}</tr></thead><tbody>
    <tr><td colspan="2" class="ct"><b>จำนวน (คน)</b></td>${G.map(g => td(stNd(countG[g]))).join('')}${td(stNd(tot(countG)), 1)}</tr>
    ${F.map((f, i) => `<tr><td class="ct">${i + 1}</td><td style="white-space:nowrap">${FUND_TH[f]}</td>${G.map(g => td(stNd(fundG[f][g]))).join('')}${td(stNd(tot(fundG[f])), 1)}</tr>`).join('')}
    <tr><td></td><td class="ct"><b>รวม</b></td>${G.map(g => td(stNd(sumG(g)), 1)).join('')}${td(stNd(all))}</tr>
    </tbody></table>`;
}
function stRateNote(M, asOf) {
  const rt = x => x.lower === x.upper ? `ม.1-ม.6 ${stNf(x.lower)} บาท/คน` : `ม.1-ม.3 ${stNf(x.lower)} บาท/คน, ม.4-ม.6 ${stNf(x.upper)} บาท/คน`;
  const L = [`ค่าอุปกรณ์การเรียน ${rt(M.rates.EQUIP)}`];
  if (M.rates.UNIFORM) L.push(`ค่าเครื่องแบบนักเรียน ${rt(M.rates.UNIFORM)}`);
  L.push(`ข้อมูล ณ วันที่ ${thDate(asOf)}`);
  return `<div style="display:flex;gap:2mm;margin:6mm 0 0 10mm;line-height:1.5"><b style="white-space:nowrap">หมายเหตุ</b><div>${L.join('<br>')}</div></div>`;
}
/* ตารางแนบรายงาน: สรุปจำนวนนักเรียนที่ได้รับเงิน รายชั้น (สะสมถึงรอบนี้) */
function stRecvTable(M, R, line2) {
  const G = M.grades, W = stFundWords(M);
  const rate = g => M.funds.reduce((x, f) => x + M.rates[f][+g.replace(/\D/g, '') >= 4 ? 'upper' : 'lower'], 0);
  const cell = (v, b) => `<td class="ct" style="vertical-align:top;line-height:1.4">${b ? '<b>' + v + '</b>' : v}</td>`;
  return `<div style="text-align:center;font-weight:700;line-height:1.5;margin:0 0 5mm">สรุปจำนวนนักเรียนที่ได้รับเงิน${W.recv}<br>${line2}</div>
    <table style="line-height:1.5"><colgroup><col style="width:4%"><col style="width:30%"><col style="width:12%"><col style="width:14%"><col style="width:15%"><col style="width:11%"><col style="width:14%"></colgroup>
    <thead><tr style="line-height:1.4">${['ที่', 'รายการเบิกจ่ายเงิน<br>งบประมาณ', 'จำนวน<br>เงินที่ได้รับ<br>(บาท/คน)', 'จำนวน<br>นักเรียน<br>ทั้งหมด', 'จำนวน<br>นักเรียนที่<br>โอนสำเร็จ', 'รายการ<br>ตีกลับ', 'รวมที่ไม่ได้<br>รับโอนเงิน<br>(คน)'].map(h => `<th style="line-height:1.4">${h}</th>`).join('')}</tr></thead><tbody>
    ${G.filter(g => R.popG[g]).map((g, i) => `<tr><td class="ct" style="vertical-align:top">${i + 1}</td><td style="vertical-align:top;line-height:1.4">${W.row} ${g}</td>${cell(stNf(rate(g)))}${cell(stNd(R.popG[g]))}${cell(stNd(R.cumG[g]), 1)}${cell(stNd(R.outRetG[g]))}${cell(stNd(R.outG[g]))}</tr>`).join('')}
    <tr><td></td><td class="ct"><b>รวมนักเรียน</b></td><td></td>${cell(stNd(R.popN), 1)}${cell(stNd(R.cumN), 1)}${cell(stNd(R.outRetN), 1)}${cell(stNd(R.outN), 1)}</tr>
    </tbody></table>`;
}

async function openStMemo() {
  const isReq = ST.disbTab === 'req';
  loading(true);
  try { ST.memo = await api('getDisbMemoData', ST.term); }
  catch (e) { return fail(e); }
  loading(false);
  const M = ST.memo, W = stFundWords(M);
  const n = isReq ? M.next.n : +ST.disbTab.slice(1);
  const R = isReq ? null : M.rounds.find(r => r.n === n);
  $('stMemoTitle').textContent = isReq ? `บันทึกข้อความขออนุมัติจ่ายเงิน ครั้งที่ ${n}` : `บันทึกข้อความรายงานการจ่ายเงิน ครั้งที่ ${n}`;
  $('fStXferWrap').style.display = isReq ? '' : 'none';
  $('fStMemoDate').value = M.today; $('fStXferDate').value = M.today; $('fStAsOf').value = M.today;
  let h = '';
  if (isReq) {
    h = M.next.targetN
      ? `${W.subj} ครั้งที่ ${n} ภาคเรียนที่ ${M.term} · นักเรียน ${stNf(M.next.targetN)} คน · เป็นเงิน ${stNf(M.next.total)} บาท` +
        (M.nextShort ? `<br><span class="neg">เงินที่ได้รับยังไม่พอจ่าย ขาด ${stNf(M.nextShort)} บาท — บันทึกจะมีข้อเสนอขอยืมเงินจากกิจกรรมพัฒนาผู้เรียน</span>` : '') +
        (n > 1 ? `<br>อ้างอิงผลการโอนครั้งที่ ${n - 1} ในเรื่องเดิมโดยอัตโนมัติ · แยกตามเหตุผล: ตีกลับ/โอนไม่สำเร็จ ${M.next.mix.returned.n} คน · นักเรียนเข้าใหม่ ${M.next.mix.new.n} คน · โอนผิดบัญชี ${M.next.mix.wrong.n} คน` +
          '<br><span class="muted">ตั้งเหตุผลรายคนได้ที่รายชื่อ "ยังไม่รับเงิน" (ค่าเริ่มต้น = ตีกลับ/โอนไม่สำเร็จ)</span>' : '')
      : 'นักเรียนทุกคนได้รับเงินครบแล้ว ไม่มียอดที่ต้องขออนุมัติ';
  } else if (R) {
    h = `โอนวันที่ ${stDates(R.dates)} · โอนสำเร็จ ${stNf(R.successN)} คน เป็นเงิน ${stNf(R.successAmt)} บาท` +
      (R.outN ? ` · ยังไม่ได้รับ/ตีกลับ ${stNf(R.outN)} คน (${stNf(R.outDue)} บาท) — แนบรายชื่อท้ายรายงาน` : ' · โอนครบแล้ว') +
      '<br>ชุดเอกสาร: บันทึกข้อความรายงานผล + ตารางสรุป 2 ตาราง + รายชื่อนักเรียนตีกลับ (ถ้ามี)';
  }
  if (M.partial && M.partial.length) h += `<br><span class="neg">มีนักเรียน ${M.partial.length} คนที่ยกเลิกไว้แค่บางรายการเงิน: ${M.partial.slice(0, 5).map(s => esc(s.name) + ' (' + esc(s.cls) + ' ขาด' + s.missing.join('/') + ')').join(', ')}${M.partial.length > 5 ? ' …' : ''}
    — ขออนุมัติเฉพาะรายการที่ขาด ถ้าเงินตีกลับทั้งก้อน ให้กดยกเลิกรายการที่เหลือของคนนั้นด้วย</span>`;
  if (!M.allocTotal && M.semester === 1) h += '<br><span class="neg">ยังไม่มียอดจัดสรรของภาคเรียนนี้ในเมนูหนังสือจัดสรร/รายรับ — ตัวเลขในเรื่องเดิมจะเป็น 0</span>';
  $('stMemoHint').innerHTML = h;
  $('btnStMemoPrint').disabled = isReq ? !M.next.targetN : !R;
  $('btnStMemoPrint').onclick = () => {
    const o = { date: $('fStMemoDate').value || M.today, xfer: $('fStXferDate').value || M.today, asOf: $('fStAsOf').value || M.today, thai: $('fStThaiNum').checked };
    modal('stMemoModal').hide();
    if (isReq) printStReqMemo(M, n, o); else printStRptMemo(M, R, o);
  };
  $('btnStMemoOld').onclick = () => { modal('stMemoModal').hide(); printDisb(); };
  modal('stMemoModal').show();
}

/* ขออนุมัติจ่ายเงิน ครั้งที่ n: หน้า 1 บันทึกข้อความ + หน้า 2 ตารางสรุปจำนวนการเบิกจ่าย */
async function printStReqMemo(M, n, o) {
  const W = stFundWords(M), T = M.term, P = M.rounds.find(r => r.n === n - 1), X = M.next;
  const semY = `ภาคเรียนที่ ${M.semester} ปีการศึกษา ${M.acadYear}`;
  const base = `ตามที่${esc(M.school.name)} ได้รับจัดสรรและโอนเปลี่ยนแปลงงบประมาณรายจ่าย ประจำปีงบประมาณ พ.ศ. ${M.fy} ตามแผนงานสนับสนุนการจัดการศึกษาขั้นพื้นฐาน 15 ปี กิจกรรมสนับสนุนค่าใช้จ่ายในการจัดการศึกษาขั้นพื้นฐาน ภาคเรียนที่ ${T} (${stNf(M.pct)}%)`;
  let old, fact;
  if (n === 1 || !P) {
    old = `${base} ${stAllocText(M, ' และ', true)}`;
    fact = `งานการเงินงบประมาณ ขออนุมัติจ่ายเงิน${W.body} ครั้งที่ ${n} ภาคเรียนที่ ${T} ให้นักเรียนชั้น ม.1-ม.6 จำนวน ${stNf(X.targetN)} คน โดยวิธีโอนเข้าบัญชีนักเรียนในวันที่ ${thDate(o.xfer)} รวมยอดเงินที่ต้องจ่ายทั้งสิ้น ${stBaht(X.total)}`;
  } else {
    old = `${base} งานการเงินงบประมาณได้ขออนุมัติจ่ายเงิน${W.body} ครั้งที่ ${P.n} ภาคเรียนที่ ${T} ให้นักเรียนชั้น ม.1-ม.6 จำนวน ${stNf(P.targetN)} คน โดยวิธีโอนเข้าบัญชีนักเรียนในวันที่ ${stDates(P.dates)} <b>โอนสำเร็จ ${stNf(P.successN)} คน เป็นเงินทั้งสิ้น ${stNf(P.successAmt)} บาท</b> (${bahtText(P.successAmt)}) คิดเป็นร้อยละ ${stPct(P.successN, P.targetN)} ${stFailText(P)} ยังมีเงินคงเหลือจำนวน ${stNf(P.outDue)} บาท ซึ่งจะดำเนินการโอนให้นักเรียนในรอบที่ ${n} ต่อไป`;
    fact = `งานการเงินงบประมาณ ขออนุมัติจ่ายเงิน${W.body} ครั้งที่ ${n} ภาคเรียนที่ ${T} ให้นักเรียนชั้น ม.1-ม.6 ${stMixText(X.mix, P.n, T)} เป็นจำนวนเงิน ${stBaht(X.total)} โดยวิธีโอนเข้าบัญชีนักเรียน ในวันที่ ${thDate(o.xfer)}`;
  }
  const propose = M.nextShort
    ? stSh('ข้อเสนอ/พิจารณา') + stP(`1. งานการเงินได้รับโอนเงินเปลี่ยนแปลงไม่เพียงพอต่อการเบิกจ่ายให้นักเรียน จำเป็นต้องขอยืมเงินจากกิจกรรมพัฒนาผู้เรียน จำนวน ${stBaht(M.nextShort)}`) + stP('2. หากเห็นชอบตาม ข้อ 1 เพื่อโปรดพิจารณาอนุมัติ')
    : `<p class="ind" style="margin-top:3mm">จึงเรียนมาเพื่อโปรดพิจารณาอนุมัติ</p>`;
  let memo = `<div class="sheet memo" style="line-height:1.22">
    ${stMemoHead(M, `ขออนุมัติจ่ายเงิน${W.subj} ครั้งที่ ${n} ${semY}`, o.date)}
    ${stSh('เรื่องเดิม')}${stP(old)}
    ${stSh('ข้อเท็จจริง')}${stP(fact)}
    ${stMemoLaw(M)}
    ${propose}
    ${stMemoSig(M)}
  </div>`;
  if (o.thai) memo = stThaiDigits(memo);
  memo = await stFitMemo(memo);
  const att = `<div class="sheet">${stGradeTable(M, `ครั้งที่ ${n} ภาคเรียนที่ ${T}`, X.targetG, X.targetF)}${stRateNote(M, o.asOf)}</div>`;
  printDoc(memo + att, 'memo');
}

/* รายงานการจ่ายเงิน ครั้งที่ n: บันทึกข้อความ + ตารางสรุป 2 ตาราง (หน้าเดียวกัน) + รายชื่อนักเรียนตีกลับ */
async function printStRptMemo(M, R, o) {
  const W = stFundWords(M), T = M.term, n = R.n;
  const semY = `ภาคเรียนที่ ${M.semester} ปีการศึกษา ${M.acadYear}`;
  const xfer = stDates(R.dates);
  let old;
  if (n === 1) {
    old = `ตามที่${esc(M.school.name)} ได้รับจัดสรรและโอนเปลี่ยนแปลงงบประมาณรายจ่าย งบประมาณปี ${M.fy} ตามแผนงานยุทธศาสตร์สร้างความเสมอภาคทางการศึกษา โครงการสนับสนุนค่าใช้จ่ายในการจัดการศึกษาตั้งแต่ระดับอนุบาลจนจบการศึกษาขั้นพื้นฐาน กิจกรรมการสนับสนุนค่าใช้จ่ายในการจัดการศึกษาขั้นพื้นฐาน ภาคเรียนที่ ${T} (${stNf(M.pct)}%) ` +
      stAllocText(M, ' ', false) + (M.borrow1 ? ` และยืมเงินจากกิจกรรมพัฒนาผู้เรียน จำนวน ${stBaht(M.borrow1)}` : '');
  } else {
    old = `ตามที่งานการเงินงบประมาณ ขออนุมัติจ่ายเงิน${W.body} ครั้งที่ ${n} ภาคเรียนที่ ${T} ให้นักเรียนชั้น ม.1-ม.6 ${stMixText(R.targetMix, n - 1, T)} เป็นจำนวนเงิน ${stBaht(R.targetDue)} โดยวิธีโอนเข้าบัญชีนักเรียน ในวันที่ ${xfer} นั้น`;
  }
  let fact = `งานการเงินงบประมาณ ขออนุมัติจ่ายเงิน${W.body} ครั้งที่ ${n} ภาคเรียนที่ ${T} ให้นักเรียนชั้น ม.1-ม.6 โดยวิธีโอนเข้าบัญชีนักเรียนในวันที่ ${xfer} โอนสำเร็จ ${stNf(R.successN)} คน <b>เป็นเงินทั้งสิ้น ${stNf(R.successAmt)} บาท</b> (${bahtText(R.successAmt)}) คิดเป็นร้อยละ ${stPct(R.successN, R.targetN)}`;
  fact += R.outN
    ? ` ${stFailText(R)} <b>ยังมีเงินคงเหลือจำนวน ${stNf(R.outDue)} บาท</b> ซึ่งจะดำเนินการโอนให้นักเรียนในรอบที่ ${n + 1} ต่อไป`
    : ` ซึ่งได้ดำเนินการโอนให้นักเรียนครบตามจำนวนนักเรียน ${stNf(R.popN)} คน เป็นเงินทั้งสิ้น ${stBaht(R.cumAmt)}`;
  let memo = `<div class="sheet memo" style="line-height:1.22">
    ${stMemoHead(M, `รายงานการจ่ายเงิน${W.subj} ครั้งที่ ${n} ${semY}`, o.date)}
    ${stSh('เรื่องเดิม')}${stP(old)}
    ${stSh('ข้อเท็จจริง')}${stP(fact)}
    ${stMemoLaw(M)}
    <p class="ind" style="margin-top:3mm">จึงเรียนมาเพื่อโปรดทราบ</p>
    ${stMemoSig(M)}
  </div>`;
  if (o.thai) memo = stThaiDigits(memo);
  memo = await stFitMemo(memo);
  /* ตารางสรุป: รอบแรก = ผลครั้งที่ 1, รอบถัดไป = ผลสะสมทั้งภาคเรียน */
  const line2 = n === 1 ? `ครั้งที่ 1 ภาคเรียนที่ ${T}` : `ภาคเรียนที่ ${T}`;
  const tables = `<div class="sheet">${stRecvTable(M, R, line2)}${stGradeTable(M, line2, R.cumG, R.cumF)}${stRateNote(M, o.asOf)}</div>`;
