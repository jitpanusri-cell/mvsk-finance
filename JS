/* ---------- เอกสาร ---------- */
function printDoc(html, mode) {
  const d = $('printDoc');
  d.className = 'print-doc' + (mode ? ' ' + mode : '');
  d.innerHTML = html;
  // ขนาดกระดาษ/ขอบ: แบบหลักฐาน (เอกสาร 2) ตามต้นฉบับ 19/10 มม. อื่น ๆ ตามระเบียบงานสารบรรณ บน 2.5 ซ้าย 3 ขวา 2 ซม.
  let st = $('docPageStyle');
  if (!st) { st = document.createElement('style'); st.id = 'docPageStyle'; document.head.appendChild(st); }
  // ขอบกระดาษบันทึกข้อความตามคู่มือการพิมพ์หนังสือราชการ: บน 2.5 ซม. ล่าง 2 ซม. ซ้าย 3 ซม. ขวา 2 ซม.
  // (ครุฑสูง 1.5 ซม. วางชิดขอบบน 2.5 ซม. พอดี — เดิมตั้งขอบบน/ล่างไว้ 1.5 ซม. ไม่ตรงสเปก แก้แล้ว)
  st.textContent = '@media print{@page{' + ({ mv: 'size:A4 portrait;margin:0', mvl: 'size:A4 landscape;margin:0', f2mode: 'size:A4 portrait;margin:19mm 9.5mm 15mm 8.5mm', memo: 'size:A4 portrait;margin:15mm 20mm 20mm 30mm', land: 'size:A4 landscape;margin:12mm 12mm 12mm 15mm', gf: 'size:A4 portrait;margin:15mm 15mm 12mm 25mm', gfl: 'size:A4 landscape;margin:12mm 12mm 10mm 15mm', gvm: 'size:A4 portrait;margin:15mm 20mm 12mm 30mm', gvp: 'size:A4 portrait;margin:15mm 18mm 12mm 25mm', gvl: 'size:A4 landscape;margin:12mm 12mm 10mm 15mm' }[mode] || 'size:A4 portrait;margin:15mm 20mm 20mm 30mm') + '}}';
  document.body.classList.add('doc-mode');
  // เก็บสำเนา html/มุมมองปัจจุบันไว้ให้ปุ่ม "บันทึก PDF ลง Drive" ใช้ต่อได้ (ศูนย์รวมพิมพ์เอกสาร)
  window.__lastDoc = { html: html, mode: mode || '', title: docTitleFrom_(d), page: S.page };
  showPrintSaveBar(window.__lastDoc.title);
  // รอฟอนต์ TH Sarabun โหลดก่อนพิมพ์
  // แบบฟอร์มชุดใหม่ (.gv): จัดตัวอักษรกระจายแบบไทย/ดึงบรรทัดท้าย/บีบให้พอดีหน้า หลังฟอนต์โหลดแล้ว
  const go = () => { try { if (d.querySelector('.mvs')) { const keep = d.getAttribute('style') || ''; d.setAttribute('style', 'display:block;position:absolute;left:-12000px;top:0;visibility:hidden'); mvFitDoc(d); d.setAttribute('style', keep); } } catch (e) { /* ข้าม */ } try { dcTypesetDoc(d, mode); if (window.__lastDoc && d.querySelector('.gv')) window.__lastDoc.html = d.innerHTML; } catch (e) { /* ข้าม */ } setTimeout(() => window.print(), 100); };
  (document.fonts && document.fonts.load) ? Promise.all(['16pt THSarabunLocal', 'bold 16pt THSarabunLocal', '16pt THSarabunWeb', 'bold 16pt THSarabunWeb', '15px THSarabunMV', 'bold 15px THSarabunMV', '15px THSarabunMVW', 'bold 15px THSarabunMVW'].map(f => document.fonts.load(f, 'ก'))).then(go, go) : go();
}
/** เดาชื่อเอกสารจากเนื้อหาที่พิมพ์ (ไม่ต้องแก้ไขทุกจุดที่เรียก printDoc) */
function docTitleFrom_(d) {
  const mline = [...d.querySelectorAll('.mline')].find(el => /เรื่อง/.test((el.querySelector('.lb') || {}).textContent || ''));
  if (mline) { const t = mline.querySelector('.fillline'); if (t && t.textContent.trim()) return t.textContent.trim(); }
  const sel = d.querySelector('h2, .rtitle, .fhead, .ttl, .docno');
  if (sel && sel.textContent.trim()) return sel.textContent.replace(/\s+/g, ' ').trim();
  return (MENU.flatMap(g => g.items).find(i => i.id === S.page) || {}).label || 'เอกสาร';
}
/* ---------- ศูนย์รวมพิมพ์เอกสาร: แถบ "บันทึก PDF ลง Drive" ---------- */
function showPrintSaveBar(title) {
