}

/* ---------- ตัดงบ ---------- */
function openCutForm(actId, cutId) {
  const D = A.data, a = D.activities.find(x => x.id === actId), c = cutId ? D.cuts.find(x => x.id === cutId) : null;
  $('fCutAct').value = actId; $('fCutId').value = c ? c.id : '';
  $('cutActName').textContent = (a.code ? a.code + ' ' : '') + a.name;
  $('fCutFunds').innerHTML = a.lines.map((l, i) => {
    const f = fundOf(l.fund), remain = l.remain + (c && c.fund === l.fund ? c.amount : 0);
    const off = remain <= 0.004;
    const checked = c ? c.fund === l.fund : (!off && !a.lines.slice(0, i).some(x => x.remain > 0.004));
    return `<label class="cut-fund${off ? ' off' : ''}" style="--c:${f.color}">
      <input type="radio" name="cutFund" value="${l.fund}" data-remain="${remain}"${checked ? ' checked' : ''}${off ? ' disabled' : ''}>
      <span class="n">${esc(f.short)}</span><span class="rm">คงเหลือ ${money(remain)} / ${money(l.budget)}</span></label>`;
  }).join('');
  document.querySelectorAll('input[name=cutFund]').forEach(r => r.onchange = updateCutHint);
  $('fCutDate').value = c ? c.date : S.boot.today;
  $('fCutAmt').value = c ? c.amount : '';
  $('fCutDesc').value = c ? c.description : '';
  $('fCutVoucher').value = c ? c.voucherNo : '';
  $('fCutPayee').value = c ? c.payee : '';
  $('fCutNote').value = c ? c.note : '';
  updateCutHint();
  modal('actDetail').hide();
  modal('cutModal').show();
}
function updateCutHint() {
  const r = document.querySelector('input[name=cutFund]:checked'), amt = +$('fCutAmt').value || 0;
  if (!r) { $('fCutHint').innerHTML = '<div class="badbox">งบของกิจกรรมนี้ใช้หมดแล้ว — แก้ไขกิจกรรมเพื่อเพิ่มงบก่อน</div>'; return; }
  const rem = +r.dataset.remain;
  $('fCutHint').innerHTML = amt > rem + 0.004
    ? `<div class="badbox">เกินงบคงเหลือ ${money(amt - rem)} บาท</div>`
    : amt ? `<div class="muted">หลังตัดงบจะเหลือ <b>${money(rem - amt)}</b> บาท</div>` : '';
}
async function saveCutForm() {
  const r = document.querySelector('input[name=cutFund]:checked');
  if (!r) return toast('ไม่มีรายการเงินที่ตัดงบได้', true);
  const o = { id: $('fCutId').value, activityId: $('fCutAct').value, fund: r.value, date: $('fCutDate').value, amount: +$('fCutAmt').value || 0,
    description: $('fCutDesc').value, voucherNo: $('fCutVoucher').value, payee: $('fCutPayee').value, note: $('fCutNote').value };
  const btn = $('btnSaveCut'); btn.disabled = true;
  try { await api('saveActivityExpense', o); modal('cutModal').hide(); toast('ตัดงบเรียบร้อย'); await loadActivity(); openActDetail(o.activityId); }
  catch (e) { fail(e); }
  btn.disabled = false;
}

/* ---------- รายละเอียดกิจกรรม ---------- */
function openActDetail(id) {
  const D = A.data, a = D.activities.find(x => x.id === id); if (!a) return;
  const cuts = D.cuts.filter(c => c.activityId === id);
  $('dtTitle').innerHTML = `${a.code ? `<span class="muted">${esc(a.code)}</span> ` : ''}${esc(a.name)}`;
  $('dtSub').textContent = [a.dept, a.owner, STATUS_TXT[a.status]].filter(Boolean).join(' · ');
  $('dtBody').innerHTML = `
    <table class="tbl mb-4"><thead><tr><th>รายการเงิน</th><th class="num">งบที่ตั้ง</th><th class="num">ใช้ไป</th><th class="num">คงเหลือ</th></tr></thead><tbody>
      ${a.lines.map(l => { const f = fundOf(l.fund); return `<tr><td><div class="fund"><span class="bar" style="background:${f.color};height:22px"></span>${esc(f.name)}</div></td>
        <td class="num">${money(l.budget)}</td><td class="num">${money(l.spent)}</td><td class="num"><b>${money(l.remain)}</b></td></tr>`; }).join('')}
      <tr class="tot"><td>รวม</td><td class="num">${money(a.budget)}</td><td class="num">${money(a.spent)}</td><td class="num">${money(a.remain)}</td></tr></tbody></table>
    <div class="card-h mb-2"><h3 style="font-size:15px">รายการตัดงบ (${cuts.length})</h3></div>
    ${cuts.length ? `<div class="table-responsive"><table class="tbl"><thead><tr><th>วันที่</th><th>รายการ</th><th>จากเงิน</th><th class="num">จำนวนเงิน</th><th></th></tr></thead><tbody>
      ${cuts.map(c => `<tr><td style="white-space:nowrap">${thDate(c.date, true)}</td>
        <td><div>${esc(c.description)}</div><div class="act-sub">${[c.voucherNo && 'ฎีกา ' + c.voucherNo, c.payee].filter(Boolean).map(esc).join(' · ')}</div></td>
        <td>${chip(c.fund, c.amount).replace(/<b>.*<\/b>/, '')}</td><td class="num">${money(c.amount)}</td>
        <td class="text-end" style="white-space:nowrap">${D.canEdit ? `<button class="linkbtn" data-edit="${c.id}" title="แก้ไข">${ic('edit','sm')}</button><button class="linkbtn" style="color:var(--bad)" data-del="${c.id}" title="ลบ">${ic('trash','sm')}</button>` : ''}</td></tr>`).join('')}
      </tbody></table></div>` : '<div class="muted small-x">ยังไม่มีการตัดงบ</div>'}`;
  $('dtFoot').innerHTML = D.canEdit ? `
    ${!a.cutCount ? `<button class="btnx sec" style="color:var(--bad);border-color:var(--bad)" id="dtDel">${ic('trash','sm')}ลบกิจกรรม</button>` : ''}
    <button class="btnx sec" id="dtEdit">${ic('edit','sm')}แก้ไขกิจกรรม</button>
    ${a.status === 'active' ? `<button class="btnx pri" id="dtCut">${ic('cut','sm')}ตัดงบ</button>` : ''}` : '';
  const on = (sel, fn) => { const el = $(sel); if (el) el.onclick = fn; };
  on('dtEdit', () => { modal('actDetail').hide(); openActForm(id); });
  on('dtCut', () => openCutForm(id));
  on('dtDel', async () => {
    if (!confirm('ลบกิจกรรม "' + a.name + '" ?')) return;
    try { await api('deleteActivity', id); modal('actDetail').hide(); toast('ลบกิจกรรมแล้ว'); loadActivity(); } catch (e) { fail(e); }
  });
  $('dtBody').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openCutForm(id, b.dataset.edit));
  $('dtBody').querySelectorAll('[data-del]').forEach(b => b.onclick = async () => {
    if (!confirm('ลบรายการตัดงบนี้?')) return;
    try { await api('deleteActivityExpense', b.dataset.del); toast('ลบแล้ว'); await loadActivity(); openActDetail(id); } catch (e) { fail(e); }
  });
  modal('actDetail').show();
}

/* =========================================================
 * ค่าอุปกรณ์การเรียนฯ (ติดตามรับเงินค่าอุปกรณ์ / ค่าเครื่องแบบนักเรียน)
 * ========================================================= */
const ST = { term: null, fund: 'EQUIP', data: null, grade: '', rooms: new Set(), sel: {}, imp: null, disb: null, disbTab: 'req', both: true, batch: 0 };
const STATUS_LBL = { active: 'กำลังศึกษา', moved: 'ย้าย', left: 'ลาออก' };

function initStudentsPage() {
  if (ST.inited) return;
  ST.inited = true;
  const terms = [];
  S.boot.fyList.forEach(y => { terms.push('1/' + y, '2/' + (y - 1)); });
  /* แสดงทั้งภาคเรียนที่ 1 และ 2 ของปีการศึกษาปัจจุบันเสมอ (เช่น 1/2569 และ 2/2569) */
  terms.push('1/' + S.boot.currentFy, '2/' + S.boot.currentFy);
  const uniq = [...new Set(terms)].sort((a, b) => { const k = t => +t.split('/')[1] * 10 + (t[0] === '2' ? 5 : 0); return k(b) - k(a); });
  ST.term = '1/' + S.boot.currentFy;
  $('stTerm').innerHTML = uniq.map(t => `<option value="${t}"${t === ST.term ? ' selected' : ''}>ภาคเรียนที่ ${t}</option>`).join('');
  $('stTerm').onchange = e => { ST.term = e.target.value; ST.rooms.clear(); stSyncFundSeg(); loadStudents(); };
  stSyncFundSeg();
  $('stFund').querySelectorAll('button').forEach(b => b.onclick = () => {
    ST.fund = b.dataset.f; ST.rooms.clear();
    $('stFund').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    loadStudents();
  });
  $('btnStImport').innerHTML = ic('upload') + '<span>นำเข้ารายชื่อ DMC</span>';
  $('btnStImport').onclick = openStImport;
  $('stQ').oninput = renderStList;
  $('impFile').onchange = readImpFile;
  $('impPaste').oninput = () => parseImpText($('impPaste').value);
  $('btnStDoImport').onclick = doStImport;
  $('btnImpUrl').onclick = doStImportUrl;
  $('btnDisbPrint').innerHTML = ic('print', 'sm') + '<span>พิมพ์</span>';
  $('btnDisbPrint').onclick = openStMemo;
  $('btnStForm2').innerHTML = ic('print', 'sm') + '<span>พิมพ์เอกสารหมายเลข 2</span>';
  $('btnStForm2').onclick = printForm2Sel;
  $('btnStCid').innerHTML = ic('upload', 'sm') + '<span>อัปโหลดเลขประชาชน (DMC)</span>';
  $('btnStCid').onclick = () => { $('stCidFile').value = ''; $('stCidFile').click(); };
  $('stCidFile').onchange = stUploadCid;
  window.addEventListener('afterprint', () => { document.body.classList.remove('doc-mode'); const st = $('docPageStyle'); if (st) st.textContent = ''; });
}

/* ภาคเรียนที่ 2 จ่ายเฉพาะค่าอุปกรณ์การเรียน: ซ่อนปุ่มค่าเครื่องแบบ และสลับกลับเป็นค่าอุปกรณ์ */
function stSyncFundSeg() {
  const t2 = ST.term[0] === '2';
  if (t2 && ST.fund === 'UNIFORM') ST.fund = 'EQUIP';
  $('stFund').querySelectorAll('button').forEach(x => {
    x.classList.toggle('on', x.dataset.f === ST.fund);
    x.style.display = (t2 && x.dataset.f === 'UNIFORM') ? 'none' : '';
  });
}

async function loadStudents() {
  initStudentsPage();
  loading(true);
  try {
    // เดิมเรียก getPaymentTracking + getDisbursement แยกกัน 2 คำสั่งพร้อมกัน (Promise.all)
    // ซึ่งยังทำให้เซิร์ฟเวอร์เปิดรัน 2 รอบและอ่านชีต Students/StudentPayments ซ้ำ จึงรวมเป็นคำสั่งเดียว
    const r = await api('getStudentPageData', ST.term, ST.fund);
    const d = r.tracking, b = r.disb;
    ST.data = d; ST.disb = b; ST.sel = {};
    const last = b.batches.length ? b.batches[b.batches.length - 1].batch : 1;
    if (!ST.batch || ST.batch > b.nextBatch) ST.batch = last;
    if (ST.disbTab !== 'req' && !b.batches.some(x => 'b' + x.batch === ST.disbTab)) ST.disbTab = 'req';
    renderStudents();
  } catch (e) { fail(e); }
  loading(false);
}
const roomCls = r => !r.total ? 'none' : r.pct >= 100 ? 'full' : r.pct >= 95 ? 'hi' : r.pct >= 90 ? 'mid' : 'lo';
const fundTxt = f => f === 'EQUIP' ? 'ค่าอุปกรณ์การเรียน' : 'ค่าเครื่องแบบนักเรียน';
const roomSort = (a, b) => a.localeCompare(b, 'th', { numeric: true });

function renderStudents() {
  const D = ST.data, T = D.summary;
  $('btnStImport').style.display = D.canManage ? '' : 'none';
  $('stSub').textContent = `${fundTxt(D.fund)} ภาคเรียนที่ ${D.term} · อัตรา ม.ต้น ${money(D.rate.lower)} / ม.ปลาย ${money(D.rate.upper)} บาทต่อคน` +
    (D.deadline ? ` · กำหนดรับถึง ${thDate(D.deadline)}` : '');
  // ประกาศ
  let n = '';
  if (D.onlyTerm1) n = `<div class="banner"><div class="grow"><b>ค่าเครื่องแบบนักเรียนจ่ายเฉพาะภาคเรียนที่ 1</b><div class="muted small-x">เลือกภาคเรียนที่ 1 เพื่อติดตามการรับเงิน</div></div></div>`;
  else if (!D.hasStudents) n = `<div class="banner"><div class="brand-logo" style="background:#fff;color:var(--gold)">${ic('students')}</div>
      <div class="grow"><div class="head" style="font-size:16px">ยังไม่มีรายชื่อนักเรียนปีการศึกษา ${D.acadYear}</div>
      <div class="muted small-x">นำเข้าไฟล์รายชื่อจากระบบ DMC (Excel หรือ CSV) เพื่อเริ่มติดตามการรับเงินรายคน</div></div>
      ${D.canManage ? `<button class="btnx pri" onclick="openStImport()">${ic('upload')}นำเข้ารายชื่อ</button>` : ''}</div>`;
  else {
    if (T.legacy && !T.paidAmount) n += `<div class="banner small-x"><div class="grow">ตารางเดิมบันทึกว่า <b>${fundTxt(D.fund)} ภาค ${D.term}</b> โอนให้นักเรียนแล้ว <b>${money(T.legacy)}</b> บาท
      เมื่อเริ่มบันทึกรับเงินรายคน ระบบจะใช้ยอดจากรายชื่อแทนยอดนี้</div></div>`;
    if (D.pastDeadline && (T.unpaid || T.left) && D.canManage) n += `<div class="banner" style="background:var(--bad-bg);border-color:#F3CFCB">
      <div class="grow"><b>เลยกำหนดรับเงินแล้ว (${thDate(D.deadline)})</b><div class="small-x">ยังไม่รับ ${T.unpaid} คน · ย้าย/ลาออก ${T.left} คน${D.refundSent ? ` · ส่งไปเงินเหลือจ่ายแล้ว ${money(D.refundSent)} บาท` : ''}</div></div>
      <button class="btnx pri" id="btnClose">ส่งยอดคงค้างไปเงินเหลือจ่าย</button></div>`;
  }
  $('stNotice').innerHTML = n;
  const bc = $('btnClose'); if (bc) bc.onclick = doCloseUnclaimed;
  const show = D.hasStudents && !D.onlyTerm1;
  ['stTop', 'stGrades'].forEach(id => $(id).closest('.cardx, .st-top').style.display = show ? '' : 'none');
  document.querySelector('#page-students .st-grid').style.display = show ? '' : 'none';
  $('stDisbCard').style.display = D.hasStudents ? '' : 'none';
  $('stF2Card').style.display = show ? '' : 'none';
  if (D.hasStudents) renderDisb();
  if (!show) return;
  renderForm2Opts();

  const R = 46, C = 2 * Math.PI * R, p = T.pct / 100;
  $('stTop').innerHTML = `
    <div class="kpi ring-card">
      <div class="ring"><svg viewBox="0 0 112 112" aria-hidden="true"><circle cx="56" cy="56" r="${R}" fill="none" stroke="#EEEAE1" stroke-width="12"/>
        <circle cx="56" cy="56" r="${R}" fill="none" stroke="#1C6B42" stroke-width="12" stroke-linecap="round" stroke-dasharray="${C * p} ${C}"/></svg>
        <div class="t"><div><b>${pct(T.pct)}</b><br><small>รับแล้ว</small></div></div></div>
      <div class="ring-meta">นักเรียนทั้งหมด <b>${T.total.toLocaleString('th-TH')}</b> คน<br>
        รับแล้ว <b>${T.paid.toLocaleString('th-TH')}</b> · ยังไม่รับ <b>${T.unpaid.toLocaleString('th-TH')}</b><br>
        ${T.left ? `ย้าย/ลาออก <b>${T.left}</b> คน<br>` : ''}เงินที่ได้รับจัดสรร <b>${money(T.received)}</b></div>
    </div>
    <div class="kpi alert"><div class="l">${ic('warn','sm')}ยังไม่รับ</div>
      <div class="v">${T.unpaid.toLocaleString('th-TH')}<small>คน</small></div><div class="f">เป็นเงิน ${money(T.unpaidAmount)} บาท</div></div>
    <div class="kpi"><div class="l">${ic('check','sm')}จ่ายแล้ว</div>
      <div class="v">${moneyKpi(T.paidAmount)}<small>บาท</small></div><div class="f">${T.paid.toLocaleString('th-TH')} คน</div></div>
    <div class="kpi cream"><div class="l">${ic('balance','sm')}คงค้าง (ได้รับ − จ่ายแล้ว)</div>
      <div class="v ${T.remain < -0.004 ? 'neg' : ''}">${moneyKpi(T.remain)}<small>บาท</small></div>
      <div class="f">${Math.abs(T.remain - T.unpaidAmount - T.leftAmount) > 0.5 ? 'ต่างจากยอดตามรายชื่อ ' + money(T.remain - T.unpaidAmount - T.leftAmount) : 'ตรงกับยอดตามรายชื่อ'}</div></div>`;

  $('stGrades').innerHTML = D.grades.map(g => `<button class="gbar${ST.grade === g.grade ? ' on' : ''}" data-g="${g.grade}" ${g.total ? '' : 'disabled'}>
      <div class="h">${g.grade}<span>${g.total ? pct(g.pct) : '–'}</span></div>
      <div class="meter"><i style="width:${g.pct}%"></i></div>
      <div class="s">${g.total ? `รับแล้ว ${g.paid}/${g.total} · ค้าง ${g.unpaid}` : 'ไม่มีนักเรียน'}</div></button>`).join('');
  $('stGrades').querySelectorAll('.gbar').forEach(b => b.onclick = () => {
    ST.grade = ST.grade === b.dataset.g ? '' : b.dataset.g; renderStudents();
  });
  renderRooms(); renderStList();
}

function renderRooms() {
  const D = ST.data;
  const grades = D.grades.filter(g => g.total && (!ST.grade || g.grade === ST.grade)).map(g => g.grade);
  const nSel = ST.rooms.size;
  const visibleRooms = D.rooms.filter(r => r.total && grades.indexOf(r.grade) >= 0).map(r => r.room);
  const allSel = visibleRooms.length && visibleRooms.every(r => ST.rooms.has(r));
  $('stRoomTitle').innerHTML = (ST.grade ? 'รายห้อง ' + ST.grade : 'รายห้อง (ทุกชั้น)') +
    ' <span class="muted small-x" style="font-family:var(--f-body);font-weight:400">ตัวเลข = คนที่ยังไม่รับ · แตะเลือกได้หลายห้องพร้อมกัน</span>' +
    (visibleRooms.length ? ` <button class="linkbtn" id="stSelAllRooms">${allSel ? 'เลือกแล้วทุกห้อง' : (ST.grade ? 'เลือกทั้งชั้น ' + ST.grade : 'เลือกทั้งหมดทุกชั้น')}</button>` : '') +
    (nSel ? ` <button class="linkbtn" id="stClearRooms">ล้างที่เลือก (${nSel})</button>` : '') +
    (ST.grade && !D.onlyTerm1 ? ` <button class="linkbtn" id="stPrintGrade">${ic('print','sm')} แบบหลักฐานทั้งชั้น ${ST.grade}</button>` : '');
  const pg = $('stPrintGrade'); if (pg) pg.onclick = () => printForm2(D.rooms.filter(r => r.grade === ST.grade).map(r => r.room).sort(roomSort));
  const cr = $('stClearRooms'); if (cr) cr.onclick = () => { ST.rooms.clear(); ST.sel = {}; renderRooms(); renderStList(); };
  const sa = $('stSelAllRooms'); if (sa) sa.onclick = () => { visibleRooms.forEach(r => ST.rooms.add(r)); ST.sel = {}; renderRooms(); renderStList(); };
  $('stRooms').innerHTML = grades.map(g => {
    const rs = D.rooms.filter(r => r.grade === g).sort((a, b) => roomSort(a.room, b.room));
    return `<div class="rrow"><div class="rg">${g}</div><div class="rcells">${rs.map(r => `<button class="rcell ${roomCls(r)}${ST.rooms.has(r.room) ? ' sel' : ''}" data-r="${r.room}"
      title="${r.room} รับแล้ว ${r.paid}/${r.total} · แตะเพื่อเลือก/ยกเลิก"><b>/${r.room.split('/')[1] || ''}</b><small>${r.total ? (r.unpaid ? r.unpaid : '✓') : '–'}</small></button>`).join('')}</div></div>`;
  }).join('');
  $('stRooms').querySelectorAll('.rcell').forEach(b => b.onclick = () => {
    const r = b.dataset.r;
    if (ST.rooms.has(r)) ST.rooms.delete(r); else ST.rooms.add(r);
    ST.sel = {};
    renderRooms(); renderStList();
  });
}

function renderStList() {
  const D = ST.data; if (!D) return;
  const q = $('stQ').value.trim().toLowerCase();
  let list;
  if (ST.rooms.size) {
    const rset = ST.rooms;
    list = D.students.filter(s => rset.has(s.room)).sort((a, b) => roomSort(a.room, b.room) || (a.no || 0) - (b.no || 0));
    const roomNames = [...ST.rooms].sort(roomSort);
    $('stListTitle').textContent = (roomNames.length === 1 ? 'ห้อง ' + roomNames[0] : roomNames.length + ' ห้อง: ' + roomNames.join(', ')) + ' (' + list.length + ' คน)';
  } else {
    list = D.students.filter(s => s.status === 'active' && !s.payId && (!ST.grade || s.grade === ST.grade));
    $('stListTitle').textContent = 'ยังไม่รับเงิน' + (ST.grade ? ' ' + ST.grade : '') + ' (' + list.length + ' คน)';
  }
  if (q) list = list.filter(s => (s.name + ' ' + s.id).toLowerCase().includes(q));
  const tools = [];
  if (D.canPay && ST.rooms.size) tools.push(`<button class="btnx pri sm" id="stPayRoom">รับทั้ง${ST.rooms.size > 1 ? 'ห้องที่เลือก' : 'ห้อง'}</button>`);
  if (ST.rooms.size) tools.push(`<button class="btnx sec sm" id="stPrintSign">${ic('print','sm')}แบบหลักฐาน (เอกสาร 2)</button>`);
  else tools.push(`<button class="btnx sec sm" id="stPrintUnpaid">${ic('print','sm')}พิมพ์รายชื่อ</button>`);
  $('stListTools').innerHTML = `<div class="d-flex gap-2">${tools.join('')}</div>`;
  const LIM = 400;
  /* ตั้งเหตุผลการโอนครั้งที่ 2 เป็นต้นไป (แสดงเมื่อภาคเรียนนี้โอนไปแล้วอย่างน้อย 1 ครั้ง) */
  const RETRY = { returned: 'ตีกลับ/โอนไม่สำเร็จ', new: 'นักเรียนเข้าใหม่', wrong: 'โอนผิดบัญชี' };
  const RETRY_S = { returned: 'ตีกลับ', new: 'เข้าใหม่', wrong: 'ผิดบัญชี' };
  const canRetry = D.canManage && ST.disb && ST.disb.batches.length > 0;
  const unpaidShown = list.filter(s => !s.payId && s.status === 'active');
  const gradeOpts = D.grades.filter(g => list.some(s => !s.payId && s.status === 'active' && s.grade === g.grade));
  const bar = D.canPay && unpaidShown.length ? `<div class="st-actions">
      <label class="small-x d-inline-flex align-items-center gap-2"><input type="checkbox" id="stAll" style="width:18px;height:18px"> เลือกทั้งหมด${list.length > LIM ? ' (' + list.length + ' คน)' : ''}</label>
      ${gradeOpts.length > 1 ? `<label class="small-x d-inline-flex align-items-center gap-1">หรือเลือกทั้งชั้น
        <select class="inp" id="stSelGrade" style="width:auto;min-height:36px"><option value="">-- เลือกชั้น --</option>${gradeOpts.map(g => `<option value="${g.grade}">${g.grade}</option>`).join('')}</select></label>` : ''}
      <input class="inp" type="date" id="stDate" value="${D.today}" aria-label="วันที่รับเงิน">
      <label class="small-x d-inline-flex align-items-center gap-1">โอนครั้งที่
        <select class="inp" id="stBatch" style="width:auto;min-height:36px">${Array.from({ length: ST.disb.nextBatch }, (_, i) => i + 1).map(n => `<option${n === ST.batch ? ' selected' : ''}>${n}</option>`).join('')}</select></label>
      ${ST.term[0] === '1' ? `<label class="small-x d-inline-flex align-items-center gap-1"><input type="checkbox" id="stBoth" style="width:18px;height:18px"${ST.both ? ' checked' : ''}> จ่ายค่าอุปกรณ์+ค่าเครื่องแบบพร้อมกัน</label>` : ''}
      <button class="btnx pri sm" id="stPaySel" disabled>บันทึกรับเงิน (<span id="stSelN">0</span>)</button>
      ${canRetry ? `<label class="small-x d-inline-flex align-items-center gap-1">เหตุผลที่ต้องโอนรอบนี้ (คนที่เลือก)
        <select class="inp" id="stRetryBulk" style="width:auto;min-height:36px"><option value="">-- เลือก --</option>${Object.keys(RETRY).map(k => `<option value="${k}">${RETRY[k]}</option>`).join('')}</select></label>` : ''}</div>` : '';
  $('stList').innerHTML = bar + (list.length ? `<div class="st-list">${list.slice(0, LIM).map(s => {
    const paid = !!s.payId;
    return `<div class="stu${paid ? ' paid' : ''}">
      ${D.canPay && !paid && s.status === 'active' ? `<input type="checkbox" data-id="${esc(s.id)}"${ST.sel[s.id] ? ' checked' : ''} aria-label="เลือก ${esc(s.name)}">` : '<span style="width:18px"></span>'}
      <div class="n"><div>${s.no ? s.no + '. ' : ''}${esc(s.name)}</div><div class="m">${esc(s.id)} · ${s.room}${paid ? ' · รับ ' + thDate(s.paidDate, true) : ''}</div></div>
      ${D.canManage ? `<select data-st="${esc(s.id)}" aria-label="สถานะ">${Object.keys(STATUS_LBL).map(k => `<option value="${k}"${k === s.status ? ' selected' : ''}>${STATUS_LBL[k]}</option>`).join('')}</select>`
        : (s.status !== 'active' ? `<span class="st none">${STATUS_LBL[s.status]}</span>` : '')}
      ${canRetry && !paid && s.status === 'active' ? `<select data-retry="${esc(s.id)}" aria-label="เหตุผลที่ต้องโอนรอบนี้" title="เหตุผลที่ต้องโอนรอบนี้">${Object.keys(RETRY_S).map(k => `<option value="${k}"${k === (s.retry || 'returned') ? ' selected' : ''}>${RETRY_S[k]}</option>`).join('')}</select>` : ''}
      ${paid ? `<span class="st ok">${money(s.paid)}</span>${D.canPay ? `<button class="linkbtn" data-undo="${s.payId}" title="ยกเลิก">${ic('trash','sm')}</button>` : ''}`
        : `<span class="amt muted">${money(s.due)}</span>`}
    </div>`; }).join('')}${list.length > LIM ? `<div class="muted small-x p-2">แสดง ${LIM} จาก ${list.length} คน — เลือกชั้นหรือห้องเพื่อดูเพิ่ม</div>` : ''}</div>`
    : `<div class="empty" style="padding:24px"><div class="ic" style="background:var(--ok-bg);color:var(--ok)">${ic('check')}</div><div class="fw-semibold">${ST.rooms.size ? 'ไม่มีนักเรียน' : 'รับเงินครบแล้ว'}</div></div>`);

  const upd = () => { const n = Object.keys(ST.sel).filter(k => ST.sel[k]).length; if ($('stSelN')) { $('stSelN').textContent = n; $('stPaySel').disabled = !n; } };
  $('stList').querySelectorAll('input[data-id]').forEach(c => c.onchange = () => { ST.sel[c.dataset.id] = c.checked; upd(); });
  // "เลือกทั้งหมด" ใช้จาก unpaidShown (รายชื่อทั้งหมดที่ตรงตัวกรอง) ไม่ใช่แค่ที่แสดงในจอ กันพลาดกรณีเกิน 400 คน
  const all = $('stAll'); if (all) all.onchange = () => {
    unpaidShown.forEach(s => ST.sel[s.id] = all.checked);
    renderStList();
  };
  const selGrade = $('stSelGrade'); if (selGrade) selGrade.onchange = () => {
    if (!selGrade.value) return;
    unpaidShown.filter(s => s.grade === selGrade.value).forEach(s => ST.sel[s.id] = true);
    renderStList();
  };
  upd();
  const bs = $('stBatch'); if (bs) bs.onchange = () => ST.batch = +bs.value;
  const bo = $('stBoth'); if (bo) bo.onchange = () => ST.both = bo.checked;
  const ps = $('stPaySel'); if (ps) ps.onclick = () => doPay(Object.keys(ST.sel).filter(k => ST.sel[k]));
  const pr = $('stPayRoom'); if (pr) pr.onclick = doPayRoom;
  const sg = $('stPrintSign'); if (sg) sg.onclick = () => printForm2([...ST.rooms].sort(roomSort));
  const pu = $('stPrintUnpaid'); if (pu) pu.onclick = printUnpaid;
  $('stList').querySelectorAll('[data-undo]').forEach(b => b.onclick = async () => {
    const who = (ST.data.students.find(x => x.payId === b.dataset.undo) || {}).name || 'นักเรียนคนนี้';
    const both = ST.term[0] === '1';
    if (!confirm(`ยกเลิกการรับเงินของ ${who} เฉพาะคนนี้คนเดียว?` + (both ? '\n(ยกเลิกทั้งค่าอุปกรณ์การเรียนและค่าเครื่องแบบนักเรียนของรอบนี้พร้อมกัน)' : '') +
      '\nจากนั้นเลือกเหตุผลได้ที่รายชื่อ "ยังไม่รับเงิน" (ตีกลับ / โอนผิดบัญชี)')) return;
    loading(true); try { const r = await api('cancelPayment', b.dataset.undo); await loadStudents(); toast(`ยกเลิกแล้ว ${r && r.funds ? r.funds.length : 1} รายการเงินของ ${who}`); } catch (e) { fail(e); }
  });
  $('stList').querySelectorAll('select[data-retry]').forEach(sel => sel.onchange = () => saveRetry([sel.dataset.retry], sel.value));
  const rb = $('stRetryBulk'); if (rb) rb.onchange = () => {
    const ids = Object.keys(ST.sel).filter(k => ST.sel[k]);
    if (!rb.value) return;
    if (!ids.length) { rb.value = ''; return toast('เลือกนักเรียนก่อน แล้วค่อยตั้งเหตุผล', true); }
    saveRetry(ids, rb.value);
  };
  $('stList').querySelectorAll('select[data-st]').forEach(sel => sel.onchange = async () => {
    loading(true); try { await api('setStudentStatus', sel.dataset.st, ST.data.acadYear, sel.value); await loadStudents(); toast('เปลี่ยนสถานะแล้ว'); } catch (e) { fail(e); }
  });
}

/* บันทึกเหตุผลที่ต้องโอนในครั้งที่ 2 เป็นต้นไป (ไม่ต้องโหลดหน้าใหม่ทั้งหน้า) */
async function saveRetry(ids, reason) {
  loading(true);
  try {
    const n = await api('setRetryReason', ST.term, ids, reason);
    const set = new Set(ids.map(String));
    ST.data.students.forEach(s => { if (set.has(String(s.id))) s.retry = reason; });
    toast(`ตั้งเหตุผล ${n} คน: ${{ returned: 'ตีกลับ/โอนไม่สำเร็จ', new: 'นักเรียนเข้าใหม่', wrong: 'โอนผิดบัญชี' }[reason]}`);
    renderStList();
  } catch (e) { fail(e); }
  loading(false);
}
async function doPay(ids) {
  if (!ids.length) return;
  const d = $('stDate').value;
  loading(true);
  try { const r = await api('savePayment', ST.term, payFunds(), ids, d, '', ST.batch); await loadStudents(); toast(`บันทึกรับเงิน ${r.saved} รายการ (โอนครั้งที่ ${r.batch})`); }
  catch (e) { fail(e); }
}
const payFunds = () => (ST.term[0] === '1' && ST.both) ? ['EQUIP', 'UNIFORM'] : ST.fund;
async function doPayRoom() {
  const d = $('stDate') ? $('stDate').value : ST.data.today;
  const rooms = [...ST.rooms].sort(roomSort);
  if (!rooms.length) return;
  const n = ST.data.students.filter(s => rooms.includes(s.room) && s.status === 'active' && !s.payId).length;
  if (!n) return toast('ห้องที่เลือกรับเงินครบแล้ว');
  const label = rooms.length > 1 ? rooms.length + ' ห้อง (' + rooms.join(', ') + ')' : 'ห้อง ' + rooms[0];
  if (!confirm(`บันทึกรับเงินทั้ง${label} จำนวน ${n} คน วันที่ ${thDate(d)} ?`)) return;
  loading(true);
  try { const r = await api('savePaymentByRoom', rooms.length === 1 ? rooms[0] : rooms, ST.term, payFunds(), d, ST.batch); await loadStudents(); toast(`บันทึกรับเงิน ${r.saved} คน`); }
  catch (e) { fail(e); }
}
async function doCloseUnclaimed() {
  const T = ST.data.summary;
  if (!confirm(`ส่งยอดคงค้าง ${money(T.remain)} บาท ไปรายการเงินเหลือจ่าย/ส่งคืน?`)) return;
  loading(true);
  try { const r = await api('closeUnclaimed', ST.term, ST.fund); await loadStudents(); toast('ส่งไปเงินเหลือจ่ายแล้ว ' + money(r.total) + ' บาท'); }
  catch (e) { fail(e); }
}

