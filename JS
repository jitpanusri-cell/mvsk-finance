function parseImpText(t) {
  t = String(t || '').replace(/^﻿/, '');
  if (!t.trim()) { $('impPreview').innerHTML = ''; $('btnStDoImport').disabled = true; return; }
  const delim = t.includes('\t') ? '\t' : ',';
  const rows = [];
  let row = [], cur = '', q = false;
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (q) { if (c === '"' && t[i + 1] === '"') { cur += '"'; i++; } else if (c === '"') q = false; else cur += c; }
    else if (c === '"') q = true;
    else if (c === delim) { row.push(cur); cur = ''; }
    else if (c === '\n' || c === '\r') { if (c === '\r' && t[i + 1] === '\n') i++; row.push(cur); rows.push(row); row = []; cur = ''; }
    else cur += c;
  }
  if (cur || row.length) { row.push(cur); rows.push(row); }
  mapImpRows(rows);
}
function mapImpRows(rows, quiet) {
  const test = (h, re) => re.test(String(h).replace(/\s+/g, ' ').trim());
  let hi = -1, col = {};
  for (let r = 0; r < Math.min(rows.length, 15) && hi < 0; r++) {
    const c = {};
    rows[r].forEach((h, i) => {
      if (c.id == null && test(h, /เลขประจำตัวนักเรียน|รหัสนักเรียน|^เลขประจำตัว$|student\s*id/i)) c.id = i;
      else if (c.cid == null && test(h, /ประชาชน/)) c.cid = i;
      else if (c.prefix == null && test(h, /คำนำหน้า/)) c.prefix = i;
      else if (c.full == null && test(h, /ชื่อ\s*[-–]?\s*(นาม)?สกุล/)) c.full = i;
      else if (c.last == null && test(h, /^(นาม)?สกุล/)) c.last = i;
      else if (c.first == null && test(h, /^ชื่อ/)) c.first = i;
      else if (c.grade == null && test(h, /^(ระดับ)?ชั้น/)) c.grade = i;
      else if (c.room == null && test(h, /^ห้อง/)) c.room = i;
      else if (c.no == null && test(h, /^(เลขที่|ที่|no\.?)$/i)) c.no = i;
      else if (c.acct == null && test(h, /เลขบัญชี|เลขที่บัญชี/)) c.acct = i;
      else if (c.bank == null && test(h, /^ธนาคาร/)) c.bank = i;
    });
    if ((c.first != null || c.full != null) && c.grade != null) { hi = r; col = c; }
  }
  if (hi < 0) {
    if (quiet) return null;
    $('impPreview').innerHTML = '<div class="badbox small-x">ไม่พบหัวตาราง ต้องมีคอลัมน์ ชื่อ (หรือ ชื่อ-สกุล) และ ชั้น/ระดับชั้น</div>'; $('btnStDoImport').disabled = true; return null;
  }
  const PFX = /^(เด็กชาย|เด็กหญิง|ด\.ช\.|ด\.ญ\.|นางสาว|น\.ส\.|นาย|นาง)\s*/;
  const g = (r, k) => col[k] != null ? String(r[col[k]] == null ? '' : r[col[k]]).trim() : '';
  const out = rows.slice(hi + 1).map(r => {
    let prefix = g(r, 'prefix'), first = g(r, 'first'), last = g(r, 'last');
    if (col.full != null) { let f = g(r, 'full').replace(/\s+/g, ' '); const m = f.match(PFX); if (m && !prefix) prefix = m[1]; f = f.replace(PFX, ''); const p = f.split(' '); first = p.shift() || ''; last = p.join(' '); }
    let grade = g(r, 'grade'), room = g(r, 'room');
    const gm = grade.match(/([1-6])\s*\/\s*(\d+)/); if (gm) { grade = 'ม.' + gm[1]; if (!room) room = gm[2]; }
    return { studentId: g(r, 'id'), prefix: prefix, firstName: first, lastName: last, grade: grade, room: room, no: g(r, 'no'),
      citizenId: g(r, 'cid'), bankAccount: g(r, 'acct'), bank: g(r, 'bank') };
  }).filter(s => s.firstName && s.grade);
  if (quiet) return out;
  showImpPreview(out);
  return out;
}
