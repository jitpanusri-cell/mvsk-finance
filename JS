function dcGaruda() { const u = dcSchoolInfo().garudaUrl; return garudaImg(u); }
/* ช่องกรอก: มีข้อมูล = พิมพ์ข้อความตรง ๆ ไม่มีเส้นประ (ตามแบบของโรงเรียน), ว่าง = เว้นเส้นประให้เขียนมือ */
const gD = (v, w, left) => (v === 0 || (v && String(v).trim()))
  ? `<span class="dv">${esc(v)}</span>`
  : `<span class="dl${left ? ' l' : ''}" style="min-width:${w || 30}mm">&nbsp;</span>`;
const gM = v => (+v ? money(v) : '');
const gCb = on => `<span class="cb${on ? ' on' : ''}"></span>`;
const gPad = (rows, n, blank) => rows.concat(Array.from({ length: Math.max(0, n - rows.length) }, () => blank));
function thParts(iso) {
  if (!iso) return { d: '', m: '', y: '' };
  const p = String(iso).slice(0, 10).split('-').map(Number);
  return { d: p[2], m: MTH[p[1] - 1], y: p[0] + 543 };
}
const thDateLine = iso => { const t = thParts(iso); return `วันที่ ${gD(t.d, 12)} เดือน ${gD(t.m, 30)} พ.ศ. ${gD(t.y, 18)}`; };
const dcTime = dt => dt && String(dt).length > 10 ? String(dt).slice(11, 16).replace(':', '.') : '';
function dcDuration(r) {
  if (!r.departAt || !r.returnAt) return null;
  const h = (new Date(r.returnAt) - new Date(r.departAt)) / 3600000;
  if (!(h > 0)) return null;
  return { days: Math.floor(h / 24), hours: Math.round((h % 24) * 10) / 10 };
}
/* บรรทัด "รายการ | จำนวนเงิน" (คั่นด้วย | หรือ Tab) */
function dcLines(text) {
  if (String(text || '').trim().charAt(0) === '[') return dcItemsParse(text).map(it => ({ t: dcItemText(it), amt: dcItemAmt(it) })).filter(x => x.t || x.amt);
  return String(text || '').split('\n').map(s => s.trim()).filter(Boolean).map(s => {
    const p = s.split(/\s*[|\t]\s*/);
    const amt = p.length > 1 ? +String(p[p.length - 1]).replace(/,/g, '') : NaN;
    return isNaN(amt) ? { t: s, amt: 0 } : { t: p.slice(0, -1).join(' '), amt: amt };
  });
}
const dcPerdiem = r => r.perdiemRate * r.perdiemDays * r.people;
const dcLodge = r => r.lodgeRate * r.lodgeDays * r.people;
/* รายการค่าใช้จ่ายทั้งหมด (ใช้ในสัญญายืม / บันทึกขออนุมัติเบิก / ใบสำคัญรับเงิน) */
function dcCostLines(r) {
  const L = [];
  if (dcPerdiem(r)) L.push({ t: `ค่าเบี้ยเลี้ยงเดินทาง ${dcFmtN(r.perdiemRate)} บาท × ${dcFmtN(r.perdiemDays)} วัน × ${dcFmtN(r.people)} คน`, amt: dcPerdiem(r) });
  if (dcLodge(r)) L.push({ t: `ค่าเช่าที่พัก ${dcFmtN(r.lodgeRate)} บาท × ${dcFmtN(r.lodgeDays)} คืน × ${dcFmtN(r.people)} คน`, amt: dcLodge(r) });
  if (r.transportAmount) L.push({ t: 'ค่าพาหนะเดินทาง' + (r.transportRoutes ? ' (' + dcLines(r.transportRoutes).map(x => x.t).join(', ') + ')' : ''), amt: r.transportAmount });
  if (r.otherAmount) L.push({ t: r.otherDesc || 'ค่าใช้จ่ายอื่น', amt: r.otherAmount });
  dcLines(r.itemsText).forEach(x => L.push(x));
  if (!L.length) L.push({ t: r.purpose, amt: r.total });
  return L;
}
