async function loadPrintCenter() {
  $('prNotice').innerHTML = '';
  const hist = $('prHistory') && $('prHistory').closest('.cardx'); if (hist) hist.hidden = true;
  renderPrintCenter();
}
function renderPrintCenter() {
  const allowed = S.boot.user.pages;
  $('prCatalog').innerHTML = PR_DOCS.map(g => {
    const items = g.items.filter(it => allowed.includes(it.page));
    if (!items.length) return '';
    return `<div class="cardx mb-grid"><div class="card-h"><h3>${esc(g.group)}</h3></div>
      <div class="pr-items">${items.map(it => `<button type="button" class="pr-item pr-go" data-doc="${esc(it.btn)}">
        <span class="grow t text-start">${esc(it.label)}</span><span class="btnx pri sm">${ic('print', 'sm')}พิมพ์</span></button>`).join('')}</div></div>`;
  }).join('');
  $('prCatalog').querySelectorAll('[data-doc]').forEach(b => b.onclick = () => prRun(b.dataset.doc));
}
async function prRun(btnId) {
  const it = PR_DOCS.flatMap(g => g.items).find(x => x.btn === btnId); if (!it) return;
  const isReady = () => { try { return !!it.ready(); } catch (e) { return false; } };
  const LOAD = { allocation: 'loadAllocation', balance: 'loadBalance', refund: 'loadRefund', students: 'loadStudents', docs: 'loadDocs', ktb: 'loadKtb' };
  if (!isReady() && typeof window[LOAD[it.page]] === 'function') { S._lastLoad[it.page] = Date.now(); window[LOAD[it.page]](); }
  const t0 = Date.now();
  while (Date.now() - t0 < 20000) {
    const btn = $(btnId);
    if (isReady() && btn && !btn.disabled && !$('loading').classList.contains('on')) { btn.click(); return; }
    await new Promise(r => setTimeout(r, 250));
  }
  toast('โหลดข้อมูลไม่ทัน กรุณากดปุ่มพิมพ์ในหน้านี้อีกครั้ง', true);
}
/* แถบเมนูย่อเหลือไอคอน: กดตราโรงเรียนเพื่อย่อ/ขยาย (จำค่าไว้ในเครื่อง) + ไอคอนขยายตามเมาส์แบบ Dock ของ macOS */
function initSideMini() {
  document.querySelectorAll('.nav-item').forEach(b => { if (!b.title) b.title = b.textContent.trim(); });
  if (S._sideMini) return; S._sideMini = true;
  const desk = () => window.innerWidth > 991.98;
  let on = false; try { on = localStorage.getItem('sideMini') === '1'; } catch (e) { /* ไม่มีที่เก็บ */ }
  document.body.classList.toggle('side-mini', on);
  const logo = $('brandIcon'); logo.setAttribute('role', 'button'); logo.tabIndex = 0;
  logo.title = 'ย่อ/ขยายแถบเมนู';
  const flip = () => {
    if (!desk()) return;
    const v = !document.body.classList.contains('side-mini');
    document.body.classList.toggle('side-mini', v);
    logo.classList.remove('pop'); void logo.offsetWidth; logo.classList.add('pop');
    try { localStorage.setItem('sideMini', v ? '1' : '0'); } catch (e) { /* ไม่มีที่เก็บ */ }
  };
  logo.onclick = flip;
  logo.onkeydown = e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } };
  const nav = $('nav');
  const reset = () => nav.querySelectorAll('.nav-item').forEach(b => b.style.removeProperty('--dock'));
  nav.addEventListener('mousemove', e => {
    if (!document.body.classList.contains('side-mini') || !desk()) return;
    nav.querySelectorAll('.nav-item').forEach(b => {
      const r = b.getBoundingClientRect(), d = Math.abs(e.clientY - (r.top + r.height / 2));
      b.style.setProperty('--dock', (1 + 0.7 * Math.max(0, 1 - d / 110)).toFixed(3));
    });
  });
  nav.addEventListener('mouseleave', reset);
  nav.addEventListener('click', e => {
    const b = e.target.closest('.nav-item'); if (!b || !document.body.classList.contains('side-mini')) return;
    b.classList.remove('bounce'); void b.offsetWidth; b.classList.add('bounce');
  });
}
