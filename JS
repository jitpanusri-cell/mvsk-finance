/* =========================================================
 * งบกิจกรรม/โครงการ
 * ========================================================= */
const A = { fy: null, data: null, view: 'act', modals: {} };
const STATUS_TXT = { active: 'ดำเนินการ', done: 'เสร็จสิ้น', cancelled: 'ยกเลิก' };
const fundOf = code => (S.boot.funds.find(f => f.code === code) || { short: code, name: code, color: '#5B6678' });
const modal = id => (A.modals[id] = A.modals[id] || new bootstrap.Modal($(id)));

function initActivityPage() {
  if (A.inited) return;
  A.inited = true;
  A.fy = S.fy;
  $('actFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === A.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('actFy').onchange = e => { A.fy = +e.target.value; loadActivity(); };
  $('actView').querySelectorAll('button').forEach(b => b.onclick = () => {
    A.view = b.dataset.v;
    $('actView').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    renderActivity();
  });
  $('btnAddAct').innerHTML = ic('plus') + '<span>เพิ่มกิจกรรม</span>';
  $('btnAddAct').onclick = () => openActForm();
  ['aFund', 'aDept'].forEach(id => $(id).onchange = renderActTable);
  $('aQ').oninput = renderActTable;
  $('btnSaveAct').onclick = saveActForm;
  $('btnSaveCut').onclick = saveCutForm;
  $('fCutAmt').oninput = updateCutHint;
}

async function loadActivity() {
  initActivityPage();
  loading(true);
  try { A.data = await api('getActivityData', A.fy); renderActivity(); }
  catch (e) { fail(e); }
  loading(false);
}

function renderActivity() {
  const D = A.data; if (!D) return;
  $('btnAddAct').style.display = D.canEdit ? '' : 'none';
  const sum = k => D.activities.filter(a => a.status !== 'cancelled').reduce((x, a) => x + a[k], 0);
  const free = D.byFund.reduce((x, f) => x + f.free, 0);
  const avail = D.byFund.reduce((x, f) => x + f.available, 0);
  const over = D.byFund.filter(f => f.free < -0.004);
  $('aKpi').innerHTML = `
    <div class="kpi dark"><div class="l">${ic('activity','sm')}ตั้งงบให้กิจกรรมแล้ว</div>
      <div class="v">${moneyKpi(sum('budget'))}<small>บาท</small></div>
      <div class="f">${D.activities.filter(a => a.status !== 'cancelled').length} กิจกรรม/โครงการ</div></div>
    <div class="kpi"><div class="l">${ic('cut','sm')}ตัดงบแล้ว</div>
      <div class="v">${moneyKpi(sum('spent'))}<small>บาท</small></div>
      <div class="meter"><i style="width:${Math.min(100, sum('budget') ? sum('spent') / sum('budget') * 100 : 0)}%;background:var(--gold)"></i></div>
      <div class="f">${pct(sum('budget') ? sum('spent') / sum('budget') * 100 : 0)} ของงบที่ตั้ง</div></div>
    <div class="kpi"><div class="l">${ic('balance','sm')}คงเหลือในกิจกรรม</div>
      <div class="v">${moneyKpi(sum('remain'))}<small>บาท</small></div>
      <div class="f">ยังไม่ได้ตัดงบ</div></div>
    <div class="kpi ${over.length ? 'alert' : 'cream'}"><div class="l">${ic('receipt','sm')}เงินที่ยังไม่ได้ตั้งให้กิจกรรม</div>
      <div class="v ${free < -0.004 ? 'neg' : ''}">${moneyKpi(free)}<small>บาท</small></div>
      <div class="f">${over.length ? `<b class="neg">ตั้งงบเกินเงินที่มี: ${over.map(f => f.short).join(', ')}</b>` : 'จากเงินที่ได้รับ ' + moneyKpi(avail) + ' บาท'}</div></div>`;
  // ตัวกรอง
  const fv = $('aFund').value, dv = $('aDept').value;
  $('aFund').innerHTML = '<option value="">ทุกรายการเงิน</option>' + D.funds.map(f => `<option value="${f.code}"${f.code === fv ? ' selected' : ''}>${esc(f.short)}</option>`).join('');
  $('aDept').innerHTML = '<option value="">ทุกกลุ่มงาน</option>' + D.depts.map(d => `<option${d === dv ? ' selected' : ''}>${esc(d)}</option>`).join('');
  $('deptList').innerHTML = D.depts.map(d => `<option value="${esc(d)}">`).join('');
  $('aByAct').style.display = A.view === 'act' ? '' : 'none';
  $('aByFund').style.display = A.view === 'fund' ? '' : 'none';
  if (A.view === 'act') renderActTable(); else renderByFund();
}

const chip = (code, amt) => { const f = fundOf(code); return `<span class="chip"><i style="background:${f.color}"></i>${esc(f.short)} <b>${money(amt)}</b></span>`; };

function renderActTable() {
  const D = A.data, fv = $('aFund').value, dv = $('aDept').value, q = $('aQ').value.trim().toLowerCase();
  const list = D.activities.filter(a => (!fv || a.lines.some(l => l.fund === fv)) && (!dv || a.dept === dv) &&
    (!q || (a.code + ' ' + a.name + ' ' + a.owner + ' ' + a.dept).toLowerCase().includes(q)));
  if (!D.activities.length) {
    $('aTbl').innerHTML = `<tbody><tr><td><div class="empty"><div class="ic">${ic('activity')}</div>
      <h3 style="font-size:18px">ยังไม่มีกิจกรรมในปีงบ ${D.fy}</h3>
      <p class="muted">เพิ่มกิจกรรม/โครงการ แล้วระบุว่าใช้เงินรายการไหน เท่าไร</p>
      ${D.canEdit ? `<button class="btnx pri" onclick="openActForm()">${ic('plus')}เพิ่มกิจกรรมแรก</button>` : ''}</div></td></tr></tbody>`;
    return;
  }
  const T = k => list.reduce((x, a) => x + (a.status === 'cancelled' ? 0 : a[k]), 0);
  $('aTbl').innerHTML = `<thead><tr><th>กิจกรรม/โครงการ</th><th>ใช้งบจาก</th><th class="num">งบที่ตั้ง</th><th class="num">ใช้ไป</th>
      <th class="num">คงเหลือ</th><th class="hide-sm">% ใช้</th><th></th></tr></thead><tbody>` +
    (list.map(a => `<tr class="click" data-id="${a.id}">
      <td style="min-width:220px"><div class="act-name"><span class="code">${esc(a.code)}</span>${esc(a.name)}
        ${a.status !== 'active' ? `<span class="tag ${a.status}">${STATUS_TXT[a.status] || a.status}</span>` : ''}</div>
        <div class="act-sub">${[a.dept, a.owner].filter(Boolean).map(esc).join(' · ') || '&nbsp;'}</div></td>
      <td><div class="chips">${a.lines.map(l => chip(l.fund, l.budget)).join('')}</div></td>
      <td class="num">${money(a.budget)}</td><td class="num">${money(a.spent)}</td>
      <td class="num ${a.remain < -0.004 ? 'neg' : ''}"><b>${money(a.remain)}</b></td>
      <td class="hide-sm"><div class="pct"><div class="meter"><i style="width:${Math.min(100, a.pct)}%;background:${a.pct > 100 ? 'var(--bad)' : 'var(--pri)'}"></i></div><span>${pct(a.pct)}</span></div></td>
      <td class="text-end" style="white-space:nowrap">${D.canEdit && a.status === 'active' ? `<button class="btnx sec sm" data-cut="${a.id}">${ic('cut','sm')}ตัดงบ</button>` : ''}</td></tr>`).join('') ||
      '<tr><td colspan="7" class="text-center muted py-4">ไม่พบกิจกรรมตามเงื่อนไข</td></tr>') +
    `<tr class="tot"><td colspan="2">รวม ${list.length} รายการ</td><td class="num">${money(T('budget'))}</td><td class="num">${money(T('spent'))}</td><td class="num">${money(T('remain'))}</td><td class="hide-sm"></td><td></td></tr></tbody>`;
  $('aTbl').querySelectorAll('tr.click').forEach(tr => tr.onclick = e => {
    const cut = e.target.closest('[data-cut]');
    if (cut) { e.stopPropagation(); openCutForm(cut.dataset.cut); } else openActDetail(tr.dataset.id);
  });
}

function renderByFund() {
  const D = A.data;
  $('aByFund').innerHTML = D.byFund.map(f => {
    const base = Math.max(f.available, f.committed + f.spentOther, 1);
    const w = v => Math.max(0, v / base * 100);
    const unspent = Math.max(0, f.committed - f.spentLinked);
    return `<div class="fund-card" style="--c:${f.color}">
      <h3>${esc(f.name)}</h3>
      <div class="fnums">
        <div><div class="l">เงินที่ได้รับ</div><div class="v">${moneyKpi(f.available)}</div></div>
        <div><div class="l">ตั้งให้กิจกรรม</div><div class="v">${moneyKpi(f.committed)}</div></div>
        <div><div class="l">ใช้ไปแล้ว</div><div class="v">${moneyKpi(f.spentLinked + f.spentOther)}</div></div>
        <div><div class="l">ยังไม่ได้ตั้ง</div><div class="v ${f.free < -0.004 ? 'neg' : ''}">${moneyKpi(f.free)}</div></div>
      </div>
      <div class="bar2" role="img" aria-label="ใช้ในกิจกรรม ${money(f.spentLinked)} ตั้งแต่ยังไม่ใช้ ${money(unspent)} จ่ายอื่น ${money(f.spentOther)}">
        <i style="width:${w(f.spentLinked)}%;background:${f.color}"></i>
        <i style="width:${w(unspent)}%;background:${f.color};opacity:.35"></i>
        <i class="other" style="width:${w(f.spentOther)}%"></i>
      </div>
      <div class="legend">
        <span><i style="background:${f.color}"></i>ตัดงบกิจกรรมแล้ว ${money(f.spentLinked)}</span>
        <span><i style="background:${f.color};opacity:.35"></i>ตั้งไว้ยังไม่ใช้ ${money(unspent)}</span>
        ${f.spentOther ? `<span><i style="background:repeating-linear-gradient(135deg,#C9C2B3 0 3px,#DDD7CB 3px 6px)"></i>จ่ายอื่น (ไม่ผูกกิจกรรม) ${money(f.spentOther)}</span>` : ''}
      </div>
      ${f.free < -0.004 ? `<div class="badbox small-x mb-2">ตั้งงบให้กิจกรรมเกินเงินที่ได้รับ ${money(-f.free)} บาท</div>` : ''}
      <div class="flist">${f.activities.length ? f.activities.map(a => `
        <div class="r" data-id="${a.id}"><span class="n"><span class="muted">${esc(a.code)}</span> ${esc(a.name)}</span>
          <span class="a">ใช้ ${money(a.spent)} / ${money(a.budget)}</span></div>`).join('')
        : '<div class="muted small-x py-2">ยังไม่มีกิจกรรมที่ใช้เงินรายการนี้</div>'}</div>
    </div>`;
  }).join('');
  $('aByFund').querySelectorAll('.r[data-id]').forEach(r => r.onclick = () => openActDetail(r.dataset.id));
}

/* ---------- ฟอร์มกิจกรรม ---------- */
