};
const dcIsLoanKind = k => k === 'travel' || k === 'loanAct';
const dcIsTravelKind = k => k === 'travel' || k === 'advTravel';
const dcIsLoan = r => !!r && dcIsLoanKind(r.kind);
const dcIsTravel = r => !!r && dcIsTravelKind(r.kind);
