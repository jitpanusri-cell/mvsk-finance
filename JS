function stMixText(mix, prev, T) {
  const P = [];
  if (mix.returned.n) P.push(`รายการตีกลับจากการโอนครั้งที่ ${prev} ภาคเรียนที่ ${T} จำนวน ${stNf(mix.returned.n)} คน`);
  if (mix.new.n) P.push(`นักเรียนเข้าใหม่ จำนวน ${stNf(mix.new.n)} คน`);
  if (mix.wrong.n) P.push(`รายการโอนผิดบัญชี จำนวน ${stNf(mix.wrong.n)} คน`);
  if (!P.length) return '';
  const total = mix.returned.n + mix.new.n + mix.wrong.n;
  return 'มี' + (P.length > 1 ? P.slice(0, -1).join(' ') + ' และ' + P[P.length - 1] + ` รวม ${stNf(total)} คน` : P[0]);
}
