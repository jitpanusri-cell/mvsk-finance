    <div class="fr">ค่าที่พัก อัตราวันละ${gvF(r.lodgeRate && r.lodgeDays ? dcFmtN(r.lodgeRate) : '', 1.1)}บาท เวลา${gvF(r.lodgeDays || '', .9)}วัน เป็นเงิน${amt(dcLodge(r))}บาท</div>
    <div class="f1gap">ค่าพาหนะเดินทาง ดังนี้</div>
    ${R.map((x, i) => `<div class="fr">${i + 1}.ค่าโดยสารรถ${gvF('', 1.3)}จาก${gvF(x.a, 1.25, 'fit')}ถึง${gvF(x.b, 1, 'fit')}</div>
