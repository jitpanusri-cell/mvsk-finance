async function readAcImpFile() {
  const f = $('acImpFile').files[0]; if (!f) return;
  try {
    if (/\.(xlsx|xls)$/i.test(f.name)) {
      await loadSheetJs();
      const wb = XLSX.read(await f.arrayBuffer(), { type: 'array' });
      let all = [];
      wb.SheetNames.forEach(n => { const r = mapAcRows(XLSX.utils.sheet_to_json(wb.Sheets[n], { header: 1, raw: false, defval: '' }), true); if (r) all = all.concat(r); });
      showAcImpPreview(all);
    } else parseAcImpText(await f.text());
  } catch (e) { fail(e); }
}
function parseAcImpText(t) {
  t = String(t || '').replace(/^﻿/, '');
  if (!t.trim()) { $('acImpPreview').innerHTML = ''; $('btnAcDoImport').disabled = true; return; }
  const delim = t.includes('\t') ? '\t' : ',';
  const rows = [];
  let row = [], cur = '', q = false;
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (q) { if (c === '"' && t[i + 1] === '"') { cur += '"'; i++; } else if (c === '"') q = false; else cur += c; }
    else if (c === '"') q = true;
    else if (c === delim) { row.push(cur); cur = ''; }
    else if (c === '\n' || c === '\r') { if (c === '\r' && t[i + 1] === '\n') i++; row.push(cur); rows.push(row); row = []; cur = ''; }
    else cur += c;
  }
  if (cur || row.length) { row.push(cur); rows.push(row); }
  mapAcRows(rows);
}
function mapAcRows(rows, quiet) {
  const test = (h, re) => re.test(String(h).replace(/\s+/g, ' ').trim());
  let hi = -1, col = {};
  for (let r = 0; r < Math.min(rows.length, 12) && hi < 0; r++) {
    const c = {};
    rows[r].forEach((h, i) => {
      if (c.date == null && test(h, /^วันที่/)) c.date = i;
      else if (c.fund == null && test(h, /รายการเงิน|ประเภทเงิน/)) c.fund = i;
      else if (c.amount == null && test(h, /จำนวนเงิน|ยอดเงิน/)) c.amount = i;
      else if (c.refNo == null && test(h, /เลขที่(อ้างอิง|เอกสาร|ฎีกา)?$/)) c.refNo = i;
      else if (c.note == null && test(h, /หมายเหตุ/)) c.note = i;
    });
    if (c.date != null && c.fund != null && c.amount != null) { hi = r; col = c; }
  }
  if (hi < 0) {
    if (quiet) return null;
    $('acImpPreview').innerHTML = '<div class="badbox small-x">ไม่พบหัวตาราง ต้องมีคอลัมน์ วันที่, รายการเงิน, จำนวนเงิน</div>'; $('btnAcDoImport').disabled = true; return null;
  }
  const g = (r, k) => col[k] != null ? String(r[col[k]] == null ? '' : r[col[k]]).trim() : '';
  const out = rows.slice(hi + 1).map(r => ({ date: g(r, 'date'), fund: g(r, 'fund'), amount: g(r, 'amount'), refNo: g(r, 'refNo'), note: g(r, 'note') }))
    .filter(x => x.fund && x.amount);
  if (quiet) return out;
  showAcImpPreview(out);
  return out;
}
function showAcImpPreview(out) {
  AC.imp = out;
  if (!out.length) { $('acImpPreview').innerHTML = '<div class="badbox small-x">ไม่พบข้อมูลในไฟล์</div>'; $('btnAcDoImport').disabled = true; return; }
  $('acImpPreview').innerHTML = `<div class="warnbox small-x" style="background:var(--info-bg);color:var(--info)">พบข้อมูล <b>${out.length.toLocaleString('th-TH')}</b> รายการ</div>
    <div class="table-responsive mt-2"><table class="tbl small-x"><thead><tr><th>วันที่</th><th>รายการเงิน</th><th>จำนวนเงิน</th><th>เลขที่อ้างอิง</th></tr></thead><tbody>
    ${out.slice(0, 5).map(r => `<tr><td>${esc(r.date)}</td><td>${esc(r.fund)}</td><td>${esc(r.amount)}</td><td>${esc(r.refNo)}</td></tr>`).join('')}</tbody></table></div>
    <div class="small-x muted">แสดง 5 แถวแรกจาก ${out.length} แถว</div>`;
  $('btnAcDoImport').disabled = false;
}
