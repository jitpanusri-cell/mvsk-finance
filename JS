const ROUND_COLORS = ['#1F3A5F', '#4A7FB5', '#9DB6D3', '#C7D5E6'];
const canEditAlloc = () => ['admin', 'finance'].includes(S.boot.user.role);
function pctControl(t) {
  const opts = [100, 70, 30];
  if (!opts.includes(t.pctReceived)) opts.push(t.pctReceived);
  if (!canEditAlloc()) return `<span class="st ${t.pctReceived < 100 ? 'warn' : 'ok'}">ได้รับแล้ว ${t.pctReceived}%</span>`;
  return `<label class="small-x muted no-print" style="display:inline-flex;align-items:center;gap:6px">ได้รับแล้ว
    <select class="sel" data-term="${t.term}" style="min-height:32px;padding:0 28px 0 10px;font-size:13px;background-position:right 6px center">
      ${opts.sort((a, b) => b - a).map(p => `<option value="${p}"${p === t.pctReceived ? ' selected' : ''}>${p}%</option>`).join('')}
    </select></label>`;
}
function renderRounds() {
  const R = S.dash.rounds;
  $('dRounds').innerHTML = R.map(t => {
    if (!t.rounds.length) return `<div class="term-block"><div class="term-h"><b>ภาคเรียนที่ ${t.label}</b><span class="muted small-x">ยังไม่มีหนังสือจัดสรร</span></div></div>`;
    const pend = t.pctReceived < 100;
    const stack = t.rounds.map((r, i) => `<i style="width:${r.pct}%;background:${ROUND_COLORS[i % 4]}" title="ครั้งที่ ${r.round} ${pct(r.pct)}"></i>`).join('') +
      (pend ? `<i class="pending" style="width:${100 - t.pctReceived}%" title="รองวดที่เหลือ ${100 - t.pctReceived}%"></i>` : '');
    const rows = t.rounds.map((r, i) => {
      const st = r.status === 'ok' ? '<span class="st ok">ตรวจแล้ว</span>' : '<span class="st warn">รอตรวจ</span>';
      const recOk = r.received + 0.004 >= r.total;
      const tr = r.tranche ? ` · งวด ${esc(r.tranche)}%` : '';
      const stu = (r.studentsLower || r.studentsUpper) ? `<span>ม.ต้น ${r.studentsLower.toLocaleString('th-TH')} · ม.ปลาย ${r.studentsUpper.toLocaleString('th-TH')} คน</span>` : '';
      return `<div class="round">
        <span class="rbadge" style="background:${ROUND_COLORS[i % 4]};${i >= 2 ? 'color:#16263D' : ''}">${r.round}</span>
        <div style="flex:1;min-width:0">
          <div class="top"><span>ครั้งที่ ${r.round} · ${pct(r.pct)}${tr}</span><span class="num">${money(r.total)}</span></div>
          <div class="meta">
            <span>${r.docNo ? esc(r.docNo) : 'ยังไม่มีเลขที่หนังสือ'}</span>
            <span>${r.estimated ? '≈ ' : ''}${thDate(r.docDate, true)}</span>
            ${st}${recOk ? '' : '<span class="st bad">เงินเข้าไม่ครบ</span>'}
          </div>
          ${stu ? `<div class="meta">${stu}</div>` : ''}
        </div></div>`;
    }).join('');
    const pendRow = pend ? `<div class="round">
        <span class="rbadge pending-badge">…</span>
        <div style="flex:1;min-width:0">
          <div class="top"><span>รองวดที่เหลือ · ${100 - t.pctReceived}%</span><span class="num muted">≈ ${money(t.pending)}</span></div>
          <div class="meta"><span>ประมาณจากสัดส่วนงวดที่ได้รับแล้ว ยอดจริงขึ้นกับจำนวนนักเรียน ณ วันนับ</span></div>
        </div></div>` : '';
    return `<div class="term-block">
      <div class="term-h"><b>ภาคเรียนที่ ${t.label}</b>${pctControl(t)}</div>
      <div class="term-sum small-x muted">ได้รับแล้ว <b class="num" style="color:var(--ink)">${money(t.total)}</b>${pend ? ` จากที่คาดทั้งภาค ≈ ${money(t.expected)}` : ' (ครบทั้งภาค)'}</div>
      <div class="stack" role="img" aria-label="สัดส่วนงวดเงิน ${t.rounds.map(r => 'ครั้งที่ ' + r.round + ' ' + pct(r.pct)).join(', ')}${pend ? ', รอ ' + (100 - t.pctReceived) + '%' : ''}">${stack}</div>
      ${rows}${pendRow}</div>`;
  }).join('') + (R.some(t => t.rounds.some(r => r.estimated)) ? '<div class="muted small-x" style="grid-column:1/-1">≈ วันที่ประมาณจากการนำเข้า</div>' : '');
  $('dRounds').querySelectorAll('select[data-term]').forEach(sel => sel.onchange = async () => {
    loading(true);
    try { await api('saveTermPct', sel.dataset.term, +sel.value); await loadDashboard(); toast('บันทึกแล้ว'); }
    catch (e) { fail(e); }
  });
}

/* ---------- นำเข้าตารางเดิม ---------- */
