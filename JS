/* วันครบกำหนดส่งใช้ (ระเบียบการเบิกเงินจากคลังฯ 2562 ข้อ 57): เดินทาง 15 วันนับจากวันกลับ / อื่น ๆ 30 วันนับจากวันรับเงิน */
function dcAddDays(iso, n) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(String(iso || ''))) return '';
  const p = iso.split('-').map(Number), d = new Date(Date.UTC(p[0], p[1] - 1, p[2] + n));
  return d.toISOString().slice(0, 10);
}
const dcDueOf = (kind, loanDate, dateTo) => kind === 'travel' && dateTo ? dcAddDays(dateTo, 15) : dcAddDays(loanDate || S.boot.today, 30);

