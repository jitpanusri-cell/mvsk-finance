/* key → { t: ชื่อ, land: แนวนอน, fn(r) } — f2 พิมพ์ 2 ชุด (ด้านหลังเว้นว่างให้การเงินกรอก) */
const MV_FORMS = {
  f2: { t: 'สัญญาการยืมเงิน (แบบ 206)', fn: r => mvF206(r) },
  f3: { t: 'บันทึกข้อความขออนุมัติเบิกเงิน', fn: r => mvMemoAdv(r) },
  f4: { t: 'บันทึกข้อความขออนุมัติส่งใช้เงินยืม', fn: r => mvMemoRet(r) },
  f5: { t: 'ใบเบิกค่าใช้จ่ายในการเดินทางไปราชการ (แบบ 8708 ส่วนที่ 1)', fn: r => mv8708(r) },
  f6: { t: 'หลักฐานการจ่าย (แบบ 8708 ส่วนที่ 2)', land: 1, fn: r => mv8708p2(r) },
  f7: { t: 'ใบสำคัญรับเงินสำหรับนักเรียน (ใบขวาง)', land: 1, fn: r => mvStudent(r) },
  f8: { t: 'ใบสำคัญรับเงิน', fn: () => mvReceipt() },
  f10: { t: 'ใบรับรองแทนใบเสร็จรับเงิน (แบบ บก.111)', fn: r => mv111(r) }
};
/* พิมพ์ (blank = ฟอร์มเปล่า) — สัญญายืมพิมพ์ 2 ชุด ด้านหลังเว้นว่าง */
function mvPrint(key, r, blank) {
  const F = MV_FORMS[key]; if (!F) return false;
  const rec = blank ? null : r;
  let html = F.fn(rec);
  if (key === 'f2') {
    /* ด้านหลัง: ตารางรายการส่งใช้ เว้นว่างให้เจ้าหน้าที่การเงินกรอก (แบบฟอร์มเดิม .gf มีขอบกระดาษในตัวเมื่อพิมพ์แบบ mv) */
    const back = dcF2Back({ returns: [] }, true);
    const attach = rec && mvCost(rec).length > MV_206_ROWS ? dcF206Attach(rec, dcCostLines(rec)) : '';
    html = (html + back + attach) + (html + back + attach);
  }
  printDoc(html, F.land ? 'mvl' : 'mv');
  if (window.__lastDoc) { window.__lastDoc.title = F.t; showPrintSaveBar(F.t); }
  return true;
}
/* จัดให้พอดี: ข้อความยาวเกินช่อง → ลดขนาดตัวอักษรทีละน้อย (ไม่ต่ำกว่า 12.5px) ถ้ายังไม่พอ ให้ขึ้นบรรทัดใหม่แทนการตัดทิ้ง
 * แล้วถ้าเนื้อหาเกินหน้า → ลดระยะบรรทัดของทั้งแผ่นจนพอดี 1 หน้า */
function mvFitDoc(root) {
  if (!root) return;
  root.querySelectorAll('.mvfit').forEach(el => {
    if (el.dataset.ws == null) { el.dataset.ws = el.style.whiteSpace; el.dataset.lh = el.style.lineHeight; }
    el.style.fontSize = ''; el.style.whiteSpace = el.dataset.ws; el.style.lineHeight = el.dataset.lh;
    /* ข้อความสั้น (เช่น ตัวเลข/อัตรา) ย่อตัวอักษรให้พอดีช่อง · ข้อความยาว ขึ้นบรรทัดใหม่ (ขนาดเท่าเดิม) */
    const long = el.textContent.trim().length > 40;
    let fs = 15;
    while (el.scrollWidth > el.clientWidth + 1 && fs > (long ? 15 : 10.5)) { fs -= 0.5; el.style.fontSize = fs + 'px'; }
    if (long && el.scrollWidth > el.clientWidth + 1) { el.style.whiteSpace = 'normal'; el.style.lineHeight = '1.45'; }
  });
  /* เส้นประ: ตัดให้สั้นลงถ้าล้นขอบช่อง/ขอบกระดาษ หรือทำให้ขึ้นบรรทัดใหม่ (ความกว้างจุดต่างกันตามฟอนต์ในเครื่อง) */
  root.querySelectorAll('.mvd').forEach(d => {
    const box = d.closest('div'); if (!box) return;
    /* บรรทัดสั้น (บรรทัดลงชื่อ/วันที่/ตำแหน่ง) ห้ามตัดคำขึ้นบรรทัดใหม่ — ตัดเส้นประให้สั้นลงแทน */
    if (!box.querySelector('div') && box.textContent.replace(/\.+/g, '.').trim().length < 70) box.style.whiteSpace = 'nowrap';
    const full = d.dataset.n ? +d.dataset.n : d.textContent.length; d.dataset.n = full; d.textContent = '.'.repeat(full);
    const over = () => {
      if (d.getClientRects().length > 1) return true;
      const cs = getComputedStyle(box), b = box.getBoundingClientRect();
      const right = b.right - parseFloat(cs.paddingRight || 0) - parseFloat(cs.borderRightWidth || 0);
      return d.getBoundingClientRect().right > right + 0.5 || box.scrollWidth > box.clientWidth + 1;
    };
    let g = 0;
    while (over() && d.textContent.length > 6 && g++ < 300) d.textContent = d.textContent.slice(2);
  });
  root.querySelectorAll('.mvs').forEach(sh => {
    const base = parseFloat(sh.style.lineHeight) || 2;
    let lh = base;
    while (sh.scrollHeight > sh.clientHeight + 1 && lh > 1.4) { lh = Math.round((lh - 0.05) * 100) / 100; sh.style.lineHeight = String(lh); }
  });
}
/* แสดงตัวอย่างบนจอ (ย่อให้พอดีกล่อง) */
function mvPreview(host, key, r) {
  const F = MV_FORMS[key]; if (!host || !F) return;
  const html = F.fn(r);
  host.innerHTML = `<div class="mv-prev-in">${html}</div>`;
  const fit = () => { const inner = host.firstElementChild; if (!inner) return;
    inner.style.zoom = 1; mvFitDoc(inner);
    const w = F.land ? 1122 : 794, avail = Math.max(240, host.clientWidth - 24);
    inner.style.zoom = Math.min(1, avail / w); };
  fit();
  requestAnimationFrame(fit);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
}

/* ---------- จัดตัวอักษร: กระจายแบบไทย + ดึงบรรทัดท้ายที่ตกมานิดเดียว + ย่อช่องที่ล้น + บีบให้พอดี 1 หน้า ----------
 * ใช้ Intl.Segmenter ตัดคำ: ระหว่างคำใส่ช่องว่าง (ตัดบรรทัดได้), ระหว่างตัวอักษรในคำใส่ NBSP (ตัดบรรทัดไม่ได้)
 * แล้วตั้ง word-spacing ติดลบเท่าความกว้างช่องว่าง → ปกติไม่เห็นช่องว่าง แต่ text-align:justify กระจายช่องไฟให้เท่ากันทั้งบรรทัด */
const DC_PAGE_H = { gvm: 270, gvp: 270, gvl: 188 };
function dcTypesetDoc(d, mode) {
  if (!d || !d.querySelector('.gv')) return;
  const keep = d.getAttribute('style') || '';
  d.setAttribute('style', 'display:block;position:absolute;left:-12000px;top:0;visibility:hidden');
  try {
    const hasSeg = typeof Intl !== 'undefined' && Intl.Segmenter;
    const ws = hasSeg ? new Intl.Segmenter('th', { granularity: 'word' }) : null, gs = hasSeg ? new Intl.Segmenter('th', { granularity: 'grapheme' }) : null;
    const isTh = ch => !!ch && ch.charCodeAt(0) >= 0x0E01 && ch.charCodeAt(0) <= 0x0E5B;
    const lineInfo = el => {
      const rg = document.createRange(); rg.selectNodeContents(el);
      const rs = [...rg.getClientRects()].filter(x => x.width > .5).sort((a, b) => (a.top + a.bottom) - (b.top + b.bottom));
      const L = [];
      rs.forEach(x => { const m = (x.top + x.bottom) / 2, g = L.find(l => Math.abs(l.m - m) < 10);
        if (g) { g.l = Math.min(g.l, x.left); g.r = Math.max(g.r, x.right); } else L.push({ m: m, b: x.bottom, l: x.left, r: x.right }); });
      return L.sort((a, b) => a.m - b.m);
    };
    if (hasSeg) d.querySelectorAll('.gv .tj').forEach(el => {
      if (el.dataset.tj) return; el.dataset.tj = '1';
      const pr = document.createElement('span'); pr.style.cssText = 'white-space:pre;word-spacing:0;letter-spacing:0';
      pr.textContent = 'ก ก'; el.appendChild(pr); const w1 = pr.getBoundingClientRect().width; pr.textContent = 'กก'; const w2 = pr.getBoundingClientRect().width; pr.remove();
      const W = w1 - w2; if (!(W > 0)) return;
      const walk = n => [...n.childNodes].forEach(c => {
        if (c.nodeType === 3) {
          const frag = document.createDocumentFragment(); let prev = '';
          [...ws.segment(c.data)].map(x => x.segment).forEach(t => {
            if (/^\s+$/.test(t)) { const sp = document.createElement('span'); sp.className = 'osp'; sp.textContent = ' '; frag.appendChild(sp); prev = ' '; return; }
            let out = (isTh(prev.slice(-1)) && isTh(t.charAt(0))) ? ' ' : '';
            const g = [...gs.segment(t)].map(x => x.segment);
            g.forEach((x, i) => { out += (i && isTh(x.charAt(0)) && isTh(g[i - 1].slice(-1))) ? ' ' + x : x; });
            frag.appendChild(document.createTextNode(out)); prev = t;
          });
          c.replaceWith(frag);
        } else if (c.nodeType === 1 && !c.classList.contains('dt') && !c.classList.contains('fx')) walk(c);
      });
      walk(el);
      el.style.wordSpacing = (-W) + 'px';
      el.querySelectorAll('.osp').forEach(sp => sp.style.wordSpacing = '0px');
      // เส้นประเว้นว่าง: ย่อให้สั้นสุดก่อน ให้ข้อความเต็มบรรทัด แล้วยืดเส้นประให้เต็มส่วนที่เหลือของบรรทัด (แทนการถ่างตัวอักษร)
      const dts = [...el.querySelectorAll('.dt')];
      if (dts.length) {
        const pre = dts.map(t => t.getBoundingClientRect().width), MIN = 15 * 96 / 25.4;
        dts.forEach((t, i) => { t.style.width = Math.min(MIN, pre[i]) + 'px'; });
        el.style.textAlign = 'left';
        const bx = el.getBoundingClientRect(), Ls = lineInfo(el);
        Ls.forEach((ln, li) => {
          const onL = dts.filter(t => { const q = t.getBoundingClientRect(); return Math.abs((q.top + q.bottom) / 2 - ln.m) < 10; });
          if (!onL.length) return;
          let slack = bx.right - ln.r - 3;
          if (li === Ls.length - 1) onL.forEach(t => { const i = dts.indexOf(t), cur = t.getBoundingClientRect().width, add = Math.max(0, Math.min(pre[i] - cur, slack)); t.style.width = (cur + add) + 'px'; slack -= add; });
          else if (slack > 0) onL.forEach(t => { t.style.width = (t.getBoundingClientRect().width + slack / onL.length) + 'px'; });
        });
        el.style.textAlign = '';
      }
      // บรรทัดสุดท้ายสั้นมาก (ไม่ถึง 30% ของบรรทัด) → บีบช่องไฟทีละนิดจนดึงขึ้นบรรทัดบนได้
      let L = lineInfo(el); const box = el.getBoundingClientRect();
      if (L.length >= 2 && (L[L.length - 1].r - box.left) / box.width < 0.3) {
        const n0 = L.length; let ok = false;
        for (let dd = 0.1; dd <= 0.61 && !ok; dd += 0.1) { el.style.wordSpacing = (-W - dd) + 'px'; ok = lineInfo(el).length < n0; }
        if (!ok) el.style.wordSpacing = (-W) + 'px';
      }
    });
    // รายการเงินที่ยาวจนตกบรรทัดเล็กน้อย → ย่อตัวอักษรลง (ไม่ต่ำกว่า 86%) ให้อยู่บรรทัดเดียว
    d.querySelectorAll('.gv .fit1').forEach(el => {
      const lh = parseFloat(getComputedStyle(el).lineHeight) || 28; let k = 100;
      while (el.getBoundingClientRect().height > lh * 1.4 && k > 84) { k -= 2; el.style.fontSize = k + '%'; }
      if (el.getBoundingClientRect().height > lh * 1.4) el.style.fontSize = '';
    });
    // ช่องกรอก (fx) ที่ข้อความยาวเกินช่อง → ย่อขนาดตัวอักษรลงทีละนิด (ไม่ต่ำกว่า 72%)
    d.querySelectorAll('.gv .fx.has').forEach(el => {
      let k = 100; while (el.scrollWidth > el.clientWidth + 1 && k > 72) { k -= 4; el.style.fontSize = k + '%'; }
    });
    // ทั้งแผ่นยาวเกิน 1 หน้า → ลดระยะบรรทัดทีละนิด (ไม่ต่ำกว่า 1.12)
    d.querySelectorAll('.gv[data-fit]').forEach(sh => {
      const H = (+sh.dataset.fit || DC_PAGE_H[mode] || 270) * 96 / 25.4;
      let lh = 1.36;
      while (sh.getBoundingClientRect().height > H && lh > 1.13) { lh = Math.round((lh - .03) * 100) / 100; sh.style.setProperty('--lh', lh); }
      if (sh.getBoundingClientRect().height > H) sh.style.fontSize = '15pt';
    });
  } catch (e) { /* จัดตัวอักษรไม่สำเร็จ ก็พิมพ์ตามปกติ */ }
  if (keep) d.setAttribute('style', keep); else d.removeAttribute('style');
}

