/* ---------- ฟอร์มแก้ไข ---------- */
function openAlForm(id) {
  const D = AL.data;
  const r = id ? D.terms.flatMap(t => t.rounds.map(x => Object.assign({ term: t.term }, x))).find(x => x.id === id) : null;
  $('alModalTitle').textContent = r ? `แก้ไขงวดจัดสรร ภาค ${r.term} ครั้งที่ ${r.round}` : 'เพิ่มงวดจัดสรร · ปีงบ ' + D.fy;
  $('fAlTerm').innerHTML = D.terms.map(t => `<option value="${t.term}">${t.semester}/${t.acadYear}</option>`).join('');
  $('fAlTerm').value = r ? r.term : D.terms[D.terms.length - 1].term;
  $('fAlTerm').disabled = !!r;
  $('fAlId').value = r ? r.id : '';
  const t = D.terms.find(x => x.term === $('fAlTerm').value);
  $('fAlRound').value = r ? r.round : (t.rounds.reduce((m, x) => Math.max(m, x.round), 0) + 1);
  $('fAlDoc').value = r ? r.docNo : '';
  $('fAlDate').value = r ? r.docDate : S.boot.today;
  $('fAlCount').value = r ? r.countDate : '';
  $('fAlLower').value = r ? r.studentsLower || '' : '';
  $('fAlUpper').value = r ? r.studentsUpper || '' : '';
  $('fAlTranche').value = r ? r.tranche : '';
  $('fAlStatus').value = r ? (r.status === 'ok' ? 'ok' : 'รอตรวจ') : 'ok';
  $('fAlNote').value = r ? r.note.replace(/นำเข้าจากชีต.*$/, '').trim() : '';
  $('fAlRec').checked = true;
  $('fAlRecDate').value = $('fAlDate').value; delete $('fAlRecDate').dataset.touched;
  $('fAlFunds').innerHTML = D.funds.map(f => `<div class="fund-in" style="--c:${f.color}"><label for="fa_${f.code}">${esc(f.name)}</label>
      <input class="inp num" type="number" step="0.01" min="0" id="fa_${f.code}" data-fund="${f.code}" data-t1="${f.term1Only ? 1 : 0}" value="${r && r[f.code] ? r[f.code] : ''}" placeholder="0.00"></div>`).join('');
  document.querySelectorAll('#fAlFunds input').forEach(i => i.oninput = alTotal);
  alTermChanged(); alTotal();
  $('btnAlDel').style.display = r ? '' : 'none';
  modal('alModal').show();
}
function alTermChanged() {
  const t2 = $('fAlTerm').value[0] === '2';
  document.querySelectorAll('#fAlFunds input[data-t1="1"]').forEach(i => { i.disabled = t2; if (t2) i.value = ''; i.closest('.fund-in').style.opacity = t2 ? .45 : 1; });
  alTotal();
}
function alTotal() { $('fAlTotal').textContent = money([...document.querySelectorAll('#fAlFunds input')].reduce((x, i) => x + (+i.value || 0), 0)); }
async function saveAlForm() {
  const o = { id: $('fAlId').value, term: $('fAlTerm').value, round: +$('fAlRound').value, docNo: $('fAlDoc').value.trim(), docDate: $('fAlDate').value,
    countDate: $('fAlCount').value.trim(), studentsLower: +$('fAlLower').value || 0, studentsUpper: +$('fAlUpper').value || 0,
    tranche: $('fAlTranche').value.trim(), status: $('fAlStatus').value, note: $('fAlNote').value.trim(),
    received: $('fAlRec').checked, receivedDate: $('fAlRecDate').value };
  document.querySelectorAll('#fAlFunds input').forEach(i => o[i.dataset.fund] = +i.value || 0);
  const btn = $('btnAlSave'); btn.disabled = true;
  try { await api('saveAllocation', o); modal('alModal').hide(); toast('บันทึกงวดจัดสรรแล้ว'); await loadAllocation(); if (S.dash) loadDashboardQuiet(); }
  catch (e) { fail(e); }
  btn.disabled = false;
}
async function deleteAlForm() {
  const id = $('fAlId').value; if (!id) return;
  if (!confirm('ลบงวดจัดสรรนี้ พร้อมยอดเงินเข้าบัญชีของงวดนี้?')) return;
  try { await api('deleteAllocation', id); modal('alModal').hide(); toast('ลบแล้ว'); await loadAllocation(); } catch (e) { fail(e); }
}
async function loadDashboardQuiet() { try { S.dash = await api('getDashboard', S.fy, S.term); renderDashboard(); } catch (e) { } }

