  if (bad.length) { toast(`แถวที่ ${bad[0].i + 1}: ${bad[0].why}` + (bad.length > 1 ? ` (และอีก ${bad.length - 1} แถว)` : ''), true); ktFocus(bad[0].i, bad[0].why.includes('จำนวนเงิน') ? KT_COLS.findIndex(c => c.k === 'amount') : bad[0].why.includes('บัญชี') ? 0 : KT_COLS.findIndex(c => c.k === 'fundSource')); return; }
  const dels = (KT.dels[KT.date] || []).slice();
  if (!payload.length && !dels.length) return toast('ไม่มีรายการที่ต้องบันทึก', true);
  const btn = $('btnKtShSave'); btn.disabled = true; btn.querySelector('span').textContent = 'กำลังบันทึก…';
  try {
    const r = await api('saveKtbRows', KT.fy, KT.date, payload, dels);
    const lastRow = payload[payload.length - 1];
    if (lastRow) { KT.lastBank = lastRow.bankAccount; KT.lastFund = lastRow.fundSource; KT.lastBt = lastRow.budgetType; }
    KT.drafts[KT.date] = null; KT.dels[KT.date] = []; try { localStorage.removeItem(ktDraftKey()); } catch (e) {}
    delete KT.month[KT.date.slice(0, 7)];
    toast(['บันทึกแล้ว', r.added && `เพิ่ม ${r.added}`, r.updated && `แก้ ${r.updated}`, r.deleted && `ลบ ${r.deleted}`].filter(Boolean).join(' · '));
    await loadKtbDay();
  } catch (e) { fail(e); btn.disabled = false; ktSheetTotals(); }
}

/* เอกสารแจ้งโอน: แยกตามประเภทเงิน (งบประมาณ / รายได้แผ่นดิน / นอกงบประมาณ) → บัญชีปลายทาง (กรุงไทย / ต่างธนาคาร) */
let KT_THEME = 'grid';
const KT_SEC = [{ k: 'bud', cats: [1, 3], t: 'เงินงบประมาณ' }, { k: 'rev', cats: [2], t: 'เงินรายได้แผ่นดิน' }, { k: 'off', cats: [4], t: 'เงินนอกงบประมาณ' }, { k: 'etc', cats: [0], t: 'เงินอื่นๆ' }];
const ktBankKind = s => /กรุงไทย|ktb/i.test(String(s || '')) ? 'ธนาคารกรุงไทย' : 'ต่างธนาคาร';
const ktThDateBE = iso => { const p = String(iso).split('-').map(Number); return `${p[2]} ${MTH[p[1] - 1]} พ.ศ. ${p[0] + 543}`; };
function ktLogoSrc() { try { return mvImg('logo'); } catch (e) { return (KT.day && KT.day.school && KT.day.school.logoUrl) || ''; } }
function ktDocHtml(B, canEdit) {
  const secs = KT_SEC.map(s => ({ ...s, groups: {} }));
  B.forEach(g => g.rows.forEach(r => {
    const bt = r.budgetType || ktCatToBt(g.fundCat), sec = secs.find(s => s.k === bt) || secs[0];
    const bk = ktBankKind(g.bankAccount) + '|' + g.date;
    (sec.groups[bk] = sec.groups[bk] || []).push({ r, g });
  }));
  const used = secs.filter(s => Object.keys(s.groups).length);
  const logo = ktLogoSrc();
  let gN = 0, gT = 0;
  const body = used.map((s, si) => {
    const keys = Object.keys(s.groups).sort((a, b) => (a.startsWith('ธนาคารกรุงไทย') ? 0 : 1) - (b.startsWith('ธนาคารกรุงไทย') ? 0 : 1) || a.localeCompare(b));
    let no = 0, tot = 0;
    const rows = keys.map(k => {
      const [kind, date] = k.split('|');
      const items = s.groups[k];
      const other = kind === 'ต่างธนาคาร', arr = other ? (KT.day.arriveOther || date) : date;
      const edit = other && canEdit ? `<button type="button" class="kd-arr-ed" data-arr="${esc(arr)}" title="เปลี่ยนวันที่เงินเข้าต่างธนาคาร" aria-label="เปลี่ยนวันที่เงินเข้าต่างธนาคาร" data-html2canvas-ignore>${ic('calendar', 'sm')}</button>` : '';
      return `<tr class="bk"><td></td><td colspan="2"><span class="kd-arr">บัญชีปลายทาง${kind} (วันที่ ${ktThDateBE(arr)})</span>${edit}</td><td></td></tr>` +
        items.map(({ r, g }) => {
          no++; tot += r.amount;
          const dl = ktDaysLeft(r.loanDueDate);
          const badge = ktIsPendingLoan(r) ? `<span class="ktb-loan-badge${dl < 0 ? ' overdue' : ''}" data-html2canvas-ignore>${dl < 0 ? 'เกินกำหนด ' + (-dl) + ' วัน' : 'รอส่งใช้ ' + dl + ' วัน'}</span>` : '';
          return `<tr class="it${canEdit ? ' ed' : ''}" data-row="${esc(r.id)}" data-batch="${esc(g.id)}"><td class="ct">${no}</td><td>${esc(r.itemName)}${badge}</td>
            <td>${r.isGroup ? `<span class="gname" data-group="${esc(r.id)}">${r.groupCount} ราย</span>` : esc(r.name)}</td><td class="num">${money(r.amount)}</td></tr>`;
        }).join('');
    }).join('');
    gN += no; gT += tot;
    return `<tbody>${si ? '<tr class="gap"><td colspan="4"></td></tr>' : ''}<tr class="sec"><td colspan="4">${s.t} (ประจำปีงบประมาณ ${KT.fy})</td></tr>
      <tr class="ch"><th>ที่</th><th>รายการ</th><th>ชื่อ-สกุล</th><th>จำนวนเงิน</th></tr>${rows}
      <tr class="tot"><td colspan="2" class="ct">รวม ${no} รายการ</td><td class="ct">เป็นเงิน</td><td class="num">${money(tot)}</td></tr></tbody>`;
  }).join('');
  const grand = used.length > 1 ? `<tbody><tr class="gap"><td colspan="4"></td></tr><tr class="grand"><td colspan="2" class="ct">รวมทั้งสิ้น ${gN} รายการ</td><td class="ct">เป็นเงิน</td><td class="num">${money(gT)}</td></tr></tbody>` : '';
  const tools = [['copy', 'ktCopy', 'คัดลอกรูปภาพ (วางในไลน์ได้)'], ['png', 'ktSave', 'บันทึกรูปภาพ (PNG)'], ['pdf', 'ktPdf', 'บันทึกเป็น PDF']]
    .map(([k, i, t]) => `<button type="button" class="kd-tool" data-exp="${k}" title="${t}" aria-label="${t}">${ic(i)}</button>`).join('');
  const sch = (KT.day && KT.day.school && KT.day.school.name) || 'โรงเรียนมหาวชิราวุธ จังหวัดสงขลา';
  return `<div class="kd-wrap"><div class="kd-tools">${tools}</div><div id="ktDocInner" class="ktb-doc2 kt-th-${KT_THEME}">
    <div class="kd-hd">${logo ? `<div class="kd-logo"><img src="${esc(logo)}" alt="ตราโรงเรียน"></div>` : ''}
      <div class="kd-ttl"><div class="s1">รายการสั่งจ่ายเงินผ่านระบบ KTB Corporate Online</div><div class="s2">${esc(sch)} · วันที่ ${ktThDateBE(KT.date)}</div></div></div>
    <div class="kd-in"><table class="kd">
    <colgroup><col style="width:7%"><col><col style="width:27%"><col style="width:17%"></colgroup>
    ${body}${grand}</table>
    <div class="kd-baht">(${bahtText(gT)})</div>
    <div class="kd-sig">${ktSigHtml()}</div></div></div></div>`;
}

/* ===== ส่งออก Excel รายเดือน (ExcelJS) ===== */
function loadExcelJs() {
  if (window.ExcelJS) return Promise.resolve();
  return new Promise((ok, no) => { const s = document.createElement('script');
    s.src = 'https:\/\/cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js'; s.onload = ok; s.onerror = () => no(new Error('โหลดตัวสร้างไฟล์ Excel ไม่ได้ ลองใหม่อีกครั้ง')); document.head.appendChild(s); });
}
function ktXlsxOpen() {
  const ym = KT.date.slice(0, 7);
  document.querySelector('#ktGroupView .modal-title').textContent = 'ส่งออก Excel รายเดือน';
  $('ktGroupBody').innerHTML = `<label class="form-label" for="ktXlsxYm">เลือกเดือน</label>
    <input type="month" class="form-control mb-3" id="ktXlsxYm" value="${ym}">
    <p class="small-x muted mb-3">แผ่นงาน: สรุปรายวัน · เงินในงบ · เงินนอกงบ · แยกรายวัน (แบบเอกสารแจ้งโอน) · รายการทั้งหมด (กรองได้)</p>
    <button type="button" class="btnx pri w-100" id="btnKtXlsxGo">${ic('ktXls')}<span>ดาวน์โหลด Excel</span></button>`;
  $('btnKtXlsxGo').onclick = () => { const v = $('ktXlsxYm').value; if (!/^\d{4}-\d{2}$/.test(v)) return toast('กรุณาเลือกเดือน', true); modal('ktGroupView').hide(); exportKtbXlsx(v); };
  modal('ktGroupView').show();
}
async function exportKtbXlsx(ym) {
  loading(true);
  try {
    const [D] = await Promise.all([api('getKtbMonthExport', ym), loadExcelJs()]);
    if (!D.days.length) { loading(false); return toast('เดือนนี้ยังไม่มีรายการแจ้งโอน', true); }
    const [Y, M] = ym.split('-').map(Number), mLbl = `${MTH[M - 1]} พ.ศ. ${Y + 543}`;
    const school = (D.school && D.school.name) || (KT.day && KT.day.school && KT.day.school.name) || '';
    const secOf = r => { const k = r.budgetType || ktCatToBt(r.fundCat); return KT_SEC.find(s => s.k === k) || KT_SEC[0]; };
    const F = 'TH Sarabun New', NF = '#,##0.00;-#,##0.00;"-"';
    const C = { navy: 'FF0B3B66', sky: 'FF00A6E6', lt: 'FFCDEBF9', lt2: 'FFEAF7FD', line: 'FF9CC9E2', white: 'FFFFFFFF' };
    const fill = c => ({ type: 'pattern', pattern: 'solid', fgColor: { argb: c } });
    const bd = { style: 'thin', color: { argb: C.line } }, box = { top: bd, left: bd, bottom: bd, right: bd };
    const wb = new ExcelJS.Workbook(); wb.creator = school; wb.created = new Date();
    const mk = (name, widths, land) => {
      const ws = wb.addWorksheet(name, { pageSetup: { paperSize: 9, orientation: land ? 'landscape' : 'portrait', fitToPage: true, fitToWidth: 1, fitToHeight: 0, margins: { left: .4, right: .4, top: .5, bottom: .5, header: .3, footer: .3 } } });
      ws.columns = widths.map(w => ({ width: w }));
      ws.properties.defaultRowHeight = 21;
      return ws;
    };
    const style = (row, o) => row.eachCell({ includeEmpty: true }, c => {
      c.font = { name: F, size: o.size || 15, bold: !!o.bold, color: { argb: o.color || 'FF13293D' } };
      if (o.fill) c.fill = fill(o.fill);
      if (o.border !== false) c.border = box;
      c.alignment = { vertical: 'middle', horizontal: o.align || 'left', wrapText: !!o.wrap };
    });
    const title = (ws, n, sub) => {
      ws.mergeCells(1, 1, 1, n); ws.mergeCells(2, 1, 2, n);
      ws.getCell(1, 1).value = 'รายการสั่งจ่ายเงินผ่านระบบ KTB Corporate Online';
      ws.getCell(2, 1).value = [school, sub].filter(Boolean).join(' · ');
      style(ws.getRow(1), { size: 20, bold: true, color: C.navy, align: 'center', border: false });
      style(ws.getRow(2), { size: 16, color: 'FF4A6378', align: 'center', border: false });
      ws.getRow(1).height = 30; ws.getRow(2).height = 24;
    };
    const money2 = (row, cols) => cols.forEach(i => { const c = row.getCell(i); c.numFmt = NF; c.alignment = { vertical: 'middle', horizontal: 'right' }; });

    /* 1) สรุปรายวัน */
    const s1 = mk('สรุปรายวัน', [7, 26, 13, 18, 18, 18, 18]);
    title(s1, 7, `ประจำเดือน${mLbl}`);
    const h1 = s1.getRow(4); h1.values = ['ที่', 'วันที่โอน', 'จำนวนรายการ', 'เงินงบประมาณ', 'เงินรายได้แผ่นดิน', 'เงินนอกงบประมาณ', 'รวม'];
    style(h1, { bold: true, fill: C.sky, color: C.white, align: 'center', wrap: true }); h1.height = 42;
    D.days.forEach((d, i) => {
      const t = { bud: 0, rev: 0, off: 0, etc: 0 }; d.rows.forEach(r => { t[secOf(r).k] += r.amount; });
      const rn = 5 + i, row = s1.getRow(rn);
      row.values = [i + 1, thDate(d.date), d.rows.length, t.bud || null, t.rev || null, t.off + t.etc || null, { formula: `SUM(D${rn}:F${rn})` }];
      style(row, { fill: i % 2 ? C.lt2 : null }); row.getCell(1).alignment = row.getCell(3).alignment = { vertical: 'middle', horizontal: 'center' };
      money2(row, [4, 5, 6, 7]); row.getCell(7).font = { name: F, size: 15, bold: true, color: { argb: C.navy } };
    });
    const e1 = 4 + D.days.length, t1 = s1.getRow(e1 + 1);
    t1.values = [`รวมทั้งเดือน ${D.days.length} วัน`, '', { formula: `SUM(C5:C${e1})` }, ...['D', 'E', 'F', 'G'].map(L => ({ formula: `SUM(${L}5:${L}${e1})` }))];
    s1.mergeCells(e1 + 1, 1, e1 + 1, 2);
    style(t1, { bold: true, fill: C.navy, color: C.white, align: 'center' }); money2(t1, [4, 5, 6, 7]);
    s1.views = [{ state: 'frozen', ySplit: 4 }];

    /* 1.1) แท็ปแยกตามประเภทเงิน: เงินในงบ / เงินนอกงบ (/ รายได้แผ่นดิน ถ้ามี) */
    const typeTab = (name, label, keys, always) => {
      const days = D.days.map(d => ({ d, rows: d.rows.filter(x => keys.includes(secOf(x).k)) })).filter(x => x.rows.length);
      if (!days.length && !always) return;
      const ws = mk(name, [6, 19, 42, 32, 14, 19, 30, 17], true);
      title(ws, 8, `${label} · ประจำเดือน${mLbl}`);
      const h = ws.getRow(4); h.values = ['ที่', 'วันที่โอน', 'รายการ', 'ชื่อ-สกุล', 'บัญชีปลายทาง', 'วันที่เงินเข้า', 'ตัดยอดจากประเภทเงิน', 'จำนวนเงิน'];
      style(h, { bold: true, fill: C.sky, color: C.white, align: 'center', wrap: true }); h.height = 30;
      let rr = 5, no = 0;
      if (!days.length) { ws.mergeCells(5, 1, 5, 8); ws.getCell(5, 1).value = 'เดือนนี้ไม่มีรายการ'; style(ws.getRow(5), { align: 'center', color: 'FF7C93A6' }); return; }
      days.forEach(({ d, rows }) => rows.forEach(x => {
        no++;
        const other = ktBankKind(x.bankAccount) === 'ต่างธนาคาร', row = ws.getRow(rr);
        row.values = [no, thDate(d.date), x.itemName, x.isGroup ? `${x.groupCount} ราย${x.groupNames ? ': ' + x.groupNames : ''}` : x.name,
          other ? 'ต่างธนาคาร' : 'กรุงไทย', thDate(other ? (d.arriveOther || d.date) : d.date), x.fundSourceName, x.amount];
        style(row, { fill: no % 2 ? null : C.lt2, wrap: true });
        [1, 2, 5, 6].forEach(i => row.getCell(i).alignment = { vertical: 'middle', horizontal: 'center', wrapText: true });
        money2(row, [8]); rr++;
      }));
      ws.autoFilter = { from: { row: 4, column: 1 }, to: { row: rr - 1, column: 8 } };
      const t = ws.getRow(rr);
      t.values = ['', `รวม${label}ทั้งเดือน ${no} รายการ`, '', '', '', '', '', { formula: `SUBTOTAL(9,H5:H${rr - 1})` }];
      ws.mergeCells(rr, 2, rr, 7);
      style(t, { bold: true, fill: C.navy, color: C.white, align: 'right' }); money2(t, [8]); t.height = 26;
      ws.views = [{ state: 'frozen', ySplit: 4 }];
    };
    typeTab('เงินในงบ', 'เงินงบประมาณ', ['bud'], true);
    typeTab('เงินนอกงบ', 'เงินนอกงบประมาณ', ['off', 'etc'], true);
    typeTab('เงินรายได้แผ่นดิน', 'เงินรายได้แผ่นดิน', ['rev'], false);

    /* 2) แยกรายวัน (แบบเอกสารแจ้งโอน) */
    const s2 = mk('แยกรายวัน', [7, 50, 30, 18]);
    title(s2, 4, `ประจำเดือน${mLbl}`);
    let r = 4;
    const put = (vals, o, merge) => { const row = s2.getRow(r); row.values = vals; if (merge) s2.mergeCells(r, merge[0], r, merge[1]); style(row, o); r++; return row; };
    D.days.forEach(d => {
      put([`วันที่โอน ${ktThDateBE(d.date)}`], { size: 17, bold: true, fill: C.navy, color: C.white }, [1, 4]); s2.getRow(r - 1).height = 26;
      const secs = KT_SEC.map(x => ({ ...x, g: {} }));
      d.rows.forEach(x => { const sc = secs.find(y => y.k === secOf(x).k); const bk = ktBankKind(x.bankAccount); (sc.g[bk] = sc.g[bk] || []).push(x); });
      let dn = 0, dt = 0; const used = secs.filter(x => Object.keys(x.g).length);
      used.forEach(sc => {
        put([`${sc.t} (ประจำปีงบประมาณ ${d.fy})`], { bold: true, fill: C.sky, color: C.white, align: 'center' }, [1, 4]);
        put(['ที่', 'รายการ', 'ชื่อ-สกุล', 'จำนวนเงิน'], { bold: true, fill: C.lt, color: C.navy, align: 'center' });
        let no = 0, tot = 0;
        ['ธนาคารกรุงไทย', 'ต่างธนาคาร'].filter(k => sc.g[k]).forEach(k => {
          const arr = k === 'ต่างธนาคาร' ? (d.arriveOther || d.date) : d.date;
          put(['', `บัญชีปลายทาง${k} (วันที่ ${ktThDateBE(arr)})`], { bold: true }, [2, 3]);
          sc.g[k].forEach(x => {
            no++; tot += x.amount;
            const row = put([no, x.itemName, x.isGroup ? `${x.groupCount} ราย${x.groupNames ? ': ' + x.groupNames : ''}` : x.name, x.amount], { wrap: true });
            row.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' }; money2(row, [4]);
          });
        });
        const tr = put([`รวม ${no} รายการ`, '', 'เป็นเงิน', tot], { bold: true, fill: C.lt, color: C.navy, align: 'center' }, [1, 2]); money2(tr, [4]);
        dn += no; dt += tot;
      });
      if (used.length > 1) { const g = put([`รวมทั้งสิ้น ${dn} รายการ`, '', 'เป็นเงิน', dt], { bold: true, fill: C.navy, color: C.white, align: 'center' }, [1, 2]); money2(g, [4]); }
      put([`(${bahtText(dt)})`], { bold: true, color: C.navy, align: 'right', border: false }, [1, 4]);
      r++;
    });

    /* 3) รายการทั้งหมด (กรอง/เรียงได้) */
    const s3 = mk('รายการทั้งหมด', [7, 22, 20, 18, 22, 32, 20, 44, 30, 16, 24], true);
    title(s3, 11, `ประจำเดือน${mLbl}`);
    const h3 = s3.getRow(4);
    h3.values = ['ที่', 'วันที่โอน', 'ประเภทการแจ้งโอน', 'บัญชีปลายทาง', 'วันที่เงินเข้า', 'ตัดยอดจากประเภทเงิน', 'หมวดรายจ่าย', 'รายการ', 'ชื่อ-สกุล', 'จำนวนเงิน', 'หมายเหตุ'];
    style(h3, { bold: true, fill: C.sky, color: C.white, align: 'center', wrap: true }); h3.height = 42;
    let n = 0;
    D.days.forEach(d => d.rows.forEach(x => {
      n++; const other = ktBankKind(x.bankAccount) === 'ต่างธนาคาร';
      const row = s3.getRow(4 + n);
      row.values = [n, thDate(d.date), secOf(x).t, x.bankAccount, thDate(other ? (d.arriveOther || d.date) : d.date), x.fundSourceName, x.expenseCat, x.itemName,
        x.isGroup ? `${x.groupCount} ราย${x.groupNames ? ': ' + x.groupNames : ''}` : x.name, x.amount, x.note];
      style(row, { fill: n % 2 ? null : C.lt2, wrap: true }); row.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' }; money2(row, [10]);
    }));
    const t3 = s3.getRow(5 + n);
    t3.values = ['', `รวม ${n} รายการ`, '', '', '', '', '', '', 'เป็นเงิน', { formula: `SUBTOTAL(9,J5:J${4 + n})` }, ''];
    s3.mergeCells(5 + n, 2, 5 + n, 8);
    style(t3, { bold: true, fill: C.navy, color: C.white, align: 'center' }); money2(t3, [10]);
    s3.autoFilter = { from: { row: 4, column: 1 }, to: { row: 4 + n, column: 11 } };
    s3.views = [{ state: 'frozen', ySplit: 4 }];

    const buf = await wb.xlsx.writeBuffer();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }));
