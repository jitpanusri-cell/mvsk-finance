/* จำนวนเงินเป็นตัวอักษรไทย (บาทถ้วน) */
function bahtText(n) {
  n = Math.round((+n || 0) * 100) / 100; if (n === 0) return 'ศูนย์บาทถ้วน';
  const neg = n < 0; n = Math.abs(n);
  const b = Math.floor(n), st = Math.round((n - b) * 100);
  return (neg ? 'ลบ' : '') + (b ? readTh(b, false) + 'บาท' : '') + (st ? readTh(st, false) + 'สตางค์' : 'ถ้วน');
}
function readTh(n, hi) {
  const d = ['', 'หนึ่ง', 'สอง', 'สาม', 'สี่', 'ห้า', 'หก', 'เจ็ด', 'แปด', 'เก้า'], p = ['', 'สิบ', 'ร้อย', 'พัน', 'หมื่น', 'แสน'];
  if (n >= 1e6) { const r = n % 1e6; return readTh(Math.floor(n / 1e6), hi) + 'ล้าน' + (r ? readTh(r, true) : ''); }
  const s = String(n), L = s.length; let o = '';
  for (let i = 0; i < L; i++) { const x = +s[i], pos = L - i - 1; if (!x) continue;
    if (pos === 1 && x === 1) o += 'สิบ'; else if (pos === 1 && x === 2) o += 'ยี่สิบ';
    else if (pos === 0 && x === 1 && (L > 1 || hi)) o += 'เอ็ด'; else o += d[x] + p[pos]; }
  return o;
}

