  'driveFolderId', 'garudaUrl', 'legacySpreadsheetId', 'rateEquipLower', 'rateEquipUpper', 'rateUniformLower', 'rateUniformUpper',
  'payDeadlineEquip', 'payDeadlineUniform'];
const SF_KEY = { payDeadlineEquip: 'payDeadline_EQUIP', payDeadlineUniform: 'payDeadline_UNIFORM' };

function initSettingsPage() {
  if (SF.inited) return;
  SF.inited = true; SF.fy = S.fy;
  $('sfOpenFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === SF.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('sfOpenFy').onchange = e => { SF.fy = +e.target.value; loadSettings(); };
  $('btnSfSave').innerHTML = ic('check', 'sm') + '<span>บันทึกการตั้งค่า</span>';
  $('btnSfSave').onclick = saveSfForm;
  $('btnSfOpenSave').onclick = saveSfOpenings;
  const card = document.createElement('div');
  card.className = 'cardx mb-grid'; card.id = 'sfFyCard';
  card.innerHTML = `<div class="card-h"><h3>ปีงบประมาณ</h3></div>
    <div class="px-3 pb-3 d-flex flex-wrap gap-2 align-items-center">
      <div id="sfFyChips" class="d-flex flex-wrap gap-2"></div>
      <input class="inp num" type="number" id="sfFyNew" min="2550" max="2700" placeholder="เช่น 2571" style="width:130px" aria-label="ปีงบประมาณที่จะเพิ่ม">
      <button class="btnx pri sm" id="btnSfFyAdd">${ic('plus', 'sm')}<span>เพิ่มปีงบประมาณ</span></button></div>`;
  $('sfOpenList').closest('.cardx').before(card);
  $('btnSfFyAdd').onclick = () => sfFyChange('addFiscalYear', +$('sfFyNew').value);
}

function renderSfFy() {
  const B = S.boot, extra = (B.fyExtra || []).map(Number);
  $('sfFyChips').innerHTML = B.fyList.map(y => `<span class="st ${y === B.fyNow ? 'ok' : 'none'}" style="display:inline-flex;align-items:center;gap:6px">ปีงบ ${y}${extra.includes(y) ? `<button class="linkbtn" data-fydel="${y}" title="ลบปีงบ ${y} ออกจากรายการ" aria-label="ลบปีงบ ${y}">×</button>` : ''}</span>`).join('');
  $('sfFyChips').querySelectorAll('[data-fydel]').forEach(b => b.onclick = () => sfFyChange('removeFiscalYear', +b.dataset.fydel));
  const can = SF.data && SF.data.canEdit;
  $('sfFyNew').disabled = !can; $('btnSfFyAdd').style.display = can ? '' : 'none';
}

async function sfFyChange(fn, y) {
  if (fn === 'addFiscalYear' && !(y >= 2550 && y <= 2700)) return toast('กรอกปีงบประมาณเป็น พ.ศ. เช่น 2571', true);
  loading(true);
  try {
    await api(fn, y);
    S.boot = await api('getBootstrapFy');
    refreshFySelects();
    $('sfFyNew').value = '';
    renderSfFy();
    toast(fn === 'addFiscalYear' ? 'เพิ่มปีงบประมาณ ' + y + ' แล้ว' : 'ลบปีงบประมาณ ' + y + ' ออกจากรายการแล้ว');
  } catch (e) { fail(e); }
  loading(false);
}

/* ---------- สวิตช์ปีงบประมาณ (แถบบน) — เลือกปีแล้วทุกเมนูใช้ปีนั้น ยกเว้นเปลี่ยนเองในเมนูนั้น ๆ ---------- */
const gfyKey = () => 'gfy|' + ((S.boot && S.boot.user && S.boot.user.email) || '');
function gfyLoad() { try { return +localStorage.getItem(gfyKey()) || 0; } catch (e) { return 0; } }
function gfySave(y) { try { localStorage.setItem(gfyKey(), String(y)); } catch (e) { } }

function renderGFy() {
  if (!$('gFyBox')) {
    const isAdmin = S.boot.user.role === 'admin';
    document.head.insertAdjacentHTML('beforeend', `<style>
      .gfy{margin:4px 14px 10px;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.12);display:flex;flex-wrap:wrap;gap:6px;align-items:center}
      .gfy label{width:100%;color:rgba(255,255,255,.85);font-size:12.5px;font-weight:600}
      .gfy .sel{flex:1;min-width:0;min-height:38px}
      .gfy .btnx.sec{background:rgba(255,255,255,.9)}
      .gfy #gFyAddBox{display:flex;gap:6px;width:100%}
      .gfy #gFyAddBox[hidden]{display:none}
      .gfy #gFyNew{flex:1;min-width:0;min-height:36px}
      .page-head .sub:not(#dSub){display:none}
      #printSaveBar{display:none!important}
      .pr-go{width:100%;border:0;background:none;cursor:pointer;font:inherit;color:inherit}
      .pr-go:hover{background:var(--line2,#F2F4F7)}
      .card-h .hint:not(#dTblHint):not(#dcListHint){display:none}
    </style>`);
    $('nav').insertAdjacentHTML('beforebegin', `<div class="gfy" id="gFyBox">
      <label for="gFySel">ปีงบประมาณ</label>
      <select class="sel" id="gFySel" aria-label="สลับปีงบประมาณทั้งระบบ" title="เลือกปีงบประมาณที่ใช้ทุกเมนู"></select>
      ${isAdmin ? `<button class="btnx sec sm icon" id="btnGFyAdd" title="เพิ่มปีงบประมาณ" aria-label="เพิ่มปีงบประมาณ">${ic('plus', 'sm')}</button>
      <span id="gFyAddBox" hidden><input class="inp num" type="number" id="gFyNew" min="2550" max="2700" placeholder="พ.ศ. เช่น 2571" aria-label="ปีงบประมาณที่จะเพิ่ม">
        <button class="btnx pri sm" id="btnGFyOk">เพิ่ม</button><button class="btnx sec sm" id="btnGFyX" aria-label="ยกเลิก">×</button></span>` : ''}</div>`);
    $('gFySel').onchange = e => setGlobalFy(+e.target.value);
    if (isAdmin) {
      const box = $('gFyAddBox');
      $('btnGFyAdd').onclick = () => { box.hidden = false; $('btnGFyAdd').hidden = true; $('gFyNew').focus(); };
      $('btnGFyX').onclick = () => { box.hidden = true; $('btnGFyAdd').hidden = false; };
      $('btnGFyOk').onclick = async () => {
        const y = +$('gFyNew').value;
        await sfFyChange('addFiscalYear', y);
        if (S.boot.fyList.includes(y)) { box.hidden = true; $('btnGFyAdd').hidden = false; setGlobalFy(y); }
      };
      $('gFyNew').onkeydown = e => { if (e.key === 'Enter') $('btnGFyOk').click(); };
    }
  }
  $('gFySel').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === S.fy ? ' selected' : ''}>${y}</option>`).join('');
}

function setGlobalFy(y) {
  y = +y; if (!y) return;
  S.fy = y; S.term = 'ALL'; gfySave(y);
  const pages = [[typeof A !== 'undefined' && A], [typeof AL !== 'undefined' && AL], [typeof RF !== 'undefined' && RF, o => o.sel && o.sel.clear()],
    [typeof AC !== 'undefined' && AC], [typeof RC !== 'undefined' && RC], [typeof BL !== 'undefined' && BL, o => { o.date = ''; }],
    [typeof SF !== 'undefined' && SF], [typeof RP !== 'undefined' && RP], [typeof EX !== 'undefined' && EX], [typeof KT !== 'undefined' && KT],
    [typeof DC !== 'undefined' && DC], [typeof LG !== 'undefined' && LG]];
  pages.forEach(([o, extra]) => { if (o && o.inited) { o.fy = y; if (extra) extra(o); } });
  if (typeof ST !== 'undefined' && ST.inited && $('stTerm')) {
    const t = '1/' + y;
    if ([...$('stTerm').options].some(o => o.value === t)) { ST.term = t; $('stTerm').value = t; ST.rooms.clear(); }
  }
  ['gFySel', 'lgFy', 'fySel', 'actFy', 'alFy', 'rpFy', 'exFy', 'acFy', 'rcFy', 'blFy', 'rfFy', 'ktFy', 'dcFy', 'sfOpenFy'].forEach(id => {
    const el = $(id); if (el && [...el.options].some(o => +o.value === y)) el.value = String(y);
  });
  S._lastLoad = {};
  renderTermSeg();
  if (S.page === 'dashboard') loadDashboard(); else go(S.page);
  toast('ปีงบประมาณ ' + y);
}

function refreshFySelects() {
  ['lgFy', 'fySel', 'actFy', 'alFy', 'rpFy', 'exFy', 'acFy', 'rcFy', 'blFy', 'rfFy', 'ktFy', 'dcFy', 'sfOpenFy'].forEach(id => {
    const el = $(id); if (!el) return;
    const cur = +el.value || S.fy;
    el.innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === cur ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  });
  if ($('gFyBox')) renderGFy();
}

async function loadSettings() {
  initSettingsPage();
  loading(true);
  try { SF.data = await api('getSettingsData', SF.fy); renderSettings(); renderSfFy(); }
  catch (e) { fail(e); }
  loading(false);
}

function renderSettings() {
  const D = SF.data, F = D.fields;
  $('sfSchoolName').value = F.schoolName; $('sfArea').value = F.area; $('sfDocPrefix').value = F.docPrefix;
  $('sfDirector').value = F.director; $('sfDeputy').value = F.deputy; $('sfFinOfficer').value = F.finOfficer; $('sfAccOfficer').value = F.accOfficer;
  $('sfDriveFolderId').value = F.driveFolderId; $('sfGarudaUrl').value = F.garudaUrl; $('sfLegacySpreadsheetId').value = F.legacySpreadsheetId;
  $('sfRateEquipLower').value = F.rateEquipLower; $('sfRateEquipUpper').value = F.rateEquipUpper;
  $('sfRateUniformLower').value = F.rateUniformLower; $('sfRateUniformUpper').value = F.rateUniformUpper;
  $('sfPayDeadlineEquip').value = F.payDeadline_EQUIP; $('sfPayDeadlineUniform').value = F.payDeadline_UNIFORM;
  document.querySelectorAll('#page-settings input').forEach(i => i.disabled = !D.canEdit);
  $('btnSfSave').style.display = D.canEdit ? '' : 'none';
  $('btnSfOpenSave').style.display = D.canEdit ? '' : 'none';
  $('sfOpenList').innerHTML = D.openings.map(o => `<div class="col-sm-4 col-6">
    <label class="flabel"><span class="fdot" style="background:${o.color}"></span>${esc(o.name)}</label>
    <input class="inp num" type="number" step="0.01" min="0" data-fund="${o.code}" value="${o.value}"></div>`).join('');
}

async function saveSfForm() {
  const obj = {};
  SF_FIELDS.forEach(k => { const key = SF_KEY[k] || k; obj[key] = $('sf' + k.charAt(0).toUpperCase() + k.slice(1)).value; });
  const btn = $('btnSfSave'); btn.disabled = true;
  try { await api('saveSettings', obj); toast('บันทึกการตั้งค่าแล้ว'); await loadSettings(); S.boot = await api('getBootstrapFy'); renderShell(); }
  catch (e) { fail(e); }
  btn.disabled = false;
}

async function saveSfOpenings() {
  const inputs = [...document.querySelectorAll('#sfOpenList [data-fund]')];
  const btn = $('btnSfOpenSave'); btn.disabled = true;
  try {
    for (const i of inputs) await api('saveOpeningBalance', SF.fy, i.dataset.fund, +i.value || 0);
    toast('บันทึกยอดยกมาแล้ว'); await loadSettings();
  } catch (e) { fail(e); }
  btn.disabled = false;
}

/* =========================================================
 * ผู้ใช้และสิทธิ์
 * ========================================================= */
const US = { data: null };
const US_ROLE_BADGE = { admin: 'bad', exec: 'info', finance: 'ok', account: 'warn', teacher: 'none' };

function initUsersPage() {
  if (US.inited) return;
  US.inited = true;
  $('btnUsAdd').innerHTML = ic('plus') + '<span>เพิ่มผู้ใช้</span>';
  $('btnUsAdd').onclick = () => openUsForm();
  $('btnUsSave').onclick = saveUsForm;
  $('btnUsDel').onclick = deleteUsForm;
}

async function loadUsers() {
  initUsersPage();
  loading(true);
  try { US.data = await api('getUsersData'); renderUsers(); }
  catch (e) { fail(e); }
  loading(false);
}

function renderUsers() {
  const D = US.data;
  $('btnUsAdd').style.display = D.canEdit ? '' : 'none';
  const roleLabel = r => (D.roles.find(x => x.code === r) || { label: r }).label;
  $('usList').innerHTML = `<thead><tr><th>ชื่อ</th><th>อีเมล</th><th>บทบาท</th><th>สถานะ</th><th>ห้องที่รับผิดชอบ</th><th>หมายเหตุ</th><th></th></tr></thead><tbody>
    ${D.list.map(u => `<tr>
      <td>${esc(u.name) || '-'}${u.email === D.me ? ' <span class="muted small-x">(ฉัน)</span>' : ''}</td>
      <td>${esc(u.email)}</td>
      <td><span class="st ${US_ROLE_BADGE[u.role] || 'none'}">${esc(roleLabel(u.role))}</span></td>
      <td>${u.active ? '<span class="st ok">ใช้งานอยู่</span>' : '<span class="st none">ปิดใช้งาน</span>'}</td>
      <td class="small-x">${esc(u.rooms) || '-'}</td>
      <td class="small-x">${esc(u.note) || '-'}</td>
      <td class="text-end">${D.canEdit ? `<button class="btnx sec icon sm" style="width:36px" data-edit="${esc(u.email)}" title="แก้ไข" aria-label="แก้ไข">${ic('edit','sm')}</button>` : ''}</td>
      </tr>`).join('') || `<tr><td colspan="7" class="text-center muted py-4">ยังไม่มีผู้ใช้ในระบบ</td></tr>`}</tbody>`;
  $('usList').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openUsForm(b.dataset.edit));
}

function openUsForm(email) {
  const D = US.data;
  const u = email ? D.list.find(x => x.email === email) : null;
  $('fUsRole').innerHTML = D.roles.map(r => `<option value="${r.code}">${esc(r.label)}</option>`).join('');
  $('usModalTitle').textContent = u ? 'แก้ไขผู้ใช้' : 'เพิ่มผู้ใช้';
  $('fUsIsNew').value = u ? '' : '1';
  $('fUsEmail').value = u ? u.email : '';
  $('fUsEmail').disabled = !!u;
  $('fUsName').value = u ? u.name : '';
  $('fUsRole').value = u ? u.role : 'teacher';
  $('fUsActive').checked = u ? u.active : true;
  $('fUsRooms').value = u ? u.rooms : '';
  $('fUsNote').value = u ? u.note : '';
  $('btnUsDel').style.display = (u && u.email !== D.me) ? '' : 'none';
  modal('usModal').show();
}
async function saveUsForm() {
  const obj = {
    email: $('fUsEmail').value.trim(), isNew: !!$('fUsIsNew').value,
    name: $('fUsName').value.trim(), role: $('fUsRole').value, active: $('fUsActive').checked,
    rooms: $('fUsRooms').value.trim(), note: $('fUsNote').value.trim()
  };
  const btn = $('btnUsSave'); btn.disabled = true;
  try { await api('saveUser', obj); modal('usModal').hide(); toast('บันทึกแล้ว'); await loadUsers(); }
  catch (e) { fail(e); }
  btn.disabled = false;
}
async function deleteUsForm() {
  const email = $('fUsEmail').value; if (!email) return;
  if (!confirm('ลบผู้ใช้นี้?')) return;
  try { await api('deleteUser', email); modal('usModal').hide(); toast('ลบแล้ว'); await loadUsers(); }
  catch (e) { fail(e); }
}

/* =========================================================
 * บันทึกรายรับ (เงินเข้าบัญชีจริง)
 * ========================================================= */
const RP = { fy: null, data: null };
const RP_ST = { ok: 'ok', under: 'warn', over: 'bad' };
const RP_ST_TXT = { ok: 'ตรงกับหนังสือ', under: 'เงินเข้ายังไม่ครบ', over: 'เงินเข้าเกินหนังสือ' };

function initReceiptPage() {
  if (RP.inited) return;
  RP.inited = true; RP.fy = S.fy;
  $('rpFy').innerHTML = S.boot.fyList.map(y => `<option value="${y}"${y === RP.fy ? ' selected' : ''}>ปีงบประมาณ ${y}</option>`).join('');
  $('rpFy').onchange = e => { RP.fy = +e.target.value; loadReceipt(); };
  $('btnRpAdd').innerHTML = ic('plus') + '<span>เพิ่มรายการ</span>';
  $('btnRpAdd').onclick = () => openRpForm();
  $('btnRpSave').onclick = saveRpForm;
  $('btnRpDel').onclick = deleteRpForm;
  $('fRpAlloc').onchange = () => { $('fRpTermWrap').style.display = $('fRpAlloc').value ? 'none' : ''; };
}

async function loadReceipt() {
  initReceiptPage();
  loading(true);
  try { RP.data = await api('getReceiptData', RP.fy); renderReceipt(); }
  catch (e) { fail(e); }
  loading(false);
}

function renderReceipt() {
  const D = RP.data;
  $('btnRpAdd').style.display = D.canEdit ? '' : 'none';
  $('rpKpi').innerHTML = `
    <div class="kpi dark"><div class="l">${ic('receipt','sm')}รายรับทั้งหมด</div>
      <div class="v">${moneyKpi(D.totalReceived)}<small>บาท</small></div><div class="f">${D.receipts.length} รายการ · ปีงบ ${D.fy}</div></div>
    <div class="kpi cream"><div class="l">${ic('check','sm')}ตรงกับหนังสือจัดสรร</div>
      <div class="v">${D.rounds.length - D.diffCount}<small>/ ${D.rounds.length} งวด</small></div><div class="f">เทียบยอดตามหนังสือกับยอดที่บันทึกจริง</div></div>
    <div class="kpi ${D.diffCount ? 'alert' : 'cream'}"><div class="l">${ic('danger','sm')}ยอดไม่ตรง</div>
      <div class="v ${D.diffCount ? 'neg' : ''}">${D.diffCount}<small>งวด</small></div>
      <div class="f">${D.diffCount ? D.rounds.filter(r => r.status !== 'ok').map(r => r.label).join(', ') : 'ไม่มี'}</div></div>`;
  renderRpRounds(); renderRpList();
}

function renderRpRounds() {
  const D = RP.data;
  $('rpRounds').innerHTML = `<thead><tr><th>งวด</th><th>เลขที่หนังสือ</th><th class="num">ตามหนังสือ</th><th class="num">เงินเข้าจริง</th><th class="num">ผลต่าง</th><th>สถานะ</th></tr></thead><tbody>
    ${D.rounds.map(r => `<tr><td>${esc(r.label)}</td><td>${esc(r.docNo) || '-'}</td>
      <td class="num">${money(r.total)}</td><td class="num">${money(r.received)}</td>
      <td class="num ${Math.abs(r.diff) > 0.004 ? 'neg' : ''}">${money(r.diff)}</td>
      <td><span class="st ${RP_ST[r.status]}">${RP_ST_TXT[r.status]}</span></td></tr>`).join('')
      || `<tr><td colspan="6" class="text-center muted py-4">ยังไม่มีหนังสือจัดสรรของปีงบนี้</td></tr>`}</tbody>`;
}

function renderRpList() {
  const D = RP.data;
  const fundOfCode = code => (D.funds.find(f => f.code === code) || { name: code, short: code, color: '#999' });
  $('rpList').innerHTML = `<thead><tr><th>วันที่</th><th>อ้างอิง</th><th>รายการเงิน</th><th class="num">จำนวนเงิน</th><th>เลขที่อ้างอิง</th><th>หมายเหตุ</th><th></th></tr></thead><tbody>
    ${D.receipts.map(r => { const f = fundOfCode(r.fund); return `<tr>
      <td style="white-space:nowrap">${thDate(r.date, true)}</td>
      <td class="small-x">${r.allocLabel ? esc(r.allocLabel) : `<span class="muted">${esc(termText(r.term))}</span>`}</td>
      <td><span class="fdot" style="background:${f.color}"></span>${esc(f.short)}</td>
      <td class="num">${money(r.amount)}</td><td>${esc(r.refNo) || '-'}</td><td>${esc(r.note) || '-'}</td>
      <td class="text-end">${D.canEdit ? `<button class="btnx sec icon sm" style="width:36px" data-edit="${r.id}" title="แก้ไข" aria-label="แก้ไข">${ic('edit','sm')}</button>` : ''}</td></tr>`; }).join('')
      || `<tr><td colspan="7" class="text-center muted py-4">ยังไม่มีรายการรายรับ</td></tr>`}</tbody>`;
  $('rpList').querySelectorAll('[data-edit]').forEach(b => b.onclick = () => openRpForm(b.dataset.edit));
}

function openRpForm(id) {
  const D = RP.data;
  const r = id ? D.receipts.find(x => x.id === id) : null;
  $('rpModalTitle').textContent = r ? 'แก้ไขรายการรายรับ' : 'เพิ่มรายการรายรับ · ปีงบ ' + D.fy;
  $('fRpId').value = r ? r.id : '';
  $('fRpAlloc').innerHTML = '<option value="">— ไม่อ้างอิงหนังสือ —</option>' +
    D.rounds.map(x => `<option value="${x.id}">${esc(x.label)}${x.docNo ? ' · ' + esc(x.docNo) : ''}</option>`).join('');
  $('fRpAlloc').value = r ? r.allocId : '';
  $('fRpTermWrap').style.display = $('fRpAlloc').value ? 'none' : '';
  $('fRpTerm').innerHTML = D.terms.map(t => `<option value="${t.key}">${esc(t.label)}</option>`).join('');
  $('fRpTerm').value = r ? r.term : D.terms[D.terms.length - 1].key;
  $('fRpDate').value = r ? r.date : D.today;
  $('fRpFund').innerHTML = D.funds.map(f => `<option value="${f.code}">${esc(f.name)}</option>`).join('');
  $('fRpFund').value = r ? r.fund : D.funds[0].code;
  $('fRpAmt').value = r ? r.amount : '';
  $('fRpRef').value = r ? r.refNo : '';
  $('fRpNote').value = r ? r.note : '';
  $('btnRpDel').style.display = r ? '' : 'none';
  modal('rpModal').show();
}
async function saveRpForm() {
  const o = { id: $('fRpId').value, fy: RP.fy, allocId: $('fRpAlloc').value, term: $('fRpTerm').value,
    date: $('fRpDate').value, fund: $('fRpFund').value, amount: +$('fRpAmt').value || 0,
