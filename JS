}
async function exportKtb(kind) {
  if (!$('ktDocInner')) return;
  if (kind === 'copy') {
    const p = ktCanvas().then(c => new Promise(ok => c.toBlob(ok, 'image/png')));
    try {
      if (!navigator.clipboard || !window.ClipboardItem) throw new Error('no clipboard');
      await navigator.clipboard.write([new ClipboardItem({ 'image/png': p })]);
      toast('คัดลอกรูปแล้ว · วางในไลน์ได้เลย');
    } catch (e) {
      try { const b = await p; ktShowImage(URL.createObjectURL(b)); } catch (e2) { fail(e2); }
    }
    return;
  }
  loading(true);
  try {
    if (kind === 'png') {
      const canvas = await ktCanvas();
      const a = document.createElement('a'); a.download = `KTB-${KT.date}.png`; a.href = canvas.toDataURL('image/png'); a.click();
    } else {
      await loadHtml2Pdf();
      $('ktDocInner').classList.add('kd-pdf');
      try { await html2pdf().set({ margin: 8, filename: `KTB-${KT.date}.pdf`, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } }).from($('ktDocInner')).save(); }
      finally { $('ktDocInner').classList.remove('kd-pdf'); }
    }
  } catch (e) { fail(e); }
  loading(false);
}

