  document.querySelectorAll('#dcModal .dc-loan-only').forEach(el => el.style.display = loan ? '' : 'none');
  document.querySelectorAll('#dcModal .dc-travel-only').forEach(el => el.style.display = travel ? '' : 'none');
  $('dcModal').classList.toggle('adv', !loan);
  $('dcKinds').innerHTML = `<legend>${esc(O.legend)}</legend>` + O.opts.map(([v, t, d]) => `<label class="dc2-kind${v === k ? ' on' : ''}"><input type="radio" name="dcKindR" value="${v}"${v === k ? ' checked' : ''}><span><b>${esc(t)}</b><small>${esc(d)}</small></span></label>`).join('');
  $('dcKinds').querySelectorAll('input').forEach(inp => inp.onchange = () => { $('fDcKind').value = inp.value; dcApplyKind(); dcRecalc(); });
  $('dcSecPerson').textContent = loan ? 'ผู้ยืม' : 'ผู้ขอเบิก';
  $('dcPurposeHead').textContent = travel ? (loan ? 'ยืมเงินไปราชการ' : 'ไปราชการ') : (loan ? 'ยืมเงินเพื่อ' : 'สำรองจ่ายไปเพื่อ');
  $('dcPurposeLabel').textContent = travel ? 'ไปราชการเรื่อง' : (loan ? 'เพื่อเป็นค่าใช้จ่ายในการ' : 'จัดกิจกรรม/เข้าร่วมกิจกรรม/โครงการ');
  $('dcPeopleLabel').textContent = travel ? 'จำนวนผู้เดินทาง (คน)' : 'จำนวนผู้เข้าร่วม (คน)';
  $('dcItemsLabel').textContent = travel ? 'รายการค่าใช้จ่ายอื่น (นอกจากเบี้ยเลี้ยง / ที่พัก / พาหนะด้านบน)' : (loan ? 'รายการค่าใช้จ่าย' : 'รายการที่ขอเบิก (ตามใบเสร็จ / ใบสำคัญรับเงิน)');
  $('dcFormTitle').textContent = loan ? 'กรอกข้อมูลสัญญายืมเงิน' : 'กรอกข้อมูลการขอเบิก';
  $('dcFormHint').textContent = '';
  const dl = document.querySelector('label[for="fDcDocDate"]');
  if (dl) dl.textContent = loan ? 'วันที่ลงในสัญญา' : 'วันที่ลงในบันทึกข้อความ (เว้นวันได้)';
  $('btnDcToDocs').innerHTML = (loan ? 'ถัดไป: ดูสัญญาการยืมเงิน' : 'ถัดไป: ดูบันทึกข้อความ') + ' ' + ic('chevron', 'sm');
