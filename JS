function dcQuickFill(key, r) {
  const Q = DC_QF[key]; let box = $('dcQf');
  if (!box) { openDcPrintModal(r); box = $('dcQf'); }
  if (!box) { window[Q.fn](r, {}); return; }
  box.hidden = false;
  box.innerHTML = `<div class="dc-sec-h" style="color:#0B7680;margin-bottom:6px"><span class="n" style="background:var(--c-teal)">${ic('print', 'sm')}</span>${esc(Q.t)}</div>
    <div class="small-x muted mb-2">เอกสารประกอบ — กด "พิมพ์แบบฟอร์มเปล่า" ได้ทันที หรือกรอกหัวเอกสาร/ผู้ลงนามคร่าว ๆ แล้วกด "พิมพ์ตามที่กรอก" (ช่องที่ว่าง = เว้นเส้นประให้เขียนเอง)</div>
    <div class="row g-2">${Q.f.map(([k, l, def, type]) => `<div class="col-md-4 col-sm-6"><label class="flabel">${esc(l)}</label><input class="inp" data-qk="${k}"${type === 'date' ? ' type="date"' : ''} value="${esc(def(r) == null ? '' : def(r))}"></div>`).join('')}</div>
    <div class="d-flex flex-wrap gap-2 mt-3"><button type="button" class="btnx pri sm" data-qgo>${ic('print', 'sm')}พิมพ์ตามที่กรอก</button>
      <button type="button" class="btnx sec sm" data-qblank>${ic('print', 'sm')}พิมพ์แบบฟอร์มเปล่า</button><button type="button" class="btnx sec sm" data-qclose>ปิด</button></div>`;
  const val = () => { const o = {}; box.querySelectorAll('[data-qk]').forEach(i => o[i.dataset.qk] = i.value.trim()); return o; };
  box.querySelector('[data-qgo]').onclick = () => window[Q.fn](r, val());
  box.querySelector('[data-qblank]').onclick = () => window[Q.fn](r, {});
  box.querySelector('[data-qclose]').onclick = () => { box.hidden = true; };
  box.scrollIntoView({ block: 'start', behavior: 'smooth' });
}

