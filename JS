}
/* จำนวนแบบบันทึกข้อความ: "2 คน x 120 บาท" / "40 คน x 1 มื้อ x 60 บาท" */
function mvQtyMemo(it) {
  if (!it) return '';
  const p = dcNum(it.p), q1 = dcNum(it.q1), q2 = dcNum(it.q2);
  if (p === '' || q1 === '') return q1 !== '' ? `${dcFmtN(q1)} ${it.u1 || ''}` : '';
  return [q2 !== '' ? `${dcFmtN(q2)} ${it.u2 || ''}`.trim() : '', `${dcFmtN(q1)} ${it.u1 || ''}`.trim()].filter(Boolean).join(' x ') + ` x ${dcFmtN(p)} บาท`;
