  if (r.transportAmount) L.push({ n: 'ค่าพาหนะเดินทาง', it: null, amt: r.transportAmount });
  if (r.otherAmount) L.push({ n: r.otherDesc || 'ค่าใช้จ่ายอื่น', it: null, amt: r.otherAmount });
  const txt = String(r.itemsText || '').trim();
