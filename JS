/* ---------- กราฟรายจ่ายรายเดือน (SVG) ---------- */
function niceMax(v) {
  if (v <= 0) return 1;
  const p = Math.pow(10, Math.floor(Math.log10(v))), n = v / p;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * p;
}
const shortMoney = v => v >= 1e6 ? (v / 1e6).toLocaleString('th-TH', { maximumFractionDigits: 1 }) + ' ล้าน'
  : v >= 1e3 ? (v / 1e3).toLocaleString('th-TH', { maximumFractionDigits: 0 }) + ' พัน' : String(Math.round(v));

function renderChart() {
  const D = S.dash, M = D.months, funds = S.boot.funds;
  $('btnChartTable').textContent = S.chartTable ? 'ดูเป็นกราฟ' : 'ดูเป็นตาราง';
  if (S.chartTable) {
    $('dChart').innerHTML = `<div class="table-responsive"><table class="tbl"><thead><tr><th>เดือน</th>${funds.map(f => `<th class="num">${esc(f.short)}</th>`).join('')}<th class="num">รวม</th></tr></thead><tbody>` +
      M.map(m => `<tr><td>${MTH_S[m.month-1]} ${String(m.yearBE).slice(-2)}</td>${funds.map(f => `<td class="num">${m.byFund[f.code] ? money(m.byFund[f.code]) : '–'}</td>`).join('')}<td class="num"><b>${money(m.total)}</b></td></tr>`).join('') +
      '</tbody></table></div>';
    return;
  }
  const W = 720, H = 270, L = 64, R = 12, TP = 22, B = 34, pw = W - L - R, ph = H - TP - B;
  const max = niceMax(Math.max(...M.map(m => m.total), 0));
  const y = v => TP + ph - (v / max) * ph, cw = pw / 12, bw = Math.min(34, cw * 0.56);
  const ticks = [0, .25, .5, .75, 1].map(k => k * max);
  const iMax = M.reduce((b, m, i) => m.total > M[b].total ? i : b, 0);
  const bar = (x, top, h) => {             // มุมบนโค้ง 4px ฐานตรง
    const r = Math.min(4, h, bw / 2);
    return `M${x},${top + h}V${top + r}Q${x},${top} ${x + r},${top}H${x + bw - r}Q${x + bw},${top} ${x + bw},${top + r}V${top + h}Z`;
  };
  let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="กราฟรายจ่ายรายเดือน ตุลาคมถึงกันยายน"><g class="grid">`;
  const hasData = M.some(m => m.total > 0);
  ticks.forEach(t => { svg += `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}"/>` + (hasData || !t ? `<text x="${L - 8}" y="${y(t) + 4}" text-anchor="end">${t ? shortMoney(t) : '0'}</text>` : ''); });
  svg += '</g>';
  M.forEach((m, i) => {
    const cx = L + cw * i + cw / 2, x = cx - bw / 2;
    svg += `<text x="${cx}" y="${H - 12}" text-anchor="middle">${MTH_S[m.month-1]}</text>`;
    if (m.total > 0) {
      const h = Math.max(2, ph - (y(m.total) - TP));
      svg += `<path d="${bar(x, y(m.total), h)}" fill="#1F3A5F"/>`;
      if (i === iMax) svg += `<text class="vlabel" x="${cx}" y="${y(m.total) - 7}" text-anchor="middle">${shortMoney(m.total)}</text>`;
    }
    svg += `<rect class="hit" data-i="${i}" x="${L + cw * i}" y="${TP}" width="${cw}" height="${ph}"/>`;
  });
  svg += `<line x1="${L}" x2="${W - R}" y1="${TP + ph}" y2="${TP + ph}" stroke="#D5D0C4"/>`;
  if (!hasData) svg += `<text x="${L + pw / 2}" y="${TP + ph / 2}" text-anchor="middle" style="font-size:14px">ยังไม่มีรายจ่ายในช่วงนี้</text>`;
  svg += '</svg>';
  $('dChart').innerHTML = svg + '<div class="tip" id="chartTip"></div>';

  const tip = $('chartTip'), wrap = $('dChart');
  wrap.querySelectorAll('.hit').forEach(h => {
    h.onmousemove = ev => {
      const m = M[+h.dataset.i];
      const parts = funds.filter(f => m.byFund[f.code]).map(f =>
        `<div class="r"><i style="background:${f.color}"></i>${esc(f.short)}<b>${money(m.byFund[f.code])}</b></div>`).join('');
      tip.innerHTML = `<div class="h"><span>${MTH[m.month-1]} ${m.yearBE}</span><span>${money(m.total)}</span></div>` +
        (parts || '<div class="r" style="color:#9AA6B8">ไม่มีรายจ่าย</div>');
      const rc = wrap.getBoundingClientRect();
      let left = ev.clientX - rc.left + 14;
      if (left + 230 > rc.width) left = ev.clientX - rc.left - 230;
      tip.style.left = Math.max(0, left) + 'px';
      tip.style.top = Math.max(0, ev.clientY - rc.top - 20) + 'px';
      tip.style.opacity = 1;
    };
    h.onmouseleave = () => tip.style.opacity = 0;
  });
}

